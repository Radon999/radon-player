    def go_to_album(self, t):
        """The album song t is on: yours in the Albums tab if you have it, else its page on the song's service
        (or Tidal's, or YouTube Music's)."""
        album = (t.get("album") or "").strip()
        if not album:
            self.toast("This song has no album in its tags")
            return
        if self.selecting:
            self.stop_selecting()
        key = find_album_group(t, self.song_groups("albums"))
        if key is not None:
            self.open_pin({"kind": "group", "view": "albums", "id": key})
            return
        srcs = self.app.sources
        name = next((k for k in (source_of(t), "tidal", "ytm") if k in srcs and hasattr(srcs[k], "find")
                     and (k != "tidal" or getattr(srcs[k], "signed_in", True))), None)
        if name is None:
            self.toast(f"“{album}” isn't in your music, and no service is connected to look it up")
            return
        lead = lead_artist(t.get("artist") or "") or ""
        self.toast(f"Looking for “{album}”…")

        def found(res, err):
            want = norm(clean_title(album))
            albums = (res or {}).get("albums") or []
            pick = (next((x for x in albums if norm(clean_title(x["title"])) == want and norm(lead) in norm(x.get("sub") or "")), None)
                    or next((x for x in albums if norm(clean_title(x["title"])) == want), None))
            if pick is None:
                self.toast(f"Couldn't find “{album}” on {SOURCES.get(name, name)}")
                return
            self.open_album_page({**pick, "source": name})
        in_thread(srcs[name].find, f"{album} {lead}".strip(), done=found)

    def open_album_page(self, album):
        """An album from the search: its page on its own, Back goes to the search."""
        if self.stack.get_visible_child_name() != "artist":
            self.artist_from, self.artist_pages = self.stack.get_visible_child_name(), []
        self.stack.set_visible_child_name("artist")
        self.open_album(album)

    def open_album(self, album):
        artist = self.artist_pages[-1] if self.artist_pages else {}
        source = album.get("source") or (artist.get("info") or {}).get("source")
        page = {"kind": "album", "name": album["title"], "album": album, "artist": artist.get("name", ""),
                "tracks": album.get("tracks"), "error": None}
        self.artist_pages.append(page)
        self.render_artist()
        if page["tracks"] is not None:   # one of yours: its songs are here already
            return
        src = self.app.sources.get(source)
        if not src:
            page["error"] = f"{SOURCES.get(source, 'that service')} isn't connected"
            self.render_artist()
            return

        def done(res, err):
            page["tracks"], page["error"] = res or [], err
            if self.artist_pages and self.artist_pages[-1] is page:
                self.render_artist()
        in_thread(src.album, album["id"], done=done)

