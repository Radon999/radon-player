    def show_checks(self, on):
        for key in self.SELECT_LISTS:
            for r in self.rows(getattr(self, f"{key}_list", None)):
                r.check.visible, r.check.active = on, on and r.track["id"] in self.selected
                if r.cell:
                    r.cell.show_check()

    def start_selecting(self, row, extend=False):
        """Pick row's song (Shift: every song from the last one picked to it). Picks from other lists add up."""
        j = getattr(row, "np_index", None)
        if j is not None:   # from the queue in Now playing: pick in Up next & queues, this song first
            self.show_tab("queue")

            def pick():
                hit = next((r for r in self.rows(self.queue_list) if r.index == j), None)
                if hit is not None:
                    self.start_selecting(hit)
                return False
            GLib.timeout_add(250, pick)
            return
        lst = row.get_parent()
        if not self.selecting:
            self.selecting, self.selected, self.anchor = True, {}, None
            self.show_checks(True)
            self.selectbar.set_reveal_child(True)
        if lst is not self.select_list:
            self.select_list, self.anchor = lst, None
        if extend and self.anchor is not None:
            lo, hi = sorted((self.anchor, row.index))
            for r in self.rows(lst):
                if lo <= r.index <= hi:
                    r.show_check(True, True)
        else:
            row.show_check(True, not row.check.get_active())
            self.anchor = row.index
        self.update_selectbar()

    def set_selected(self, row, on):
        if not self.selecting:
            return
        if on:
            self.selected[row.track["id"]] = row.track
            self.select_list = row.get_parent() or self.select_list
        else:
            self.selected.pop(row.track["id"], None)
        self.update_selectbar()

    def stop_selecting(self):
        self.selecting, self.select_list, self.selected = False, None, {}
        self.show_checks(False)
        self.selectbar.set_reveal_child(False)

    def clear_selection(self):
        self.selected = {}
        self.show_checks(True)
        self.update_selectbar()

    def after_option(self):
        """An option was done with the songs picked: the selection closes, or stays for the next option."""
        if self.group_selecting:   # albums picked (Select in Albums): done with, or kept for another option
            if self.app.close_after:
                self.group_select(False)
            return
        if not self.selecting:   # an album's Options… (right-click), not songs picked
            self.selected = {}
            return
        if self.app.close_after:
            self.stop_selecting()
        else:
            self.show_checks(True)
            self.update_selectbar()

    def select_all(self):
        self.select_here("invert" if False else "toggle")

    def select_here(self, how):
        """All, none, the songs between the first and last picked, or the others: in the list you're picking in."""
        lst = self.select_list
        if lst is None:
            return
        self.lazy_all(lst)
        rows = list(self.rows(lst))
        if how == "toggle":
            how = "none" if rows and all(r.check.get_active() for r in rows) else "all"
        if how == "between":
            picked = [i for i, r in enumerate(rows) if r.check.get_active()]
            if len(picked) < 2:
                self.toast("Pick a first and a last song in this list")
                return
            for r in rows[picked[0]:picked[-1] + 1]:
                r.show_check(True, True)
        else:
            for r in rows:
                r.show_check(True, True if how == "all" else False if how == "none" else not r.check.get_active())
        self.update_selectbar()

    def picked_tracks(self):
        return list(self.selected.values())

    def update_selectbar(self):
        n = len(self.selected)
        lists = len({id(r.get_parent()) for key in self.SELECT_LISTS for r in self.rows(getattr(self, f"{key}_list", None))
                     if r.check.active})
        self.picked_label.set_label((f"{n} selected" + (f" · from {lists} lists" if lists > 1 else "")) if n
                                    else "Pick songs (from any lists)")
        self.sel_options.set_sensitive(n > 0)

    def options_dialog(self):
        """Everything to do with the songs picked. With Close selection after an option off, the
        selection stays for another option (queue them, then add them to a playlist, then…)."""
        a, tracks = self.app, self.picked_tracks()
        if not tracks:
            return
        dlg = Adw.Dialog(title=f"{len(tracks)} song{'s' if len(tracks) != 1 else ''}", content_width=380, content_height=600)
        page = Adw.ToolbarView()
        page.add_top_bar(Adw.HeaderBar())
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, margin_start=10, margin_end=10, margin_bottom=12)
        files = [t for t in tracks if song_file(self.lib, t)]
