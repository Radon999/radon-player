# Playback: one mpv process over its JSON IPC socket
# =============================================================================

def _die_with_parent():
    # mpv must not outlive the app (a killed app would leave music playing).
    import ctypes
    ctypes.CDLL("libc.so.6").prctl(1, signal.SIGTERM)  # PR_SET_PDEATHSIG


def child(args, **kw):
    """Start a helper program that goes when the app goes, however it goes."""
    if not WINDOWS:
        return subprocess.Popen(args, preexec_fn=_die_with_parent, **kw)
    proc = subprocess.Popen(args, **NO_WINDOW, **kw)
    _windows_job().assign(proc)
    return proc


class _WindowsJob:
    """A Windows job object that ends its processes when the app's handle on it closes
    (Windows' counterpart of PR_SET_PDEATHSIG)."""

    def __init__(self):
        import ctypes
        from ctypes import wintypes
        self.k32 = k32 = ctypes.WinDLL("kernel32", use_last_error=True)
        k32.CreateJobObjectW.restype = wintypes.HANDLE
        self.job = k32.CreateJobObjectW(None, None)

        class Basic(ctypes.Structure):
            _fields_ = [("PerProcessUserTimeLimit", ctypes.c_int64), ("PerJobUserTimeLimit", ctypes.c_int64),
                        ("LimitFlags", wintypes.DWORD), ("MinimumWorkingSetSize", ctypes.c_size_t),
                        ("MaximumWorkingSetSize", ctypes.c_size_t), ("ActiveProcessLimit", wintypes.DWORD),
                        ("Affinity", ctypes.c_size_t), ("PriorityClass", wintypes.DWORD),
                        ("SchedulingClass", wintypes.DWORD)]

        class Extended(ctypes.Structure):
            _fields_ = [("BasicLimitInformation", Basic), ("IoInfo", ctypes.c_uint64 * 6),
                        ("ProcessMemoryLimit", ctypes.c_size_t), ("JobMemoryLimit", ctypes.c_size_t),
                        ("PeakProcessMemoryUsed", ctypes.c_size_t), ("PeakJobMemoryUsed", ctypes.c_size_t)]
        info = Extended()
        info.BasicLimitInformation.LimitFlags = 0x2000   # JOB_OBJECT_LIMIT_KILL_ON_JOB_CLOSE
        k32.SetInformationJobObject(wintypes.HANDLE(self.job), 9, ctypes.byref(info), ctypes.sizeof(info))

    def assign(self, proc):
        from ctypes import wintypes
        self.k32.AssignProcessToJobObject(wintypes.HANDLE(self.job), wintypes.HANDLE(int(proc._handle)))


_JOB = None


def _windows_job():
    global _JOB
    if _JOB is None:
        _JOB = _WindowsJob()
    return _JOB


class _PipeIPC:
    """mpv's IPC on Windows: a named pipe, read and written at once through asyncio's
    overlapped I/O (a plain handle to a pipe can't read and write at the same time)."""

    def __init__(self, path, on_line):
        import asyncio
        self.loop = asyncio.ProactorEventLoop()
        self.transport = None
        ready, failed = threading.Event(), []

        class Proto(asyncio.Protocol):
            buf = b""

            def data_received(p, data):
                p.buf += data
                while b"\n" in p.buf:
                    line, p.buf = p.buf.split(b"\n", 1)
                    on_line(line)

        async def connect():
            for _ in range(100):
                try:
                    self.transport, _proto = await self.loop.create_pipe_connection(Proto, path)
                    return
                except OSError:
                    await asyncio.sleep(0.05)

        def run():
            asyncio.set_event_loop(self.loop)
            try:
                self.loop.run_until_complete(connect())
            except Exception as e:  # noqa: BLE001 -- reported below
                failed.append(e)
            ready.set()
            if self.transport:
                self.loop.run_forever()
        threading.Thread(target=run, daemon=True).start()
        ready.wait(15)
        if not self.transport:
            raise RuntimeError("mpv did not start")

    def send(self, data):
        self.loop.call_soon_threadsafe(self.transport.write, data)


GAIN_PROBE = 9001   # the request_id of asking mpv whether it has volume-gain


class Player:
    def __init__(self, on_event):
        self.on_event = on_event
        if not WINDOWS:
            SOCK.unlink(missing_ok=True)
        self.proc = child(
            ["mpv", "--idle=yes", "--no-video", "--no-terminal", "--load-scripts=no",
             f"--audio-client-name=omarchy-music{SUFFIX}",  # the desktop visualizer listens to this stream only
             "--no-config", "--audio-display=no", "--gapless-audio=weak", "--volume=100",
             f"--input-ipc-server={PIPE if WINDOWS else SOCK}", *shlex.split(os.environ.get("OMARCHY_MUSIC_MPV", ""))],
            stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        self.sock = self.pipe = None
        self.heard = False
        self.wlock = threading.Lock()
        if WINDOWS:
            self.pipe = _PipeIPC(PIPE, self._line)
        else:
            for _ in range(100):
                try:
                    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                    s.connect(str(SOCK))
                    self.sock = s
                    break
                except OSError:
                    time.sleep(0.05)
            if not self.sock:
                raise RuntimeError("mpv did not start")
            threading.Thread(target=self._reader, daemon=True).start()
        for i, prop in enumerate(("time-pos", "duration", "pause", "idle-active"), 1):
            self.cmd("observe_property", i, prop)
        # A song's own volume (Volume…) is mpv's volume-gain where mpv has it (0.36 on); an
        # older mpv gets it as a change of the volume instead.
        self.has_gain, self.base_volume, self.gain = None, 100.0, 0.0
        self.answers, self.next_rid, self.bitperfect = {}, 10000, False
        self.cmd_id("get_property", "volume-gain", rid=GAIN_PROBE)

    def ask(self, prop, cb):
        """mpv's prop, handed to cb (None if mpv has none) on the UI thread."""
        self.next_rid += 1
        self.answers[self.next_rid] = cb
        self.cmd_id("get_property", prop, rid=self.next_rid)

    def set_bitperfect(self, on, replaygain="off"):
        """Bit-perfect: the device to itself (WASAPI exclusive on Windows), at each song's own rate and
        depth, at full volume, with nothing in between (no EQ, volume, speed or ReplayGain); gapless stays."""
        self.bitperfect = on
        self.cmd("set_property", "audio-exclusive", bool(on))
        self.cmd("set_property", "replaygain", "no" if on else replaygain)
        self.cmd("set_property", "audio-samplerate", 0)   # each song's own rate
        if on:
            self.cmd("set_property", "af", "")
            self.cmd("set_property", "volume", 100)
            if self.has_gain:
                self.cmd("set_property", "volume-gain", 0)
            self.cmd("set_property", "speed", 1.0)
        self.cmd("ao-reload")

    def cmd_id(self, *args, rid):
        """A command whose answer comes back marked with rid (read in _line)."""
        self._send((json.dumps({"command": list(args), "request_id": rid}) + "\n").encode())

    def cmd(self, *args):
        self._send((json.dumps({"command": list(args)}) + "\n").encode())

    def _send(self, data):
        if self.pipe:
            self.pipe.send(data)
            return
        with self.wlock:
            try:
                self.sock.sendall(data)
            except OSError:
                pass

    def _reader(self):
        buf = b""
        while True:
            try:
                chunk = self.sock.recv(65536)
            except OSError:
                return
            if not chunk:
                return
            buf += chunk
            while b"\n" in buf:
                line, buf = buf.split(b"\n", 1)
                self._line(line)

    def _line(self, line):
        try:
            msg = json.loads(line)
        except ValueError:
            return
        self.heard = True   # mpv answered (the self-test checks this)
        if msg.get("request_id") == GAIN_PROBE:
            self.has_gain = msg.get("error") == "success"
            return
        cb = self.answers.pop(msg.get("request_id"), None) if msg.get("request_id") else None
        if cb:
            GLib.idle_add(lambda: (cb(msg.get("data") if msg.get("error") == "success" else None), False)[1])
            return
        if "event" in msg:
            GLib.idle_add(lambda m=msg: (self.on_event(m), False)[1])

    def load(self, path, paused=False, start=0, speed=1.0, pitch=False, gain=0.0):
        if getattr(self, "bitperfect", False):   # nothing in between: the song's own speed and volume wait
            speed, gain = 1.0, 0.0
        # The speed and the song's own volume go with every file, the defaults too: mpv puts
        # per-file options back when the file ends.
        opts = (f"pause={'yes' if paused else 'no'}" + (f",start={start:.1f}" if start else "")
                + f",speed={speed:g},audio-pitch-correction={'no' if pitch else 'yes'}"
                + (f",volume-gain={gain:g}" if self.has_gain else ""))
        self.gain = gain
        if not self.has_gain:
            self._volume_now()
        if getattr(self, "faded_in", False):
            self.cmd("af", "remove", "@fadein")   # the last crossfade's fade-in, done with
            self.faded_in = False
        self.cmd("loadfile", path, "replace", -1, opts)
        if self.fade_next and not self.bitperfect:
            self.cmd("af", "add", f"@fadein:lavfi=[afade=t=in:st={start or 0:.2f}:d={self.fade_next}:curve=qsin]")
            self.faded_in = True
        self.fade_next = 0

    def set_gain(self, db):
        """The playing song's own volume boost (dB), on top of the volume."""
        self.gain = db
        if self.has_gain:
            self.cmd("set_property", "volume-gain", db)
        else:
            self._volume_now()

    def _volume_now(self):
        """(an mpv without volume-gain) the volume with the song's boost in it, up to mpv's 130."""
        self.cmd("set_property", "volume", round(max(0.0, min(130.0, self.base_volume * 10 ** (self.gain / 20))), 1))

    def set_speed(self, speed, pitch=False):
        self.cmd("set_property", "audio-pitch-correction", not pitch)
        self.cmd("set_property", "speed", speed)

    def set_volume(self, volume, muted):
        if self.bitperfect:
            volume = 100   # full volume: the DAC (or your amp) sets the loudness
        self.base_volume = volume
        if self.has_gain is False and self.gain:
            self._volume_now()
        else:
            self.cmd("set_property", "volume", volume)
        self.cmd("set_property", "mute", muted)

    def set_filters(self, graph):
        """mpv's audio filters: a libavfilter graph, or none for untouched audio."""
        if self.bitperfect:
            graph = ""
        self.graph = graph
        self.cmd("set_property", "af", f"@eq:lavfi=[{graph}]" if graph else "")

    fade_next = 0      # crossfade: the next song loaded fades in over this many seconds
    graph = ""         # the filters playing (the EQ's), for the crossfade's tail

    def tail(self, path, start, secs, volume, playing=None):
        """Crossfade: the song ending goes on, from start, in an mpv of its own with the same filters, fading out over
        secs (an even, equal-power fade), while this one moves on to the next song. playing() is called (on the UI
        thread) once it's really playing, so this one moves on only then, with no gap; at the latest after 2 s."""
        af = ",".join(x for x in (self.graph, f"afade=t=out:st={start:.2f}:d={secs}:curve=qsin") if x)
        told = [False]

        def tell():
            if not told[0]:
                told[0] = True
                if playing:
                    playing()
            return False
        try:
            proc = child(["mpv", "--no-video", "--no-config", "--terminal", "--term-status-msg=", "--load-scripts=no",
                          "--audio-display=no", f"--audio-client-name=omarchy-music{SUFFIX}", f"--start={start:.2f}",
                          f"--volume={volume:g}", f"--af=lavfi=[{af}]", f"--length={secs + 0.5:.1f}",
                          "--term-playing-msg=PLAYING", str(path)],
                         stdin=subprocess.DEVNULL, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL)
        except OSError:
            tell()
            return

        def watch():
            for line in proc.stdout:
                if b"PLAYING" in line:
                    time.sleep(0.12)   # its first sound on its way out
                    GLib.idle_add(tell)
                    break
            for _ in proc.stdout:
                pass
        threading.Thread(target=watch, daemon=True).start()
        GLib.timeout_add(2000, tell)
        GLib.timeout_add(int((secs + 3) * 1000), lambda: (proc.poll() is None and proc.kill(), False)[1])

    def filter_cmd(self, command, arg, target):
        """Change one setting of one filter in the running graph, without a gap."""
        self.cmd("af-command", "eq", command, str(arg), target)

    caster = None   # casting (Caster): pauses and seeks go to the device too

    def set_pause(self, paused):
        self.cmd("set_property", "pause", paused)
        if self.caster and self.caster.cast:
            self.caster.pause(paused)

    def seek(self, seconds):
        self.cmd("seek", seconds, "absolute")
        if self.caster and self.caster.cast:
            self.caster.seek(seconds)

    def stop(self):
        self.cmd("stop")

    def quit(self):
        self.cmd("quit")
        try:
            self.proc.wait(timeout=2)
        except subprocess.TimeoutExpired:
            self.proc.kill()
        SOCK.unlink(missing_ok=True)


