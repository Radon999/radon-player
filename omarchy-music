        for r in rows:
            to = r["to"]
            ln = [f"{r['plays']:,} play{'s' if r['plays'] != 1 else ''} as “{r['title']}”",
                  f"→ “{to[0]}”: {to[2]:,} play{'s' if to[2] != 1 else ''}"]
            if r["version"]:
                ln.append("A version (acoustic, live, remix…): merge only if you count it as the same song")
            lines.append((f"{r['title']} — {r['artist']}", ln))
            alts.append((None, [to[0]] + r["others"], "Other song", sorted(by_artist[stats_key("", r["artist"])[1]], key=norm)))

