    def lyrics_into_files(self, tracks, quiet=False):
        """Each song's lyrics into its own file (found now if they weren't yet), so they stay with it."""
        files = [(t, song_file(self.lib, t)) for t in tracks]
        files = [(t, f) for t, f in files if f]

        def work():
            done = 0
            for t, f in files:
                try:
                    got = self.lyrics.get(t)
                    if got and put_lyrics(f, Lyrics.words(got)):
                        done += 1
                except Exception:  # noqa: BLE001 -- a file that can't be written (read-only, in use): the next one
                    continue
            return done

        def finished(n, _err):
            if not quiet:
                self.toast(f"Lyrics put into {n} file{'s' if n != 1 else ''}" if n else
                           "No lyrics to add: they're in the files already, or weren't found")
        if files:
            in_thread(work, done=finished)

