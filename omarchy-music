        line("Continue where you left off", "Stop on your phone and come back to the PC (or the other way round): it offers the "
             "same song at the same spot. Needs the phone paired (Phone, above) and this on, on both", bool(a.opt("continue_across")),
             opt_switch("continue_across"))
        line("Smart shuffle", "Shuffle leans toward songs you love (play a lot) but haven't heard in a while, instead of pure chance",
             bool(a.opt("smart_shuffle")), opt_switch("smart_shuffle"))
        flagged = a.qc_flagged() if a.opt("loudness_check") else []
        clipped = sum(1 for _f, r in flagged if r.get("clipped"))
