        menu.connect("pressed", lambda _g, _n, x, y: win.playlist_row_menu(self, x, y))
        self.add_controller(menu)


VIS_BANDS = 48     # bars (ffmpeg makes one more, at the top of the range, that's always empty: left out)
VIS_FPS = 60       # spectra a second: one a screen frame, so a beat shows the moment it lands
VIS_STEPS = 40     # how finely each bar's height is measured
VIS_FLOOR = 12     # of those steps: as quiet as a bar shows (ffmpeg's log scale starts here with sound)


def spectrum_cmd(src):
    """ffmpeg working out src's spectrum ahead of the music: VIS_FPS frames a second, each
    VIS_BANDS + 1 rows of VIS_STEPS bytes, a row's non-zero bytes its band's level (low bands
    first). A 3-minute song takes it about half a second."""
    return ["ffmpeg", "-v", "error", "-nostdin", "-protocol_whitelist", "file,http,https,tcp,tls,crypto,data", "-i", src,
            "-filter_complex", f"[0:a]aformat=channel_layouts=mono,showfreqs=s={VIS_BANDS + 1}x{VIS_STEPS}:rate={VIS_FPS}"
            ":mode=bar:ascale=log:fscale=log:win_size=1024,format=gray,transpose=1[v]",   # 23 ms of sound a spectrum
            "-map", "[v]", "-f", "rawvideo", "-"]


def spectrum_levels(frame):
    """A frame of spectrum_cmd's output as each band's level, 0..1."""
    span = VIS_STEPS - VIS_FLOOR
    return [max(0.0, min(1.0, (VIS_STEPS - frame[i * VIS_STEPS:(i + 1) * VIS_STEPS].count(0) - VIS_FLOOR) / span))
            for i in range(VIS_BANDS)]


