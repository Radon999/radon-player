        if self.search_in.get_selected() != list(SEARCH_IN).index(a.search_in):
            self.search_in.set_selected(list(SEARCH_IN).index(a.search_in))
        self.entry.set_placeholder_text(self.search_hint())
        if a.browse_local and self.stack.get_visible_child_name() == "account":
            self.show_tab("music")
        self.open_playlist = None
        if not a.browse_local:
