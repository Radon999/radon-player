def xlsx_rows(path, sheet_end):
    """The rows (lists of cell texts) of the worksheet whose name ends with sheet_end, in the .xlsx at path
    (no spreadsheet library needed: an .xlsx is a zip of XML)."""
    import xml.etree.ElementTree as ET
    ns = {"m": "http://schemas.openxmlformats.org/spreadsheetml/2006/main"}
    rel = "{http://schemas.openxmlformats.org/officeDocument/2006/relationships}id"
    with zipfile.ZipFile(path) as z:
        shared = []
        if "xl/sharedStrings.xml" in z.namelist():
            for si in ET.fromstring(z.read("xl/sharedStrings.xml")).findall("m:si", ns):
                shared.append("".join(t.text or "" for t in si.iter(f"{{{ns['m']}}}t")))
        book = ET.fromstring(z.read("xl/workbook.xml"))
        sheet = next((s for s in book.iter(f"{{{ns['m']}}}sheet") if s.get("name", "").lower().endswith(sheet_end.lower())), None)
        if sheet is None:
            return None
        rels = ET.fromstring(z.read("xl/_rels/workbook.xml.rels"))
        target = next((r.get("Target") for r in rels if r.get("Id") == sheet.get(rel)), "")
        target = target.lstrip("/")
        target = target if target.startswith("xl/") else "xl/" + target
        out = []
        for row in ET.fromstring(z.read(target)).iter(f"{{{ns['m']}}}row"):
            cells = {}
            for c in row.findall("m:c", ns):
                ref = re.match(r"[A-Z]+", c.get("r") or "")
                col = 0
                for ch in (ref.group(0) if ref else ""):
                    col = col * 26 + ord(ch) - 64
                v = c.find("m:v", ns)
                if c.get("t") == "s" and v is not None:
                    text = shared[int(v.text)]
                elif c.get("t") == "inlineStr":
                    text = "".join(t.text or "" for t in c.iter(f"{{{ns['m']}}}t"))
                else:
                    text = v.text if v is not None else ""
                cells[(col or len(cells) + 1) - 1] = text or ""
            if cells:
                out.append([cells.get(i, "") for i in range(max(cells) + 1)])
        return out


class DeezerHistory(SpotifyHistory):
    """What you played on Deezer, from the file its privacy page gives you (My account › Privacy settings ›
    My personal data: an .xlsx whose "10_listeningHistory" sheet lists every play). Plays as Spotify's: from 30
    seconds, the same play not counted twice."""

    @staticmethod
    def default_path():
        return DEEZER_HISTORY
    TITLE = ("song title", "titre", "titre du morceau", "titre de la chanson")
    ARTIST = ("artist", "artiste", "artists", "artistes")
    ALBUM = ("album title", "album", "titre de l'album")
    WHEN = ("date", "date d'écoute", "date de l'écoute", "date d'ecoute", "date de l'ecoute")
    LENGTH = ("listening time", "temps d'écoute", "durée d'écoute", "duree d'ecoute", "écoute")

    @staticmethod
    def when(text):
        """A play's time: "2024-05-01 18:02:11" (as Deezer writes it, your time), or a spreadsheet's day number."""
        text = (text or "").strip()
        try:
            return int(datetime.strptime(text[:19], "%Y-%m-%d %H:%M:%S").timestamp())
        except ValueError:
            pass
        try:
            return int(datetime.strptime(text[:16], "%Y-%m-%d %H:%M").timestamp())
        except ValueError:
            pass
        try:
            days = float(text)
            return int((datetime(1899, 12, 30) + timedelta(days=days)).timestamp()) if days > 20000 else 0
        except ValueError:
            return 0

    @staticmethod
    def seconds(text):
        text = (text or "").strip().replace(",", ".")
        try:
            return float(text)
        except ValueError:
            parts = text.split(":")
            try:
                nums = [float(p) for p in parts]
            except ValueError:
                return 0
            return sum(n * 60 ** i for i, n in enumerate(reversed(nums))) if len(nums) in (2, 3) else 0

    @classmethod
    def parse_rows(cls, rows):
        out, cols = [], None
        for row in rows:
            low = [c.strip().lower() for c in row]
            if cols is None:
                pick = lambda names: next((i for i, c in enumerate(low) if c in names), None)
                found = {k: pick(v) for k, v in (("title", cls.TITLE), ("artist", cls.ARTIST), ("album", cls.ALBUM),
                                                ("when", cls.WHEN), ("length", cls.LENGTH))}
                if None not in (found["title"], found["artist"], found["when"]):
                    cols = found
                continue
            cell = lambda k: row[cols[k]] if cols[k] is not None and cols[k] < len(row) else ""
            title, artist = cell("title").strip(), cell("artist").strip()
            t = cls.when(cell("when"))
            secs = cls.seconds(cell("length")) if cols["length"] is not None else 30
            if title and artist and t > 0 and secs >= 30:
                out.append((t, artist, title, cell("album").strip(), int(secs * 1000)))
        return out

    def import_file(self, path):
        """Read Deezer's .xlsx (or the zip it came in); how many plays were new (blocking)."""
        rows = None
        if zipfile.is_zipfile(path):
            with zipfile.ZipFile(path) as z:
                names = z.namelist()
                if "xl/workbook.xml" in names:
                    rows = xlsx_rows(path, "_listeningHistory")
                else:   # the download's zip, with the .xlsx in it
                    inner = next((n for n in names if n.lower().endswith(".xlsx")), None)
                    if inner:
                        rows = xlsx_rows(io.BytesIO(z.read(inner)), "_listeningHistory")
        if rows is None:
            raise ValueError("that isn't Deezer's personal data file: it's an .xlsx with a “10_listeningHistory” sheet")
        out = self.parse_rows(rows)
        if not out:
            raise ValueError("no songs played for 30 seconds or more in it")
        return self.add(out)


APPLE_HISTORY = STATE_DIR / f"omarchy-music{SUFFIX}-apple-history.json"


class AppleHistory:
    """What you played on Apple Music, from the zip Apple's privacy page gives you (Apple Media
    Services information) or a library exported from the Music app (File › Library › Export
    Library…). Rows: [start, artist, title, album, ms, count]: a play (Play Activity, Track Play
    History), a day's plays of a song (Play History Daily Tracks: start is the day, ms the day
    long), or a song's all-time count from a library (start 0)."""

    def __init__(self, path=None):
        self.path = path or APPLE_HISTORY
        self.lock = threading.Lock()
        self.rows = [list(r) for r in read_json(self.path, {}).get("rows", [])]

    @property
    def plays(self):
        return sum(int(r[5]) for r in self.rows)

    def add(self, new):
        """Add rows; one already here (the same song at the same time) keeps the higher count. How many plays were new."""
        with self.lock:
            have = {(r[0], norm(r[1]), norm(clean_title(r[2]))): r for r in self.rows}
            before = self.plays
            for r in new:
                k = (r[0], norm(r[1]), norm(clean_title(r[2])))
                old = have.get(k)
                if old is None:
                    have[k] = list(r)
                    self.rows.append(have[k])
                elif r[5] > old[5]:
                    old[5] = r[5]
                    old[3] = old[3] or r[3]
            self.rows.sort(key=lambda r: r[0])
            write_atomic(self.path, json.dumps({"rows": self.rows}))
            return self.plays - before

    def timed_plays(self):
        """Each play with its time, as Spotify's are: (start, artist, title, album, ms)."""
        return [(r[0], r[1], r[2], r[3], r[4]) for r in self.rows if r[0] > 0 for _ in range(int(r[5]))]

    def clear(self):
        with self.lock:
            self.rows = []
            self.path.unlink(missing_ok=True)

    @staticmethod
    def split_description(d):
        """"Artist - Title" (Apple's Track Description) into (artist, title)."""
        artist, _sep, title = (d or "").partition(" - ")
        return (artist.strip(), title.strip()) if title else ("", (d or "").strip())

    @staticmethod
    def parse_csv(name, text):
        """The rows in one of Apple's CSV files (by its name), [] for files without plays."""
        rows = list(csv.DictReader(io.StringIO(text.lstrip("\ufeff"))))
        out = []
        low = name.lower()
        col = lambda r, *keys: next((r[k] for k in keys if r.get(k) not in (None, "")), "")   # noqa: E731

        def stamp(v):
            v = str(v or "").strip()
            if v.isdigit():
                n = int(v)
                return n // 1000 if n > 10 ** 11 else n
            try:
                return int(datetime.fromisoformat(v.replace("Z", "+00:00")).timestamp())
            except ValueError:
                return 0
        if "play activity" in low:
            for r in rows:
                title, artist = col(r, "Song Name", "Content Name"), col(r, "Artist Name", "Container Artist Name")
                played, length = col(r, "Play Duration Milliseconds"), col(r, "Media Duration In Milliseconds")
                try:
                    played, length = int(float(played or 0)), int(float(length or 0))
                except ValueError:
                    continue
                if not title or not artist or played <= 0:
                    continue
                if length > 0 and played < length / 2:
                    continue   # a play counts from half the song
                if length <= 0 and played < 30000:
                    continue
                start = stamp(col(r, "Event Start Timestamp", "Event Received Timestamp", "Event End Timestamp"))
                if start:
                    out.append([start, artist, title, col(r, "Album Name", "Container Album Name"), played, 1])
        elif "daily tracks" in low:
            for r in rows:
                artist, title = AppleHistory.split_description(col(r, "Track Description"))
                day = str(col(r, "Date Played")).strip()
                try:
                    n = int(float(col(r, "Play Count") or 0))
                    start = int(datetime.strptime(day, "%Y%m%d").replace(tzinfo=timezone.utc).timestamp())
                except ValueError:
                    continue
                if artist and title and n > 0:
                    out.append([start, artist, title, "", 86400 * 1000, n])
        elif "track play history" in low:
            for r in rows:
                artist, title = AppleHistory.split_description(col(r, "Track Name", "Track Description"))
                start = stamp(col(r, "Last Played Date", "Play Date"))
                if artist and title and start:
                    out.append([start, artist, title, "", 0, 1])
        return out

    @staticmethod
    def parse_library(data):
        """A library the Music app exported (.xml): each song's all-time Play Count."""
        import plistlib
        lib = plistlib.loads(data)
        out = []
        for t in (lib.get("Tracks") or {}).values():
            n = int(t.get("Play Count") or 0)
            if n > 0 and t.get("Name") and t.get("Artist"):
                out.append([0, t["Artist"], t["Name"], t.get("Album") or "", int(t.get("Total Time") or 0), n])
        return out

    def import_file(self, path):
        """Read Apple's zip, one of its .csv files, or a library .xml; how many plays were new (blocking)."""
        found = {}
        if zipfile.is_zipfile(path):
            with zipfile.ZipFile(path) as z:
                for n in z.namelist():
                    if n.lower().endswith(".csv") and any(k in n.lower() for k in ("play activity", "daily tracks",
                                                                                   "track play history")):
                        found[n] = self.parse_csv(n.rsplit("/", 1)[-1], z.read(n).decode("utf-8", "replace"))
                    elif n.lower().endswith(".zip"):   # Apple puts the Music files in a zip of their own
                        import io as _io
                        with zipfile.ZipFile(_io.BytesIO(z.read(n))) as inner:
                            for m in inner.namelist():
                                if m.lower().endswith(".csv") and any(k in m.lower() for k in (
                                        "play activity", "daily tracks", "track play history")):
                                    found[m] = self.parse_csv(m.rsplit("/", 1)[-1], inner.read(m).decode("utf-8", "replace"))
        elif str(path).lower().endswith(".xml"):
            found[path] = self.parse_library(Path(path).read_bytes())
        else:
            found[path] = self.parse_csv(Path(path).name, Path(path).read_text("utf-8", "replace"))
        # The most detailed file wins: each play (Play Activity) over each day's (Daily Tracks) over the list.
        for kind in ("play activity", "daily tracks", "track play history"):
            rows = [r for n, rs in found.items() if kind in n.lower() for r in rs]
            if rows:
                return self.add(rows)
        rows = [r for rs in found.values() for r in rs]
        if not rows:
            raise ValueError("no plays in it: Apple's download has Apple Music Play Activity.csv (or Play History "
                             "Daily Tracks.csv), or export your library from the Music app (File › Library › Export Library…)")
        return self.add(rows)


def solo_names(app, called):
    """The artists known on their own (artist_key's names): in your songs, or played with a credit of their own."""
    try:
        solo = solo_artists(app.my_songs())
    except Exception:  # noqa: BLE001 -- no library to ask: the plays alone
        solo = set()
    for names in called.values():
        for n in names:
            if not re.search(r" & | x | X | and |,|;", n):
                solo.add(re.sub(r"[\W_]+", "", norm(n)))
    return solo


def artist_named(names, solo=()):
    """An artist's name for Most played and Artists, from the credits played {credit: plays}: one on its own if there
    is one; else "Quinn XCII & Jeremy Zucker" is Quinn XCII when Quinn XCII is an artist of their own (in your songs
    or played alone), and "Simon & Garfunkel" stays a duo."""
    best = min(names, key=lambda n: (bool(re.search(r" & | x |,", n)), -names[n]))
    if re.search(r" & | x |,", best):
        head = main_artist(best, solo)
        if head and head != best:
            return head
    return best


def stats_key(title, artist):
    """A song across Last.fm, Spotify, Apple Music and here: its name and lead artist, tidied
    (feat., & and x credits, remaster notes left out)."""
    lead = re.split(r",|;| & | x | feat\.? | ft\.? | featuring | with ", (artist or "").lower())[0]
    return norm(clean_title(title or "")), re.sub(r"[\W_]+", "", norm(lead)) or norm(lead)   # K.Flay = kflay


NEW_RELEASES = STATE_DIR / f"omarchy-music{SUFFIX}-new-releases.json"
NR_KINDS = (("album", "Albums"), ("single", "Singles"), ("ep", "EPs"), ("artists", "Artists"))
NR_RANGES = {"week": 7, "month": 30, "year": 365}


class NewReleases:
    """New releases of every artist with songs on your device, from Deezer's catalogue (free, no account;
    it says when each came out and whether it's an album, a single or an EP). Nothing is checked on its
    own: Refresh reads your artists again and looks, for the last week, month or year, when you press it."""

    def __init__(self, path=None):
        self.path = path or NEW_RELEASES
        saved = read_json(self.path, {})
        self.artists = saved.get("artists") or []   # the names to look for
        self.ids = saved.get("ids") or {}           # norm(name) -> Deezer's artist id (0: not found)
        self.found = saved.get("found") or []       # [{title, artist, date, type, cover, link}], newest first
        self.scanned, self.range = saved.get("scanned", 0), saved.get("range", "month")
        self.busy, self.status, self.stop = False, "", False

    def save(self):
        write_atomic(self.path, json.dumps({"artists": self.artists, "ids": self.ids, "found": self.found,
                                            "scanned": self.scanned, "range": self.range}))

    def read_artists(self, songs):
        """The artists to look for: the lead artist of every song of yours, the ones you have most songs of first."""
        c = Counter(lead_artist(t.get("artist")) for t in songs if t.get("artist"))
        self.artists = [a for a, _n in c.most_common() if a and norm(a) not in ("unknown artist", "various artists")]
        self.save()
        return len(self.artists)

    @staticmethod
    def kind(album):
        t = (album.get("record_type") or "album").lower()
        return "ep" if t == "ep" else "single" if t == "single" else "album"

    @staticmethod
    def same_name(a, b):
        """The same artist, written either way: "half•alive" and "half alive", "K.Flay" and "KFlay"."""
        bare = lambda x: re.sub(r"[\W_]+", "", norm(re.sub(r"^the ", "", x or "", flags=re.I)))   # noqa: E731
        return bool(bare(a)) and bare(a) == bare(b)

    def deezer(self, url):
        """Deezer's answer; when it says too many asks at once, wait and ask again."""
        for wait in (0, 5, 10):
            time.sleep(wait)
            got = http_json(url)
            if (got.get("error") or {}).get("code") != 4:   # 4: quota (50 asks every 5 seconds)
                return got
        return got

    def artist_id(self, name):
        k = norm(name)
        if self.ids.get(k):
            return self.ids[k]
        got = self.deezer("https://api.deezer.com/search/artist?q=" + urllib.parse.quote(name) + "&limit=10")
        hit = next((a for a in got.get("data") or [] if self.same_name(a.get("name"), name)), None)
        self.ids[k] = int(hit["id"]) if hit else 0
        return self.ids[k]

    def scan(self, period, progress=lambda text: None):
        """(blocking) Look at each artist's releases from the last week, month or year."""
        since = (datetime.now() - timedelta(days=NR_RANGES.get(period, 30))).date().isoformat()
        out, names = [], list(self.artists)
        self.stop = False
        for i, name in enumerate(names):
            if self.stop:
                break
            progress(f"Looking at {name} · {i + 1} of {len(names)}")
            try:
                aid = self.artist_id(name)
                if not aid:
                    continue
                got = self.deezer(f"https://api.deezer.com/artist/{aid}/albums?limit=100")
            except Exception:  # noqa: BLE001 -- the next artist
                continue
            for al in got.get("data") or []:
                date = al.get("release_date") or ""
                if date >= since:
                    out.append({"title": al.get("title") or "", "artist": name, "date": date, "type": self.kind(al),
                                "cover": al.get("cover_medium") or al.get("cover") or "", "link": al.get("link") or ""})
            time.sleep(0.12)   # Deezer takes 50 asks every 5 seconds
        out.sort(key=lambda r: r["date"], reverse=True)
        self.found, self.scanned, self.range = out, time.time(), period
        self.save()
        return len(out)


def fmt_date(iso):
    """2026-10-12 as 12 Oct 2026."""
    try:
        d = datetime.strptime(iso[:10], "%Y-%m-%d")
    except ValueError:
        return iso
    return f"{d.day} {d:%b %Y}"


def scrobble_rows(fm, period, progress=None):
    """Your scrobbles in period (a year, "m2026-10" or "w2026-10-19"): [(time, artist, title,
    album, image)], read from Last.fm once and kept in WRAPPED; later only what's new is asked for."""
    start = period_start(period).timestamp()
    end = min(period_end(period).timestamp(), time.time())
    WRAPPED.mkdir(parents=True, exist_ok=True)
    path = WRAPPED / f"{safe_name(fm.user.lower())}-{period}.json"
    saved = read_json(path, {})
    rows = [tuple(r) for r in saved.get("rows", [])]
    since = max(start, saved["until"] - 14 * 86400) if "until" in saved else start   # Last.fm takes scrobbles two weeks late
    if saved.get("until", start) < end:
        new = fm.recent(since, end, lambda p, n: progress and progress(f"Reading your scrobbles · {period_name(period)} · "
                                                                      f"page {p} of {n}"))
        have = {(r[0], r[2]) for r in rows}
        rows = sorted(rows + [r for r in new if (r[0], r[2]) not in have])
        write_atomic(path, json.dumps({"rows": rows, "until": end}))
    return rows


STAT_SOURCES = ("lastfm", "spotify", "deezer", "apple", "here")
STATS_VERSION = 7   # 7: a joint credit's plays count for its main artist (Joint artists… picks); 6: "A & B" named A; 5: listening time by song too; 2: every scrobble and every imported play, added up; 3: this week, month and year too; 4: artists named solo
STATS_PERIODS = {"week": 7, "month": 30, "year": 365}

# 2.0's switches and their defaults (the app's opts): each one off until you turn it on.
OPTS = {"crossfade": False, "crossfade_secs": 6, "smart_transitions": False, "crossfeed": False, "continue_across": False,
        "smart_shuffle": False, "loudness_check": False, "mono": False,
        "clip_guard": False, "loudness_comp": False, "hq_resample": False, "balance": 0.0, "crossfeed_k": 0.3, "tilt": 0.0, "rg_target": -18.0, "detail": False}   # Most played over the last so many days (and all time)


def all_scrobbles(fm, progress=None):
    """(blocking) Every scrobble you have on Last.fm: [(time, artist, title, album, image)], a year at a
    time (kept, as Wrapped keeps them: after the first time only the new ones are read). From the year you
    joined; and further back while there are fewer than Last.fm's count (scrobbles imported from before)."""
    me = fm.info()
    now = datetime.now().year
    first = datetime.fromtimestamp(me.get("registered") or time.time()).year
    rows = []
    for y in range(first, now + 1):
        rows += scrobble_rows(fm, y, progress)
    y = first - 1
    while len(rows) < (me.get("playcount") or 0) - 10 and y >= 2002:
        rows += scrobble_rows(fm, y, progress)
        y -= 1
    return rows


def add_plays(songs, title, artist, album, thumb, n, source):
    return _add_plays(songs, title, artist, album, thumb, n, source)


def _add_plays(songs, title, artist, album, thumb, n, source):
    """Count n plays from source (STAT_SOURCES) for a song in songs (stats key -> its counts): the
    same song from every source is one row, its plays added up."""
    if not title or not artist or n <= 0:
        return
    k = stats_key(title, artist)
    s = songs.get(k)
    if s is None:
        s = songs[k] = {"title": title, "artist": artist, "album": album or "", "thumb": thumb or "",
                        "plays": 0, **{x: 0 for x in STAT_SOURCES}}
    s.setdefault(source, 0)
    s[source] += n
    s["plays"] += n
    s["album"] = s["album"] or album or ""
    s["thumb"] = s["thumb"] or thumb or ""


def album_kind(album, title=""):
    """What an album is, for which one a song's plays go to: 0 a single, 1 an EP, 2 an album, 3 a deluxe,
    extended or anniversary edition (always the one, when there is one)."""
    name = (album or "").strip()
    if is_single(name, title):
        return 0
    if re.search(r"(?:^|[\s(\[-])EP\b", name) or re.search(r"\bsessions?\b|\bgreatest hits\b|\bbest of\b", name, re.I):
        return 1   # an EP, or a sessions record or a best-of: the album its songs are from over it
    if album_edition(name)[1]:
        return 3
    return 2


def album_play_key(title, artist, album):
    """A song's plays on one album, for album_picks: "title|artist|album", tidied."""
    k = stats_key(title, artist)
    return f"{k[0]}|{k[1]}|{norm(clean_title(album or ''))}"


def album_plays_plan(plays, mine=(), picks=None):
    """Songs whose plays (your imports' and Last.fm's) are on more than one album (its single, an EP, the
    album, its deluxe): [{"title", "artist", "albums": [(album, plays)], "to": the one they all go to}].
    The album wins over an EP and a single, a deluxe or extended edition over the album; then one you
    have, then the most played. plays: (title, artist, album, n); mine: your songs (their albums count, with
    no plays). Songs already decided (album_picks, any of their albums) aren't offered."""
    picks = picks or {}
    songs = {}
    for title, artist, album, n in plays:
        if not title or not artist or not (album or "").strip():
            continue
        k = stats_key(title, artist)
        s = songs.setdefault(k, {"title": title, "artist": artist, "albums": collections.Counter(), "names": {}, "have": set()})
        a = norm(clean_title(album))
        s["albums"][a] += n
        s["names"].setdefault(a, album.strip())
    for t in mine:
        k = stats_key(t.get("title"), t.get("artist"))
        if k in songs and (t.get("album") or "").strip():
            a = norm(clean_title(t["album"]))
            s = songs[k]
            s["names"].setdefault(a, t["album"].strip())
            s["albums"].setdefault(a, 0)
            s["have"].add(a)
    out = []
    for k, s in songs.items():
        if len(s["albums"]) < 2 or not any(n for n in s["albums"].values()):
            continue
        if any(f"{k[0]}|{k[1]}|{a}" in picks for a in s["albums"]):
            continue   # decided before (merged, or left as they are)
        to = max(s["albums"], key=lambda a: (album_kind(s["names"][a], s["title"]), a in s["have"], s["albums"][a]))
        if all(a == to or not s["albums"][a] for a in s["albums"]):
            continue   # every play on the one already
        out.append({"title": s["title"], "artist": s["artist"], "to": s["names"][to],
                    "albums": sorted(((s["names"][a], n) for a, n in s["albums"].items()), key=lambda x: -x[1])})
    return sorted(out, key=lambda x: (norm(x["artist"]), norm(x["title"])))


SONG_VERSION = re.compile(r"\b(acoustic|remix|rmx|live|demo|stripped|orchestra|session|sessions|alternate|commentary|instrumental|"
                          r"sped|slowed|mix|edit|rework|piano|reprise|cover|karaoke|cappella|unplugged|extended|voice memo|"
                          r"home recording|recorded at|version|vip|bootleg|flip)\b", re.I)


def loose_title(title):
    """A song's name with everything after it left out ("(Acoustic)", "- From the Original Motion Picture…",
    "[v2]") and no punctuation ("N.P.D" = "NPD"): songs with the same one may be one song, or versions of it."""
    t = unicodedata.normalize("NFKC", (title or "").lower())
    t = re.sub(r"[(\[][^)\]]*[)\]]", " ", t)
    t = re.sub(r"\s[-–—]\s.*$", " ", t)
    t = re.sub(r"\s(?:feat|ft|featuring)\b.*$", " ", t)
    return re.sub(r"[\W_]+", "", t)


def song_pick_key(title, artist):
    return "|".join(stats_key(title, artist))


def duplicate_songs_plan(songs, picks=None):
    """Songs in Most played that may be one song counted twice: the same name but for what's after it ("Zero - From
    the Original Motion Picture…" and "Zero (From 'Ralph Breaks the Internet')"), or its punctuation ("N.P.D" and
    "NPD"), or a version of it ("creature" and "Creature - Acoustic"). [{"title", "artist", "plays", "to": (title,
    artist, plays), "others": [titles], "version"}]: each onto the group's most played one that isn't a version.
    songs: Most played's ({title, artist, plays}). Ones decided before (picks) aren't offered."""
    picks = picks or {}
    groups = collections.defaultdict(list)
    for s in songs:
        lt = loose_title(s.get("title"))
        if len(lt) >= 2 and s.get("artist"):
            groups[(lt, stats_key("", s["artist"])[1])].append(s)
    out = []
    for group in groups.values():
        if len(group) < 2:
            continue

        def extra(t):   # what a title has past the plain name: "Acoustic", "From the Original Motion Picture…"
            return re.sub(r"^[^(\[\-–—]*", "", t or "")
        to = max(group, key=lambda x: (not SONG_VERSION.search(extra(x["title"])), x.get("plays", 0)))
        for x in group:
            if x is to or song_pick_key(x["title"], x["artist"]) in picks:
                continue
            out.append({"title": x["title"], "artist": x["artist"], "plays": x.get("plays", 0),
                        "to": (to["title"], to["artist"], to.get("plays", 0)),
                        "others": [y["title"] for y in group if y is not x and y is not to],
                        "version": bool(SONG_VERSION.search(extra(x["title"])))})
    return sorted(out, key=lambda r: (norm(r["artist"]), norm(r["to"][0]), -r["plays"]))


MILESTONES = (100, 250, 500, 1000, 2500, 5000, 10000, 25000, 50000, 100000)


def reached_at(total, times, level):
    """When a play count got to level: times are the plays with a time [(when, n)]; the rest of total (plays with
    no time: an Apple library's totals, the app's own counts) count as before them all (0). None: not yet."""
    if total < level:
        return None
    got = total - sum(n for _t, n in times)
    if got >= level:
        return 0
    for t, n in sorted(times):
        got += n
        if got >= level:
            return int(t)
    return 0


def new_milestones(songs, artists, old, times=None):
    """Milestones: a song or artist reaching 100, 250, 500, 1,000… plays, each with when it got there, from the plays'
    own times (times: ({song key: [(when, n)]}, {artist key: [(when, n)]})), so Wrapped can show a year's. One
    reached without times is dated now, or 0 (where things already stood) on the first count."""
    song_times, artist_times = times or ({}, {})
    seen = {(m["what"], m["key"], m["plays"]): m for m in old}
    first = not old
    now = int(time.time())
    out = []
    for what, rows, by in (("song", songs[:3000], song_times), ("artist", artists[:1000], artist_times)):
        for s in rows:
            name = s.get("title") or s.get("name") or ""
            if what == "song":
                key = "|".join(stats_key(name, s.get("artist") or name))
                ts = by.get(stats_key(name, s.get("artist") or name), [])
            else:
                key = artist_key(name)
                ts = by.get(key, [])
            for level in MILESTONES:
                at = reached_at(s["plays"], ts, level)
                if at is None:
                    break
                before = seen.get((what, key, level))
                if at == 0 and not first:
                    at = before["at"] if before else now   # reached just now, with plays that have no time
                out.append({"what": what, "key": key, "name": name, "artist": s.get("artist") or "", "plays": level, "at": at})
    return sorted(out, key=lambda m: (-m["at"], -m["plays"]))[:6000]


def period_milestones(milestones, start, end, n=6):
    """The milestones reached between start and end (all of them: start 0), the highest of each song's and artist's,
    biggest first."""
    best = {}
    for m in milestones:
        if (m.get("at") or 0) >= start and (m.get("at") or 0) < end or (start == 0 and m.get("at") is not None):
            k = (m["what"], m["key"])
            if k not in best or m["plays"] > best[k]["plays"]:
                best[k] = m
    return sorted(best.values(), key=lambda m: (-m["plays"], m["what"] != "artist", -(m.get("at") or 0)))[:n]


class ListenTime:
    """Listening time (Most played › Time): how long you listened, by artist and album, by hour of the day and day of the
    week, for the last week, month, year and all time. A play's length is what Spotify or Apple say it played, else the
    song's own length (your copy of it), else 3½ minutes."""

    def __init__(self, app, since):
        self.since = dict(since, all=0)
        self.lengths = {}
        self.app = app
        self.resolve = resolver_of(app)
        try:
            for t in app.my_songs():
                if t.get("duration"):
                    self.lengths[stats_key(t.get("title"), t.get("artist"))] = t["duration"]
        except Exception:  # noqa: BLE001 -- the default length, then
            pass
        self.t = {k: {"secs": 0, "artists": Counter(), "albums": Counter(), "songs": Counter(), "names": {},
                      "hours": [0] * 24, "days": [0] * 7, "called": collections.defaultdict(Counter)} for k in self.since}

    def add(self, t, title, artist, album, n, ms=0):
        if not t or n <= 0:
            return
        secs = (ms / 1000 if ms and ms > 30000 else self.lengths.get(stats_key(title, artist), 210)) * n
        lead = self.resolve(artist) or lead_artist(artist) or artist
        ak = resolved_key(lead)
        base = album_edition(album or "")[0]
        bk = f"{norm(clean_title(base))}|{ak}" if album else ""
        d = datetime.fromtimestamp(t)
        for k, start in self.since.items():
            if t < start:
                continue
            x = self.t[k]
            x["secs"] += secs
            x["artists"][ak] += secs
            x["names"].setdefault(ak, lead)
            x["called"][ak][lead] += 1
            sk = "s|" + "|".join(stats_key(title, artist))
            x["songs"][sk] += secs
            x["names"].setdefault(sk, (title, artist, album or ""))
            if bk:
                x["albums"][bk] += secs
                if album_edition(album)[1] or bk not in x["names"]:
                    x["names"][bk] = (album, lead)
            x["hours"][d.hour] += secs
            x["days"][d.weekday()] += secs

    def totals(self):
        out = {}
        for x in self.t.values():   # named as resolved, as Most played names them
            for a, names in x["called"].items():
                x["names"][a] = max(names, key=names.get)
        for k, x in self.t.items():
            out[k] = {"secs": round(x["secs"]), "hours": [round(h) for h in x["hours"]], "days": [round(h) for h in x["days"]],
                      "artists": [(x["names"][a], round(v)) for a, v in x["artists"].most_common(300)],
                      "albums": [(*x["names"][b], round(v), b) for b, v in x["albums"].most_common(300)],
                      "songs": [(*x["names"][s], round(v)) for s, v in x["songs"].most_common(500)]}
        return out


class Stats:
    """Every play added up, from wherever you played it: every scrobble on Last.fm (all time), plus
    every play in your Spotify and Apple Music imports (those don't change once they're in), and
    without Last.fm, the plays here. Most played, the Artists tab and the artist pages show these.
    Added up again when you press Refresh, when an import or Last.fm changes, and in the
    background when they're older than STATS_FOR (only new scrobbles are read from Last.fm)."""

    def __init__(self, app):
        self.app = app
        saved = read_json(STATS, {})
        self.songs = saved.get("songs") or []       # most played first: {title, artist, album, thumb, plays, lastfm, spotify, here}
        self.artists = saved.get("artists") or []   # [{name, plays, lastfm, spotify, here, thumb}], most played first
        self.periods = saved.get("periods") or {}   # "week", "month", "year" -> songs as above, from those days' plays
        self.time = saved.get("time") or {}         # Listening time: period -> listen_time's totals
        self.milestones = saved.get("milestones") or []   # [{"what", "name", "artist", "plays", "at"}], newest first
        self.built, self.sig = saved.get("built", 0), saved.get("sig")
        self.busy, self.status, self.error = False, "", ""
        self.watchers = []   # called (on the UI thread) when new counts are in

    def inputs(self):
        a = self.app
        return [STATS_VERSION, json.dumps(getattr(a, "artist_picks", None) or {}, sort_keys=True),
                json.dumps(getattr(a, "album_picks", None) or {}, sort_keys=True),
                json.dumps(getattr(a, "song_picks", None) or {}, sort_keys=True), a.lastfm.user if a.lastfm.connected else "", len(a.spotify_history.plays), len(a.deezer_history.plays), a.apple_history.plays,
                0 if a.lastfm.connected else sum(e.get("plays", 0) for e in a.plays.items.values())]

    @property
    def sources(self):
        """Where the counts come from: "Last.fm", "Spotify", "Apple Music", "here", in that order."""
        have = {k for s in self.songs[:200] for k in STAT_SOURCES if s.get(k)}
        return [name for k, name in (("lastfm", "Last.fm"), ("spotify", "Spotify"), ("deezer", "Deezer"), ("apple", "Apple Music"),
                                     ("here", "here")) if k in have]

    def refresh(self, force=False):
        """Add them up again (off the UI thread) if they're stale."""
        if self.busy or not (force or self.sig != self.inputs() or time.time() - self.built > STATS_FOR):
            return
        self.busy = True

        def progress(text):
            self.status = text

        def done(res, err):
            self.busy, self.status = False, ""
            if err is not None:
                self.error = str(err)[:120]
                self.built = time.time() - STATS_FOR + 120   # try again in two minutes
                self.sig = self.inputs()   # (not straight away: the inputs didn't change)
                print(f"stats: {err!r}", file=sys.stderr)
            else:
                self.error = ""
            for cb in self.watchers:
                cb()
        in_thread(self.build, progress, done=done)

    def build(self, progress=lambda text: None):
        """(blocking) Add everything up and keep it."""
        a, fm = self.app, self.app.lastfm
        sig = self.inputs()
        songs = {}
        picks = getattr(a, "artist_picks", None) or {}

        def moved(artist):   # an artist you merged into another (Merge into…, Similar artists): their songs' plays too
            return (picks.get(pair_key(artist or "")) or artist) if picks else artist

        album_picks = getattr(a, "album_picks", None) or {}

        def onto(title, artist, album):   # a single's (an EP's) plays you put on the album (Plays on singles and albums)
            if not album_picks or not album:
                return album
            return album_picks.get(album_play_key(title, artist, album)) or album

        song_picks = getattr(a, "song_picks", None) or {}

        def same_song(title, artist):   # a song you merged into another (Duplicates in Most played): counted as that one
            for _ in range(5):
                p = song_picks.get(song_pick_key(title, artist)) if song_picks and title and artist else None
                if not isinstance(p, dict):
                    break
                title, artist = p.get("title") or title, p.get("artist") or artist
            return title, artist

        def add_plays(d, title, artist, album, *rest):   # (shadows the module's: the song counted under the artist it is now)
            album = onto(title, artist, album)
            title, artist = same_song(title, artist)
            return _add_plays(d, title, moved(artist), album, *rest)
        # This week's, month's and year's: the plays with a time (scrobbles, Spotify's, Apple Music's timed ones).
        now = time.time()
        since = {k: now - d * 86400 for k, d in STATS_PERIODS.items()}
        recent = {k: {} for k in STATS_PERIODS}

        clock = ListenTime(a, since)
        song_times, artist_times = collections.defaultdict(list), collections.defaultdict(list)   # for milestones' dates

        def timed(t, title, artist, album, thumb, n, source, ms=0):
            album = onto(title, artist, album)
            title, artist = same_song(title, artist)
            artist = moved(artist)
            for k, start in since.items():
                if t >= start:
                    add_plays(recent[k], title, artist, album, thumb, n, source)
            clock.add(t, title, artist, album, n, ms)
            song_times[stats_key(title, artist)].append((t, n))
            artist_times[artist_key(lead_artist(artist) or artist)].append((t, n))
        if fm.connected:
            for r in all_scrobbles(fm, progress):
                img = "" if LASTFM_BLANK in (r[4] or "") else r[4]
                add_plays(songs, r[2], r[1], r[3], img, 1, "lastfm")
                timed(r[0], r[2], r[1], r[3], img, 1, "lastfm")
        else:
            for e in a.plays.items.values():
                t = e.get("track") or {}
                add_plays(songs, t.get("title"), t.get("artist"), t.get("album"), t.get("thumb"), e.get("plays", 0), "here")
        # Spotify's and Apple Music's imports, every play in them (from 30 seconds, as Spotify counts a stream),
        # added to Last.fm's: the totals add up, even where Spotify scrobbled to Last.fm too.
        for p in a.spotify_history.plays:
            add_plays(songs, p[2], p[1], p[3], "", 1, "spotify")
            timed(p[0], p[2], p[1], p[3], "", 1, "spotify", p[4] if len(p) > 4 else 0)
        for p in a.deezer_history.plays:   # Deezer's, the same way
            add_plays(songs, p[2], p[1], p[3], "", 1, "deezer")
            timed(p[0], p[2], p[1], p[3], "", 1, "deezer", p[4] if len(p) > 4 else 0)
        for r in a.apple_history.rows:
            if r[0] > 0:
                add_plays(songs, r[2], r[1], r[3], "", int(r[5]), "apple")
                timed(r[0], r[2], r[1], r[3], "", int(r[5]), "apple", r[4] if int(r[5]) == 1 else 0)
        # A library's counts: Apple's all-time total for a song, past the Apple plays counted already.
        for r in a.apple_history.rows:
            if r[0] <= 0:
                have = songs.get(stats_key(r[2], moved(r[1])))
                add_plays(songs, r[2], r[1], r[3], "", int(r[5]) - (have.get("apple", 0) if have else 0), "apple")
        artists, called = {}, collections.defaultdict(collections.Counter)
        resolve = resolver_of(a)
        for st in songs.values():
            lead = resolve(st["artist"]) or lead_artist(st["artist"]) or st["artist"]
            k = ("", resolved_key(lead))
            for source in STAT_SOURCES:
                if st.get(source, 0):
                    x = artists.setdefault(k, {"title": lead, "artist": lead, "album": "", "thumb": "", "plays": 0,
                                               **{src: 0 for src in STAT_SOURCES}})
                    x[source] = x.get(source, 0) + st[source]
                    x["plays"] += st[source]
            called[k][lead] += st["plays"]
            pic = artists.get(k)
            if pic is not None and not pic["thumb"]:
                pic["thumb"] = st["thumb"]
        for k, names in called.items():   # (named as resolved: "Quinn XCII & Jeremy Zucker" is Quinn XCII already)
            if k in artists:
                artists[k]["title"] = max(names, key=names.get)
        self.songs = sorted(songs.values(), key=lambda s: -s["plays"])
        self.artists = [{"name": s["title"], **{k: s.get(k, 0) for k in ("plays", *STAT_SOURCES)}, "thumb": s["thumb"]}
                        for s in sorted(artists.values(), key=lambda s: -s["plays"])]
        for k, got in recent.items():   # a cover from the all-time row where the period's has none
            for key, st in got.items():
                if not st["thumb"] and songs.get(key):
                    st["thumb"] = songs[key]["thumb"]
        self.periods = {k: sorted(got.values(), key=lambda s: -s["plays"])[:5000] for k, got in recent.items()}
        self.time = clock.totals()
        self.milestones = new_milestones(self.songs, self.artists, self.milestones, (song_times, artist_times))
        self.built, self.sig = time.time(), sig
        write_atomic(STATS, json.dumps({"songs": self.songs, "artists": self.artists, "periods": self.periods,
                                        "time": self.time, "milestones": self.milestones,
                                        "built": self.built, "sig": sig}))

    def artist_songs(self, name):
        """The songs of artist name (theirs or with them), most played first."""
        n = norm(name)
        return [s for s in self.songs if any(norm(a) == n for a in re.split(r",|&| x | feat\.? | ft\.? ", s["artist"]))]

    def artist(self, name):
        n = norm(name)
        return next((a for a in self.artists if norm(a["name"]) == n), None)


# =============================================================================
# DJ, like Spotify's: sets of a few songs, each begun with a line from the DJ, made from
# your listening: what you've had on repeat, what you play at this time of day, your
# favourites, throwbacks to a year you played something to death, songs you loved and
# haven't heard in months, and new ones like yours (Tidal's and YouTube Music's radios),
# leaving out the ones you keep skipping. Your history is every play Most played counts:
# Last.fm's scrobbles, your Spotify and Apple Music imports, and the plays here.
# "Switch it up" starts another kind of set, and you can ask for one: a decade, a genre,
# an artist or a vibe ("something chill": Last.fm's tags for it).
# =============================================================================
DJ_SET = 6   # songs in a set
DJ_ORDER = ("repeat", "fresh", "hour", "throwback", "deep", "rediscover", "fresh", "favorites", "genre", "like")
# Playing from songs you picked (a playlist, a folder, an album): sets of only those.
DJ_FROM_ORDER = ("loved", "unplayed", "hour", "artist", "throwback", "mix")
# …and with new songs too: sets of new ones like them in between.
DJ_FROM_NEW_ORDER = ("loved", "fresh", "unplayed", "hour", "like", "artist", "fresh", "throwback", "mix")
DJ_KINDS = {"repeat": "On repeat", "fresh": "New for you", "throwback": "Throwback", "deep": "Deep cuts",
            "genre": "Your genre", "like": "More like this", "ask": "You asked", "loved": "Your favourites",
            "unplayed": "Not played yet", "artist": "One artist", "mix": "Mix", "hour": "This time of day",
            "rediscover": "Rediscover", "favorites": "Your favourites"}
DJ_HISTORY_FOR = 600   # seconds your history is good for, before the DJ reads it again
# Words in a request and the Last.fm tags they mean.
DJ_WORDS = {
    "chill": ("chill", "chillout"), "chilled": ("chill", "chillout"), "relax": ("chill", "relaxing"),
    "relaxing": ("relaxing", "chill"), "calm": ("calm", "chill"), "study": ("study", "chill"),
    "studying": ("study", "chill"), "focus": ("focus", "instrumental"), "work": ("focus", "chill"),
    "sleep": ("sleep", "ambient"), "lofi": ("lo-fi",), "sad": ("sad", "melancholic"), "happy": ("happy", "feel good"),
    "upbeat": ("upbeat", "happy"), "hype": ("energetic", "hype"), "energy": ("energetic",),
    "workout": ("workout", "energetic"), "gym": ("workout", "energetic"), "running": ("running", "workout"),
    "party": ("party", "dance"), "dance": ("dance",), "love": ("love", "romantic"), "romantic": ("romantic", "love"),
    "angry": ("aggressive",), "rainy": ("rainy day", "chill"), "summer": ("summer",), "driving": ("driving",),
    "drive": ("driving",), "night": ("night", "late night"), "morning": ("morning",),
}
# Tags that say nothing about how a song sounds.
DJ_JUNK_TAGS = {"seen live", "favorites", "favourites", "favorite", "favourite", "albums i own", "under 2000 listeners",
                "spotify", "youtube", "male vocalists", "female vocalists", "american", "british", "usa", "uk"}
DJ_FILLER = {"play", "some", "something", "songs", "song", "music", "me", "for", "a", "the", "please", "mix", "of",
             "like", "more", "vibes", "vibe", "tunes", "stuff", "give", "i", "want", "to", "listen", "put", "on", "and"}


def dj_tags(text):
    """The Last.fm tags a request means: its words ("chill", "workout"), its decade ("80s", "2010s"), else the
    request itself as a genre ("house", "k-pop")."""
    every = re.findall(r"[\w'-]+", text.lower())
    words = [w for w in every if w not in DJ_FILLER]
    tags = []
    for w in words:
        if re.fullmatch(r"(19|20)?\d0s", w):
            tags.append(w)   # "80s", "1980s", "2010s"
        tags.extend(DJ_WORDS.get(w, ()))
    while every and every[0] in DJ_FILLER:   # "play some drum and bass music": "drum and bass"
        every.pop(0)
    while every and every[-1] in DJ_FILLER:
        every.pop()
    if not tags and every:
        tags.append(" ".join(every))
    return list(dict.fromkeys(tags))


def dj_pick(pool, n, used, rng=random):
    """n songs of pool at random, the ones nearer the top likelier, none twice and none in used
    (song keys of what the DJ played already)."""
    seen, out = set(used), []
    weighted = [(rng.random() ** (1 + 8 * i / max(1, len(pool))), t) for i, t in enumerate(pool)]
    for _w, t in sorted(weighted, key=lambda x: -x[0]):
        k = song_key(t)
        if k in seen:
            continue
        seen.add(k)
        out.append(t)
        if len(out) == n:
            break
    return out


def dj_names(tracks, n=2):
    """ "A and B": the lead artists of tracks, each once."""
    names = list(dict.fromkeys((t.get("artist") or "").split(",")[0].strip() for t in tracks if t.get("artist")))[:n]
    return " and ".join(names) if len(names) < 3 else ", ".join(names[:-1]) + " and " + names[-1]


class DJ:
    """The DJ's sets. Building a set blocks (run it in a thread); the app plays them."""

    def __init__(self, app):
        self.app = app
        self.taste_at, self.taste = 0, None
        self.used = set()      # song keys the DJ has played this session
        self.step = 0          # where in DJ_ORDER (or DJ_FROM_ORDER) the next set comes from
        self.scope = None      # (name, songs): what the DJ plays from; None: everything
        self.new = True        # with a scope: new songs like those too, between sets of them

    def play_from(self, name, songs):
        """Play only songs (named name: a playlist, a folder), or with None everything."""
        self.scope = (name, [dict(t) for t in songs]) if songs else None
        self.step = 0

    # ---- what you like ----
    def load_taste(self):
        """(blocking) What you play, from every play Most played counts (read again every ten minutes):
        all: your most played songs of all time; recent: of the last 30 days; hour: what you play around
        this hour; years: each year's most played; last: when you last played each song (stats key);
        artists: the ones you've played most lately; skipped: songs you keep skipping."""
        if self.taste and time.time() - self.taste_at < DJ_HISTORY_FOR:
            return self.taste
        a = self.app
        mine = a.song_index()
        now = time.time()
        history = self.history()
        last, recent, hour, years, artists, names = {}, Counter(), Counter(), {}, Counter(), {}
        h = datetime.now().hour
        for when, artist, title in history:
            k = stats_key(title, artist)
            names.setdefault(k, (title, artist))
            last[k] = max(last.get(k, 0), when)
            age = now - when
            if age < 30 * 86400:
                recent[k] += 1
            if age < 90 * 86400:
                artists[lead_artist(artist) or artist] += 1
            if age < 365 * 86400 and abs((datetime.fromtimestamp(when).hour - h + 12) % 24 - 12) <= 1:
                hour[k] += 1
            years.setdefault(datetime.fromtimestamp(when).year, Counter())[k] += 1

        def songs(counter, n):
            return [dict(a.fm_song(*names[k], "", mine), plays=c) for k, c in counter.most_common(n)]
        taste = {"mine": mine, "last": last, "recent": songs(recent, 60), "hour": songs(hour, 80),
                 "years": {y: songs(c, 60) for y, c in years.items() if sum(c.values()) >= 30},
                 "artists": [n for n, _c in artists.most_common(20) if n]}
        try:
            taste["all"] = [dict(t) for t in a.most_played()[:300]]
        except Exception:  # noqa: BLE001 -- the plays here, then
            taste["all"] = []
        if not taste["all"]:
            taste["all"] = [dict(e["track"], plays=e["plays"]) for e in sorted(
                a.plays.items.values(), key=lambda e: -e.get("plays", 0))[:300]]
        if not taste["artists"]:
            count = Counter(lead_artist(t.get("artist")) for t in taste["recent"] + taste["all"])
            taste["artists"] = [n for n, _c in count.most_common(20) if n]
        # Skipped more often than heard out, three times or more: left out of the DJ's sets.
        skipped = set()
        try:
            for t, n, f in a.song_stats.rows():
                if n >= 3 and n > f:
                    skipped |= {song_key(t), stats_key(t.get("title"), t.get("artist"))}
        except Exception:  # noqa: BLE001 -- none, then
            pass
        taste["skipped"] = skipped
        self.taste, self.taste_at = taste, time.time()
        return taste

    def history(self):
        """(blocking) Every play Most played counts, as (time, artist, title): your Last.fm scrobbles (else
        the plays here) and your Spotify and Apple Music imports."""
        a = self.app
        out = []
        if a.lastfm.connected:
            try:
                out += [(r[0], r[1], r[2]) for r in all_scrobbles(a.lastfm)]
            except Exception:  # noqa: BLE001 -- the plays here, then
                out = []
        if not out:
            for e in list(a.plays.items.values()):
                t = e.get("track") or {}
                out += [(x, t.get("artist", ""), t.get("title", "")) for x in e.get("at") or []]
        out += [(p[0], p[1], p[2]) for p in a.imported_plays()]
        return out

    def last_played(self, taste, t):
        return taste["last"].get(stats_key(t.get("title"), t.get("artist")), 0)

    def ok(self, taste, pool):
        """pool without the songs you keep skipping."""
        sk = taste.get("skipped") or set()
        return [t for t in pool if song_key(t) not in sk and stats_key(t.get("title"), t.get("artist")) not in sk]

    def known(self, taste):
        """Song keys and stats keys of every song you have or have played."""
        return set(taste["mine"]) | {song_key(t) for t in taste["all"]} | set(taste["last"])

    @staticmethod
    def new_to_you(t, known):
        return song_key(t) not in known and stats_key(t.get("title"), t.get("artist")) not in known

    def radio(self, seed, key):
        src = self.app.sources.get(key)
        if not src or (key == "tidal" and not src.signed_in):
            return []
        try:
            return src.radio(seed)
        except Exception:  # noqa: BLE001 -- the other service, then
            return []

    def services(self):
        """The services new songs come from: Tidal and YouTube Music both, when both are there."""
        tidal = self.app.sources.get("tidal")
        return (["tidal"] if tidal and tidal.signed_in else []) + ["ytm"]

    # ---- the kinds of set: each gives (songs, line) or None ----
    def set_repeat(self, taste, first):
        songs = dj_pick(self.ok(taste, taste["recent"][:25]), DJ_SET, self.used)
        if len(songs) < 3:
            return None
        if first:
            return songs, f"{greeting()}, I'm your DJ. Let's start with what you've had on repeat, like “{songs[0]['title']}” by {dj_names(songs[:1])}."
        return songs, f"Back to what you've had on repeat lately: {dj_names(songs, 3)}."

    def set_throwback(self, taste, first):
        """A year you played something to death: that year's most played, the ones you haven't played in two months."""
        now = time.time()
        this = datetime.now().year
        years = [y for y in taste["years"] if y < this]
        random.shuffle(years)
        for y in years:
            pool = [t for t in self.ok(taste, taste["years"][y]) if now - self.last_played(taste, t) > 60 * 86400]
            songs = dj_pick(pool[:40], DJ_SET, self.used)
            if len(songs) >= 3:
                t = songs[0]
                n = t.get("plays") or 0
                return songs, (f"Throwback to {y}. You played “{t['title']}” {n} times that year." if n > 1
                               else f"Throwback to {y}, starting with “{t['title']}” by {dj_names([t])}.")
        return None

    def set_rediscover(self, taste, first):
        """Songs you've played a lot, all told, but not for three months."""
        now = time.time()
        recent = {song_key(t) for t in taste["recent"]}
        pool = [t for t in self.ok(taste, taste["all"]) if song_key(t) not in recent
                and now - self.last_played(taste, t) > 90 * 86400]
        songs = dj_pick(pool[:120], DJ_SET, self.used)
        if len(songs) < 3:
            return None
        t = songs[0]
        when = self.last_played(taste, t)
        since = f", not since {datetime.fromtimestamp(when):%B %Y}" if when else ""
        return songs, f"Remember this one? You've played “{t['title']}” {t.get('plays') or 'a lot of'} times{since}."

    def set_hour(self, taste, first):
        """What you usually play around this hour."""
        songs = dj_pick(self.ok(taste, taste["hour"][:40]), DJ_SET, self.used)
        if len(songs) < 3:
            return None
        h = datetime.now().hour
        when = "this morning" if 5 <= h < 12 else "this afternoon" if h < 17 else "tonight" if h < 23 else "this late"
        if first:
            return songs, f"{greeting()}, I'm your DJ. Here's what you usually play {when}, starting with “{songs[0]['title']}”."
        return songs, f"What you usually play {when}: {dj_names(songs, 3)}."

    def set_favorites(self, taste, first):
        """Your starred songs, the ones you play most likelier."""
        plays = {song_key(t): t.get("plays") or 0 for t in taste["all"]}
        favs = sorted(self.app.favorites.tracks(), key=lambda t: -plays.get(song_key(t), 0))
        songs = dj_pick(self.ok(taste, favs), DJ_SET, self.used)
        if len(songs) < 3:
            return None
        return songs, f"Some of your favourites, like “{songs[0]['title']}” by {dj_names(songs[:1])}."

    def set_fresh(self, taste, first):
        seeds = dj_pick(taste["recent"][:20] or taste["all"][:40], 2, set())
        if not seeds:
            return None
        known = self.known(taste) | self.used
        found = []
        for i, seed in enumerate(seeds):
            keys = self.services()
            got = self.radio(seed, keys[i % len(keys)]) or self.radio(seed, keys[(i + 1) % len(keys)])
            found.append([t for t in got if self.new_to_you(t, known)])
        mixed = [t for pair in itertools.zip_longest(*found) for t in pair if t]
        songs = dj_pick(mixed[:30], DJ_SET, self.used)
        if len(songs) < 3:
            return None
        return songs, f"Something new for you, picked from {dj_names(seeds)}. Let's see what you think."

    def set_deep(self, taste, first):
        for name in random.sample(taste["artists"][:10], min(3, len(taste["artists"][:10]))):
            try:
                info = self.app.artist_info(name)
            except Exception:  # noqa: BLE001 -- the next artist
                info = None
            if not info:
                continue
            known = self.known(taste) | self.used
            songs = [t for t in info.get("top") or [] if self.new_to_you(t, known)][:DJ_SET]
            if len(songs) >= 3:
                return songs, f"Deep cuts from {info.get('name') or name}: songs of theirs you haven't played yet."
        return None

    def set_genre(self, taste, first):
        fm = self.app.lastfm
        if not fm.key:
            return None
        weight = Counter()
        lead = taste["artists"][:3]
        for name in lead:
            try:
                for tag, n in fm.artist_tags(name)[:6]:
                    if tag.lower() not in DJ_JUNK_TAGS:
                        weight[tag.lower()] += n
            except Exception:  # noqa: BLE001 -- the other artists' tags
                pass
        if not weight:
            return None
        tag = random.choice([t for t, _n in weight.most_common(3)])
        songs = self.tag_songs(tag, taste)
        if len(songs) < 3:
            return None
        return songs, f"Some {tag}, since you've been playing {dj_names([{'artist': lead[0]}])} so much."

    def set_like(self, taste, first):
        """Radio of what's playing (or, when no service has one of it, of a song you play a lot)."""
        seeds = [t for t in [self.app.current_track()] + taste["recent"][:5] if t]
        for seed in seeds[:4]:
            for key in self.services():
                songs = dj_pick([t for t in self.radio(seed, key)[:25] if song_key(t) != song_key(seed)], DJ_SET, self.used)
                if len(songs) >= 3:
                    return songs, f"More like “{seed['title']}” by {dj_names([seed])}."
        return None

    def tag_songs(self, tag, taste):
        """Songs Last.fm files under tag, the ones by artists you play first."""
        fm = self.app.lastfm
        if not fm.key:
            return []
        try:
            res = fm.call("tag.getTopTracks", tag=tag, limit=100)
        except Exception:  # noqa: BLE001 -- none, then
            return []
        rows = ((res.get("tracks") or {}).get("track")) or []
        yours = {norm(n) for n in taste["artists"]}
        pool = []
        for x in [rows] if isinstance(rows, dict) else rows:
            artist = (x.get("artist") or {}).get("name", "") if isinstance(x.get("artist"), dict) else ""
            img = next((i["#text"] for i in reversed(x.get("image") or []) if i.get("#text")), "")
            if x.get("name") and artist:
                pool.append(self.app.fm_song(x["name"], artist, img, taste["mine"]))
        pool.sort(key=lambda t: norm(t["artist"].split(",")[0]) not in yours)   # stable: Last.fm's order within each
        return dj_pick(pool, DJ_SET, self.used)

    # ---- playing from songs you picked ----
    def from_set(self, kind, taste, first):
        """A set of kind from the songs the DJ plays from: (songs, line) or None."""
        name, pool = self.scope
        fresh = [t for t in pool if song_key(t) not in self.used]
        if len(fresh) < min(3, len(pool)):   # all of them played: around again, but not with songs still to come
            a = self.app
            coming = {song_key(t) for t in a.queue[a.index:]}
            fresh = [t for t in pool if song_key(t) not in coming]
            if len(fresh) < min(3, len(pool)):
                fresh = list(pool)
        plays = {song_key(e["track"]): e.get("plays", 0) for e in self.app.plays.items.values()}
        for t in taste["all"]:
            plays[song_key(t)] = max(plays.get(song_key(t), 0), t.get("plays") or 0)
        now = time.time()
        fresh = self.ok(taste, fresh) or fresh
        recent = {song_key(t) for t in taste["recent"]}
        n, least = min(DJ_SET, len(fresh)), min(3, len(fresh))
        songs, line = [], ""
        if kind == "loved":
            loved = sorted((t for t in fresh if plays.get(song_key(t))), key=lambda t: -plays[song_key(t)])
            songs = dj_pick(loved[:30], n, set())
            if songs:
                line = f"From {name}, the ones you keep coming back to, like “{songs[0]['title']}” by {dj_names(songs[:1])}."
        elif kind == "unplayed":
            new = [t for t in fresh if not plays.get(song_key(t)) and not self.last_played(taste, t)]
            songs = random.sample(new, min(n, len(new)))
            if songs:
                line = f"Some from {name} you haven't played yet, starting with “{songs[0]['title']}” by {dj_names(songs[:1])}."
        elif kind == "throwback":
            old = [t for t in fresh if plays.get(song_key(t)) and song_key(t) not in recent
                   and now - self.last_played(taste, t) > 21 * 86400]
            songs = random.sample(old, min(n, len(old)))
            if songs:
                line = f"From {name}, a few you haven't played in a while, like “{songs[0]['title']}”."
        elif kind == "hour":
            at = {song_key(t): i for i, t in enumerate(taste["hour"])}
            theirs = sorted((t for t in fresh if song_key(t) in at), key=lambda t: at[song_key(t)])
            songs = dj_pick(theirs, n, set())
            if songs:
                line = f"From {name}, what you usually play around now, like “{songs[0]['title']}”."
        elif kind == "artist":
            count = Counter((t.get("artist") or "").split(",")[0].strip() for t in fresh)
            who = [a for a, c in count.items() if a and c >= least]
            if len(who) > 1:   # one artist in it all: that's not a set of its own
                a = random.choices(who, weights=[count[w] for w in who])[0]
                theirs = [t for t in fresh if (t.get("artist") or "").split(",")[0].strip() == a]
                songs = random.sample(theirs, min(n, len(theirs)))
                line = f"A few from {a}, from {name}."
        else:
            songs = random.sample(fresh, n)
            line = f"More from {name}: {dj_names(songs, 3)}." if songs else ""
        if len(songs) < least or not songs:
            return None
        if first:
            line = f"{greeting()}, I'm your DJ, playing {name}. " + line[0].upper() + line[1:]
        return songs, line

    def ask_from(self, text):
        """A set of the songs the DJ plays from that match what you asked (artist, title, album, genre)."""
        name, pool = self.scope
        words = [norm(w) for w in re.findall(r"[\w'&.-]+", text) if w.lower() not in DJ_FILLER and norm(w)]
        if not words:
            return None
        hits = [t for t in pool if all(w in norm(" ".join(str(t.get(k) or "") for k in ("title", "artist", "album", "genre")))
                                       for w in words)]
        unplayed = [t for t in hits if song_key(t) not in self.used]
        songs = dj_pick(random.sample(unplayed, len(unplayed)) + random.sample(hits, len(hits)), DJ_SET, set())
        if not songs:
            return None
        return "ask", songs, f"From {name}, you asked for {text.strip()}: “{songs[0]['title']}” by {dj_names(songs[:1])} first."

    def ask(self, text):
        """(blocking) A set for what you asked, ("ask", songs, line): an artist, a decade, a genre or a vibe.
        Playing from songs you picked: the ones of them that match, else from everywhere."""
        if self.scope:
            got = self.ask_from(text)
            if got:
                return got
            got = self.ask_all(text)
            return got and (got[0], got[1], f"There's nothing like that in {self.scope[0]}, so from everywhere: {got[2]}")
        return self.ask_all(text)

    def ask_all(self, text):
        taste = self.load_taste()
        words = " ".join(w for w in re.findall(r"[\w'&.-]+", text) if w.lower() not in DJ_FILLER)
        names = {norm(n): n for n in taste["artists"]}
        names.update({norm(t["artist"].split(",")[0]): t["artist"].split(",")[0].strip() for t in taste["mine"].values()})
        who = best_named(list(names.values()), words, lambda n: n) if words else None
        vibe = any(w in DJ_WORDS for w in words.lower().split()) or re.search(r"\d0s", words)
        if not who and words and not vibe:
            try:
                info = self.app.artist_info(words)
            except Exception:  # noqa: BLE001 -- not an artist, then
                info = None
            # Only an artist called just that: "drum and bass" isn't DrymBass.
            if info and norm(re.sub(r"^the ", "", info.get("name") or "", flags=re.I)) == norm(re.sub(r"^the ", "", words, flags=re.I)):
                who = info["name"]
        if who:
            info = self.app.artist_info(who) or {}
            theirs = [t for t in taste["mine"].values() if norm(who) in {norm(a) for a in split_artists(t.get("artist") or "")}]
            pool = dj_pick(theirs, 2, self.used) + [t for t in info.get("top") or []]
            songs = dj_pick(pool, DJ_SET, self.used)
            if songs:
                return "ask", songs, f"{info.get('name') or who}, coming up: some you know, and some you might not."
        for tag in dj_tags(text):
            songs = self.tag_songs(tag, taste)
            if len(songs) >= 3:
                return "ask", songs, f"You asked for {text.strip()}, so here's some {tag}, starting with “{songs[0]['title']}” by {dj_names(songs[:1])}."
        # A playlist of it: named by its mood ("chill"), which finds a curated one more often than a sentence.
        for q in dict.fromkeys(dj_tags(text)[:1] + [text.strip()]):
            for key in self.services():
                src = self.app.sources.get(key)
                try:
                    found = src.mix_for(q) if src else []
                except Exception:  # noqa: BLE001 -- the other service
                    found = []
                songs = dj_pick(found, DJ_SET, self.used)
                if len(songs) >= 3:
                    return "ask", songs, f"You asked for {text.strip()}. Here's a mix of it, starting with “{songs[0]['title']}” by {dj_names(songs[:1])}."
        return None

    def build(self, kind=None, avoid=None, first=False):
        """(blocking) The next set: of kind, else the next kind in the DJ's order that has songs
        (not avoid, the kind playing now). (kind, songs, line), or None."""
        taste = self.load_taste()
        order = (DJ_FROM_NEW_ORDER if self.new else DJ_FROM_ORDER) if self.scope else DJ_ORDER
        spots = [None] if kind else [(self.step + i) % len(order) for i in range(len(order))]
        if avoid and not kind:   # the kind playing now only when nothing else has songs
            spots = [i for i in spots if order[i] != avoid] + [i for i in spots if order[i] == avoid][:1]
        for spot in spots:
            k = kind or order[spot]
            if self.scope and k in ("fresh", "like"):   # new songs, from the ones it plays from
                pool = self.scope[1]
                got = getattr(self, f"set_{k}")({**taste, "recent": random.sample(pool, min(20, len(pool))), "all": pool}, first)
            else:
                got = self.from_set(k, taste, first) if self.scope else getattr(self, f"set_{k}")(taste, first)
            if got:
                if not kind:
                    self.step = spot + 1
                return k, [dict(t) for t in got[0]], got[1]
        return None


def greeting():
    h = datetime.now().hour
    return "Good morning" if 5 <= h < 12 else "Good afternoon" if h < 17 else "Good evening" if h < 23 else "Hey, night owl"


