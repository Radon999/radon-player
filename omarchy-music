        pop = Gtk.Popover(child=box)

        def item(label, how):
            b = Gtk.Button(label=label)
            b.add_css_class("menu-item")
            b.get_child().set_xalign(0)
            b.connect("clicked", lambda *_: (pop.popdown(), self.share_slide(how)))
            box.append(b)
        item("Save as a picture", "save")
        item("Copy the picture", "copy")
        for how, (name, _url) in self.SHARE_SITES.items():
            item(f"Post to {name}…", how)
        button.set_popover(pop)
        return button

    def share_slide(self, how):
        """Make a picture of the slide showing, then save it, copy it, or both and open the site
        to post it on. The sites take no picture from an app on a computer (only their phone apps
        do), so it's pasted (Ctrl+V) or picked from Pictures there."""
        n = self.carousel.get_n_pages()
        if not self.data or not n:
            return
        i = max(0, min(n - 1, round(self.carousel.get_position())))
        slide = self.carousel.get_nth_page(i)
        hidden = [w for w in widgets_in(slide) if w.has_css_class("w-unshot") and w.get_visible()]
        for w in hidden:
            w.set_visible(False)   # not in the picture
        # That throws away the slide's last drawing, which is what gets saved: wait for the next frame to draw it again.
        clock = self.get_frame_clock()

        def painted(*_):
            clock.disconnect(handler)
            GLib.idle_add(lambda: (self._shared(slide, i, how, hidden), False)[1])
        handler = clock.connect("after-paint", painted)
        slide.queue_draw()

    def _shared(self, slide, i, how, hidden):
        try:
            tex = self.picture_of(slide)
            if how == "copy":
                self.get_clipboard().set_content(Gdk.ContentProvider.new_for_value(tex))
                self.toasts.add_toast(Adw.Toast(title="Picture copied", timeout=3))
            else:
                path = self.save_png(tex, i)
                if how == "save":
                    self.toasts.add_toast(Adw.Toast(title=f"Saved to {path.parent.name}/{path.name}", timeout=4))
                else:
                    name, url = self.SHARE_SITES[how]
                    self.get_clipboard().set_content(Gdk.ContentProvider.new_for_value(tex))
                    open_url(url)
                    self.toasts.add_toast(Adw.Toast(
                        title=f"Copied, and saved to {path.parent.name}: paste it (Ctrl+V) or pick it in {name}", timeout=6))
        except Exception as e:  # noqa: BLE001 -- say why
            self.toasts.add_toast(Adw.Toast(title=f"Couldn't make the picture: {str(e)[:80]}", timeout=4))
        for w in hidden:
            w.set_visible(True)

    def picture_of(self, slide):
        """The slide as a texture, drawn at twice its size."""
        paintable = Gtk.WidgetPaintable.new(slide)   # padding and all, unlike get_width()
        w, h, scale = paintable.get_intrinsic_width(), paintable.get_intrinsic_height(), 2
        snap = Gtk.Snapshot()
        snap.scale(scale, scale)
        paintable.snapshot(snap, w, h)
        node = snap.to_node()
        if node is None:
            raise RuntimeError("the slide wasn't drawn yet")
        return self.get_renderer().render_texture(node, Graphene.Rect().init(0, 0, w * scale, h * scale))

    def save_png(self, tex, i):
        """tex as a PNG in Pictures, named for the period and the slide; returns its path."""
        d = self.data
        title = "All Time" if d["period"] == "all" else period_name(d["period"])
        pictures = Path(GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_PICTURES) or HOME / "Pictures")
        last = i == self.carousel.get_n_pages() - 1   # the summary: named as it always was
        name = re.sub(r'[<>:"/\\|?*]', "", f"Wrapped {title} · {d['user']}{'' if last else f' · {i + 1}'}.png")
        path = pictures / name
        path.parent.mkdir(parents=True, exist_ok=True)
        tex.save_to_png(str(path))
        return path

    # ---- moving around ----
    def go(self, step):
        n = self.carousel.get_n_pages()
        i = max(0, min(n - 1, round(self.carousel.get_position()) + step))
        if n:   # at once: the swipe redrew two glowing full-window slides every frame, which lagged
            self.carousel.scroll_to(self.carousel.get_nth_page(i), False)

    def on_click(self, gesture, _n, x, _y):
        if gesture.get_current_button() == Gdk.BUTTON_PRIMARY:
            self.go(-1 if x < self.carousel.get_width() * 0.3 else 1)

    def on_key(self, _ctl, keyval, _code, _state):
        if keyval == Gdk.KEY_Escape:
            if self.is_full():
                self.toggle_fullscreen()
            else:
                self.close()
        elif keyval in (Gdk.KEY_F11, Gdk.KEY_f):
            self.toggle_fullscreen()
        elif keyval == Gdk.KEY_s and self.data:
            self.share.popup()
        elif keyval in (Gdk.KEY_Right, Gdk.KEY_space, Gdk.KEY_l, Gdk.KEY_Page_Down):
            self.go(1)
        elif keyval in (Gdk.KEY_Left, Gdk.KEY_h, Gdk.KEY_Page_Up):
            self.go(-1)
        elif keyval == Gdk.KEY_Home:
            self.go(-999)
        elif keyval == Gdk.KEY_End:
            self.go(999)
        else:
            return False
        return True


