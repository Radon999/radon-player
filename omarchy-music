    "acoustid": ("AcoustID key", "A free application key from acoustid.org/new-application: Identify by sound (a song's "
                 "Tagger…) finds what a song really is from its sound"),
}
PICTURES_RETRY = 14 * 86400   # an artist nothing was found for is looked for again after this long
PICTURES_RETRY_FAILED = 3600   # …or after this long, when a service didn't answer (rather than had nothing)
PICTURES_V = 3   # 3: Deezer paced; the ones found with no picture before it are looked for again, once
WIKI_API = "https://en.wikipedia.org/w/api.php"
GENIUS_BLANK = "assets.genius.com/images/default_"   # Genius's grey placeholder
