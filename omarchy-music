        line("Empty folders", "Folders in your music folders with no songs left in them (only pictures or lyrics files): "
             "you see each one, its size and what's in it, and pick which to delete", False,
             pill("Clean up…", self.cleanup_start, quiet=True))
        dl_box = Gtk.Box(spacing=6)
        dl_box.append(pill("Change", self.pick_download_dir, quiet=True))
        line("Downloads", f"To {short_path(a.download_folder())}, as Artist/Albums, EPs or Singles/Album", True, dl_box)
        dupes = Adw.ToggleGroup(valign=Gtk.Align.CENTER)
