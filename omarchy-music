    def do_activate(self):
        if not self.win and os.environ.get("OMARCHY_MUSIC_SELFTEST") == "1":
            GLib.timeout_add_seconds(5, self.self_test)
        if not self.win:
            self.win = MusicWindow(self)
            self.win.update_now_playing()
            self.win.update_position(self.position, self.duration or (self.current_track() or {}).get("duration"))
            present(self.win)
            self.win.entry.grab_focus()
            return
        if self.win.get_visible():  # bar icon / keybind toggle the dropdown
            self.win.set_visible(False)
        else:
            self.show_window()

    def self_test(self):
        """OMARCHY_MUSIC_SELFTEST=1 (the Windows build checks its package with it): the window
        opened, mpv runs and answers. Prints the verdict and exits 0 or 1."""
        missing = []
        for mod in ("requests", "mutagen", "ytmusicapi", "tidalapi", "yt_dlp"):   # imported when first needed
            try:
                __import__(mod)
            except Exception as e:
                missing.append(f"{mod} ({e})")
        import requests
        certs = Path(requests.certs.where()).is_file()   # what HTTPS checks servers against
        ok = bool(self.win) and self.player.proc.poll() is None and self.player.heard and not missing and certs
        print(f"selftest {'ok' if ok else 'FAILED'}: window={bool(self.win)} mpv_running={self.player.proc.poll() is None} "
              f"mpv_answered={self.player.heard} modules={'ok' if not missing else ', '.join(missing)} certs={certs} "
              f"gtk={Gtk.get_major_version()}.{Gtk.get_minor_version()} "
              f"adw={Adw.get_major_version()}.{Adw.get_minor_version()}", flush=True)
        self.player.quit()
        os._exit(0 if ok else 1)

    def show_window(self, tab=None):
        if not self.win:
            self.activate()
        else:
            present(self.win)
            self.win.entry.grab_focus()
        if tab:
            self.win.show_tab(tab)

    def to_tray(self):
        """Windows: the window closed, the music plays on, by the clock (told once)."""
        tray = getattr(self, "tray", None)
        if not tray or not tray.ready:
            GLib.idle_add(lambda: (self.quit_app(), False)[1])   # no tray: closing quits, as before
            return
        if not self.tray_told:
            self.tray_told = True
            self.save_soon()
            tray.tell("Radon Player is still playing", "It's by the clock: click it to open, right-click to quit.")

    def restart_app(self):
        """Quit and start again (after a restore): a helper waits for this one to be gone, then starts it."""
        argv = [sys.executable, *sys.argv] if not getattr(sys, "frozen", False) else list(sys.argv)
        helper = "import subprocess, sys, time; time.sleep(3); subprocess.Popen(sys.argv[1:])"
        try:
            subprocess.Popen([sys.executable, "-c", helper, *argv], stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                             stderr=subprocess.DEVNULL, **({"creationflags": subprocess.CREATE_NO_WINDOW | subprocess.DETACHED_PROCESS}
                                                           if WINDOWS else {"start_new_session": True}))
        except OSError:
            self.toast("Restored: close and open the app to use it")
            return
        self.quit_app()

    def quit_app(self):
        if getattr(self, "tray", None):
            self.tray.remove()
        self.save_state()
        self.remote.stop()
        self.player.quit()
        self.quit()

