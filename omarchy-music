class EasyChunkID3:
    """A WAV's, AIFF's or DSF's ID3 tags with the names easy tags use ("artist", "album"…), like an MP3's:
    mutagen's easy=True doesn't do these, so their tags couldn't be read or written by name."""

    def __init__(self, f):
        self.f, self.info, self.tags = f, f.info, None
        if f.tags is not None:
            self._wrap()

    def _wrap(self):
        from mutagen.easyid3 import EasyID3
        easy = EasyID3()
        easy._EasyID3__id3 = self.f.tags   # the file's own ID3: writes land in it
        self.tags = easy

    def add_tags(self):
        self.f.add_tags()
        self._wrap()

    def __setitem__(self, k, v):
        self.tags[k] = v

    def save(self):
        self.f.save()


def easy_audio(path):
    """mutagen.File(path, easy=True), a WAV's, AIFF's or DSF's ID3 as easy tags too (EasyChunkID3)."""
    import mutagen
    from mutagen.id3 import ID3
    from mutagen.easyid3 import EasyID3
    f = mutagen.File(path, easy=True)
    if f is not None and (type(f).__name__ in ("WAVE", "AIFF", "DSF") or
                          (isinstance(f.tags, ID3) and not isinstance(f.tags, EasyID3))):
        return EasyChunkID3(f)   # ID3 tags easy=True leaves raw: writing "artist" to them fails ("not a Frame instance")
    return f


def track_from_file(path):
    """A song on disk (anything mpv plays), named from its tags, else its file name."""
    path = Path(path).expanduser().resolve()
    title, artist, album, dur = path.stem, "", "", 0
    genre = albumartist = number = ""
    try:
        f = easy_audio(path)
        if f is not None:
            tags = f.tags or {}
            title = (tags.get("title") or [title])[0]
            artist = ", ".join(tags.get("artist") or [])
            album = (tags.get("album") or [""])[0]
            genre = (tags.get("genre") or [""])[0]
            albumartist = (tags.get("albumartist") or [""])[0]
            number = (tags.get("tracknumber") or [""])[0]
            dur = round(getattr(f.info, "length", 0) or 0)
    except Exception:  # noqa: BLE001 -- untagged, or not audio mutagen knows: the file name, then
        pass
    return {"id": "f" + hashlib.sha1(str(path).encode()).hexdigest()[:16], "source": "file", "file": str(path),
            "title": title, "artist": artist or "Unknown artist", "album": album, "duration": dur, "thumb": "",
            "genre": genre, "albumartist": albumartist, "track": number}


