    def song_groups(self, view):
        """{key: [title, sub, songs]} of your songs by album (and its artist), genre or folder. Kept until
        your songs change (thousands of songs took a few tenths of a second to sort out each time)."""
        try:
            lib_t = os.stat(LIBRARY).st_mtime
        except OSError:
            lib_t = 0
        loc = self.app.local
        sig = (len(self.lib.items), lib_t, len(loc.files), loc.scanned, len(self.app.lib.items))
        cache = self.__dict__.setdefault("_groups", {})
        if view in cache and cache[view][0] == sig:
            return {k: [v[0], v[1], list(v[2])] for k, v in cache[view][1].items()}
        out = self._song_groups(view)
        cache[view] = (sig, out)
        return {k: [v[0], v[1], list(v[2])] for k, v in out.items()}

    def _song_groups(self, view):
        out = {}
        for t in self.app.my_songs():
            if view in ("albums", "eps", "singles"):
                album = t.get("album") or ""
                if view == "eps" and not is_ep(album):
                    continue   # EPs: only the EPs (they're in Albums too)
                artist = (t.get("albumartist") or t["artist"]).split(",")[0].strip() or "Unknown artist"
                if view == "singles":
                    if not album:   # no album at all: the song is its own single
                        out.setdefault("single:" + (t.get("file") or norm(t["artist"] + " " + t["title"])),
                                       [t["title"], artist, []])[2].append(t)
                        continue
                    if not is_single(album, t.get("title")):
                        continue   # Singles: "single" in the name, or named for its song (they're in Albums too)
                key, title, sub = album_group_key(t), album or "Unknown album", artist
            elif view == "genres":
                g = self.app.genre_of(t) or "Unknown genre"
                key, title, sub = norm(g), g, ""
            else:
                folder = os.path.dirname(t["file"]) if t.get("file") else ""
                if folder in out:
                    out[folder][2].append(t)
                    continue
                key, title, sub = folder, os.path.basename(folder) or folder or "Unknown folder", short_path(folder)
            out.setdefault(key, [title, sub, []])[2].append(t)
        return out

    def refresh_groups(self, view):
        lst, a = self.music_list, self.app
        self._music_sig = None
        groups = self.song_groups(view)
        if self.open_group is not None and self.open_group in groups:
            title, sub, tracks = groups[self.open_group]
            if view in ("albums", "eps", "singles"):
                tracks.sort(key=lambda t: (track_no(t), norm(t["title"])))
            else:
                tracks.sort(key=lambda t: (norm(t["artist"]), norm(t.get("album")), track_no(t), norm(t["title"])))
            lst.remove_all()
            lst.append(self.action_row(f"‹  {title}", "group-back"))
            self.head_row(lst, title, " · ".join(x for x in (sub, f"{len(tracks)} song{'s' if len(tracks) != 1 else ''}",
                                                            fmt_total(tracks)) if x), thumb_track=tracks[0],
                          icon="folder-symbolic" if view == "folders" else "media-optical-symbolic")
            buttons = [("Play", lambda _b: a.play_list(tracks), False),
                       ("Shuffle", lambda _b: a.play_list(tracks, shuffled=True), False),
                       ("Add to queue", lambda _b: a.enqueue(tracks), True)]
            if view in ("albums", "eps", "singles"):
                buttons.append(("Cover…", lambda _b: self.cover_dialog(tracks), True))
            gpin = {"kind": "group", "view": view, "id": self.open_group, "title": title}
            buttons.append(("Unpin" if a.pinned(gpin) else "Pin", lambda _b: (a.toggle_pin(gpin), self.refresh_music()), True))
            buttons += self.download_button(tracks)
            self.actions_row(lst, buttons)
            self.lazy(lst, len(tracks), lambda i: self.add_track(lst, tracks[i], i, tracks))
            if view in ("albums", "eps", "singles") and not str(self.open_group).startswith("single:"):   # the album's songs you haven't got, at the very bottom
                gid = self.open_group
                artist = (tracks[0].get("albumartist") or lead_artist(tracks[0].get("artist") or "") or "")
                in_thread(a.album_missing, title, artist, tracks,
                          done=lambda res, _e: res and self.open_group == gid and self.music_view == view
                          and GLib.timeout_add(300, lambda: (self.missing_rows(lst, gid, artist, title, res), False)[1]))
            return
        self.open_group = None
        if not groups:
            self.set_empty(lst, f"No {self.GROUP_VIEWS[view].lower()} yet",
                           "Songs you download, and the music in your folders, show up here.")
            return
        lst.remove_all()
        order = sorted(groups.items(), key=lambda kv: (kv[1][0].startswith("Unknown"), norm(kv[1][0]), norm(kv[1][1])))
        if self.group_selecting and self.group_view != view:
            self.group_select(False, refresh=False)
        picked = self.group_picked
        if self.group_selecting:   # Select: tick albums (genres, folders), then Options for all their songs
            n = len(picked)
            songs = sum(len(groups[k][2]) for k in picked if k in groups)
            self.actions_row(lst, [(f"Options ({songs} songs)" if n else "Options", lambda _b: self.group_options(), False)]
                             + ([("Clear", lambda _b: (picked.clear(), self.refresh_music()), True)] if n else [])
                             + [("Done", lambda _b: self.group_select(False), True)])
            self.section(lst, f"{n} PICKED" if n else f"PICK {self.GROUP_VIEWS[view].upper()}: A CLICK TICKS ONE")
        elif view in ("albums", "eps", "singles"):
            self.actions_row(lst, [(f"Collage of your top {dict(eps='EPs', singles='singles').get(view, 'albums')}…",
                                    lambda _b: self.collage_dialog(view, "all"), True),
                                   ("Select", lambda _b: self.group_select(True), True)]
                             + ([("Single scan…", lambda _b: self.singles_scan_dialog(), True)] if view == "singles" else []))
        else:
            self.actions_row(lst, [("Select", lambda _b: self.group_select(True), True)])
        name = self.GROUP_VIEWS[view].upper()
        self.section(lst, f"{len(order)} {name[:-1] if len(order) == 1 and name.endswith('S') else name}")

        def add(i):
            key, (title, sub, tracks) = order[i]
            n = len(tracks)
            line = " · ".join(x for x in (sub if view != "folders" else "", f"{n} song{'s' if n != 1 else ''}") if x)

            def made():
                row = PlaylistRow(self, {"kind": "group", "id": key, "title": title, "thumb": "", "sub": line},
                                  cover=next((t for t in tracks if t.get("thumb") or source_of(t) == "file"), None),
                                  icon="folder-symbolic" if view == "folders" else "media-optical-symbolic")
                if self.group_selecting:
                    tick = Gtk.CheckButton(active=key in picked, valign=Gtk.Align.CENTER, can_target=False)
                    if row.get_child() is not None:
                        row.get_child().prepend(tick)
                    else:
                        row.lead = tick
                    row.group_tick = tick
                return row
            # Made when it comes into view: two thousand albums' rows at once took half a second.
            lst.append_lazy(made, text=f"{title} {sub} {line}", tile=True)
        for i in range(len(order)):
            add(i)

