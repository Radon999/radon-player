def eq_graph(correction, bands, preamp, tone=None):
    """The libavfilter graph, in 64-bit float throughout so nothing clips or rounds
    between filters. The bands and the bass and treble shelves are named so their
    gains can change while playing."""
    names = {"pk": "equalizer", "ls": "lowshelf", "hs": "highshelf"}
    parts = ["aformat=sample_fmts=dblp", f"volume@pre=volume={preamp}dB:precision=double"]
    parts += [f"{names[k]}@c{i}=f={hz}:t=q:w={q}:g={g}" for i, (k, hz, g, q) in enumerate(correction)]
    q = eq_q_for(len(bands))
    parts += [f"equalizer@g{i}=f={hz}:t=q:w={q}:g={g}" for i, (hz, g) in enumerate(zip(eq_bands_for(len(bands)), bands))]
    parts += [f"{names[k]}@{name}=f={hz}:t=q:w={q}:g={(tone or {}).get(name, 0)}" for name, (k, hz, q) in TONE.items()]
    return ",".join(parts)


# ---- Auto EQ: any headphones' correction from AutoEq's results ----
# The AutoEq project's own results on GitHub: an index of every profile, and each profile's
# filters (ParametricEQ.txt). AutoEqApi (github.com/timschneeb/AutoEqApi) serves the same data,
# but answers only RootlessJamesDSP; a copy of it you host yourself (with that check taken out)
# can be used instead: Settings › AutoEq server.
AUTOEQ_RESULTS = "https://raw.githubusercontent.com/jaakkopasanen/AutoEq/master/results/"
AUTOEQ_INDEX = CACHE / "autoeq-index.md"
AUTOEQ_INDEX_FOR = 7 * 86400   # seconds the index is kept before it's fetched again
AUTOEQ_TYPES = {"PK": "pk", "PEQ": "pk", "LSC": "ls", "HSC": "hs", "LS": "ls", "HS": "hs", "LSQ": "ls", "HSQ": "hs"}


def autoeq_index_entries(text):
    """AutoEq's INDEX.md as [{"name", "path", "source"}]."""
    out = []
    for m in re.finditer(r"^- \[(.+?)\]\(\./(.+?)\) by (.+?)\s*$", text, re.M):
        name, path, source = m.groups()
        out.append({"name": name, "path": path, "source": re.sub(r" on .*$", "", source)})
    return out


def autoeq_index(refresh=False):
    """(blocking) AutoEq's profiles, from the copy kept here when it's fresh enough."""
    try:
        fresh = not refresh and time.time() - AUTOEQ_INDEX.stat().st_mtime < AUTOEQ_INDEX_FOR
    except OSError:
        fresh = False
    if not fresh:
        try:
            write_file(AUTOEQ_INDEX, http(AUTOEQ_RESULTS + "INDEX.md", timeout=30))
        except (OSError, urllib.error.URLError):
            if not AUTOEQ_INDEX.exists():
                raise
    return autoeq_index_entries(AUTOEQ_INDEX.read_text(encoding="utf-8"))


def autoeq_search(entries, query, n=12):
    """The profiles whose name has every word of query, the closest names first."""
    words = norm(query).split()
    if not words:
        return []
    hits = [e for e in entries if all(w in norm(e["name"]) for w in words)]
    return sorted(hits, key=lambda e: (-difflib.SequenceMatcher(None, norm(query), norm(e["name"])).ratio(), e["name"]))[:n]


def parse_parametric(text):
    """An AutoEq ParametricEQ.txt as [(type, Hz, gain dB, Q)] (HEADPHONES' filters)."""
    out = []
    for m in re.finditer(r"Filter\s*\d*:\s*ON\s+([A-Z]+)\s+Fc\s+([\d.]+)\s*Hz\s+Gain\s+(-?[\d.]+)\s*dB\s+Q\s+([\d.]+)", text):
        kind, hz, gain, q = m.groups()
        if kind in AUTOEQ_TYPES:
            out.append((AUTOEQ_TYPES[kind], round(float(hz)), float(gain), float(q)))
    if not out:
        raise ValueError("no filters in that profile")
    return out


def graphic_to_filters(text):
    """A GraphicEQ ("GraphicEQ: 20 -1.2; 21 -1.1; …", what AutoEqApi gives) as a peak filter an
    octave wide at each of the ten bands, at the curve's level there: close, not exact."""
    points = sorted((float(f), float(g)) for f, g in re.findall(r"([\d.]+)\s+(-?[\d.]+)", text.split(":", 1)[-1]))
    if not points:
        raise ValueError("no curve in that profile")

    def at(hz):
        lo = max((p for p in points if p[0] <= hz), default=points[0])
        hi = min((p for p in points if p[0] >= hz), default=points[-1])
        if hi[0] == lo[0]:
            return lo[1]
        k = math.log(hz / lo[0]) / math.log(hi[0] / lo[0])
        return lo[1] + (hi[1] - lo[1]) * k
    return [("pk", hz, round(at(hz), 1), EQ_Q) for hz in EQ_BANDS]


def autoeq_profile(entry, api=""):
    """(blocking) The filters of an AutoEq profile: {"name", "path", "source"} from the index, or
    {"name", "id", "source"} from your own AutoEqApi."""
    if entry.get("id") is not None:
        return graphic_to_filters(http(f"{api.rstrip('/')}/results/{entry['id']}", headers={"User-Agent": APP_UA}).decode())
    name = entry["path"].rsplit("/", 1)[-1]
    return parse_parametric(http(f"{AUTOEQ_RESULTS}{entry['path']}/{name}%20ParametricEQ.txt").decode())


def autoeq_api_search(api, query):
