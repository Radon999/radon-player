        in_mine = self.select_list is self.music_list and bool(self.open_mine)
        queue_ids = {t["id"] for t in tracks}

        def do(cb, closes=True):
            def go(*_):
                dlg.close()
                cb()
                if closes:
                    self.after_option()
            return go
        items = [("play", "Play", lambda: a.play_list(tracks)),
                 ("shuffle", "Shuffle", lambda: a.play_list(tracks, shuffled=True)),
                 ("next", "Play next", lambda: a.enqueue(tracks, "next")),
                 ("queue", "Add to the queue", lambda: a.enqueue(tracks, "queue")),
                 ("playlist", "Add to a playlist…", None),
                 ("star", "Favorite (again: unfavorite)", lambda: a.set_favorite(tracks))]
        if in_queue:
            items.append(("close", "Take out of the queue", lambda: a.unqueue_many(
                [r.index for r in self.rows(self.queue_list) if r.track["id"] in queue_ids])))
        if in_mine:
            items.append(("close", "Take out of this playlist", lambda: a.remove_from_playlist(self.open_mine, queue_ids)))
        if any(source_of(t) != "file" and not self.lib.has(t["id"]) for t in tracks):
            items.append(("down", "Download in FLAC", lambda: a.download(tracks)))
        if files:
            items.append(("lyrics", "Put the lyrics into the files", lambda: a.lyrics_into_files(files)))
        items.append(("edit", "Tagger…", "tagger"))   # tags, cover, the file's details and lyrics
        items += [("chart", "Speed…", "speed"), ("speaker", "Volume…", "volume")]
        if not a.upgrading and any(upgradable(t) for t in tracks):
            items.append(("reload", "Upgrade to Tidal's FLAC…", "upgrade"))
        on = {}   # the albums the songs are on (up to 3): go to one
        for t in tracks:
            if (t.get("album") or "").strip():
                on.setdefault(norm(clean_title(t["album"])), t)
        if len(on) <= 3:
            for t in on.values():
                items.append(("disc", f"Go to album “{t['album'].strip()}”", lambda t=t: self.go_to_album(t)))
        if len(tracks) == 1:   # one song: the ones that are about a single song
            lead = split_artists(tracks[0].get("artist") or "")[:1]
            if lead:
                items.append(("compass", f"Discovery playlist for {lead[0]}", lambda: a.make_discovery(lead[0])))
            if files:
                items.append(("folder", "Open file location", lambda: a.open_location(song_file(self.lib, files[0]))))
        if any((self.lib.items.get(t["id"]) or {}).get("format") == "flac" for t in tracks):
            items.append(("edit", "Tag now…", lambda: self.tag_preview([t["id"] for t in tracks])))
        items.append(("copy", "Copy the names", lambda: self.copy_names(tracks)))
        if files:
            items.append(("trash", "Delete…", "delete"))
        dialogs = {"tagger": lambda: self.tagger_dialog(tracks),
                   "speed": lambda: self.speed_dialog(tracks), "volume": lambda: self.volume_dialog(tracks),
                   "upgrade": lambda: self.confirm_upgrade([t for t in tracks if upgradable(t)]),
                   "delete": lambda: self.delete_songs_dialog(files)}
        for icon, label, cb in items:
