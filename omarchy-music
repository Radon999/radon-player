    @staticmethod
    def clear_box(box):
        while (c := box.get_first_child()):
            box.remove(c)

    def choices(self, body, rows, yes, no, apply_label, done, cancel=None, defaults=None, alts=None, alt_label=None,
                own_names=None):
        """In body: a row for each of rows [(name, [lines])] with two ticks, yes (ticked) and no, one or the other,
        like the discovery playlist's review; Apply hands done [whether each is yes]. alts: for each row None or
        (group, [names]) or (group, [names], label, [names to suggest]): a third tick, alt_label (or the row's
        label), with a dropdown of names and, last, "Choose your own…": a box to type a name in, suggesting
        own_names (or the row's own) as you type. done then gets the name for a row it's ticked on
        (an OwnName for a typed one). Ticking it (or picking a name) on one row does the same on its group's
        other rows (group None: on its own)."""
        self.clear_box(body)
        lst = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        lst.add_css_class("tracks")
        picks, third = [], []
        syncing = [False]
        own_label = "Choose your own…"

        def mirror(i):
            if syncing[0] or not third[i] or alts[i][0] is None:
                return
            g = alts[i][0]
            box, drop, names, entry = third[i]
            syncing[0] = True
            try:
                for j, other in enumerate(third):
                    if j != i and other and alts[j][0] == g:
                        if box.get_active():
                            other[0].set_active(True)
                        name = names[drop.get_selected()]
                        if name in other[2]:
                            other[1].set_selected(other[2].index(name))
                        other[3].set_text(entry.get_text())
            finally:
                syncing[0] = False

        def own_entry(i):
            """The box to type an artist in, with a list of yours that match under it."""
            alt_i = alts[i] if alts else None
            pool = alt_i[3] if alt_i and len(alt_i) > 3 else own_names
            entry = Gtk.Entry(placeholder_text="Type an album" if alt_i and len(alt_i) > 2 and "album" in alt_i[2]
                              else "Type a name" if alt_i and len(alt_i) > 2 and "name" in alt_i[2]
                              else "Type an artist", width_chars=22)
            matches = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
            matches.add_css_class("boxed-list")
            pop = Gtk.Revealer(child=Gtk.ScrolledWindow(child=matches, propagate_natural_height=True, max_content_height=240,
                                                        hscrollbar_policy=Gtk.PolicyType.NEVER),
                               transition_type=Gtk.RevealerTransitionType.SLIDE_DOWN)
            pop.popup = lambda: pop.set_reveal_child(True)
            pop.popdown = lambda: pop.set_reveal_child(False)
            pop.get_visible = pop.get_reveal_child
            holder = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, valign=Gtk.Align.CENTER, visible=False)
            holder.append(entry)
            holder.append(pop)
            holder.entry = entry
            chosen = [False]

            def take(_lst, row):
                chosen[0] = True
                entry.set_text(row.get_child().get_label())
                entry.set_position(-1)
                pop.popdown()

            matches.connect("row-activated", take)

            def changed(_e):
                if syncing[0]:   # copied from another row of the album: no suggestions here
                    return
                mirror(i)
                if chosen[0]:
                    chosen[0] = False
                    return
                q = norm(entry.get_text().strip())
                self.clear_box(matches)
                if not q:
                    pop.popdown()
                    return
                ranked = sorted(((0 if norm(n).startswith(q) else 1 if any(w.startswith(q) for w in norm(n).split()) else 2, norm(n), n)
                                 for n in pool or () if q in norm(n)))[:10]
                for _r, _k, n in ranked:
                    matches.append(Gtk.ListBoxRow(child=Gtk.Label(label=n, xalign=0, margin_start=8, margin_end=8,
                                                                  margin_top=4, margin_bottom=4)))
                if ranked:
                    pop.popup()
                else:
                    pop.popdown()

            entry.connect("changed", changed)
            entry.connect("activate", lambda *_: (take(matches, matches.get_row_at_index(0)) if pop.get_visible()
                                                  and matches.get_row_at_index(0) else pop.popdown()))
            focus = Gtk.EventControllerFocus()
            focus.connect("leave", lambda *_: GLib.timeout_add(200, lambda: (pop.popdown(), False)[1]))
            entry.add_controller(focus)
            return holder

        for name, lines in rows:
            line = Gtk.Box(spacing=10)
            text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True, spacing=1)
            ti = Gtk.Label(label=name, xalign=0, ellipsize=Pango.EllipsizeMode.END, tooltip_text=name)
            ti.add_css_class("title")
            text.append(ti)
            for ln in lines:
                su = Gtk.Label(label=ln, xalign=0, wrap=True, wrap_mode=Pango.WrapMode.WORD_CHAR)
                su.add_css_class("sub")
                text.append(su)
            line.append(text)
            on = True if defaults is None else defaults[len(picks)]
            y = Gtk.CheckButton(label=yes, active=on, valign=Gtk.Align.CENTER)
            n = Gtk.CheckButton(label=no, group=y, valign=Gtk.Align.CENTER, active=not on)
            line.append(y)
            line.append(n)
            alt = alts[len(picks)] if alts else None
            if alt:
                i = len(picks)
                names = list(alt[1]) + [own_label]
                o = Gtk.CheckButton(label=alt[2] if len(alt) > 2 else alt_label, group=y, valign=Gtk.Align.CENTER)
                drop = Gtk.DropDown.new_from_strings(names)
                drop.set_valign(Gtk.Align.CENTER)
                holder = own_entry(i)
                entry = holder.entry

                def dropped(d, _p, i=i, holder=holder, names=names):
                    holder.set_visible(names[d.get_selected()] == own_label)
                    if not syncing[0]:
                        third[i][0].set_active(True)
                        if holder.get_visible():
                            holder.entry.grab_focus()
                    mirror(i)
                drop.connect("notify::selected", dropped)
                holder.set_visible(names[0] == own_label)
                o.connect("toggled", lambda b, i=i: b.get_active() and mirror(i))
                line.append(o)
                line.append(drop)
                line.append(holder)
                third.append((o, drop, names, entry))
            else:
                third.append(None)
            lst.append(Gtk.ListBoxRow(child=line, activatable=False))
            picks.append(y)
        body.append(Gtk.ScrolledWindow(child=lst, vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER))
        bar = Gtk.Box(spacing=8, halign=Gtk.Align.END)
        for label, on in ((f"{yes} all", True), (f"{no} all", False)):
            b = Gtk.Button(label=label)
            b.add_css_class("pill")
            b.add_css_class("quiet")
            b.connect("clicked", lambda _b, on=on: [p.set_active(True) if on else self._tick_other(p) for p in picks])
            bar.append(b)
        if cancel:
            c = Gtk.Button(label=cancel[0])
            c.add_css_class("pill")
            c.add_css_class("quiet")
            c.connect("clicked", lambda *_: cancel[1]())
            bar.append(c)
        go = Gtk.Button(label=apply_label)
        go.add_css_class("pill")
        def picked(i, p):
            if third[i] and third[i][0].get_active():
                box, drop, names, entry = third[i]
                name = names[drop.get_selected()]
                return OwnName(entry.get_text().strip()) if name == own_label else name
            return p.get_active()

        def go_on(*_):
            out = [picked(i, p) for i, p in enumerate(picks)]
            blank = [rows[i][0] for i, v in enumerate(out) if isinstance(v, OwnName) and not v]
            if blank:
                self.toast(f"Type a name for “{blank[0]}” (or pick another choice)")
                return
            done(out)
        go.connect("clicked", go_on)
        bar.append(go)
        body.append(bar)

    @staticmethod
    def _tick_other(yes_box):
        """Tick a row's other box (its "no")."""
        nxt = yes_box.get_next_sibling()
        if nxt is not None:
            nxt.set_active(True)

