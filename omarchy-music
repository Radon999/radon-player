    # ---- editing songs' tags by hand ----
    def edit_tags(self, tracks, changes):
        """Write changes {field: value} to the files of tracks (blocking), and show the new names
        everywhere the songs are: the library, your folders' index, playlists, the queue."""
        return self.edit_tags_each([(t, changes) for t in tracks])

    def edit_tags_each(self, pairs):
        """edit_tags with each song's own changes: [(track, {field: value})]."""
        done, failed = 0, []
        for t, changes in pairs:
            path = song_file(self.lib, t)
            if not path:
                continue
            try:
                write_tags(path, changes)
            except Exception as e:  # noqa: BLE001 -- the next song
                failed.append(f"{Path(path).name}: {e}")
                continue
            done += 1
            fresh = track_from_file(path)
            names = {k: fresh[k] for k in ("title", "artist", "album", "albumartist") if k in changes}
            if "tracknumber" in changes:
                names["track"] = fresh["track"]
            with self.lib.lock:
                for e in self.lib.items.values():
                    if e.get("file") == path:
                        e.update(names)
                        if "genre" in changes:
                            e["genre"] = changes["genre"].strip()
            key = str(Path(path).resolve())
            if key in self.local.files:
                st, old = Path(path).stat(), self.local.files[key]["track"]
                fresh["added"] = old.get("added", st.st_mtime)
                self.local.files[key] = {"mtime": st.st_mtime, "size": st.st_size, "track": fresh}
            ids = {t["id"]} | {v for v, e in self.lib.items.items() if e.get("file") == path}
            for pl in self.lists.items:
                for x in pl["tracks"]:
                    if x["id"] in ids:
                        x.update(names)
            for x in self.queue:
                if x["id"] in ids:
                    x.update(names)
            for store in (self.favorites, self.song_stats):   # kept by song name and artist: under the new ones
                for k, e in list(store.items.items()):
                    tr = e.get("track") or {}
                    if tr.get("id") in ids or tr.get("file") == path:
                        tr.update(names)
                        nk = store.key(tr)
                        if nk != k:
                            store.items.pop(k)
                            store.items.setdefault(nk, e)
        if done:
            for store in (self.favorites, self.song_stats):
                write_atomic(store.path, json.dumps(store.items))
            self.lib.save()
            write_atomic(LOCAL_INDEX, json.dumps({"files": self.local.files}))
            self.lists.save()
        return done, failed

    # ---- Fix albums and artists, and empty folders (Settings; the PC only) ----
    def fixup_songs(self):
        """(blocking) Your files (in your folders and downloaded here), their tags read afresh."""
        seen, out = set(), []
        for t in self.my_songs():
            f = song_file(self.lib, t)
            if not f or os.path.normcase(f) in seen:
                continue
            seen.add(os.path.normcase(f))
            fresh = track_from_file(f)
            fresh["id"] = t["id"]
            fresh["file"] = f
            out.append(fresh)
        return out

    def fixup_scan(self, progress=lambda text: None):
        """(blocking) What Fix albums and artists would change (fixup_plan), deluxe editions' numbers looked up on Deezer."""
        progress("Reading your songs' tags…")
        songs = self.fixup_songs()
        looked = {}

        def tracklist(artist, album):
            k = (norm(artist), norm(album))
            if k not in looked:
                progress(f"Looking up “{album}”…")
                try:
                    looked[k] = deezer_tracklist(artist, album)
                except Exception:  # noqa: BLE001 -- offline, or Deezer didn't answer: the numbers stay
                    looked[k] = None
            return looked[k]
        progress("Looking for split albums, editions and singles…")
        found = {}

        def find_album(artist, title):
            k = (norm(artist), norm(title))
            if k not in found:
                progress(f"Looking up “{title}”…")
                found[k] = deezer_song_albums(artist, title)
            return found[k]
        def cover_of(path):
            data = embedded_cover(path)
            return picture_hash(data) if data else None
        progress("Comparing covers…")
        plan = fixup_plan(songs, tracklist, find_album, cover_of)
        kept = [c for c in plan if not in_folders(c["file"], self.fixup_skip)]
        self.fixup_skipped = len(plan) - len(kept)
        return kept, songs

    def set_fixup_skip(self, folders):
        """The folders Fix albums and artists leaves alone."""
        self.fixup_skip = list(dict.fromkeys(f for f in folders if f))
        self.save_state()

    def artist_resolver(self):
        """artist_resolver for your songs and Joint artists… picks, kept until either changes."""
        loc = self.local
        sig = (len(self.lib.items), len(loc.files), loc.scanned, tuple(sorted((self.artist_picks or {}).items())))
        got = self.__dict__.get("_resolver")
        if got and got[0] == sig:
            return got[1]
        try:
            songs = self.my_songs()
        except Exception:  # noqa: BLE001
            songs = []
        r = artist_resolver(songs, self.artist_picks)
        self._resolver = (sig, r)
        return r

    def artist_files(self, name):
        """Your songs credited to name (as the artist, the album artist, or one of a pair), as files on this computer."""
        k = re.sub(r"[\W_]+", "", norm(name))
        out = []
        for t in self.my_songs():
            credits = [t.get("artist") or "", t.get("albumartist") or ""]
            if any(re.sub(r"[\W_]+", "", norm(p)) == k for c in credits for p in [c] + duo_parts(c) + credit_names(c)):
                f = song_file(self.lib, t)
                if f and not in_folders(f, self.fixup_skip):   # Folders to leave alone: not retagged
                    out.append((t, f))
        return out

    def merge_artist(self, name, to):
        """(blocking) name becomes to: the artist and album artist tags of name's songs here (the whole credit when it's
        name's alone, name's part of it when it's a pair), and name's plays count for to (a Joint artists pick).
        (songs changed, [what failed])."""
        k = re.sub(r"[\W_]+", "", norm(name))

        def swap(credit):
            if not credit:
                return credit
            if re.sub(r"[\W_]+", "", norm(credit)) == k:
                return to
            parts = re.split(r"( & | x |, |;)", credit)
            return "".join(to if re.sub(r"[\W_]+", "", norm(p)) == k else p for p in parts)
        pairs = []
        for t, f in self.artist_files(name):
            ch = {}
            for field in ("artist", "albumartist"):
                old = t.get(field) or ""
                new = swap(old)
                if new != old:
                    ch[field] = new
            if ch:
                pairs.append(({"id": t["id"], "source": "file", "file": f}, ch))
        done, failed = self.edit_tags_each(pairs) if pairs else (0, [])
        GLib.idle_add(lambda: (self.set_artist_pick(name, to), False)[1])
        return done, failed

    def set_artist_pick(self, credit, name):
        """Joint artists…: credit's plays count for name ("" keeps them as the pair; None: back to undecided)."""
        picks = dict(self.artist_picks or {})
        if name is None:
            picks.pop(pair_key(credit), None)
        else:
            picks[pair_key(credit)] = name
        self.artist_picks = picks
        self.save_soon()

    @staticmethod
    def tried_quiet(fn, *args):
        try:
            return fn(*args)
        except Exception:  # noqa: BLE001 -- that service is down: without it
            return None

    def tagscan_apply(self, tags, covers):
        """(blocking) The tag scanner's picks written: tags {file: {field: value}}, covers {folder: (url, [files])}.
        What was done, a line each."""
        lines = []
        pairs = [({"id": "f" + hashlib.sha1(f.encode()).hexdigest()[:16], "source": "file", "file": f}, dict(ch))
                 for f, ch in tags.items()]
        done, failed = self.edit_tags_each(pairs)
        bad = {x.split(":")[0] for x in failed}
        for f, ch in tags.items():
            if Path(f).name not in bad:
                lines.append(f"{Path(f).name}: " + "; ".join(f"{SCAN_FIELDS.get(k, k)} → {v}" for k, v in ch.items()))
        lines += [f"Couldn't change {x}" for x in failed]
        ids = set()
        for _key, (url, files) in covers.items():
            folder = str(Path(files[0]).parent) if files else ""
            try:
                data, mime = cover_image(fetch_bytes(url))
            except Exception as e:  # noqa: BLE001 -- the next album
                lines.append(f"Couldn't get the cover for {Path(folder).name}: {e}")
                continue
            n = 0
            for f in files:
                try:
                    write_cover(f, data, mime)
                    n += 1
                except Exception as e:  # noqa: BLE001
                    lines.append(f"Couldn't put the cover in {Path(f).name}: {e}")
                    continue
                same = os.path.normcase(os.path.normpath(f))
                for k, e in list(self.local.files.items()):
                    if os.path.normcase(os.path.normpath(k)) == same:
                        ids.add(e["track"]["id"])
                for v, e in list(self.lib.items.items()):
                    if e.get("file") and os.path.normcase(os.path.normpath(e["file"])) == same:
                        ids.add(v)
                        if e.get("art"):
                            write_file(Path(e["art"]), data)
            for v in ids - set(self.lib.items):
                write_file(thumb_path(v), data)   # the small cover shown, made again from the new one
            if n:
                lines.append(f"New cover for {Path(folder).name}: {n} song{'s' if n != 1 else ''}")
                _COVER_BESIDE.pop(folder, None)
        if ids and self.win:
            GLib.idle_add(lambda: (self.win.redraw_art(ids), False)[1])
        return lines

    def fixup_apply(self, changes):
        """(blocking) Write the changes picked (fixup_plan's) into the files; a single with no cover of its own
        gets its album's. (done, [what failed])."""
        pairs = []
        for c in changes:
            pairs.append(({"id": "f" + hashlib.sha1(c["file"].encode()).hexdigest()[:16], "source": "file",
                           "file": c["file"]}, dict(c["new"])))
        done, failed = self.edit_tags_each(pairs)
        for c in changes:
            if not c.get("cover"):
                continue
            try:
                import mutagen
                f = mutagen.File(c["file"])
                has = bool(getattr(f, "pictures", None)) or any(
                    str(k).startswith(("APIC", "covr", "metadata_block_picture")) for k in (getattr(f, "tags", None) or {}).keys())
                if not has:
                    data = file_cover(c["cover"])
                    if data:
                        write_cover(c["file"], *cover_image(data))
            except Exception as e:  # noqa: BLE001 -- the tags are in; just no cover
                failed.append(f"{Path(c['file']).name} (cover): {e}")
        return done, failed

    def move_files(self, moves):
        """(blocking) Move songs [(file, new path)] and keep them everywhere they are: the library, your folders'
        index, playlists, queues, favorites, plays. (moved, [what failed])."""
        moved, failed = {}, []
        for src, dest in moves:
            try:
                move_song(src, dest)
                moved[src] = str(Path(dest).resolve())
            except Exception as e:  # noqa: BLE001 -- the next one
                failed.append(f"{Path(src).name}: {e}")
        if not moved:
            return 0, failed
        ids = {"f" + hashlib.sha1(str(Path(o).resolve()).encode()).hexdigest()[:16]:
               "f" + hashlib.sha1(n.encode()).hexdigest()[:16] for o, n in moved.items()}
        by_file = {os.path.normcase(str(Path(o).resolve())): n for o, n in moved.items()}

        def fix(x):
            if isinstance(x, dict):
                f = x.get("file")
                if isinstance(f, str) and os.path.normcase(f) in by_file:
                    x["file"] = by_file[os.path.normcase(f)]
                if x.get("id") in ids:
                    x["id"] = ids[x["id"]]
                for v in x.values():
                    if isinstance(v, (dict, list)):
                        fix(v)
            elif isinstance(x, list):
                for v in x:
                    fix(v)
        with self.lib.lock:
            fix(list(self.lib.items.values()))
        for old, new in moved.items():
            k = str(Path(old).resolve())
            entry = self.local.files.pop(k, None) or self.local.files.pop(old, None)
            if entry is not None or any(new.startswith(str(Path(r).resolve()) + os.sep) for r in self.folders):
                st, tr = Path(new).stat(), track_from_file(new)
                tr["added"] = (entry or {}).get("track", {}).get("added", st.st_mtime)
                self.local.files[new] = {"mtime": st.st_mtime, "size": st.st_size, "track": tr}
        fix(self.lists.items)
        fix(self.queue)
        fix(self.queues)
        for store in (self.favorites, self.song_stats):
            fix(store.items)
            write_atomic(store.path, json.dumps(store.items))
        fix(self.plays.items)
        for o, n in ids.items():
            if o in self.plays.items:
                self.plays.items[n] = self.plays.items.pop(o)
        write_atomic(PLAYS, json.dumps(self.plays.items))
        self.lib.save()
        write_atomic(LOCAL_INDEX, json.dumps({"files": self.local.files}))
        self.lists.save()
        self.save_state()
        return len(moved), failed

    def delete_folders(self, folders):
        """(blocking) Delete folders (empty_folders' ones: no music in them) to the trash where there is one.
        (deleted, [what failed])."""
        done, failed = 0, []
        for d in folders:
            p = Path(d)
            if any(Path(sub, n).suffix.lower() not in LEFTOVER_EXTS for sub, _ds, ns in os.walk(p) for n in ns):
                failed.append(f"{p.name}: has music in it now")   # something came in since the scan
                continue
            try:
                if not trash_path(p):
                    shutil.rmtree(p)
                done += 1
            except Exception as e:  # noqa: BLE001
                failed.append(f"{p.name}: {e}")
        return done, failed

    # ---- album covers ----
    def album_files(self, t):
        """Every song on this computer from t's album: {its file: the ids it's known by}. The album by its
        album artist (else lead artist, "Quinn XCII & Jeremy Zucker" as Quinn XCII) and name, so a song
        with a featured artist on it gets the album's cover too."""
        key, out = cover_album_key(t), {}
        for v, e in list(self.lib.items.items()):
            if cover_album_key(dict(e, id=v)) == key and e.get("file"):
                out.setdefault(e["file"], set()).add(v)
        for e in list(self.local.files.values()):
            if cover_album_key(e["track"]) == key:
                out.setdefault(e["track"]["file"], set()).add(e["track"]["id"])
        path = song_file(self.lib, t)
        if path:
            out.setdefault(path, set()).add(t["id"])
        return {p: ids for p, ids in out.items() if Path(p).exists()}

    def set_cover(self, tracks, source):
        """Make source (a picture's web address or file) the cover of tracks' album (blocking):
        in every one of its songs' files here, and shown for them and for tracks.
        Returns (the ids whose cover changed, how many files have it, what failed)."""
        data = Path(source).read_bytes() if Path(source).is_file() else fetch_bytes(source)
        data, mime = cover_image(data)
        t = tracks[0]
        files, seen = {}, set()
        for x in tracks:   # every album of the songs: all of each album's songs get it, not just the ones picked
            k = cover_album_key(x)
            if k in seen:
                continue
            seen.add(k)
            for path, known in self.album_files(x).items():
                files.setdefault(path, set()).update(known)
        ids, failed, written = {x["id"] for x in tracks}, [], 0
        for path, known in files.items():
            try:
                write_cover(path, data, mime)
                written += 1
                ids |= known
            except Exception as e:  # noqa: BLE001 -- the next song
                failed.append(f"{Path(path).name}: {e}")
        with self.lib.lock:
            for v in ids:
                e = self.lib.items.get(v)
                if e is not None:
                    if not e.get("art"):
                        e["art"] = str(ART / f"{safe_name(v)}.jpg")
                    write_file(Path(e["art"]), data)
        for v in ids:
            if v not in self.lib.items:
                write_file(thumb_path(v), data)
        self.lib.save()
        if t.get("album"):
            self.pictures.choose_cover(t["artist"], t["album"], source if not Path(source).is_file() else Path(source).as_uri())
        return ids, written, failed

