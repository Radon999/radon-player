    def tag_preview(self, vids, full=True):
        """Tag now, seen first: what the tagger would change in the first few of vids (old → new), then Tag all.
        full: from scratch; else songs tagged before just get what's new since."""
        a = self.app
        vids = [v for v in dict.fromkeys(vids) if (a.lib.items.get(v) or {}).get("format") == "flac"]
        if not vids:
            self.toast("Only downloaded FLACs are tagged")
            return
        n = len(vids)
        dlg = Adw.Dialog(title="Tag preview", content_width=560, content_height=600)
        page = Adw.ToolbarView()
        page.add_top_bar(Adw.HeaderBar())
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_start=14, margin_end=14, margin_bottom=14)
        note = Gtk.Label(xalign=0, wrap=True, label=(
            "Looking it up…" if n == 1 else f"Looking up the first {min(3, n)} of {n:,} songs, to show what changes…"))
        note.add_css_class("sub")
        box.append(note)
        rows = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=14)
        spin = Gtk.Spinner(spinning=True, halign=Gtk.Align.CENTER, margin_top=20)
        rows.append(spin)
        box.append(Gtk.ScrolledWindow(child=rows, vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER))
        bar = Gtk.Box(spacing=8, halign=Gtk.Align.END)
        cancel = Gtk.Button(label="Cancel")
        cancel.add_css_class("pill")
        cancel.add_css_class("quiet")
        cancel.connect("clicked", lambda *_: dlg.close())
        go = Gtk.Button(label="Tag it" if n == 1 else f"Tag all {n:,}", sensitive=False)
        go.add_css_class("pill")
        bar.append(cancel)
        bar.append(go)
        box.append(bar)
        page.set_content(box)
        dlg.set_child(page)
        plans = []

        def short(v):
            v = "; ".join(v) if isinstance(v, list) else str(v)
            v = " ".join(v.split())
            return v if len(v) <= 90 else v[:88] + "…"

        def show(res, err):
            rows.remove(spin)
            if err is not None:
                note.set_label(f"Couldn't look it up: {str(err)[:120]}")
                return
            plans[:] = [p for p in res if p]
            changes = sum(len(p["fill"]) + bool(p["cover"]) for p in plans)
            note.set_label(("Nothing to change: it's tagged as well as it can be" if not changes and n == 1 else
                            "What changes, yours on the left:" if n == 1 else
                            f"What changes in the first {len(plans)}, yours on the left. The rest are done the same way."))
            for p in plans:
                e = a.lib.items.get(p["vid"]) or {}
                head = Gtk.Label(label=f"{e.get('title', '')} — {e.get('artist', '')}", xalign=0, ellipsize=Pango.EllipsizeMode.END)
                head.add_css_class("title")
                rows.append(head)
                grid = Gtk.Grid(column_spacing=10, row_spacing=4)
                items = [(self.TAG_NAMES.get(k, k.title()), short(p["old"].get(k) or "—"), short(v)) for k, v in p["fill"].items()]
                if p["cover"]:
                    items.append(("Cover", "smaller", "1280 px"))
                if p["lrc"]:
                    items.append(("Timed lyrics", "—", "a .lrc beside the file"))
                if not items:
                    items = [("", "Nothing to change", "")]
                for r, (name, old, new) in enumerate(items):
                    for c, (text, css) in enumerate(((name, "sub"), (old, "sub"), ("→" if new else "", "sub"), (new, None))):
                        lab = Gtk.Label(label=text, xalign=0, wrap=c in (1, 3), max_width_chars=28 if c in (1, 3) else -1,
                                        selectable=c in (1, 3))
                        if css:
                            lab.add_css_class(css)
                        grid.attach(lab, c, r, 1, 1)
                rows.append(grid)
            go.set_sensitive(True)

        def run(*_):
            dlg.close()
            first = {p["vid"] for p in plans}
            for p in plans:   # looked up already: written as shown
                in_thread(a.tagger.write, p, done=lambda *_: a.update_sync())
            rest = [v for v in vids if v not in first]
            if rest:
                a.tagger.start(rest, full=full)
            else:
                a.toast("Tagged" if n == 1 else f"Tagged {n} songs")
        go.connect("clicked", run)
        in_thread(lambda: [a.tagger.plan(v, light=not full and a.lib.items[v].get("tagged", 0) >= 1) for v in vids[:3]],
                  done=show)
        dlg.present(self)

