                artist = r["to"][1] if p is True or str(p) in [r["to"][0]] + r["others"] else r["artist"]
                if song_pick_key(title, artist) == key:
                    a.song_picks[key] = ""
                    continue
                a.song_picks[key] = {"title": title, "artist": artist}
                n += 1
            a.save_soon()
            self.report(body, status, f"{n} song{'s' if n != 1 else ''} merged. Most played is counting again." if n
