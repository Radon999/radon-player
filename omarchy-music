    @staticmethod
    def q_list():
        lst = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        lst.add_css_class("np-list")
        lst.connect("row-activated", lambda _l, r: getattr(r, "go", None) and r.go())
        return lst

    def show_queue(self, on=None):
        """Up next in the cover's place (or the cover back)."""
        now = self.views.get_visible_child_name() == "queue"
        on = not now if on is None else on
        if on:
            self.refresh_queue()
            self.q_scroll.get_vadjustment().set_value(0)
        self.views.set_visible_child_name("queue" if on else "now")
        (self.q_btn.add_css_class if on else self.q_btn.remove_css_class)("on")

    def refresh_queue(self):
        """The queue as it is now (it's made again when the song or the queue changes, while it shows)."""
        a, win = self.app, self.app.win
        q, i = a.queue, a.index
        start = max(i, 0) + 1
        queued = [j for j in range(start, len(q)) if q[j].get("queued")]
        rest = [j for j in range(start, len(q)) if not q[j].get("queued")]
        for lst in (self.q_queued, self.q_next):
            lst.remove_all()
        if win is not None:
            for j in queued[:30]:
                self.q_queued.append(win.np_song_row(q[j], j))
            for j in rest[:40]:
                self.q_next.append(win.np_song_row(q[j], j))
        self.q_queued_head.set_visible(bool(queued))
        self.q_queued.set_visible(bool(queued))
        name = a.queue_name_s or ""
        self.q_from.set_label((f"From {name}" if name else "From your music") +
                              (f" · {len(rest)} songs" if len(rest) > 40 else ""))
        if not rest:
            lab = Gtk.Label(label="Autoplay plays songs like this one next" if a.autoplay else "Nothing after this song",
                            xalign=0)
            lab.add_css_class("np-row-sub")
            self.q_next.append(Gtk.ListBoxRow(child=lab, activatable=False))
        self.q_repeat.icon.set_name("repeat_one" if a.repeat == "one" else "repeat")
        for b, on in ((self.q_repeat, a.repeat != "off"), (self.q_shuffle, a.shuffled), (self.q_autoplay, a.autoplay)):
            (b.add_css_class if on else b.remove_css_class)("on")

    def start(self):
        win = self.app.win
        self.vis = win.visualizer if win else None
        if self.vis:
            self.vis.ensure()
        if self.tick is None:
            self.tick = self.bars.add_tick_callback(self.on_tick)

    def stop(self):
        if self.tick is not None:
            self.bars.remove_tick_callback(self.tick)
            self.tick = None

    def on_tick(self, _w, _clock):
        a = self.app
        if self.vis:
            self.vis.ensure()
            if self.vis.update_levels():
                self.bars.queue_draw()
        if not self.dragging:
            pos = self.vis.position() if self.vis else a.position
            dur = a.duration or (a.current_track() or {}).get("duration") or 0
            self.seek.set_range(0, max(1, dur))
            self.seek.set_value(min(pos, dur or pos))
            self.t_pos.set_label(fmt_time(pos))
            self.t_left.set_label("-" + fmt_time(max(0, dur - pos)))
        return GLib.SOURCE_CONTINUE

    def on_seek(self, _scale, _scroll, value):
        self.dragging = True
        self.app.player.seek(value)
        GLib.timeout_add(300, lambda: (setattr(self, "dragging", False), False)[1])
        return False

    def update(self):
        """The song playing now: its cover, names, colour and the play button."""
        a = self.app
        t = a.current_track()
        self.play.icon.set_name("play" if a.paused else "pause")
        if self.views.get_visible_child_name() == "queue":
            self.refresh_queue()
        if not t:
            self.title.set_label("Nothing playing")
            self.artist.set_label("")
            return
        self.title.set_label(t["title"])
        self.artist.set_label(t.get("artist") or "")
        a.art.apply(self.pic, t, 576)
        lib = a.lib.items.get(t["id"])
        path = a.art.paths.get(t["id"]) or (lib.get("art") if lib else None)
        if path:
            def got(rgb, _e, vid=t["id"]):
                cur = a.current_track()
                if rgb and cur and cur["id"] == vid:
                    h, l, s_ = colorsys.rgb_to_hls(*(c / 255 for c in rgb))
                    self.color = colorsys.hls_to_rgb(h, max(0.55, l), max(0.45, s_) if s_ > 0.08 else s_)
            in_thread(art_color, path, done=got)


class Visualizer(Gtk.Box):
    """The Visualizer tab: what's playing as bars rising and falling with its sound. The
    spectrum is worked out ahead of the music (spectrum_cmd) and drawn in step with where mpv
    is in the song, so it's the song itself, not the speakers, and works the same on Windows.
    Now playing's background (Backdrop) uses the same sound, and the same looks."""

    def __init__(self, win):
        super().__init__(orientation=Gtk.Orientation.VERTICAL)
        self.win, self.app = win, win.app
        self.area = VisArea(self)
        self.note = Gtk.Label(xalign=0.5, wrap=True, margin_bottom=10)
        self.note.add_css_class("sub")
        looks = Adw.ToggleGroup(halign=Gtk.Align.CENTER)
        looks.add_css_class("sources")
        for name, label, tip in vis_presets():
            looks.add(Adw.Toggle(label=label, name=name, tooltip=tip))
        looks.set_active_name(self.app.vis_preset)
        looks.connect("notify::active-name", lambda g, _p: g.get_active_name() and self.app.set_vis_preset(g.get_active_name())
                      or self.area.queue_draw())
        strip = scroll_sideways(looks)
        strip.set_margin_top(8)
        self.append(strip)
        self.append(self.area)
        self.append(self.note)
        self.frames = []          # each frame's band levels, as bytes (level * 255)
        self.for_src = None
        self.proc = None
        self.levels = [0.0] * VIS_BANDS
        self.levels_at = 0.0
        self.tick = None
        self.last_draw = 0.0

    # ---- the spectrum ----
    def song_loaded(self):
        if self.win.shown("visualizer"):
            self.start()

    def ensure(self):
        """The playing song's spectrum, worked out if it isn't yet. False: nothing playing."""
        _vid, src = self.app.loaded
        t = self.app.current_track()
        if not src or not t:
            self.note.set_label("Nothing playing")
            return False
        if src != self.for_src:
            self.analyse(src)
            self.note.set_label(t["title"])
        return True

    def start(self):
        """Work out the playing song's spectrum (if not done yet) and draw it while the tab shows."""
        self.ensure()
        if self.tick is None:
            self.tick = self.area.add_tick_callback(self.on_tick)

    def stop(self):
        if self.tick is not None:
            self.area.remove_tick_callback(self.tick)
            self.tick = None

    def analyse(self, src):
        if self.proc and self.proc.poll() is None:
            self.proc.kill()
        self.for_src, self.frames = src, []
        frames, size = self.frames, (VIS_BANDS + 1) * VIS_STEPS

        def read():   # ffmpeg started here, off the main loop (starting a program took a while on each song)
            try:
                self.proc = proc = child(spectrum_cmd(src), stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                                         stdin=subprocess.DEVNULL)
            except OSError:
                GLib.idle_add(lambda: (self.note.set_label("The visualizer needs ffmpeg"), False)[1])
                return
            if frames is not self.frames:   # another song came first
                proc.kill()
                return
            while True:
                chunk = proc.stdout.read(size)
                if len(chunk) < size:
                    break
                frames.append(bytes(int(v * 255) for v in spectrum_levels(chunk)))
            proc.wait()
            if not frames and frames is self.frames:
                GLib.idle_add(lambda: (self.note.set_label("Couldn't read this song's sound"), False)[1])
        threading.Thread(target=read, daemon=True).start()

    def position(self):
        a = self.app
        pos = a.position
        if not a.paused and a.position_at:
            t = a.current_track()
            speed = a.speeds.get(t)[0] if t else 1.0
            pos += min(0.6, time.monotonic() - a.position_at) * speed
        return pos

    def update_levels(self):
        """The bands' levels for this moment (once a frame, whoever asks). True: they moved."""
        now = time.monotonic()
        if now - self.levels_at < 0.008:
            return False
        self.levels_at = now
        at = self.position() * VIS_FPS
        i, frac = int(at), at - int(at)
        frame = self.frames[i] if 0 <= i < len(self.frames) and not self.app.paused else None
        after = self.frames[i + 1] if frame and i + 1 < len(self.frames) else frame
        moving = False
        for b in range(VIS_BANDS):
            want = (frame[b] + (after[b] - frame[b]) * frac) / 255 if frame else 0.0   # between two spectra, as the music is
            have = self.levels[b]
            new = want if want > have else have - (have - want) * 0.32   # up at once, down quickly
            moving = moving or abs(new - have) > 0.002
            self.levels[b] = new
        return moving

    def on_tick(self, _area, _clock):
        if self.update_levels():
            self.area.queue_draw()
        return GLib.SOURCE_CONTINUE

    # ---- drawing ----
    def paint(self, cr, w, h, preset, fg, cols=None):
        """preset's look in fg on cr; cols: its other colours (accent, magenta, cyan)."""
        self.fg, self.cols = fg, cols
        if preset in NEON:
            self.draw_neon(cr, w, h, NEON[preset][1])
            return
        look = getattr(self, f"draw_{preset}", None)
        if look and preset != "bars":
            look(cr, w, h)
            return
        c = fg
        n, pad = VIS_BANDS, 16
        gap = max(1.0, (w - 2 * pad) / n * 0.25)
        bw = max(1.0, (w - 2 * pad) / n - gap)
        base = h * 0.78
        for b, lv in enumerate(self.levels):
            x = pad + b * (bw + gap)
            bh = max(2.0, lv * base * 0.95)
            cr.set_source_rgba(c.red, c.green, c.blue, 0.35 + 0.65 * lv)
            cr.rectangle(x, base - bh, bw, bh)
            cr.fill()
            cr.set_source_rgba(c.red, c.green, c.blue, 0.12 * (0.4 + lv))   # its reflection
            cr.rectangle(x, base + 3, bw, bh * 0.25)
            cr.fill()

    def colors(self):
        """The theme's accent and two more of its colours (or Now playing's, from the cover)."""
        if self.cols:
            return self.cols
        c = (self.app.theme or {}).get("c") or DEFAULT_COLORS
        return hex_rgb(c["accent"]), hex_rgb(c.get("magenta", c["accent"])), hex_rgb(c.get("cyan", c["accent"]))

    def draw_mirror(self, cr, w, h):
        c = self.fg
        n, pad = VIS_BANDS, 16
        gap = max(1.0, (w - 2 * pad) / n * 0.25)
        bw = max(1.0, (w - 2 * pad) / n - gap)
        mid = h / 2
        for b, lv in enumerate(self.levels):
            x = pad + b * (bw + gap)
            bh = max(1.0, lv * mid * 0.9)
            cr.set_source_rgba(c.red, c.green, c.blue, 0.3 + 0.7 * lv)
            cr.rectangle(x, mid - bh, bw, bh * 2)
            cr.fill()

    def draw_wave(self, cr, w, h):
        acc, mag, _cy = self.colors()
        n, pad = VIS_BANDS, 16
        base = h * 0.82
        pts = [(pad + i * (w - 2 * pad) / max(1, n - 1), base - lv * base * 0.85) for i, lv in enumerate(self.levels)]
        cr.move_to(pad, base)
        cr.line_to(*pts[0])
        for (x0, y0), (x1, y1) in zip(pts, pts[1:]):   # a smooth curve through the points
            mx = (x0 + x1) / 2
            cr.curve_to(mx, y0, mx, y1, x1, y1)
        cr.line_to(w - pad, base)
        cr.close_path()
        grad = cr.linear_gradient(0, base * 0.15, 0, base)
        grad.add_color_stop_rgba(0, *acc, 0.75)
        grad.add_color_stop_rgba(1, *mag, 0.12)
        cr.set_source(grad)
        cr.fill_preserve()
        cr.set_source_rgba(*acc, 0.95)
        cr.set_line_width(2.5)
        cr.stroke()

    def draw_circle(self, cr, w, h):
        import math as m
        acc, mag, _cy = self.colors()
        n = VIS_BANDS
        cx, cy = w / 2, h / 2
        bass = sum(self.levels[:max(1, n // 6)]) / max(1, n // 6)
        r0 = min(w, h) * (0.16 + 0.05 * bass)
        reach = min(w, h) * 0.3
        cr.set_line_width(max(2.0, 2 * m.pi * r0 / (n * 2) * 0.7))
        cr.set_line_cap(1)   # round ends
        for half in (1, -1):   # the bands go round both ways, lows at the top
            for b, lv in enumerate(self.levels):
                ang = -m.pi / 2 + half * (b + 0.5) / n * m.pi
                k = b / max(1, n - 1)
                cr.set_source_rgba(*(acc[i] * (1 - k) + mag[i] * k for i in range(3)), 0.35 + 0.65 * lv)
                cr.move_to(cx + m.cos(ang) * r0, cy + m.sin(ang) * r0)
                cr.line_to(cx + m.cos(ang) * (r0 + 3 + lv * reach), cy + m.sin(ang) * (r0 + 3 + lv * reach))
                cr.stroke()
        cr.set_source_rgba(*acc, 0.18 + 0.4 * bass)
        cr.arc(cx, cy, r0 * 0.85, 0, 2 * m.pi)
        cr.fill()

    def draw_led(self, cr, w, h):
        acc, _mag, _cy = self.colors()
        c = self.fg
        n, pad, rows = VIS_BANDS, 16, 18
        gap = max(1.0, (w - 2 * pad) / n * 0.25)
        bw = max(1.0, (w - 2 * pad) / n - gap)
        base, cell = h * 0.85, h * 0.8 / rows
        hot = (0.97, 0.46, 0.56)   # the top blocks go red, like a meter's
        for b, lv in enumerate(self.levels):
            x = pad + b * (bw + gap)
            lit = int(round(lv * rows))
            for r in range(rows):
                y = base - (r + 1) * cell
                if r < lit:
                    col = hot if r >= rows * 0.8 else acc
                    cr.set_source_rgba(*col, 0.95)
                else:
                    cr.set_source_rgba(c.red, c.green, c.blue, 0.06)
                cr.rectangle(x, y + 1, bw, cell - 2)
                cr.fill()

    def draw_neon(self, cr, w, h, col):
        """Black, with neon bars: a soft glow around each, a white-hot top on the loud ones."""
        red = hex_rgb(col)
        cr.set_source_rgb(0, 0, 0)
        cr.paint()
        n, pad = VIS_BANDS, 16
        gap = max(1.0, (w - 2 * pad) / n * 0.3)
        bw = max(1.0, (w - 2 * pad) / n - gap)
        base = h * 0.78
        cr.set_source_rgba(*red, 0.35)   # the floor line
        cr.rectangle(pad, base + 1, w - 2 * pad, 1)
        cr.fill()
        for b, lv in enumerate(self.levels):
            x = pad + b * (bw + gap)
            bh = max(2.0, lv * base * 0.92)
            for spread, alpha in ((7, 0.06), (4, 0.10), (2, 0.18)):   # the glow, wide and faint to near and bright
                cr.set_source_rgba(*red, alpha * (0.5 + lv))
                cr.rectangle(x - spread, base - bh - spread, bw + 2 * spread, bh + spread)
                cr.fill()
            grad = cr.linear_gradient(0, base - bh, 0, base)
            hot = 0.45 + 0.4 * lv
            grad.add_color_stop_rgba(0, *(c + (1 - c) * hot for c in red), 1.0)   # hot at the top
            grad.add_color_stop_rgba(0.25, *red, 1.0)
            grad.add_color_stop_rgba(1, *(c * 0.5 for c in red), 1.0)
            cr.set_source(grad)
            cr.rectangle(x, base - bh, bw, bh)
            cr.fill()
            cr.set_source_rgba(*red, 0.16 * (0.4 + lv))   # its reflection on the floor
            cr.rectangle(x, base + 4, bw, bh * 0.22)
            cr.fill()

    def draw_glow(self, cr, w, h):
        acc, mag, cy = self.colors()
        n, pad = VIS_BANDS, 16
        gap = max(1.0, (w - 2 * pad) / n * 0.25)
        bw = max(1.0, (w - 2 * pad) / n - gap)
        base = h * 0.8
        for b, lv in enumerate(self.levels):
            x = pad + b * (bw + gap)
            bh = max(2.0, lv * base * 0.95)
            k = b / max(1, n - 1)
            col = tuple(cy[i] * (1 - k) + mag[i] * k for i in range(3))
            grad = cr.linear_gradient(0, base - bh, 0, base)
            grad.add_color_stop_rgba(0, *col, 1.0)
            grad.add_color_stop_rgba(1, *acc, 0.25)
            cr.set_source(grad)
            cr.rectangle(x - 1, base - bh, bw + 2, bh)
            cr.fill()
            cr.set_source_rgba(*col, 0.10 + 0.25 * lv)   # the glow around a loud one
            cr.rectangle(x - gap, base - bh - 6, bw + 2 * gap, bh + 6)
            cr.fill()


class Backdrop(Gtk.Widget):
    """Now playing's background, under the whole window, Apple Music's way: a gradient in the cover's main
    colour with the cover faintly in it, slightly blurred; and bars rising and falling with the music along
    the bottom, in a light shade of the same colour. On the other pages it draws nothing."""
    __gtype_name__ = "VarMusicBackdrop"

    def __init__(self, win):
        super().__init__(hexpand=True, vexpand=True, can_target=False)
        self.win, self.app = win, win.app
        self.cover = None
        self.top, self.bottom, self.bars = (0.30, 0.30, 0.34), (0.10, 0.10, 0.12), (0.85, 0.85, 0.9)
        self.path = None
        self.active = False   # Now playing in view
        self.tick = None
        self.last = 0.0
        self.strip = BackdropBars(self)   # the bars, in a widget of their own along the bottom (see MusicWindow)

    def set_cover(self, path):
        if path == self.path:
            return
        self.path = path
        if not path:
            self.cover = None
            self.top, self.bottom, self.bars = (0.30, 0.30, 0.34), (0.10, 0.10, 0.12), (0.85, 0.85, 0.9)
            self.queue_draw()
            return

        def got(res, _err):
            if path != self.path or not res:
                return
            data, w, h, self.top, self.bottom, self.bars = res
            self.cover = texture_rgb(data, w, h)
            self.queue_draw()
        in_thread(blurred_cover, path, done=got)

    def set_active(self, on):
        if on != self.active:
            self.active = on
            self.queue_draw()
        self.update()

    def update(self):
        """Ticking (the bars move) only while Now playing shows and something plays."""
        self.strip.queue_draw()
        want = self.active and not self.app.paused
        if want:
            self.win.visualizer.ensure()
            if self.tick is None:
                self.tick = self.add_tick_callback(self.on_tick)
        elif self.tick is not None:
            self.remove_tick_callback(self.tick)
            self.tick = None
        self.queue_draw()

    def on_tick(self, _w, _clock):
        moving = self.win.visualizer.update_levels()
        now = time.monotonic()
        if moving and now - self.last >= 1 / 30:   # 30 frames a second is plenty for a background
            self.last = now
            self.strip.queue_draw()   # only the strip along the bottom: the rest of the window stays as it was
        return GLib.SOURCE_CONTINUE

    def do_size_allocate(self, w, h, baseline):
        Gtk.Widget.do_size_allocate(self, w, h, baseline)
        want = max(1, int(h * 0.28) + 2)
        if self.strip.get_size_request()[1] != want:
            GLib.idle_add(lambda: (self.strip.set_size_request(-1, want), False)[1])

    def do_snapshot(self, snap):
        if not self.active:
            return
        w, h = self.get_width(), self.get_height()
        if w <= 0 or h <= 0:
            return
        full = rect(0, 0, w, h)
        stops = []
        for off, col in ((0.0, self.top), (1.0, self.bottom)):
            st = Gsk.ColorStop()
            st.offset, st.color = off, gdk_rgba(*col, 1.0)
            stops.append(st)
        snap.append_linear_gradient(full, Graphene.Point().init(0, 0), Graphene.Point().init(0, h), stops)
        if self.cover:   # the cover, slightly blurred, faintly in the colour
            side = max(w, h) * 1.2
            snap.push_opacity(0.28)
            snap.append_scaled_texture(self.cover, Gsk.ScalingFilter.LINEAR, rect((w - side) / 2, (h - side) / 2, side, side))
            snap.pop()
        snap.append_color(gdk_rgba(0, 0, 0, 0.12), full)   # a touch darker, for the white text
        # (the bars: BackdropBars, over this)


class BackdropBars(Gtk.Widget):
    """Now playing's bars, along the bottom behind the controls, in a light shade of the cover's colour.
    A widget of their own, only as tall as the bars reach: each frame redraws that strip, not the whole
    window (which, maximized at 4K, made Now playing stutter)."""
    __gtype_name__ = "RadonBackdropBars"

    def __init__(self, backdrop):
        super().__init__(hexpand=True, valign=Gtk.Align.END, can_target=False)
        self.backdrop = backdrop

    def do_snapshot(self, snap):
        bd = self.backdrop
        if not bd.active or bd.app.paused:
            return
        w, h = self.get_width(), self.get_height()
        levels = bd.win.visualizer.levels
        n = len(levels)
        if not n or w <= 0 or h <= 0:
            return
        pad, span = 0.0, w   # under Now playing only (not under the menu beside it)
        ok, area = bd.win.np_scroll.compute_bounds(self)
        if ok and area.get_width() > 50:
            pad, span = area.get_x(), area.get_width()
        # Twice as many bars as bands (each between two bands is their mix): slim, with room between them.
        m = n * 2 - 1
        vals = [levels[i // 2] if i % 2 == 0 else (levels[i // 2] + levels[i // 2 + 1]) / 2 for i in range(m)]
        slot = span / m
        bw = max(1.5, slot * 0.38)
        base, reach = h, max(1, h - 2)
        r, g, b = bd.bars
        for i, lv in enumerate(vals):
            bh = max(2.0, lv * reach)
            snap.append_color(gdk_rgba(r, g, b, 0.88 * (0.12 + 0.22 * lv)),   # (under the darkening, before)
                              rect(pad + i * slot + (slot - bw) / 2, base - bh, bw, bh))


