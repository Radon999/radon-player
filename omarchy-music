    def cover_dialog(self, tracks):
        """Cover…: a new cover for each album of tracks, one album at a time, from Google's,
        Genius's and Wikipedia's pictures of it, or a file of yours."""
        albums = {}
        for t in tracks:
            albums.setdefault(album_key(t), []).append(t)
