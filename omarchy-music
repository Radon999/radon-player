    def backup_dialog(self):
        """Back up…: where to save the backup."""
        filt = Gtk.FileFilter(name="Radon Player backup (.zip)")
        filt.add_pattern("*.zip")
        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(filt)
        docs = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_DOCUMENTS) or str(HOME)
        dlg = Gtk.FileDialog(title="Back up Radon Player", filters=filters, default_filter=filt,
                             initial_name=f"Radon Player backup {datetime.now():%Y-%m-%d}.zip",
                             initial_folder=Gio.File.new_for_path(docs))

        def chosen(d, res):
            try:
                f = d.save_finish(res)
            except GLib.Error:
                return
            if not f or not f.get_path():
                return
            path = f.get_path() if f.get_path().lower().endswith(".zip") else f.get_path() + ".zip"
            self.app.save_state()
            in_thread(make_backup, path, done=lambda n, err: self.toast(
                f"Couldn't back up: {str(err)[:100]}" if err else f"Backed up ({n} files) to {Path(path).name}"))
        dlg.save(self, None, chosen)

    def restore_dialog(self):
        """Restore…: pick a backup, say what it replaces, put it back, then restart."""
        filt = Gtk.FileFilter(name="Radon Player backup (.zip)")
        filt.add_pattern("*.zip")
        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(filt)
        dlg = Gtk.FileDialog(title="Restore a backup", filters=filters, default_filter=filt)

        def chosen(d, res):
            try:
                f = d.open_finish(res)
            except GLib.Error:
                return
            if not f or not f.get_path():
                return
            ask = Adw.AlertDialog(heading="Restore this backup?",
                                  body="Your playlists, favorites, plays, settings and imported histories become the backup's. "
                                       "What's here now is kept beside them (.before-restore) in case. The app restarts after.")
            ask.add_response("cancel", "Cancel")
            ask.add_response("restore", "Restore")
            ask.set_response_appearance("restore", Adw.ResponseAppearance.DESTRUCTIVE)

            def answered(_d, r):
                if r != "restore":
                    return
                self.app.restoring = True   # nothing saved over it on the way out

                def done(names, err):
                    if err:
                        self.app.restoring = False
                        self.toast(f"Couldn't restore: {str(err)[:120]}")
                        return
                    self.toast(f"Restored {len(names)} files: restarting…")
                    GLib.timeout_add(1200, lambda: (self.app.restart_app(), False)[1])
                in_thread(restore_backup, f.get_path(), done=done)
            ask.connect("response", answered)
            ask.present(self)
        dlg.open(self, None, chosen)

