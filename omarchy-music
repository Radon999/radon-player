def art_color(path):
    """The colour a cover mostly is: its most common hue, vivid pixels counting
    more than grey ones. (r, g, b) 0..255, or None for an unreadable picture."""
    try:
        from gi.repository import GdkPixbuf
        pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(path), 32, 32, False)
    except GLib.Error:
        return None
    px, n, stride = pb.get_pixels(), pb.get_n_channels(), pb.get_rowstride()
    buckets = {}
    for y in range(pb.get_height()):
        for x in range(pb.get_width()):
            i = y * stride + x * n
            r, g, b = px[i], px[i + 1], px[i + 2]
            h, s, v = colorsys.rgb_to_hsv(r / 255, g / 255, b / 255)
            if v < 0.1:
                continue   # black borders and shadows say nothing about the cover
            w = 0.2 + s * v
            acc = buckets.setdefault((int(h * 12) % 12, int(s * 3), int(v * 3)), [0.0, 0.0, 0.0, 0.0])
            acc[0] += r * w
            acc[1] += g * w
            acc[2] += b * w
            acc[3] += w
    if not buckets:
        return (24, 24, 24)
    best = max(buckets.values(), key=lambda a: a[3])
    return tuple(round(c / best[3]) for c in best[:3])


def tint_css(rgb, light):
    """The window and the player bar in the cover's colour, dark (or light) enough
    that the theme's text stays readable on it."""
    h, _l, s = colorsys.rgb_to_hls(*(c / 255 for c in rgb))
    s = min(s, 0.6)

    def shade(lightness):
        r, g, b = (round(c * 255) for c in colorsys.hls_to_rgb(h, lightness, s))
        return f"#{r:02x}{g:02x}{b:02x}"
    window, bar = (shade(0.9), shade(0.84)) if light else (shade(0.15), shade(0.09))
    return (f"window.main {{ background-color: {rgba(window, OPACITY)}; }}\n"
            f".player, .selectbar {{ background-color: {rgba(bar, OPACITY)}; }}\n")


# =============================================================================
# Library: songs on disk, with the metadata to show and play them offline
# =============================================================================

class Library:
    def __init__(self):
        SONGS.mkdir(parents=True, exist_ok=True)
        ART.mkdir(parents=True, exist_ok=True)
        self.items = read_json(LIBRARY, {})
        # Drop entries whose file was deleted by hand.
        for vid in [v for v, t in self.items.items() if not Path(t.get("file", "")).exists()]:
            del self.items[vid]
        self.missing = read_json(MISSING, {})
        self.lock = threading.Lock()
        self._seen = {}   # vid -> (its file is there, when that was looked at, the file)

    def save(self):
        with self.lock:
            write_atomic(LIBRARY, json.dumps(self.items, indent=1))

    # Whether a song's file is there is asked for every row drawn and every row again each time
    # the song changes: thousands of disk lookups at once, which on Windows (antivirus and all)
    # stalled the window for seconds. The answer is kept for a minute; playing asks the disk.
    SEEN_FOR = 60

    def has(self, vid):
        t = self.items.get(vid)
        if not t:
            return False
        seen, now = self._seen.get(vid), time.monotonic()
        if seen and seen[2] == t["file"] and now - seen[1] < self.SEEN_FOR:
            return seen[0]
        there = Path(t["file"]).exists()
        self._seen[vid] = (there, now, t["file"])
        return there

    def file(self, vid):
        t = self.items.get(vid)
        there = bool(t) and Path(t["file"]).exists()
        if t:
            self._seen[vid] = (there, time.monotonic(), t["file"])
        return t["file"] if there else None

    def is_flac(self, vid):
        return self.has(vid) and self.items[vid].get("format") == "flac"

    def add(self, track, path, art, fmt="", **extra):
        entry = {k: track.get(k) for k in ("id", "title", "artist", "album", "duration", "thumb")}
        entry.update({k: track[k] for k in ("source", "isrc", "apple", "spotify") if track.get(k)})
        old = self.items.get(track["id"], {})
        entry.update(file=str(path), art=str(art) if art else "", added=time.time(), format=fmt,
                     plays=old.get("plays", 0), last=old.get("last", 0), **extra)
        self.items[track["id"]] = entry
        self._seen.pop(track["id"], None)
        self.save()

    def by_tidal(self, tidal_id):
        """The saved FLAC of Tidal track tidal_id, whichever service it was saved from."""
        for t in list(self.items.values()):
            if t.get("tidal") == tidal_id and t.get("format") == "flac" and Path(t["file"]).exists():
                return t
        return None

    def find(self, query):
        """The saved song a typed query means ("artist title", "title by artist"…), or None."""
        q = norm(re.sub(r"\s+by\s+", " ", query, flags=re.I))
        if not q:
            return None
        best, best_score = None, 0.0
        for t in self.items.values():
            title, artist = norm(clean_title(t.get("title", ""))), norm(t.get("artist", ""))
            lead = norm(t.get("artist", "").split(",")[0])
            score = max(similar(q, title), similar(q, f"{lead} {title}"), similar(q, f"{title} {lead}"),
                        similar(q, f"{artist} {title}"))
            if title and (q == title or q.endswith(title) and lead and q.startswith(lead)):
                score = max(score, 0.97)
            if score > best_score:
                best, best_score = t, score
        return dict(best) if best and best_score >= 0.82 else None

    def played(self, vid):
        if vid in self.items:
            self.items[vid]["plays"] = self.items[vid].get("plays", 0) + 1
            self.items[vid]["last"] = time.time()
            self.save()

    def remove(self, vid):
        t = self.items.pop(vid, None)
        self._seen.pop(vid, None)
        if t:
            # The same recording saved from two services shares one file: keep it for the other.
            shared = {p for o in self.items.values() for p in (o.get("file"), o.get("art"))}
            for p in (t.get("file"), t.get("art")):
                if p and p not in shared:
                    Path(p).unlink(missing_ok=True)
                    if p == t.get("file"):
                        Path(p).with_suffix(".lrc").unlink(missing_ok=True)
            self.save()

    def mark_missing(self, vid, missing=True):
        with self.lock:
            if missing:
                self.missing[vid] = time.time()
            elif self.missing.pop(vid, None) is None:
                return
            write_atomic(MISSING, json.dumps(self.missing))

    def recently_missing(self, vid):
        return time.time() - self.missing.get(vid, 0) < RETRY_MISSING

    def lossy(self):
        """Songs saved before FLAC, to replace."""
        return [dict(t) for t in self.items.values() if t.get("format") != "flac"]

    def tracks(self):
        return sorted(self.items.values(), key=lambda t: (t.get("last", 0), t.get("added", 0)), reverse=True)

    def size_mb(self):
        """How much the downloads take up (worked out again at most once a minute: it asks the disk
        about every file, and My music shows it each time it opens)."""
        got = getattr(self, "_size", None)
        if got and got[0] == len(self.items) and time.time() - got[1] < 60:
            return got[2]
        total = 0
        for t in self.items.values():
            try:
                total += os.stat(t["file"]).st_size
            except OSError:
                pass
        self._size = (len(self.items), time.time(), total / 1e6)
        return self._size[2]

    def size_text(self):
        mb = self.size_mb()
        return f"{mb / 1000:.1f} GB" if mb >= 1000 else f"{mb:.0f} MB"


def slim(track):
    """A song as a playlist or the play history keeps it: enough to show and play it again."""
    return {k: track[k] for k in TRACK_KEYS if track.get(k) not in (None, "")}


# Seconds of a song (or half of a shorter one) before it counts as played.
PLAY_AFTER = 30
RECENT_SHOWN = 180   # Recently played: the last 180 songs; a new one pushes the oldest off the bottom


class Plays:
    """What you've played here, when last and how often: the Recently played and
    Most played lists. A song counts once you've listened to PLAY_AFTER seconds."""

    def __init__(self):
        self.items = read_json(PLAYS, {})   # id -> {"plays", "last", "track"}

    def add(self, track):
        e = self.items.get(track["id"]) or {"plays": 0}
        now = time.time()
        e.update(plays=e["plays"] + 1, last=now, track=slim(track), at=(e.get("at") or [])[-499:] + [round(now)])
        self.items[track["id"]] = e
        write_atomic(PLAYS, json.dumps(self.items))

    def recent(self, n=RECENT_SHOWN):
        rows = sorted(self.items.values(), key=lambda e: -e.get("last", 0))[:n]
        return [dict(e["track"]) for e in rows]

    def top(self, n=200):
        rows = sorted(self.items.values(), key=lambda e: (-e.get("plays", 0), -e.get("last", 0)))[:n]   # n None: all
        return [dict(e["track"], plays=e["plays"]) for e in rows]


class SongSpeeds:
    """The speed you picked for songs (Speed…): kept by song, so the same song from any
    service plays at it. pitch: whether the pitch moves with the speed, the way a sped-up
    edit sounds, or stays where it is."""
    LOW, HIGH = 0.5, 2.0

    def __init__(self):
        self.items = read_json(SONG_SPEEDS, {})   # "title|artist" -> {"speed", "pitch"}

    @staticmethod
    def key(t):
        return "|".join(song_key(t))

    def get(self, t):
        """(speed, pitch) the song plays at: (1.0, False) if you didn't change it."""
        e = self.items.get(self.key(t)) or {}
        return float(e.get("speed", 1.0)), bool(e.get("pitch", False))

    def set(self, tracks, speed, pitch=False):
        speed = round(min(self.HIGH, max(self.LOW, float(speed))), 2)
        for t in tracks:
            if speed == 1.0:
                self.items.pop(self.key(t), None)
            else:
                self.items[self.key(t)] = {"speed": speed, "pitch": bool(pitch)}
        write_atomic(SONG_SPEEDS, json.dumps(self.items, indent=1))


class Favorites:
    """The songs you starred, kept by song (the same song from any service is one favorite):
    the Favorites and Not favorited lists in the Music tab."""

    def __init__(self, path=None):
        self.path = path or FAVORITES
        self.items = read_json(self.path, {})   # "title|artist" -> {"track", "added"}

    @staticmethod
    def key(t):
        return "|".join(song_key(t))

    def has(self, t):
        return self.key(t) in self.items

    def set(self, tracks, on):
        for t in tracks:
            if on:
                self.items.setdefault(self.key(t), {"track": slim(t), "added": time.time()})
            else:
                self.items.pop(self.key(t), None)
        write_atomic(self.path, json.dumps(self.items, indent=1))

    def tracks(self):
        """Your favorites, the last one starred first."""
        return [dict(e["track"]) for e in sorted(self.items.values(), key=lambda e: -e.get("added", 0))]


# A song left with more than this much of it still to go was skipped; heard to here, it counts as heard out.
SKIP_LEFT = 15
MAX_QUEUES = 12   # queues kept to go back to (one for each list you played from), the oldest dropped


class SongStats:
    """How you take each song: how often you skipped it (went on to another with more than
    SKIP_LEFT seconds of it left) and how often you heard it to the end. Kept by song. Last.fm
    keeps no skips, so they're counted from the day this came in."""

    def __init__(self, path=None):
        self.path = path or SKIPS
        self.items = read_json(self.path, {})   # "title|artist" -> {"skips", "full", "last_skip", "track"}

    @staticmethod
    def key(t):
        return "|".join(song_key(t))

    def _bump(self, t, field):
        e = self.items.setdefault(self.key(t), {"skips": 0, "full": 0})
        e[field] = e.get(field, 0) + 1
        e["track"] = slim(t)
        now = time.time()
        if field == "skips":
            e["last_skip"] = now
        e[f"{field}_at"] = (e.get(f"{field}_at") or [])[-299:] + [round(now)]   # when: for Wrapped's weeks and months
        write_atomic(self.path, json.dumps(self.items))

    def habits(self, start, end, favorites=None):
        """For Wrapped: how you took songs between start and end (timestamps)."""
        rows = []
        for e in list(self.items.values()):
            if not e.get("track"):
                continue
            sk = sum(1 for x in e.get("skips_at") or [] if start <= x < end)
            fu = sum(1 for x in e.get("full_at") or [] if start <= x < end)
            if sk or fu:
                rows.append((dict(e["track"]), sk, fu))
        skips, full = sum(r[1] for r in rows), sum(r[2] for r in rows)
        never = sorted((r for r in rows if not r[1] and r[2] >= 2), key=lambda r: -r[2])
        most = sorted((r for r in rows if r[1]), key=lambda r: (-r[1], r[2]))
        favs = [e for e in (favorites.items.values() if favorites else []) if start <= e.get("added", 0) < end]
        return {"skips": skips, "full": full, "songs": len(rows), "never": never[:5], "never_count": len(never),
                "most_skipped": most[:5], "favs_added": len(favs),
                "favs": [dict(e["track"]) for e in sorted(favs, key=lambda e: -e.get("added", 0))][:5],
                "favs_total": len(favorites.items) if favorites else 0}

    def skipped(self, t):
        self._bump(t, "skips")

    def heard_out(self, t):
        self._bump(t, "full")

    def get(self, t):
        """(skips, times heard to the end)"""
        e = self.items.get(self.key(t)) or {}
        return e.get("skips", 0), e.get("full", 0)

    def rows(self, since=0):
        """[(track, skips, heard out)] of every song you've skipped or heard out (since: from then on)."""
        if not since:
            return [(dict(e["track"]), e.get("skips", 0), e.get("full", 0)) for e in self.items.values() if e.get("track")]
        out = []
        for e in self.items.values():
            if not e.get("track"):
                continue
            sk = sum(1 for x in e.get("skips_at") or [] if x >= since)
            fu = sum(1 for x in e.get("full_at") or [] if x >= since)
            if sk or fu:
                out.append((dict(e["track"]), sk, fu))
        return out

    @staticmethod
    def rate(skips, full):
        return skips / (skips + full) if skips + full else 0.0


class SongGains:
    """The volume boost you gave songs (Volume…), in dB: quiet unreleased songs, mostly. Kept by
    song; mpv adds it on top of the volume for that song only."""
    LOW, HIGH = -12.0, 12.0

    def __init__(self, path=None):
        self.path = path or SONG_GAINS
        self.items = read_json(self.path, {})   # "title|artist" -> dB

    @staticmethod
    def key(t):
        return "|".join(song_key(t))

    def get(self, t):
        try:
            return float(self.items.get(self.key(t), 0.0))
        except (TypeError, ValueError):
            return 0.0

    def set(self, tracks, db):
        db = round(min(self.HIGH, max(self.LOW, float(db))), 1)
        for t in tracks:
            if db == 0:
                self.items.pop(self.key(t), None)
            else:
                self.items[self.key(t)] = db
        write_atomic(self.path, json.dumps(self.items, indent=1))


class PlaylistFolders:
    """Folders you name in the Library, each holding playlists: yours (kind "mine") and your
    services' (kind "service", with the service's key). A playlist is in a folder once."""

    def __init__(self):
        self.items = read_json(PLAYLIST_FOLDERS, [])   # [{"id", "name", "playlists": [item]}]

    def save(self):
        write_atomic(PLAYLIST_FOLDERS, json.dumps(self.items, indent=1))

    def all(self):
        return sorted(self.items, key=lambda f: norm(f["name"]))

    def get(self, fid):
        return next((f for f in self.items if f["id"] == fid), None)

    def create(self, name):
        f = {"id": secrets.token_hex(6), "name": name, "playlists": []}
        self.items.append(f)
        self.save()
        return f

    def rename(self, fid, name):
        f = self.get(fid)
        if f:
            f["name"] = name
            self.save()

    def delete(self, fid):
        self.items = [f for f in self.items if f["id"] != fid]
        self.save()

    @staticmethod
    def item(pl, source=None):
        """What a folder keeps of a playlist: one of yours ({"id", "name", "tracks"}) or a service's."""
        if "tracks" in pl and "name" in pl:
            return {"kind": "mine", "source": "", "id": pl["id"], "title": pl["name"], "thumb": ""}
        return {"kind": "service", "source": pl.get("source") or source or "", "id": pl["id"],
                "title": pl.get("title") or "", "thumb": pl.get("thumb") or ""}

    @staticmethod
    def key(item):
        return f"{item['kind']}:{item['source']}:{item['id']}"

    def add(self, fid, item):
        """Put a playlist in the folder; False if it's there already."""
        f = self.get(fid)
        if not f or any(self.key(x) == self.key(item) for x in f["playlists"]):
            return False
        f["playlists"].append(item)
        self.save()
        return True

    def remove(self, fid, key):
        f = self.get(fid)
        if f:
            f["playlists"] = [x for x in f["playlists"] if self.key(x) != key]
            self.save()

    def forget(self, kind, source, pid):
        """A playlist of yours was deleted: out of every folder."""
        gone = f"{kind}:{source}:{pid}"
        for f in self.items:
            f["playlists"] = [x for x in f["playlists"] if self.key(x) != gone]
        self.save()


class Playlists:
    """The playlists you make here, kept on this computer. Each song is in a
    playlist once; adding it again is a no-op."""

    def __init__(self):
        self.items = read_json(PLAYLISTS, [])   # [{"id", "name", "created", "updated", "tracks"}]

    def save(self):
        write_atomic(PLAYLISTS, json.dumps(self.items, indent=1))

    def all(self):
        """Your playlists, the last changed first (the smart ones 1.4 made, by mood, are gone)."""
        return sorted((p for p in self.items if not p.get("smart")), key=lambda p: -p.get("updated", 0))

    def get(self, pid):
        return next((p for p in self.items if p["id"] == pid), None)

    def create(self, name):
        pl = {"id": secrets.token_hex(6), "name": name, "created": time.time(), "updated": time.time(), "tracks": []}
        self.items.append(pl)
        self.save()
        return pl

    def rename(self, pid, name):
        pl = self.get(pid)
        if pl:
            pl["name"], pl["updated"] = name, time.time()
            self.save()

    def delete(self, pid):
        self.items = [p for p in self.items if p["id"] != pid]
        self.save()

    def add(self, pid, tracks, at=None):
        """Add tracks to the end (or at index at); returns how many weren't in it already."""
        pl = self.get(pid)
        if not pl:
            return 0
        have = {t["id"] for t in pl["tracks"]}
        new = [slim(t) for t in tracks if t["id"] not in have and not have.add(t["id"])]
        if new:
            at = len(pl["tracks"]) if at is None else max(0, min(at, len(pl["tracks"])))
            pl["tracks"][at:at] = new
            pl["updated"] = time.time()
            self.save()
        return len(new)

    def remove(self, pid, ids):
        pl = self.get(pid)
        if pl:
            pl["tracks"] = [t for t in pl["tracks"] if t["id"] not in ids]
            pl["updated"] = time.time()
            self.save()


class LocalFiles:
    """The songs in your own folders (~/Music to start; more in the accounts
    menu), named from their tags. Tags are read once and again only when a file
    changes. The app's own downloads folder is left out: those songs are in the
    library already."""

    def __init__(self):
        self.files = read_json(LOCAL_INDEX, {}).get("files", {})   # path -> {"mtime", "size", "track"}
        self.scanned = 0.0
        self.scanning = False

    def tracks(self):
        return [dict(e["track"]) for e in list(self.files.values())]

    def scan(self, folders):
        """Walk the folders (blocking) and read the new and changed files. Returns
        whether anything changed. A file that turns up after the first scan was
        added now; on the first scan, when it was last written. (Songs downloaded into a
        folder of yours are read too; the Music tab lists each file once.)"""
        # os.scandir, not pathlib: on Windows a folder's listing brings each file's size and time with it,
        # and a rescan of thousands of unchanged songs is then a few milliseconds of work, not a long
        # stretch of Python (which the window had to wait through: it stuttered every couple of minutes).
        first, skip = not self.files, str(MUSIC.resolve())
        seen, changed = {}, False
        for folder in folders:
            root = Path(folder).expanduser()
            if not root.is_dir() or str(root.resolve()) == skip:
                continue
            todo = [str(root.resolve())]
            while todo:
                d = todo.pop()
                try:
                    entries = list(os.scandir(d))
                except OSError:
                    continue
                for e in entries:
                    name = e.name
                    try:
                        if e.is_dir():
                            if not name.startswith(".") and e.path != skip:
                                todo.append(e.path)
                            continue
                    except OSError:
                        continue
                    if os.path.splitext(name)[1].lower() not in AUDIO_EXT:
                        continue
                    try:
                        st = e.stat()
                    except OSError:
                        continue
                    key = e.path
                    old = self.files.get(key)
                    if old and old["mtime"] == st.st_mtime and old["size"] == st.st_size and "genre" in old["track"]:
                        seen[key] = old
                        continue
                    t = track_from_file(Path(key))
                    t["added"] = old["track"].get("added") if old else st.st_mtime if first else time.time()
                    seen[key] = {"mtime": st.st_mtime, "size": st.st_size, "track": t}
                    changed = True
        changed = changed or seen.keys() != self.files.keys()
        self.files = seen
        if changed:
            write_atomic(LOCAL_INDEX, json.dumps({"files": seen}))
        self.scanned = time.time()
        return changed


COVER_NAMES = ("cover.jpg", "folder.jpg", "front.jpg", "album.jpg", "cover.png", "folder.png", "front.png")


def file_cover(path):
    """The cover inside an audio file, else a cover.jpg (folder.jpg…) beside it, as bytes; None if neither."""
    try:
        import mutagen
        f = mutagen.File(path)
        pics = getattr(f, "pictures", None) if f is not None else None
        if pics:   # FLAC
            return pics[0].data
        tags = getattr(f, "tags", None)
        if tags:
            for k in list(tags.keys()):
                if str(k).startswith("APIC"):   # MP3
                    return tags[k].data
            if "covr" in tags:   # MP4 / M4A
                return bytes(tags["covr"][0])
            if "metadata_block_picture" in tags:   # Ogg Vorbis / Opus
                from mutagen.flac import Picture
                return Picture(base64.b64decode(tags["metadata_block_picture"][0])).data
    except Exception:  # noqa: BLE001 -- no cover in the file: look beside it
        pass
    # A cover.jpg (folder.jpg…) beside it: looked for by name, not by listing the folder (a folder of
    # thousands of songs was listed again for each of them, a long stall for the whole app).
    folder = os.path.dirname(str(path))
    found = _COVER_BESIDE.get(folder, False)
    if found is False:
        found = None
        for n in COVER_NAMES:
            for cand in (n, n.capitalize(), n.upper()):
                c = os.path.join(folder, cand)
                if os.path.isfile(c):
                    found = c
                    break
            if found:
                break
        _COVER_BESIDE[folder] = found
    if found:
        try:
            with open(found, "rb") as f:
                return f.read()
        except OSError:
            return None
    return None


