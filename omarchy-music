    def delete_songs_dialog(self, tracks):
        """Are you sure? before deleting the files of tracks."""
        a = self.app
        on_disk = [t for t in tracks if song_file(a.lib, t)]
        if not on_disk:
            self.toast("None of these songs has a file on this computer to delete")
            return
        downloads = sum(1 for t in on_disk if t["id"] in a.lib.items)
        mine = len(on_disk) - downloads
        what = f"“{on_disk[0]['title']}”" if len(on_disk) == 1 else f"{len(on_disk)} songs"
        body = []
        if downloads:
            body.append(f"{'Its' if len(on_disk) == 1 else str(downloads)} downloaded FLAC{'s' if downloads > 1 else ''}"
                        " will be deleted for good (you can download them again).")
        if mine:
            body.append(f"{'Its file' if len(on_disk) == 1 else f'{mine} file' + ('s' if mine > 1 else '')} in your folders"
                        " will go to the trash.")
        if len(on_disk) < len(tracks):
            left = len(tracks) - len(on_disk)
            body.append(f"{left} of the songs you picked {'has' if left == 1 else 'have'} no file here: {'it stays' if left == 1 else 'they stay'}.")
        dlg = Adw.AlertDialog(heading=f"Delete {what}?", body="\n".join(body))
        dlg.add_response("cancel", "Cancel")
        dlg.add_response("delete", "Delete")
        dlg.set_response_appearance("delete", Adw.ResponseAppearance.DESTRUCTIVE)
        dlg.set_default_response("cancel")
        dlg.set_close_response("cancel")

        def answered(_d, r):
            if r == "delete":
                a.delete_songs(on_disk)
                if self.selecting:
                    self.after_option()
        dlg.connect("response", answered)
        dlg.present(self)

