    return data[0].get("cover_xl") if data else None


def my_covers(app):
    """A finder of covers from your own songs: (artist, title or album, album=False) -> a picture's path, or ""."""
    songs, albums = {}, {}
    for t in app.my_songs():
        lead = norm(lead_artist(t.get("artist")))
        songs.setdefault((lead, norm(clean_title(t.get("title") or ""))), t)
        if t.get("album"):
            albums.setdefault((lead, norm(t["album"])), t)

    def find(artist, name, album=False):
        lead = norm(lead_artist(artist))
        t = (albums if album else songs).get((lead, norm(name if album else clean_title(name))))
        if not t:
            return ""
        e = app.lib.items.get(t["id"]) or {}
        path = e.get("art") or app.art.paths.get(t["id"])
        if path and Path(path).exists():
            return str(path)
        f = song_file(app.lib, t)
        if not f:
            return ""
        out = WRAPPED / "img" / ("mine-" + hashlib.sha1(str(f).encode()).hexdigest() + ".jpg")
        if out.exists():
            return str(out)
        data = file_cover(f)
        if not data:
            return ""
        write_file(out, data)
        return str(out)
    return find


def deezer_cover(artist, title):
