def widget_color(w):
    """A widget's CSS colour, as (r, g, b, a)."""
    try:
        c = w.get_color()
    except AttributeError:   # GTK before 4.10
        c = w.get_style_context().get_color()
    return c.red, c.green, c.blue, c.alpha


class Icon(Gtk.DrawingArea):
    """A drawn icon in its CSS colour (draw_icon)."""

    def __init__(self, name, size=22, **kw):
        kw.setdefault("content_width", size)
        kw.setdefault("content_height", size)
        super().__init__(can_target=False, **kw)
        self.name, self.size = name, size
        self.set_draw_func(self._draw)

    def set_name(self, name):
        if name != self.name:
            self.name = name
            self.queue_draw()

    def set_size(self, size):
        if size != self.size:
            self.size = size
            self.set_content_width(size)
            self.set_content_height(size)
            self.queue_draw()

    def _draw(self, _area, cr, w, h):
        cr.set_source_rgba(*widget_color(self))
        cr.translate((w - self.size) / 2, (h - self.size) / 2)
        draw_icon(cr, self.name, self.size)


def draw_button(icon, css, tip, cb, size=18):
    """A button with a drawn icon (b.icon), the same on every system."""
    b = Gtk.Button(child=Icon(icon, size), tooltip_text=tip)
    b.icon = b.get_child()
    b.add_css_class(css)
    b.connect("clicked", lambda *_: cb())
    return b


class Wave(Gtk.DrawingArea):
    """The seek bar as a waveform (its shape made up from the song's id: the same each time it plays).
    Click or drag on it to go there."""
    BARS = 64

    def __init__(self, win):
        super().__init__(content_height=52, hexpand=True)
        self.add_css_class("wave")
        self.win, self.pos, self.dur, self.drag = win, 0.0, 0.0, None
        self.bars = [0.5] * self.BARS
        self.set_draw_func(self._draw)
        click = Gtk.GestureClick(button=Gdk.BUTTON_PRIMARY)
        click.connect("released", lambda _g, _n, x, _y: self.drag is None and self._seek(x / max(self.get_width(), 1)))
        self.add_controller(click)
        drag = Gtk.GestureDrag(button=Gdk.BUTTON_PRIMARY)
        drag.connect("drag-begin", lambda _g, x, _y: self._drag_to(x))
        drag.connect("drag-update", lambda g, dx, _dy: self._drag_to(g.get_start_point()[1] + dx))
        drag.connect("drag-end", lambda *_: self._drag_end())
        self.add_controller(drag)
        self.set_cursor(Gdk.Cursor.new_from_name("pointer"))

    def set_song(self, vid):
        import random
        r = random.Random(vid or "")
        raw = [0.25 + r.random() * 0.75 for _ in range(self.BARS)]
        n = self.BARS
        self.bars = [max(0.15, min(1.0, (raw[max(i - 1, 0)] + raw[i] * 2 + raw[min(i + 1, n - 1)]) / 4)) for i in range(n)]
        self.queue_draw()

    def set_position(self, pos, dur):
        self.pos, self.dur = pos or 0.0, dur or 0.0
        if self.drag is None:
            self.queue_draw()

    def _drag_to(self, x):
        self.drag = min(max(x / max(self.get_width(), 1), 0.0), 1.0)
        self.win.np_times[0].set_label(fmt_time(self.drag * self.dur))
        self.queue_draw()

    def _drag_end(self):
        if self.drag is not None:
            f, self.drag = self.drag, None
            self._seek(f)

    def _seek(self, f):
        if self.dur > 0:
            self.win.on_seek(None, None, min(max(f, 0.0), 1.0) * self.dur)
            self.pos = f * self.dur
            self.queue_draw()

    def _draw(self, _area, cr, w, h):
        r, g, b, a = widget_color(self)
        frac = self.drag if self.drag is not None else (self.pos / self.dur if self.dur > 0 else 0.0)
        step = w / self.BARS
        bw = step * 0.55
        for i, v in enumerate(self.bars):
            bh = h * v
            x, y = i * step + (step - bw) / 2, (h - bh) / 2
            played = (i + 0.5) / self.BARS <= frac
            cr.set_source_rgba(r, g, b, a if played else 0.22)
            rad = bw / 2
            cr.new_sub_path()
            cr.arc(x + rad, y + rad, rad, 3.14159, 0)
            cr.arc(x + rad, y + bh - rad, rad, 0, 3.14159)
            cr.close_path()
            cr.fill()
        cr.set_source_rgba(r, g, b, a)
        cr.rectangle(frac * w - 1.5, 0, 3, h)
        cr.fill()


def art_widget(px):
    # Gtk.Image draws at exactly pixel_size; a Picture grows to the texture.
    pic = Gtk.Image(pixel_size=px)
    frame = Gtk.Box(overflow=Gtk.Overflow.HIDDEN, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER)
    frame.add_css_class("art")
    frame.set_size_request(px, px)
    frame.append(pic)
    return frame, pic


def split_artists(text):
    """The artists in a credit, as written: "A, B feat. C" -> [A, B, C]. "A & B"
    may be a duo's name, so it is offered whole and as each of them."""
    out = []
    for part in re.split(r",\s*|\s+(?:feat\.?|ft\.?|featuring|with)\s+", text or "", flags=re.I):
        part = part.strip()
        if not part or part.lower() == "unknown artist":
            continue
        out.append(part)
        if " & " in part:
            out += [p.strip() for p in part.split(" & ") if p.strip()]
    return list(dict.fromkeys(out))


def lead_artist(text):
    """The first artist in a credit, or "" (none, or "Unknown artist")."""
    return next(iter(split_artists(text)), "")


# An album's edition at the end of its name: "(Deluxe)", "[Deluxe Edition]", "(Extended)", "(10th Anniversary
# Edition)", " - Deluxe". Only deluxe, extended and anniversary ones (the owner's call): "(Sessions)", "(Bonus
# Track Version)", "(Expanded)"… are albums of their own.
EDITION_END = re.compile(r"\s*(?:[(\[]\s*([^)\]]{1,60}?)\s*[)\]]|\s[-–:]\s*([^-–:()\[\]]{1,60}?))\s*$")
EDITION_WORDS = re.compile(r"^(?:the\s+)?(?:[\w']+\s+){0,2}(?:deluxe|extended|anniversary|edition|expanded)(?:\s+[\w']+){0,2}$", re.I)   # "Full Moon Edition": any edition


def album_edition(album):
    """(the album's name without its edition, the edition) — ("Persona", "Extended") — or (album, "")."""
    album = (album or "").strip()
    m = EDITION_END.search(album)
    if m:
        inner = (m.group(1) or m.group(2) or "").strip()
        if EDITION_WORDS.match(inner) and not re.search(r"\bsessions?\b", inner, re.I) and album[:m.start()].strip():
            return album[:m.start()].strip(), inner
    return album, ""


REMIX_PART = re.compile(r"\s*[(\[][^)\]]*\b(?:re-?mix|rework|flip|bootleg)\b[^)\]]*[)\]]|\s[-–]\s[^-–]*\b(?:re-?mix|rework|flip|bootleg)\b.*$",
                        re.I)


def remix_of(title):
    """The song a remix is of ("Sorry I'm Late (Roosevelt Remix)" -> "Sorry I'm Late"), or "" if it isn't one."""
    t = title or ""
    if not REMIX_PART.search(t):
        return ""
    return REMIX_PART.sub("", t).strip()


PART_END = re.compile(r"\s*(?:[:,(\[]|\s[-–])?\s*\b(?:pt\.?|part)\s*(\d+|[ivx]+|one|two|three|four)\s*[)\]]?\s*$", re.I)
PART_WORDS = {"one": 1, "two": 2, "three": 3, "four": 4, "i": 1, "ii": 2, "iii": 3, "iv": 4, "v": 5}


def album_part(album):
    """(the album's name without its part, the part's number) — ("The Original Motion Picture Soundtrack", 2)
    for "…: Pt. 2" — or (album, 0)."""
    album = (album or "").strip()
    m = PART_END.search(album)
    if not m or not album[:m.start()].strip():
        return album, 0
    p = m.group(1).lower()
    return album[:m.start()].strip(" :-–,"), int(p) if p.isdigit() else PART_WORDS.get(p, 0) or 1


def is_ep(album):
    """An EP: "EP" as a word in its name ("South - EP", "Ruby EP", "Remote EP (Deluxe)")."""
    return bool(re.search(r"(?:^|[\s(\[-])EP\b", album or ""))


def is_single(album, title):
    """An album that's a single: named for its song ("Song", "Song - Single"), or called a single."""
    a = (album or "").strip()
    if not a:
        return False
    if re.search(r"\bsingles?\b", a, re.I):   # "Talk - Single", "RUN (Single)", "Singles Collection": the word anywhere
        return True
    return bool(title) and norm(clean_title(a)) == norm(clean_title(title))


def artist_key(text):
    """An artist credit as a key: its main artist, tidied ("Quinn XCII & Jeremy Zucker" = "Quinn XCII" =
    "quinnxcii"), as stats_key keys a song's artist."""
    return stats_key("", text)[1]


def main_artist(text, solo=()):
    """The main artist in a credit: the first one ("A, B" -> A; "A feat. B" -> A); "A & B" -> A when A is an
    artist on their own (in solo: names as artist_key gives them), else "A & B" (a duo: Simon & Garfunkel)."""
    lead = re.split(r"\s+(?:feat\.?|ft\.?|featuring|with)\s+", text or "", flags=re.I)[0].strip()
    first = re.split(r",|;", lead)[0].strip()
    if "," in lead and ";" not in lead and not re.search(r" & | x | X | and ", lead) and lead.count(",") == 1 \
            and re.sub(r"[\W_]+", "", norm(first)) not in solo:
        first = lead   # one name with a comma in it ("Tyler, The Creator"), unless its first part is an artist of its own
    for sep in (" & ", " x ", " X ", " and "):
        if sep in first:
            head = first.split(sep)[0].strip()
            if head and re.sub(r"[\W_]+", "", norm(head)) in solo:
                return head
    return first


def artist_link(win, text, css="sub"):
    """A label of artists' names; a click opens the artist's page (a choice of them for a few)."""
    lab = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END)
    lab.add_css_class(css)
    lab.set_cursor(pointer_cursor())
    click = Gtk.GestureClick(button=Gdk.BUTTON_PRIMARY)

    def pressed(gesture, _n, _x, _y):
        if lab.has_css_class("link") and not win.selecting:
            gesture.set_state(Gtk.EventSequenceState.CLAIMED)   # the row underneath doesn't play the song
            win.pick_artist(lab, lab.get_label())
    click.connect("pressed", pressed)
    lab.add_controller(click)
    set_link_text(lab, text)
    return lab


def set_link_text(lab, text):
    lab.set_label(text)
    link = names_artists(text)
    if getattr(lab, "is_link", None) is link:   # a recycled row's label: only the words change
        return
    if getattr(lab, "is_link", None) is None and not link:
        lab.is_link = link   # a new label, no names in it: nothing to undo (each GTK call here cost a row time)
        return
    lab.is_link = link
    (lab.add_css_class if link else lab.remove_css_class)("link")


@functools.lru_cache(maxsize=1)
def pointer_cursor():
    return Gdk.Cursor.new_from_name("pointer")   # once: looking it up by name per row was slow


@functools.lru_cache(maxsize=4096)
def names_artists(text):
    return bool(split_artists(text))


# Song lists are recycled the way the phone's are: a list of thousands of songs keeps a
# couple of dozen row widgets and fills them with whichever songs are in view. Making a row
# widget costs over a millisecond of Python (more on Windows), so lists that made one per
# song stuttered as you scrolled and stalled whenever a song started (every row updated).
# A TrackRow is a song's place in a list: cheap, no widget of its own; a TrackCell is the
# widget that shows whichever TrackRow is in view in its place.

class _Check:
    """A row's pick box while you select songs (drawn by its TrackCell when in view)."""

    def __init__(self, row):
        self.row, self.active, self.visible = row, False, False

    def get_active(self):
        return self.active

    def set_active(self, on):
        if on == self.active:
            return
        self.active = on
        self.row.win.set_selected(self.row, on)
        if self.row.cell:
            self.row.cell.show_check()
        tile = getattr(self.row, "tile", None)
        if tile is not None:
            (tile.add_css_class if on else tile.remove_css_class)("picked")

    def set_visible(self, on):
        self.visible = on
        if self.row.cell:
            self.row.cell.show_check()

    def get_visible(self):
        return self.visible


class TrackRow:
    """A song in a list: what it is, where it is, and how its row looks (playing, picked, its mark)."""

    def __init__(self, win, track, index, removable=False, in_queue=False, group=None, extra=""):
        self.win, self.track, self.index, self.in_queue = win, track, index, in_queue
        self.group = group   # the list of songs this row is one of: picking it plays on through them
        self.removable, self.extra = removable, extra
        self.classes = set()
        self.check = _Check(self)
        self.cell = None         # the TrackCell showing it, while it's in view
        self.list = None         # the SongList it's in
        self.mark_state = None   # worked out when it comes into view (it asks the disk)

    def get_parent(self):
        return self.list

    tile = None   # its tile, in a grid layout

    def add_css_class(self, name):
        self.classes.add(name)
        if self.cell:
            self.cell.add_css_class(name)
        if self.tile is not None:
            self.tile.add_css_class(name)

    def remove_css_class(self, name):
        self.classes.discard(name)
        if self.cell:
            self.cell.remove_css_class(name)
        if self.tile is not None:
            self.tile.remove_css_class(name)

    def has_css_class(self, name):
        return name in self.classes

    def mark_now(self):
        win, track, vid = self.win, self.track, self.track["id"]
        return ("file" if source_of(track) == "file" else "remove" if self.removable else "saved" if win.lib.has(vid)
                else "busy" if win.dl.busy(vid) else "missing" if win.lib.recently_missing(vid) else "download")

    def update_mark(self):
        """The mark at the end of the row: saved, saving, not on Tidal, or a download button.
        Out of view, it's worked out again when the row comes into view."""
        if not self.cell:
            self.mark_state = None
            return
        state = self.mark_now()
        if state != self.mark_state:
            self.mark_state = state
            self.cell.set_mark(state)

    def show_check(self, on, picked=False):
        self.check.set_visible(on)
        self.check.set_active(picked)


class TrackCell(Gtk.Box):
    """The widget a song list shows a song in; it shows one song after another as you scroll."""

    def __init__(self, win):
        super().__init__()
        self.win, self.row, self.binding, self.shown_classes, self.mark = win, None, False, set(), None
        Gtk.Box.add_css_class(self, "song")
        menu = Gtk.GestureClick(button=Gdk.BUTTON_SECONDARY)   # right-click: play next, add to queue…
        menu.connect("pressed", lambda _g, _n, x, y: self.row and win.track_menu(self.row, x, y))
        self.add_controller(menu)
        ctrl = Gtk.GestureClick(button=Gdk.BUTTON_PRIMARY)     # Ctrl+click: select it; Shift+click: up to it
        ctrl.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)   # before the tick box takes a Shift+click on it
        ctrl.connect("pressed", self.on_press)
        self.add_controller(ctrl)
        box = Gtk.Box(spacing=10)
        self.check = Gtk.CheckButton(valign=Gtk.Align.CENTER, visible=False)
        self.check.add_css_class("pick")
        self.check.connect("toggled", self.on_check)
        box.append(self.check)
        frame, self.pic = art_widget(42)
        box.append(frame)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER, hexpand=True)
        self.title = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END)
        self.title.add_css_class("title")
        sub = Gtk.Box()
        self.artist = artist_link(win, "")
        sub.append(self.artist)
        self.more = Gtk.Label(xalign=0)
        self.more.add_css_class("sub")
        sub.append(self.more)
        text.append(self.title)
        text.append(sub)
        box.append(text)
        self.dur = Gtk.Label(valign=Gtk.Align.CENTER)   # its length, at the end of the row
        self.dur.add_css_class("dur")
        box.append(self.dur)
        self.box = box
        self.append(box)

    def bind(self, row):
        if row.cell is not None and row.cell is not self:
            row.cell.row = None
        self.row, row.cell = row, self
        t = row.track
        self.title.set_label(t["title"])
        set_link_text(self.artist, t["artist"])
        rest = f" · {row.extra}" if row.extra else ""
        self.dur.set_label(fmt_time(t["duration"]) if t.get("duration") else "")
        self.more.set_label(rest)
        self.more.set_visible(bool(rest))
        self.pic.clear()
        self.win.art.apply(self.pic, t)
        for c in self.shown_classes - row.classes:
            self.remove_css_class(c)
        for c in row.classes - self.shown_classes:
            self.add_css_class(c)
        self.shown_classes = set(row.classes)
        self.show_check()
        row.mark_state = None
        row.update_mark()

    def unbind(self):
        if self.row is not None and self.row.cell is self:
            self.row.cell = None
        self.row = None

    def add_css_class(self, name):
        self.shown_classes.add(name)
        super().add_css_class(name)

    def remove_css_class(self, name):
        self.shown_classes.discard(name)
        super().remove_css_class(name)

    def show_check(self):
        self.binding = True
        self.check.set_visible(self.row.check.visible if self.row else False)
        self.check.set_active(self.row.check.active if self.row else False)
        self.binding = False

    def set_mark(self, state):
        """The mark for state, made once per cell and reused (its buttons act on the song shown)."""
        if self.mark is not None:
            self.box.remove(self.mark)
        if not hasattr(self, "marks"):
            self.marks = {}
        mark = self.marks.get(state, False)
        if mark is False:
            mark = self.marks[state] = self.make_mark(state)
        self.mark = mark
        if mark is not None:
            self.box.append(mark)

    def make_mark(self, state):
        win = self.win
        if state == "remove":
            mark = icon_button("user-trash-symbolic", "row-action", "Remove download",
                               lambda: self.row and win.remove_download(self.row.track["id"]))
        elif state == "saved":
            mark = Gtk.Label(label="✓", tooltip_text="Downloaded: plays without data")
            mark.add_css_class("saved")
        elif state == "busy":
            mark = Adw.Spinner()
        elif state == "missing":
            mark = Gtk.Label(label="–", tooltip_text="No lossless copy on Tidal: skipped")
            mark.add_css_class("pending")
        elif state == "download":
            mark = icon_button("folder-download-symbolic", "row-action", "Download in FLAC",
                               lambda: self.row and win.download_only(self.row.track))
        else:
            mark = None
        return mark

    def on_check(self, c):
        """Its tick box ticked by hand: picked, and where a Shift+click picks from."""
        if self.binding or not self.row:
            return
        self.row.check.set_active(c.get_active())
        if c.get_active():
            self.win.anchor = self.row.index

    def on_press(self, gesture, _n, _x, _y):
        row = self.row
        state = gesture.get_current_event_state()
        if row and state & (Gdk.ModifierType.CONTROL_MASK | Gdk.ModifierType.SHIFT_MASK) and row.group is not None:
            gesture.set_state(Gtk.EventSequenceState.CLAIMED)
            self.win.start_selecting(row, extend=bool(state & Gdk.ModifierType.SHIFT_MASK))


class _Entry:
    """One place in a SongList: a song (TrackRow), a widget, or what makes a widget when it's first seen."""
    __slots__ = ("thing", "build", "text", "tile")

    def __init__(self, thing, build=None, text=None, tile=False):
        self.thing, self.build = thing, build
        self.text, self.tile = text, tile   # what the tab's search finds it by before it's made; a tile in a grid


class SongList(Gtk.ListView):
    """A list of songs (and the headings, buttons and playlists among them) that makes only the
    rows in view. It takes what a Gtk.ListBox was given: append(row), remove_all()."""

    def __init__(self, win, on_activate):
        # The model is only the places' numbers, as strings (made in C, a GObject only for the
        # few places in view); what's in each place is self.entries[n].
        self.store = Gtk.StringList()
        factory = Gtk.SignalListItemFactory()
        factory.connect("bind", self._bind)
        factory.connect("unbind", self._unbind)
        factory.connect("teardown", self._teardown)
        super().__init__(model=Gtk.NoSelection(model=self.store), factory=factory, single_click_activate=True)
        self.win, self.entries, self.waiting, self.flushing = win, [], [], 0
        self.full, self.filter_q = [], ""   # everything appended; what's shown is what matches the tab's search
        self.layout, self.per_row, self.on_activate = "list", 0, on_activate   # "grid", "compact": songs as tiles
        self.replacing = None   # emptied, and not yet filled again: how many places to take out then
        self.connect("activate", lambda _v, pos: self._activate(pos, on_activate))

    # ---- what's in it ----
    def append(self, thing):
        """A TrackRow, or any widget (it's shown as it is)."""
        self._add(_Entry(thing))

    def append_lazy(self, build, text=None, tile=False):
        """A widget made by build() when it first comes into view (headings in a long list). text: what the
        tab's search finds it by (it can't look inside a row not made yet); tile: a PlaylistRow, a tile in a grid."""
        self._add(_Entry(None, build, text, tile))

    @staticmethod
    def _text(thing):
        if isinstance(thing, TrackRow):
            t = thing.track
            return " ".join(str(t.get(k) or "") for k in ("title", "artist", "album"))
        pl = getattr(thing, "playlist", None)
        if pl:
            return f"{pl.get('title', '')} {pl.get('sub') or ''}"
        return None

    def _matches(self, entry):
        q = self.filter_q
        if not q:
            return True
        if getattr(entry.thing, "account_action", None):   # ‹ Back and the like stay
            return True
        text = entry.text if entry.thing is None else self._text(entry.thing)
        if text is None and entry.text is not None:
            text = entry.text
        return text is not None and all(w in norm(text) for w in q.split())

    TILE = {"grid": 148, "compact": 112}   # the covers' size in a grid; the gap between tiles below
    GAP = {"grid": 22, "compact": 12}

    def set_layout(self, layout):
        """list: a row a song; grid / compact: the songs and lists as tiles of their covers, in rows."""
        layout = layout if layout in self.TILE else "list"
        if layout == self.layout:
            return
        self.layout, self.per_row = layout, 0
        for e in self.full:
            if isinstance(e.thing, TrackRow):
                e.thing.tile = None
        self.regroup()

    def room(self):
        """How wide the list may be: its scrolled window's width, which the window sets (the list's own
        width follows its rows, so going by it let a row of tiles widen the window, and that make
        another tile fit, and so on: the window grew off the screen)."""
        sw = self.get_ancestor(Gtk.ScrolledWindow)
        width = (sw.get_width() if sw else 0) or self.get_width()
        return width or (self.win.get_width() - (300 if self.win.split.get_show_sidebar() else 0))

    def tiles_per_row(self):
        size, gap = self.TILE[self.layout], self.GAP[self.layout]
        return max(2, (max(self.room(), 320) - 36 + gap) // (size + gap))

    def do_size_allocate(self, w, h, baseline):
        Gtk.ListView.do_size_allocate(self, w, h, baseline)
        if self.layout != "list" and self.per_row and getattr(self, "_regroup_soon", 0) == 0 \
                and self.tiles_per_row() != self.per_row:
            def later():   # once the size has settled (a resize sends many sizes)
                self._regroup_soon = 0
                if self.tiles_per_row() != self.per_row:
                    self.regroup()
                return False
            self._regroup_soon = GLib.timeout_add(120, later)

    def regroup(self):
        """The places again, from everything appended: tiles grouped into rows as wide as the list."""
        if self.flushing:
            GLib.source_remove(self.flushing)
            self.flushing = 0
        old = self.store.get_n_items()
        shown = [e for e in self.full if self._matches(e)]
        if self.layout != "list":
            self.per_row = k = self.tiles_per_row()
            out, run = [], []

            def close():
                for i in range(0, len(run), k):
                    chunk = run[i:i + k]
                    out.append(_Entry(None, lambda chunk=chunk: self.tile_row([made(e) for e in chunk])))
                run.clear()

            def made(e):   # an album, genre or folder made when its row of tiles comes into view (all at once froze it)
                if e.thing is None and e.build:
                    e.thing, e.build = e.build(), None
                return e.thing
            for e in shown:
                if (e.thing is None and e.tile) or isinstance(e.thing, (TrackRow, PlaylistRow)):
                    run.append(e)
                else:
                    close()
                    out.append(e)
            close()
            shown = out
        self.entries, self.waiting, self.replacing = shown, [], None
        self.store.splice(0, old, [str(i) for i in range(len(self.entries))])

    def tile_row(self, things):
        box = Gtk.Box(spacing=self.GAP[self.layout], halign=Gtk.Align.START, hexpand=False)
        box.set_overflow(Gtk.Overflow.HIDDEN)
        box.add_css_class("tile-row")
        box.add_css_class(self.layout)
        for t in things:
            box.append(self.tile(t))
        return box

    def tile(self, thing):
        """A song (or a list) as its cover, its name and a line under it, the size of the layout."""
        win, size = self.win, self.TILE[self.layout]
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        frame, pic = art_widget(size)
        col.append(frame)
        if isinstance(thing, TrackRow):
            t = thing.track
            win.art.apply(pic, t, 320)
            title, sub = t["title"], t["artist"]
            more = thing.extra
        else:
            pl = thing.playlist
            if thing.cover:
                win.art.apply(pic, thing.cover, 320)
            elif pl.get("thumb"):
                win.art.apply(pic, {"id": "pl-" + pl["id"], "thumb": pl["thumb"]}, 320)
            else:
                pic.set_from_icon_name(thing.icon)
                pic.set_pixel_size(size // 3)
            n = pl.get("count")
            title = pl["title"]
            sub = pl.get("sub") or (f"{n} song{'s' if n != 1 else ''}" if n not in ("", None) else "")
            more = pl.get("more") or ""   # a tile: the plays on their own line, under the artist
        for text, css in ((title, "tile-title"), (sub, "tile-sub"), (more, "tile-more")):
            if text:
                # Ellipsized, with no width of its own: wider letters (Windows' fonts, scaling) can't
                # make a tile, and so the row and the window, wider than the cover.
                lab = Gtk.Label(label=text, xalign=0, ellipsize=Pango.EllipsizeMode.END, max_width_chars=1)   # the tile's width
                lab.add_css_class(css)
                col.append(lab)
        b = Gtk.Button(child=col, tooltip_text=" · ".join(x for x in (title, sub, more) if x))
        b.add_css_class("flat")
        b.add_css_class("tile")
        b.set_size_request(size, -1)
        col.set_size_request(size, -1)
        if isinstance(thing, TrackRow):
            thing.tile = b
            for c in thing.classes:
                b.add_css_class(c)
            if thing.check.active:
                b.add_css_class("picked")
        elif getattr(thing, "group_tick", None) is not None:   # Select in Albums: ticked, it shows picked
            thing.tile = b
            if thing.group_tick.get_active():
                b.add_css_class("picked")
            thing.group_tick.connect("notify::active", lambda c, _p: (b.add_css_class if c.get_active() else b.remove_css_class)("picked"))

        def clicked(_b):
            if isinstance(thing, TrackRow) and win.selecting:
                win.select_list = self
                thing.check.set_active(not thing.check.active)
            else:
                self.on_activate(thing)
        b.connect("clicked", clicked)
        menu = Gtk.GestureClick(button=Gdk.BUTTON_SECONDARY)
        if isinstance(thing, TrackRow):
            menu.connect("pressed", lambda _g, _n, x, y: win.track_menu(thing, x, y, anchor=b))
        else:
            menu.connect("pressed", lambda _g, _n, x, y: win.playlist_row_menu(thing, x, y, anchor=b))
        b.add_controller(menu)
        return b

    def set_filter(self, q):
        """Show only the rows whose song (title, artist, album) or list name has every word of q."""
        q = norm(q or "")
        if q == self.filter_q:
            return
        self.filter_q = q
        if self.layout != "list":
            self.regroup()
            return
        if self.flushing:
            GLib.source_remove(self.flushing)
            self.flushing = 0
        old = self.store.get_n_items()
        self.entries = [e for e in self.full if self._matches(e)]
        self.waiting, self.replacing = [], None
        self.store.splice(0, old, [str(i) for i in range(len(self.entries))])

    def _add(self, entry):
        if isinstance(entry.thing, TrackRow):
            entry.thing.list = self
        self.full.append(entry)
        if not self._matches(entry):
            return
        self.entries.append(entry)
        self.waiting.append(entry)
        if not self.flushing:   # into the list in one go, before the next frame
            self.flushing = GLib.idle_add(self._flush_soon, priority=GLib.PRIORITY_HIGH_IDLE)

    def _flush_soon(self):
        self.flushing = 0
        self.flush()
        return False

    def flush(self):
        """What was appended, into the list now. After remove_all, the old places go in the same step
        as the new ones come: the list then shows the new songs in the row widgets it has, instead of
        throwing them away and making a couple of hundred new ones (most of a list switch's time)."""
        if self.flushing:
            GLib.source_remove(self.flushing)
            self.flushing = 0
        if self.layout != "list":
            if self.replacing is not None or self.waiting:
                self.regroup()
            return
        if self.replacing is not None:
            old, self.replacing = self.replacing, None
            self.waiting = []
            self.store.splice(0, old, [str(i) for i in range(len(self.entries))])
            return
        if self.waiting:
            n = self.store.get_n_items()
            count, self.waiting = len(self.waiting), []
            self.store.splice(n, 0, [str(i) for i in range(n, n + count)])

    def remove_all(self):
        for e in self.full:
            if isinstance(e.thing, TrackRow):
                e.thing.list = None
        self.entries, self.waiting, self.full = [], [], []
        if self.replacing is None:
            self.replacing = self.store.get_n_items()
        if not self.flushing:   # emptied for good, unless something is appended before then
            self.flushing = GLib.idle_add(self._flush_soon, priority=GLib.PRIORITY_HIGH_IDLE)

    def is_empty(self):
        return not self.entries

    def track_rows(self):
        return [e.thing for e in self.entries if isinstance(e.thing, TrackRow)]

    # ---- showing it ----
    def _bind(self, _f, item):
        i = int(item.get_item().get_string())
        if i >= len(self.entries):   # an old place, about to be replaced (flush)
            return
        entry = self.entries[i]
        if isinstance(entry.thing, TrackRow):
            cell = item.get_child()
            if not isinstance(cell, TrackCell):   # this place showed a heading before (or nothing): a row widget
                pool = SongList.cells
                cell = pool.pop() if pool else TrackCell(self.win)
                item.set_child(cell)
            cell.bind(entry.thing)
            item.set_activatable(True)
            return
        if entry.thing is None and entry.build:
            entry.thing, entry.build = entry.build(), None
        widget = entry.thing
        holder = getattr(widget, "holder", None)
        if holder is not None and holder is not item and holder.get_child() is widget:
            holder.set_child(None)   # still in the place it was shown in before: out of it first
        widget.holder = item
        if isinstance(widget, Gtk.ListBoxRow):
            widget.set_focusable(False)   # the list's place takes the focus, not a ListBoxRow outside a ListBox
        item.set_child(widget)
        item.set_activatable(widget.get_activatable() if isinstance(widget, Gtk.ListBoxRow) else False)

    cells = []   # row widgets of places GTK let go of, for the next ones (making one took about a millisecond)

    def _teardown(self, _f, item):
        child = item.get_child()
        if isinstance(child, TrackCell):
            child.unbind()
            item.set_child(None)
            if len(SongList.cells) < 400:
                SongList.cells.append(child)

    def _unbind(self, _f, item):
        child = item.get_child()
        if isinstance(child, TrackCell):
            child.unbind()
            return
        if child is not None and getattr(child, "holder", None) is item:
            child.holder = None
            item.set_child(None)

    def _activate(self, pos, on_activate):
        self.flush()
        if pos >= self.store.get_n_items():
            return
        thing = self.entries[pos].thing
        if thing is not None:
            on_activate(thing)


class PlaylistRow(Gtk.ListBoxRow):
    """A playlist (or an album on an artist's page): its cover, name and size."""

    def __init__(self, win, playlist, cover=None, icon="starred-symbolic"):
        super().__init__()
        self.playlist, self.cover, self.icon = playlist, cover, icon
        self.win, self.filled = win, False
        # Its insides made when it's first shown: in a grid only its tile is (hundreds of albums at once froze it).
        self.connect("realize", lambda *_: self.fill())

    def fill(self):
        if self.filled:
            return
        self.filled = True
        win, playlist, cover, icon = self.win, self.playlist, self.cover, self.icon
        box = Gtk.Box(spacing=10)
        frame, pic = art_widget(42)
