    def in_music(self, path):
        """A path as it is inside your music folders ("Quinn XCII/Change of Scenery II"), else short_path's."""
        p = str(path)
        for r in self.app.folders:
            r = str(Path(r))
            if p == r:
                return Path(r).name
            if p.startswith(r + os.sep):
                return p[len(r) + 1:].replace(os.sep, "/")
        return short_path(p)

    def fixup_start(self):
        """Fix albums and artists: scan, check the tags to change, write them, check the files to move, move
        them, and say what was done."""
        a = self.app
        if not a.folders and not a.lib.items:
            self.toast("Add your music folders first (Settings › Library & playback › Folders)")
            return
        dlg, body, status = self.work_dialog("Fix albums and artists", full=True)
        status.set_label("Reading your songs' tags…")
        spin = Gtk.Spinner(spinning=True, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER, vexpand=True)
        spin.set_size_request(32, 32)
        body.append(spin)
        log = []

        def progress(text):
            GLib.idle_add(lambda: (status.set_label(text), False)[1])

        def scanned(res, err):
            if err is not None:
                status.set_label(f"Couldn't scan: {str(err)[:200]}")
                self.clear_box(body)
                return
            changes, songs = res
            n_skip = getattr(a, "fixup_skipped", 0)
            skipped = (f" ({n_skip} more in folders you leave alone, left as they are.)" if n_skip else "")
            if not changes:
                self.report(body, status, "Nothing to fix: no split albums, editions or singles to put on their albums."
                            + skipped, [], dlg.close)
                return
            kinds = Counter(k for c in changes if not c.get("unfound") for k in c["kinds"])
            kinds["unfound"] = sum(1 for c in changes if c.get("unfound"))
            status.set_label(f"{len(changes)} song{'s' if len(changes) != 1 else ''} to fix: "
                             + ", ".join(f"{n} {w}" for w, n in (("for featured artists", kinds["artist"]),
                                                                 ("for deluxe editions", kinds["edition"]),
                                                                 ("single" + ("s" if kinds["single"] != 1 else "") + " onto albums",
                                                                  kinds["single"]),
                                                                 ("remix" + ("es" if kinds["remix"] != 1 else "") + " onto their song's album",
                                                                  kinds["remix"]),
                                                                 ("from “Pt. 1”, “Pt. 2”… albums onto the one album with no part in its name", kinds["parts"]),
                                                                 ("onto an album with the same cover", kinds["cover"]),
                                                                 ("single" + ("s" if kinds["unfound"] != 1 else "") + " with no album or EP of "
                                                                  "yours found (left alone unless you pick one with Other album)", kinds["unfound"])) if n)
                             + ". Untick the ones to leave alone, then Apply." + skipped)
            rows = []
            for c in changes:
                old, new = c["old"], c["new"]
                lines = [self.in_music(c["file"])]
                for k, label in (("artist", "Artist"), ("albumartist", "Album artist"), ("album", "Album"), ("tracknumber", "Track")):
                    if k in new:
                        lines.append(f"{label}: {old[k] or '(none)'}  →  {new[k] or '(none)'}")
                if c.get("cover"):
                    lines.append("Cover: the album's, if it has none of its own")
                if c.get("unsure"):
                    lines.append("Not sure which of them is the main one: left alone unless you pick Change or Other artist")
                if c.get("unfound"):
                    lines.append(f"Album: {old['album']}  (a single: no album or EP of yours found for it)")
                    lines.append("Other album: pick the album or EP it goes on, or type one (yours are suggested)")
                elif fixup_album_row(c):
                    lines.append("Other album: this song onto the album you pick instead")
                else:
                    lines.append("Other artist: " + ("the whole album under the artist you pick instead" if c.get("group") is not None
                                                     else "this song under the artist you pick instead"))
                rows.append((c["title"], lines))
            on_it = collections.defaultdict(set)
            for t in songs:
                if t.get("album"):
                    on_it[t["album"]].add(t.get("title") or "")

            def not_single(name):   # albums and EPs only to pick from: never a single
                return not re.search(r"\bsingles?\b", name, re.I) and not (
                    len(on_it[name]) == 1 and is_single(name, next(iter(on_it[name]))))
            album_names = sorted({t.get("album") for t in songs if t.get("album") and not_single(t["album"])}, key=norm)
            by_artist = collections.defaultdict(set)
            for t in songs:
                if t.get("album") and not_single(t["album"]):
                    by_artist[artist_key(t.get("albumartist") or t.get("artist"))].add(t["album"])

            def album_alt(c):
                old = c["old"]["album"]
                planned = c["new"].get("album") or old
                theirs = sorted(by_artist.get(artist_key(c["old"]["albumartist"] or c["old"]["artist"]), ()), key=norm)
                names = list(dict.fromkeys([planned] + theirs + ([old] if old and not_single(old) else [])))
                return ("al:" + norm(planned), names, "Other album", album_names)
            alts = [album_alt(c) if fixup_album_row(c) else (c.get("group"), c.get("others") or []) for c in changes]
            defaults = [not c.get("unsure") and not c.get("unfound") for c in changes]
            yours = sorted({n for t in songs for cr in (t.get("artist"), t.get("albumartist")) for n in own_artists(cr)
                            if norm(n) not in VARIOUS}, key=norm)
            self.choices(body, rows, "Change", "Leave alone", "Apply",
                         lambda picked: apply(fixup_with_others(changes, picked), songs),
                         alts=alts, alt_label="Other artist", own_names=yours, defaults=defaults)

        def apply(chosen, songs):
            if not chosen:
                self.report(body, status, "Nothing changed: every song was left alone.", [], dlg.close)
                return
            self.clear_box(body)
            body.append(Gtk.Spinner(spinning=True, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER, vexpand=True))
            status.set_label(f"Writing the tags of {len(chosen)} songs…")

            def written(res, err):
                done, failed = res or (0, [str(err)])
                bad = {f.split(":")[0] for f in failed}
                for c in chosen:
                    if Path(c["file"]).name not in bad:
                        log.append(f"{c['title']}: " + "; ".join(f"{k} {c['old'][k] or '(none)'} → {v or '(none)'}" for k, v in c["new"].items()))
                log.extend(f"Couldn't change {f}" for f in failed)
                a.refresh_everywhere()
                moves = fixup_moves(chosen, songs, a.folders, a.fixup_skip)
                if not moves:
                    finish(done, 0)
                    return
                status.set_label(f"Tags written for {done} songs. Move {len(moves)} of their files into the right folders "
                                 "too? (Files already there are never replaced.)")
                rows = [(Path(src).name, [f"From  {self.in_music(Path(src).parent)}", f"To      {self.in_music(Path(dst).parent)}"])
                        for src, dst in moves]
                self.choices(body, rows, "Move", "Leave alone", "Move",
                             lambda picked: move([m for m, p in zip(moves, picked) if p], done))
            in_thread(a.fixup_apply, chosen, done=written)

        def move(chosen, tagged):
            if not chosen:
                finish(tagged, 0)
                return
            self.clear_box(body)
            body.append(Gtk.Spinner(spinning=True, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER, vexpand=True))
            status.set_label(f"Moving {len(chosen)} files…")

            def moved(res, err):
                n, failed = res or (0, [str(err)])
                bad = {f.split(":")[0] for f in failed}
                log.extend(f"Moved {Path(s).name}: {self.in_music(Path(s).parent)} → {self.in_music(Path(d).parent)}"
                           for s, d in chosen if Path(s).name not in bad)
                log.extend(f"Couldn't move {f}" for f in failed)
                a.refresh_everywhere()
                finish(tagged, n)
            in_thread(a.move_files, chosen, done=moved)

        def finish(tagged, moved):
            self.report(body, status, f"Done: {tagged} song{'s' if tagged != 1 else ''} fixed"
                        + (f", {moved} file{'s' if moved != 1 else ''} moved" if moved else "")
                        + ". Empty folders left behind can go with Settings › Empty folders.", log, dlg.close)
        in_thread(a.fixup_scan, progress, done=scanned)

    def tagscan_start(self, fresh=False):
        """Settings › Tagger › Scan…: your songs' tags checked against Deezer, an album at a time; each tag
        Replace or Keep, each cover one of three found or Keep; then written, and what was done said."""
        a = self.app
        every = list(dict.fromkeys(p for p in (song_file(a.lib, t) for t in a.my_songs()) if p))
        if not every:
            self.toast("No songs to scan: add your music folders (Settings › Library & playback › Folders)")
            return
        record = a.tagscan_done
        if fresh:
            record.forget()
        every = [f for f in every if not in_folders(f, a.fixup_skip)]   # Folders to leave alone: never scanned
        files = [f for f in every if not record.done(f)]   # only the new ones and the ones changed since
        skipped = len(every) - len(files)
        dlg, body, status = self.work_dialog("Scan tags", full=True)
        if not files:
            self.report(body, status, f"All {len(every):,} songs were checked before and haven't changed since: "
                                      "nothing new to scan. (Settings › Tagger › Scan all again checks every one.)", [], dlg.close)
            return
        status.set_label(f"Checking {len(files):,} songs' tags against Deezer…"
                         + (f" ({skipped:,} checked before and unchanged: skipped)" if skipped else ""))
        bar = Gtk.ProgressBar(show_text=True, valign=Gtk.Align.CENTER, vexpand=True)
        body.append(bar)
        alive = [True]
        dlg.connect("close-request", lambda *_: (alive.__setitem__(0, False), False)[1])

        def progress(i, n):
            if not alive[0]:
                raise RuntimeError("closed")
            if i % 5 == 0:
                GLib.idle_add(lambda: (bar.set_fraction(i / max(n, 1)), bar.set_text(f"{i:,} of {n:,} songs"), False)[2])

        def covers(artist, album, found):
            more = list(found)
            more += a.tried_quiet(deezer_album_covers, artist, album) or []
            if len(dict.fromkeys(more)) < 3:
                more += [c["url"] for c in (a.tried_quiet(a.pictures.cover_choices, artist, album) or [])]
            return list(dict.fromkeys(more))

        failed = set()

        def scanned(groups, err):
            if not alive[0]:
                return
            if err is not None:
                status.set_label(f"Couldn't scan: {str(err)[:200]}")
                self.clear_box(body)
                return
            offered = {f for g in groups for f in g["files"]}
            record.mark([f for f in files if f not in offered and f not in failed])   # nothing to offer: checked, done
            if failed and len(failed) == len(files):
                self.report(body, status, "Couldn't reach Deezer: nothing was checked. Try again in a while.", [], dlg.close)
                return
            if not groups:
                self.report(body, status, f"All {len(files):,} songs' tags look right: nothing missing, nothing to change.", [], dlg.close)
                return
            self.tagscan_review(dlg, body, status, groups)
        in_thread(lambda: tag_scan_plan(files, deezer_find_track, deezer_album_info, covers, progress, failed=failed), done=scanned)

    def tagscan_review(self, dlg, body, status, groups):
        """The scan's findings: an album a card, its tags (Replace or Keep) and its cover (one of those found, or Keep)."""
        a = self.app
        n_songs = sum(len(g["songs"]) for g in groups)
        n_covers = sum(1 for g in groups if g["covers"])
        status.set_label(f"{len(groups)} albums to look at: {n_songs:,} songs with tags missing or different"
                         + (f", {n_covers} albums with no cover or a small one" if n_covers else "")
                         + ". Missing tags are ticked to Replace, different ones to Keep: change what you like, then Apply.")
        self.clear_box(body)
        lst = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        lst.add_css_class("tracks")
        ticks = []      # (CheckButton, [(file, field)])
        cover_picks = {}   # folder -> [(ToggleButton, url or None)]

        def tick(label, keys, on, box):
            c = Gtk.CheckButton(label=label, active=on)
            c.get_last_child().set_wrap(True) if isinstance(c.get_last_child(), Gtk.Label) else None
            box.append(c)
            ticks.append((c, keys))

        def card(g):
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=3, margin_top=8, margin_bottom=8)
            head = Gtk.Label(label=f"{g['album'] or 'Unknown album'} — {g['artist'] or 'Unknown artist'}", xalign=0,
                             ellipsize=Pango.EllipsizeMode.END)
            head.add_css_class("title")
            col.append(head)
            where = Gtk.Label(label=self.in_music(g["folder"]), xalign=0, ellipsize=Pango.EllipsizeMode.MIDDLE)
            where.add_css_class("sub")
            col.append(where)
            if g["covers"]:
                row = Gtk.Box(spacing=10, margin_top=4)
                lab = Gtk.Label(label=f"Cover ({g['cover_note'].lower()}):", valign=Gtk.Align.CENTER)
                lab.add_css_class("sub")
                row.append(lab)
                group, opts = None, []
                keep = Gtk.ToggleButton()
                kb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                frame, pic = art_widget(96)
                fid = "f" + hashlib.sha1(g["files"][0].encode()).hexdigest()[:16]
                self.art.apply(pic, {"id": fid, "source": "file", "file": g["files"][0]}, 128)
                kb.append(frame)
                kb.append(Gtk.Label(label="Keep" if not g["cover_note"].startswith("No cover") else "Keep (none)"))
                keep.set_child(kb)
                keep.add_css_class("flat")
                keep.add_css_class("cover-pick")
                group = keep
                opts.append((keep, None))
                row.append(keep)
                for j, url in enumerate(g["covers"]):
                    b = Gtk.ToggleButton(group=group)
                    bb = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
                    frame, pic = art_widget(96)
                    self.art.apply(pic, {"id": "scan-" + hashlib.sha1(url.encode()).hexdigest()[:16], "thumb": url}, 160)
                    bb.append(frame)
                    bb.append(Gtk.Label(label=f"Cover {j + 1}"))
                    b.set_child(bb)
                    b.add_css_class("flat")
                    b.add_css_class("cover-pick")
                    opts.append((b, url))
                    row.append(b)
                (opts[1][0] if g["cover_note"].startswith("No cover") and len(opts) > 1 else keep).set_active(True)
                cover_picks[g["key"]] = opts
                col.append(row)
            # The album's tags: one tick for each change the same on several songs.
            same = {}
            for s in g["songs"]:
                for f, (o, n, d) in s["changes"].items():
                    if f in dict(SCAN_ALBUM_FIELDS):
                        same.setdefault((f, o, n, d), []).append((s["file"], f))
            for (f, o, n, d), keys in sorted(same.items(), key=lambda kv: [k for k, _l in SCAN_ALBUM_FIELDS].index(kv[0][0])):
                tick(f"{SCAN_FIELDS[f]}: {o or '(none)'}  →  {n}" + (f"   · {len(keys)} songs" if len(keys) > 1 else ""), keys, d, col)
            for s in g["songs"]:
                mine = [(f, c) for f, c in s["changes"].items() if f in dict(SCAN_SONG_FIELDS)]
                if not mine:
                    continue
                line = Gtk.Box(spacing=14, margin_start=12)
                name = Gtk.Label(label=f"♪ {s['title']}", xalign=0, ellipsize=Pango.EllipsizeMode.END, width_chars=28, max_width_chars=40)
                line.append(name)
                for f, (o, n, d) in mine:
                    tick(f"{SCAN_FIELDS[f]}: {o or '(none)'}  →  {n}", [(s["file"], f)], d, line)
                col.append(line)
            lst.append(Gtk.ListBoxRow(child=col, activatable=False))

        todo = list(groups)

        def more():   # a few cards a frame: hundreds at once held the window up
            for g in todo[:12]:
                card(g)
            del todo[:12]
            return bool(todo)
        GLib.idle_add(more)
        body.append(Gtk.ScrolledWindow(child=lst, vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER))
        bar = Gtk.Box(spacing=8, halign=Gtk.Align.END)

        def every(on):
            for c, _k in ticks:
                c.set_active(on)
            if not on:
                for opts in cover_picks.values():
                    opts[0][0].set_active(True)
        for label, on in (("Replace all", True), ("Keep all", False)):
            b = Gtk.Button(label=label)
            b.add_css_class("pill")
            b.add_css_class("quiet")
            b.connect("clicked", lambda _b, on=on: every(on))
            bar.append(b)
        go = Gtk.Button(label="Apply")
        go.add_css_class("pill")

        def apply(*_):
            if todo:
                self.toast("Still listing the albums: a moment")
                return
            picked = {k: c.get_active() for c, keys in ticks for k in keys}
            chosen = {key: next((u for b, u in opts if b.get_active()), None) for key, opts in cover_picks.items()}
            tags, covers = scan_changes(groups, picked, chosen)
            gone_through = [f for g in groups for f in g["files"]]   # replaced or kept: you've seen them, not asked again
            if not tags and not covers:
                a.tagscan_done.mark(gone_through)
                self.report(body, status, "Nothing changed: every tag and cover was kept.", [], dlg.close)
                return
            self.clear_box(body)
            body.append(Gtk.Spinner(spinning=True, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER, vexpand=True))
