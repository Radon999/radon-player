            self.stale.pop("np-queue", None)
            self._refresh_np_queue()
        else:
            self.stale["np-queue"] = self._refresh_np_queue

    def _refresh_np_queue(self):
        """The queue view: the songs you queued, then the next 60 it plays on with (and how many more),
        then your queues."""
        a = self.app
        q, i = a.queue, a.index
        t = a.current_track()
        if t:
            self.np_q_title.set_label(t["title"])
            self.np_q_artist.set_label(t["artist"])
            self.np_q_pic.clear()
            self.art.apply(self.np_q_pic, t)
        start = max(i, 0) + 1
        queued = [j for j in range(start, len(q)) if q[j].get("queued")]
        rest = [j for j in range(start, len(q)) if not q[j].get("queued")]
        self.np_queued.remove_all()
        for j in queued[:30]:
            self.np_queued.append(self.np_song_row(q[j], j))
        self.np_queued_head.set_visible(bool(queued))
        self.np_queued.set_visible(bool(queued))
        self.np_next.remove_all()
        name = a.queue_name_s or ""
        self.np_q_from.set_label(f"From {name}" if name else "From your music")
        for j in rest[:30]:
            self.np_next.append(self.np_song_row(q[j], j))
        if len(rest) > 30:
            more = Gtk.ListBoxRow()
            lab = Gtk.Label(label=f"See all {len(rest)} songs", xalign=0)
            lab.add_css_class("np-more")
            more.set_child(lab)
            more.go = lambda: self.show_tab("queue")
            self.np_next.append(more)
        elif not rest:
            lab = Gtk.Label(label="Autoplay plays songs like this one next" if a.autoplay else "Nothing after this song",
                            xalign=0)
            lab.add_css_class("np-row-sub")
            self.np_next.append(Gtk.ListBoxRow(child=lab, activatable=False))
        self.np_queues.remove_all()
        for qq in a.saved_queues():
            self.np_queues.append(self.np_queue_row(qq))
        self.np_clear_queues.set_visible(any(x["id"] != a.queue_id for x in a.queues))
        self.np_repeat.icon.set_name("repeat_one" if a.repeat == "one" else "repeat")
        for b, on in ((self.np_repeat, a.repeat != "off"), (self.np_shuffle, a.shuffled), (self.np_autoplay, a.autoplay)):
            (b.add_css_class if on else b.remove_css_class)("on")

