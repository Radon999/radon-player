LOSSLESS_FILES = {"FLAC", "WAV", "AIF", "AIFF", "APE", "WV", "TTA", "DSF", "DFF", "ALAC"}


def file_facts(path):
    """What a file is, for telling copies of a song apart: {"format", "quality", "size", "duration", "bitrate"}."""
    out = {"format": Path(path).suffix.lstrip(".").upper() or "?", "quality": "", "size": 0, "duration": 0,
           "bitrate": 0, "bits": 0, "rate": 0, "lossless": Path(path).suffix.lstrip(".").upper() in LOSSLESS_FILES}
    try:
        out["size"] = Path(path).stat().st_size
    except OSError:
        return out
    try:
        import mutagen
        f = mutagen.File(path)
        info = getattr(f, "info", None) if f is not None else None
        if info:
            out["duration"] = round(getattr(info, "length", 0) or 0)
            out["bitrate"] = round((getattr(info, "bitrate", 0) or 0) / 1000)
            bits, rate = getattr(info, "bits_per_sample", 0), getattr(info, "sample_rate", 0)
            out["bits"], out["rate"] = bits or 0, rate or 0
            out["lossless"] = (out["format"] in LOSSLESS_FILES
                               or "alac" in str(getattr(info, "codec", "")).lower())   # ALAC in an .m4a
            out["quality"] = (f"{bits}-bit/{rate / 1000:g} kHz" if bits and rate else
                              f"{out['bitrate']} kbps" if out["bitrate"] else "")
    except Exception:  # noqa: BLE001 -- the size alone, then
        pass
    return out


def facts_text(f):
    mb = f["size"] / 1e6
    return " · ".join(x for x in (f["format"], f["quality"], f"{mb:.1f} MB" if mb else "",
                                  fmt_time(f["duration"]) if f["duration"] else "") if x)


def copy_rank(f):
    """Which copy of a song is best to keep: lossless first, then more bits and kHz, then the bigger file."""
    lossless = f["format"] in ("FLAC", "WAV", "ALAC", "AIFF", "APE", "WV")
    bits = int(re.match(r"(\d+)-bit", f["quality"]).group(1)) if re.match(r"(\d+)-bit", f["quality"]) else 0
    return (lossless, bits, f["bitrate"], f["size"])


@functools.lru_cache(maxsize=1 << 16)   # sorting thousands of songs asks for the same names again and again

def on_single(c):
    """Whether Tidal track c comes from a single: its release is named after it ("Song", "Song - Single")."""
    album = norm(re.sub(r"\s*[-–]\s*(single|ep)\s*$", "", getattr(getattr(c, "album", None), "name", "") or "", flags=re.I))
    return bool(album) and album == norm(getattr(c, "name", "") or "")

def norm(s):
    """Lowercase letters and digits only, accents dropped: for comparing names across services."""
    return _norm(s) if isinstance(s, str) else _norm(s or "")


@functools.lru_cache(maxsize=100000)   # sorting and matching thousands of songs asks it of the same names again and again
def _norm(s):
    s = unicodedata.normalize("NFKD", s or "").encode("ascii", "ignore").decode() or (s or "")
    return " ".join(re.sub(r"[^\w\s]", " ", s.lower()).split())


def rgba(hex_color, alpha):
    h = hex_color.lstrip("#")
    if len(h) < 6:
        return hex_color
    r, g, b = (int(h[i:i + 2], 16) for i in (0, 2, 4))
    return f"rgba({r},{g},{b},{alpha})"


def track_from_ytm(item):
    """Normalise a ytmusicapi song/watch/playlist item into our track dict."""
    vid = item.get("videoId")
    if not vid:
        return None
    artists = ", ".join(a.get("name", "") for a in (item.get("artists") or []) if a.get("name"))
    album = item.get("album") or {}
    thumbs = item.get("thumbnails") or item.get("thumbnail") or []
    if isinstance(thumbs, dict):
        thumbs = thumbs.get("thumbnails", [])
    thumb = thumbs[-1]["url"] if thumbs else ""
    dur = item.get("duration_seconds")
    if dur is None:
        text = item.get("duration") or item.get("length") or ""
        parts = [int(p) for p in text.split(":") if p.isdigit()]
        dur = sum(p * 60 ** i for i, p in enumerate(reversed(parts))) if parts else 0
    return {"id": vid, "source": "ytm", "title": item.get("title") or "Unknown", "artist": artists or "Unknown artist",
            "album": album.get("name", "") if isinstance(album, dict) else "",
            "duration": dur, "thumb": thumb}


def thumb_path(vid):
    """Where a picture shown for vid is kept: its id as the name, or a hash of it where the id isn't a name a file can
    have (a New releases album's is its Deezer address, with "/" and ":" in it, which Windows refuses)."""
    vid = str(vid)
    if re.fullmatch(r"[\w.\- ]{1,120}", vid) and vid.strip(". "):
        return THUMBS / f"{vid}.jpg"
    return THUMBS / f"h{hashlib.sha1(vid.encode()).hexdigest()[:24]}.jpg"


def sized_thumb(url, px):
    # YouTube Music art URLs end in =w120-h120-...; Apple's in /226x226bb.jpg: ask for the size we draw.
    if "googleusercontent" in url:
        return re.sub(r"=w\d+-h\d+", f"=w{px}-h{px}", url)
    if "mzstatic.com" in url:
        return re.sub(r"/\d+x\d+(bb|cc)?\.(jpg|webp|png)$", f"/{px}x{px}bb.jpg", url)
    return url


