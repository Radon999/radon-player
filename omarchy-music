# =============================================================================
# Fix albums and artists (Settings, the PC only): albums split by featured artists ("Quinn XCII & Jeremy
# Zucker"), an album beside its deluxe edition, and singles of songs on an album you have, fixed in the
# files' own tags (artist, album artist, album, track number; titles never), then the files moved into the
# right folders if you say so. Empty folders left behind are cleaned up on their own button.
# =============================================================================

AUDIO_EXTS = {".flac", ".mp3", ".m4a", ".aac", ".ogg", ".opus", ".wav", ".aif", ".aiff", ".wv", ".ape", ".alac",
              ".dsf", ".dff", ".tta", ".mka", ".webm", ".wma", ".mpc"}
LEFTOVER_EXTS = {".jpg", ".jpeg", ".png", ".webp", ".gif", ".bmp", ".lrc", ".txt", ".nfo", ".m3u", ".m3u8", ".cue",
                 ".log", ".sfv", ".md5", ".ini", ".db", ".ds_store"}   # what a folder of music leaves behind
VARIOUS = {"various artists", "various", "va", "verschiedene interpreten"}


def solo_artists(songs):
    """The artists who are credited on their own somewhere (artist_key's names): "Quinn XCII" is, so "Quinn
    XCII & Jeremy Zucker" is him with a guest; "Simon" never is, so "Simon & Garfunkel" stays a duo."""
    out = set()
    for t in songs:
        for credit in (t.get("albumartist"), t.get("artist")):
            parts = []
            for piece in re.split(r";|\s+(?:feat\.?|ft\.?|featuring|with)\s+", credit or "", flags=re.I):
                one_comma = piece.count(",") == 1 and not re.search(r" & | x | X | and ", piece)
                parts += [piece] if one_comma else piece.split(",")   # "Tyler, The Creator" whole
            for part in parts:
                part = part.strip()
                if part and not re.search(r" & | x | X | and ", part):
                    out.add(re.sub(r"[\W_]+", "", norm(part)))
    out.discard("")
    return out


def fixup_plan(songs, tracklist=None, find_album=None, cover_of=None):
    """What Fix albums and artists would change: [{"file", "title", "kinds", "why", "old", "new", "cover"}].
    songs: your files, as track_from_file gives them. old/new: {"artist", "albumartist", "album", "tracknumber"}
    (new: only what changes). cover: a file to take the cover from (a single that has none). tracklist(artist,
    album) -> {clean title: track number} (or None): the deluxe edition's numbers, looked up. find_album(artist,
    title) -> the albums a song is on (Deezer's: its single among them), or []: for singles and remixes whose
    album you have but not the song on it. cover_of(file) -> picture_hash of its cover, or None: albums of an
    artist's with the same cover (a single, an edition, a part) onto one of them."""
    solo = solo_artists(songs)
    fields = ("artist", "albumartist", "album", "tracknumber")
    now = {t["file"]: {"artist": t.get("artist") or "", "albumartist": t.get("albumartist") or "",
                       "album": t.get("album") or "", "tracknumber": str(t.get("track") or "")} for t in songs}
    why = collections.defaultdict(list)
    kinds = collections.defaultdict(set)
    cover = {}

    # 1. Featured artists: each album's songs credited to its main artist only.
    albums = collections.defaultdict(list)
    for t in songs:
        credit = t.get("albumartist") or t.get("artist") or ""
        if not t.get("album") or norm(credit) in VARIOUS or norm(t.get("artist") or "") in VARIOUS:
            continue
        albums[(norm(clean_title(t["album"])), artist_key(credit))].append(t)
    others, siblings, group_of, unsure = {}, {}, {}, set()
    credits_of = credit_counts(songs)
    spelt = solo_spellings(songs)
    alone = {k: spelt[k] for k in solo if k in spelt} or {k: k for k in solo}
    for gn, group in enumerate(albums.values()):
        picks = [pick_main(t.get("albumartist") or t.get("artist") or "", alone, credits_of) for t in group]
        mains = collections.Counter(m for m, _sure in picks)
        main = min(mains, key=lambda m: (bool(re.search(r" & | x |,", m)), -mains[m], len(m)))
        if not main:
            continue
        sure = all(ok for m, ok in picks if m == main)
        # The other artists credited on the album, for "Other artist" (when the main one picked is the wrong one).
        names = collections.Counter()
        for t in group:
            for credit in {t.get("albumartist") or "", t.get("artist") or ""}:
                lead = re.split(r"\s+(?:feat\.?|ft\.?|featuring|with)\s+", credit, flags=re.I)
                for part in duo_parts(lead[0]) + [p.strip() for p in lead[1:]]:
                    if part and artist_key(part) != artist_key(main):
                        names[part] += 1
        alt = [n for n, _c in names.most_common()]
        changed_before = set(kinds)
        for t in group:
            cur = now[t["file"]]
            credit = cur["albumartist"] or cur["artist"]
            if cur["artist"] != main or (cur["albumartist"] and cur["albumartist"] != main):
                theirs = {artist_key(n) for c in (cur["artist"], credit) for n in [c] + credit_names(c) + duo_parts(
                    re.split(r"\s+(?:feat\.?|ft\.?|featuring|with)\s+", c, flags=re.I)[0])}
                if artist_key(main) not in theirs:
                    continue   # someone else's song on the album (a compilation): not ours to change
                if not sure:
                    unsure.add(t["file"])
                was = cur["artist"]
                cur["artist"] = main
                if cur["albumartist"]:
                    cur["albumartist"] = main
                kinds[t["file"]].add("artist")
                why[t["file"]].append(f"“{was}” → “{main}”")
        mine = [t["file"] for t in group if "artist" in kinds.get(t["file"], ()) and t["file"] not in changed_before]
        if mine:
            sib = [t for t in group if t["file"] not in mine]
            for f in mine:
                others[f], siblings[f], group_of[f] = alt, sib, gn

    # 1b. An album in parts ("…: Pt. 1", "…: Pt. 2", and the whole one): all of it onto the one with no part,
    # numbered as the whole album has them (looked up), else one part after the other.
    parts = collections.defaultdict(list)
    for t in songs:
        cur = now[t["file"]]
        if cur["album"]:
            base, _n = album_part(cur["album"])
            parts[(norm(clean_title(base)), artist_key(cur["albumartist"] or cur["artist"]))].append(t)
    for group in parts.values():
        names = {now[t["file"]]["album"] for t in group}
        if len(names) < 2 or not any(album_part(n)[1] for n in names):
            continue
        whole = album_part(next(iter(names)))[0]
        lead = now[group[0]["file"]]
        numbers = (tracklist(lead["albumartist"] or lead["artist"], whole) if tracklist else None) or {}
        order = sorted(group, key=lambda t: (album_part(now[t["file"]]["album"])[1], track_no({"track": now[t["file"]]["tracknumber"]}),
                                             norm(t.get("title") or "")))
        before = collections.Counter()
        for t in order:
            before[album_part(now[t["file"]]["album"])[1]] += 1
        for t in order:
            cur = now[t["file"]]
            part = album_part(cur["album"])[1]
            if not part:
                continue
            was = cur["album"]
            cur["album"] = whole
            n = numbers.get(norm(clean_title(t.get("title") or "")))
            if not n and cur["tracknumber"]:
                n = track_no({"track": cur["tracknumber"]}) + sum(c for p, c in before.items() if p < part)
            if n:
                cur["tracknumber"] = str(n)
            kinds[t["file"]].add("parts")
            why[t["file"]].append(f"“{was}” → “{whole}”")

    # 2. Deluxe, extended and anniversary editions: the album's songs moved onto the edition.
    editions = collections.defaultdict(list)
    for t in songs:
        cur = now[t["file"]]
        if cur["album"]:
            base, _ed = album_edition(cur["album"])
            editions[(norm(clean_title(base)), artist_key(cur["albumartist"] or cur["artist"]))].append(t)
    for group in editions.values():
        names = collections.Counter(now[t["file"]]["album"] for t in group if album_edition(now[t["file"]]["album"])[1])
        if not names or all(album_edition(now[t["file"]]["album"])[1] for t in group):
            continue   # no edition, or nothing but editions
        edition = names.most_common(1)[0][0]
        numbers = None
        for t in group:
            cur = now[t["file"]]
            if cur["album"] == edition:
                continue
            if album_edition(cur["album"])[1] and album_edition(cur["album"])[1] != album_edition(edition)[1]:
                continue   # another edition (Deluxe beside Anniversary): left as it is
            if numbers is None:
                numbers = (tracklist(cur["albumartist"] or cur["artist"], edition) if tracklist else None) or {}
            was = cur["album"]
            cur["album"] = edition
            kinds[t["file"]].add("edition")
            why[t["file"]].append(f"“{was}” → “{edition}”")
            n = numbers.get(norm(clean_title(t.get("title") or "")))
            if n and track_no({"track": cur["tracknumber"]}) != n:
                cur["tracknumber"] = str(n)
        if numbers:   # the edition's own songs numbered wrong too
            for t in group:
                cur = now[t["file"]]
                n = numbers.get(norm(clean_title(t.get("title") or "")))
                if cur["album"] == edition and n and track_no({"track": cur["tracknumber"]}) != n:
                    cur["tracknumber"] = str(n)
                    kinds[t["file"]].add("edition")

    # 3. Singles of songs on an album you have: put on the album (its number; its cover if the single has none).
    # A single: an album called one ("- Single", the song's name), or any song alone on its album (the only song
    # of it you have), or with no album at all.
    sizes = collections.Counter((norm(clean_title(now[t["file"]]["album"])), artist_key(now[t["file"]]["albumartist"] or now[t["file"]]["artist"]))
                                for t in songs if now[t["file"]]["album"])

    def alone(t):
        cur = now[t["file"]]
        if not cur["album"]:
            return True
        return is_single(cur["album"], t.get("title")) or \
            sizes[(norm(clean_title(cur["album"])), artist_key(cur["albumartist"] or cur["artist"]))] <= 1
    on_albums = collections.defaultdict(list)
    for t in songs:
        cur = now[t["file"]]
        if cur["album"] and not is_single(cur["album"], t.get("title")):   # (an album you have one song of is a home too)
            on_albums[stats_key(t.get("title"), cur["artist"])].append(t)
    for t in songs:
        cur = now[t["file"]]
        if not alone(t):
            continue
        mine_single = not cur["album"] or is_single(cur["album"], t.get("title"))
        home = [h for h in on_albums.get(stats_key(t.get("title"), cur["artist"])) or ()
                if h["file"] != t["file"] and now[h["file"]]["album"] != cur["album"]
                and (mine_single or not alone(h))]   # two copies each alone on an album: neither moves
        if not home:
            continue
        best = home[0]
        to = now[best["file"]]
        was = cur["album"]
        cur["album"] = to["album"]
        cur["albumartist"] = to["albumartist"] if cur["albumartist"] or to["albumartist"] else ""
        if to["tracknumber"]:
            cur["tracknumber"] = to["tracknumber"]
        kinds[t["file"]].add("single")
        why[t["file"]].append(f"single “{was}” → “{to['album']}”")
        cover[t["file"]] = best["file"]

    # 4. Singles of songs on an album you have, but not that song on it (Deezer says which album), and remixes
    # (on a single, or a remixes EP): onto the album their song is on. Onto its deluxe or extended edition
    # when you have that: "Songs" is on Persona, you have Persona (Extended): there.
    mine = collections.defaultdict(collections.Counter)   # (album without edition, artist) -> your albums of it
    first = {}
    for t in songs:
        cur = now[t["file"]]
        if cur["album"] and not is_single(cur["album"], t.get("title")) and not remix_of(cur["album"]) and "single" not in kinds.get(t["file"], ()):
            k = (norm(clean_title(album_edition(cur["album"])[0])), artist_key(cur["albumartist"] or cur["artist"]))
            mine[k][cur["album"]] += 1
            first.setdefault((k, cur["album"]), t)
    artists_with_albums = {k[1] for k in mine}

    def your_album(names, artist, skip=""):
        """The first of names that's an album of yours (an edition of it wins), by artist: its name, or None. skip: the
        album the song is alone on now (not where it goes)."""
        own = norm(clean_title(album_edition(skip)[0])) if skip else None
        for name in ([names] if isinstance(names, str) else names or []):
            if own is not None and norm(clean_title(album_edition(name)[0])) == own:
                continue
            have = mine.get((norm(clean_title(album_edition(name)[0])), artist_key(artist)))
            if have:
                return max(have, key=lambda a: (bool(album_edition(a)[1]), have[a]))
        return None

    looked = {}

    def deezer_home(artist, title):
        if not find_album or artist_key(artist) not in artists_with_albums:
            return []
        k = (artist_key(artist), norm(clean_title(title)))
        if k not in looked:
            try:
                looked[k] = find_album(artist, title)
            except Exception:  # noqa: BLE001 -- offline: left as it is
                looked[k] = []
        return looked[k] or []

    def numbers_of(artist, album):
        k = ("#n", artist_key(artist), norm(album))
        if k not in looked:
            try:
                looked[k] = (tracklist(artist, album) if tracklist else None) or {}
            except Exception:  # noqa: BLE001
                looked[k] = {}
        return looked[k]

    for t in songs:
        f = t["file"]
        cur = now[f]
        if kinds.get(f, set()) & {"single", "edition"}:
            continue
        title = t.get("title") or ""
        base = remix_of(title)
        artist = cur["albumartist"] or cur["artist"]
        if base:   # a remix: on a single, a remixes EP, or no album
            if cur["album"] and not (is_single(cur["album"], title) or remix_of(cur["album"])
                                     or norm(clean_title(base)) in norm(clean_title(cur["album"]))):
                continue   # already on an album of its own (a remix album): left there
            home = on_albums.get(stats_key(base, cur["artist"]))
            to = now[home[0]["file"]]["album"] if home else None
            to = your_album(to, artist) if to else your_album(deezer_home(cur["artist"], base), artist)
        elif alone(t):   # a single, or a song alone on its album (or with none): the album or EP it's on, if you have it
            to = your_album(deezer_home(cur["artist"], title), artist, skip=cur["album"])
            if to and cur["album"] and not is_single(cur["album"], title) and album_kind(to) < album_kind(cur["album"]):
                to = None   # alone on an album: not off it onto a sessions record or a best-of
        else:
            continue
        if not to or to == cur["album"]:
            continue
        was = cur["album"]
        src = first.get(((norm(clean_title(album_edition(to)[0])), artist_key(artist)), to))
        cur["album"] = to
        if src is not None:
            ref = now[src["file"]]
            cur["albumartist"] = ref["albumartist"] if cur["albumartist"] or ref["albumartist"] else ""
            cover[f] = src["file"]
        if base:   # not on the album's track list: after its songs
            last = max((track_no({"track": now[x["file"]]["tracknumber"]}) for x in songs
                        if now[x["file"]]["album"] == to and x["file"] != f), default=0)
            cur["tracknumber"] = str(last + 1) if last else cur["tracknumber"]
            kinds[f].add("remix")
            why[f].append(f"remix of “{base}”: “{was or '(no album)'}” → “{to}”")
        else:
            n = numbers_of(artist, to).get(norm(clean_title(title)))
            if n:
                cur["tracknumber"] = str(n)
            kinds[f].add("single")
            why[f].append(f"single “{was}” → “{to}”")

    # 5. The same cover: an artist's albums whose covers look alike (a single with its album's cover, a deluxe
    # beside the album, the parts of one) onto one of them: the album over a single or a remix, an edition
    # over the plain one, the one with the most songs. Only ones nothing above moved, and you check each.
    if cover_of:
        by_album = collections.defaultdict(list)   # (artist, album as it'll be) -> its songs
        for t in songs:
            cur = now[t["file"]]
            if cur["album"] and not kinds.get(t["file"]):
                by_album[(artist_key(cur["albumartist"] or cur["artist"]), cur["album"])].append(t)
        per_artist = collections.defaultdict(list)
        for (ak, name), group in by_album.items():
            per_artist[ak].append(name)
        for ak, names in per_artist.items():
            if len(names) < 2:
                continue
            looks = {}
            for name in names:
                for t in by_album[(ak, name)][:3]:   # the first song of it with a cover
                    try:
                        h = cover_of(t["file"])
                    except Exception:  # noqa: BLE001 -- unreadable: no cover
                        h = None
                    if h is not None:
                        looks[name] = h
                        break
            parent = {n: n for n in looks}

            def root(n):
                while parent[n] != n:
                    parent[n] = parent[parent[n]]
                    n = parent[n]
                return n
            named = sorted(looks)
            for i, x in enumerate(named):
                for y in named[i + 1:]:
                    if bin(looks[x] ^ looks[y]).count("1") <= COVER_ALIKE:
                        parent[root(x)] = root(y)
            clusters = collections.defaultdict(list)
            for n in named:
                clusters[root(n)].append(n)
            for same in clusters.values():
                if len(same) < 2:
                    continue

                def rank(name):
                    group = by_album[(ak, name)]
                    single = all(is_single(name, t.get("title")) for t in group) or bool(remix_of(name))
                    return (not single, bool(album_edition(name)[1]), not album_part(name)[1], len(group), -len(name))
                to = max(same, key=rank)
                ref = now[by_album[(ak, to)][0]["file"]]
                numbers = None
                for name in same:
                    if name == to:
                        continue
                    for t in by_album[(ak, name)]:
                        f = t["file"]
                        cur = now[f]
                        cur["album"] = to
                        cur["albumartist"] = ref["albumartist"] if cur["albumartist"] or ref["albumartist"] else ""
                        if numbers is None:
                            try:
                                numbers = (tracklist(ref["albumartist"] or ref["artist"], to) if tracklist else None) or {}
                            except Exception:  # noqa: BLE001
                                numbers = {}
                        n = numbers.get(norm(clean_title(t.get("title") or "")))
                        if n:
                            cur["tracknumber"] = str(n)
                        kinds[f].add("cover")
                        why[f].append(f"same cover as “{to}”: “{name}” → “{to}”")

    # Never onto a single: a song only ever goes onto an album or an EP. A single: "single" in its name, or named for
    # its song ("Songs"), or one of yours with a song or none on it named for that one song.
    titles_on = collections.defaultdict(set)
    for t in songs:
        if t.get("album"):
            titles_on[norm(clean_title(t["album"]))].add(t.get("title") or "")

    def a_single(name, title):
        if not name:
            return False
        if re.search(r"\bsingles?\b", name, re.I):
            return True
        on = titles_on.get(norm(clean_title(name)), set()) - {title or ""}   # the other songs of yours on it
        if not on:
            return is_single(name, title)   # nothing else on it, and named for this song
        return len(on) == 1 and is_single(name, next(iter(on)))   # one song on it, and named for that one
    for t in songs:
        f = t["file"]
        cur = now[f]
        if kinds.get(f) and cur["album"] != (t.get("album") or "") and a_single(cur["album"], t.get("title")):
            cur["album"] = t.get("album") or ""   # back as it was: its album, number and album artist
            cur["tracknumber"] = str(t.get("track") or "")
            if "artist" not in kinds[f]:
                cur["albumartist"] = t.get("albumartist") or ""
            kinds[f] -= {"single", "remix", "edition", "parts", "cover"}
            why[f] = [f"“{t.get('artist') or ''}” → “{cur['artist']}”"] if "artist" in kinds[f] else []
            cover.pop(f, None)

    out = []
    for t in songs:
        f = t["file"]
        if not kinds.get(f):
            continue
        old = {"artist": t.get("artist") or "", "albumartist": t.get("albumartist") or "", "album": t.get("album") or "",
               "tracknumber": str(t.get("track") or "")}
        new = {k: now[f][k] for k in fields if now[f][k] != old[k]}
        if new:
            c = {"file": f, "title": t.get("title") or Path(f).stem, "kinds": sorted(kinds[f]),
                 "why": "; ".join(why[f]), "old": old, "new": new, "cover": cover.get(f)}
            if f in unsure:
                c["unsure"] = True   # a duo neither of whom is an artist of their own here: Leave alone unless you say
            if f in group_of:
                c.update(others=others[f], group=group_of[f],
                         siblings=[{"file": x["file"], "title": x.get("title") or Path(x["file"]).stem,
                                    "old": {"artist": x.get("artist") or "", "albumartist": x.get("albumartist") or "",
                                            "album": x.get("album") or "", "tracknumber": str(x.get("track") or "")}}
                                   for x in siblings[f]])
            out.append(c)
    return out   # (a single with no album or EP of yours found for it: left as it is, not listed)


def own_artists(credit):
    """The artists in a credit, for suggestions: a credit of one ("Tyler, The Creator") whole; "A & B feat. C"
    as A, B and C."""
    credit = (credit or "").strip()
    if not credit:
        return []
    if not re.search(r" & | x | X | and |;|\s(?:feat\.?|ft\.?|featuring|with)\s", credit, flags=re.I):
        return [credit]
    return credit_names(credit)


class OwnName(str):
    """A name typed in (Fix albums and artists' "Choose your own…"), not one of the album's credits."""


def credit_counts(songs):
    """How many different credits each artist (artist_key) is in across your songs: Berner, in "Berner & Cozmo" and
    "Berner & Styles P", is the one those two have in common."""
    seen = collections.defaultdict(set)
    for t in songs:
        for credit in {t.get("albumartist") or "", t.get("artist") or ""}:
            if credit:
                for n in credit_names(credit):
                    seen[artist_key(n)].add(norm(credit))
    return {k: len(v) for k, v in seen.items()}


def pick_main(credit, solo, counts=None):
    """The main artist of a credit, and whether that's sure: "A feat. B" is A; "A & B" is whichever of them is an artist
    of their own here (in solo: Big Wild & Surfaces is Surfaces); if both or neither are, the one in the most credits
    (Berner), else the first, and not sure (Nas & 21 Savage: you pick)."""
    lead = re.split(r"\s+(?:feat\.?|ft\.?|featuring|with)\s+", credit or "", flags=re.I)[0].strip()
    parts = duo_parts(lead)
    key = lambda n: re.sub(r"[\W_]+", "", norm(n))   # noqa: E731
    canon = solo if isinstance(solo, dict) else {}
    named = lambda n: canon.get(key(n), n)   # noqa: E731 -- spelt as their own songs have it (K.Flay, not KFlay)
    if len(parts) <= 1:
        return named(parts[0]) if parts else lead, True
    alone = [n for n in parts if key(n) in solo]
    if len(alone) == 1:
        return named(alone[0]), True
    if len(alone) > 1:   # both are artists of their own (Lil Nas X & Jack Harlow): the first billed, and you say
        return named(alone[0]), False
    pool = parts
    counts = counts or {}
    ranked = sorted(pool, key=lambda n: -counts.get(artist_key(n), 0))
    if len(ranked) > 1 and counts.get(artist_key(ranked[0]), 0) > max(1, counts.get(artist_key(ranked[1]), 0)):
        return named(ranked[0]), True
    return named(ranked[0]), False


def artist_resolver(songs, picks=None):
    """credit -> the artist its plays count for in Most played, Artists and the time tabs: "Quinn XCII & Jeremy
    Zucker" is Quinn XCII, "Big Wild & Surfaces" is Surfaces (the one of them with songs of their own here), "A feat.
    B" is A, and what you picked in Joint artists… (picks: {pair_key: name, or "" for the pair}) stands. A pair
    neither of whom has songs of their own stays a pair until you pick."""
    picks = picks or {}
    solo = solo_artists(songs)
    spelt = solo_spellings(songs)
    alone = {k: spelt[k] for k in solo if k in spelt} or {k: k for k in solo}
    counts = credit_counts(songs)
    cache = {}

    def resolve(credit):
        c = (credit or "").strip()
        k = norm(c)
        if k in cache:
            return cache[k]
        pk = pair_key(c)
        if pk in picks:
            out = picks[pk] or re.split(r"\s+(?:feat\.?|ft\.?|featuring|with)\s+", c, flags=re.I)[0].strip()
        else:
            lead = re.split(r"\s+(?:feat\.?|ft\.?|featuring|with)\s+", c, flags=re.I)[0].strip()
            lead = re.split(r";", lead)[0].strip()
            if "," in lead and len(duo_parts(lead)) == 1 and re.sub(r"[\W_]+", "", norm(lead)) not in alone:
                lead = lead.split(",")[0].strip()   # "Joji, Rei Brown" is Joji's; "Tyler, The Creator" (yours, whole) stays
            if len(duo_parts(lead)) <= 1:
                key = re.sub(r"[\W_]+", "", norm(lead))
                out = alone.get(key, lead) if isinstance(alone, dict) else lead
            else:
                main, sure = pick_main(lead, alone, counts)
                out = main if sure else lead
        cache[k] = out
        return out
    return resolve


def pair_key(credit):
    """A pair's (or more's) key, whichever way round they're billed: "Forrest & Forrest Frank" = "Forrest Frank & Forrest"."""
    lead = re.split(r"\s+(?:feat\.?|ft\.?|featuring|with)\s+", credit or "", flags=re.I)[0].strip()
    return "&".join(sorted(re.sub(r"[\W_]+", "", norm(p)) for p in duo_parts(lead)))


