def read_m3u(path):
    """The songs of an .m3u or .m3u8 playlist, in order: [(location as written, artist, title, seconds)],
    the names from its #EXTINF lines (empty where it has none)."""
    raw = Path(path).read_bytes()
    try:
        text = raw.decode("utf-8-sig")
    except UnicodeDecodeError:
        text = raw.decode("latin-1")   # an old .m3u
    out, info = [], None
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("#EXTINF:"):
            head, _, name = line[8:].partition(",")
            m = re.match(r"-?\d+(\.\d+)?", head.strip())
            artist, dash, title = name.partition(" - ")
            info = ((artist.strip(), title.strip()) if dash else ("", name.strip())) + (max(0, int(float(m.group()))) if m else 0,)
        elif line and not line.startswith("#"):
            out.append((line, *(info or ("", "", 0))))
            info = None
    return out


def m3u8_text(tracks, file_of):
    """An .m3u8 playlist of tracks: each song's file where it's on this computer (file_of(t)),
    else its page on the service it's from, which this app (and others) can find again by
    the #EXTINF line's artist and title."""
    lines = ["#EXTM3U"]
    for t in tracks:
        secs = int(t.get("duration") or 0) or -1
        lines.append(f"#EXTINF:{secs},{t.get('artist') or ''} - {t.get('title') or ''}")
        if t.get("album"):
            lines.append(f"#EXTALB:{t['album']}")
        lines.append(file_of(t) or (song_page(t) or (None, None))[1] or f"{t.get('artist') or ''} - {t.get('title') or ''}")
    return "\n".join(lines) + "\n"


def local_matches(songs, q):
    """Songs, artists and albums of yours whose names have every word of q in them."""
    words = norm(q).split()
    if not words:
        return [], [], []

    def has(text):
        t = norm(text)
        return all(w in t for w in words)
    hits = [t for t in songs if has(f"{t.get('title', '')} {t.get('artist', '')} {t.get('album', '')}")]
    artists, albums = {}, {}
    for t in songs:
        for name in split_artists(t.get("artist") or ""):
            if has(name):
                artists.setdefault(norm(name), name)
        if t.get("album") and has(f"{t['album']} {t.get('artist', '')}"):
            lead = (t.get("artist") or "").split(",")[0].strip()
            albums.setdefault((norm(t["album"]), norm(lead)), {"title": t["album"], "artist": lead, "tracks": []})["tracks"].append(t)
    return hits, sorted(artists.values(), key=norm)[:8], list(albums.values())[:12]


def album_group_key(t):
    """Which of your albums (the Albums tab's) a song of yours is on: "album|album artist"."""
    artist = ((t.get("albumartist") or t.get("artist") or "").split(",")[0].strip()) or "Unknown artist"
    return f"{norm(t.get('album') or '')}|{norm(artist)}"


def find_album_group(t, groups):
    """The key of the album in groups (the Albums tab's: key -> [title, artist, songs]) that song t is on, or
    None: the same album and album artist, else the same album name with one of t's artists as its artist."""
    album = norm(clean_title(t.get("album") or ""))
    if not album:
        return None
    key = album_group_key(t)
    if key in groups:
        return key
    names = {norm(n) for n in split_artists(t.get("artist") or "")} | {norm(t.get("albumartist") or "")}
    names.discard("")
    same = [k for k, (title, sub, _songs) in groups.items() if norm(clean_title(title)) == album]
    return next((k for k in same if norm(groups[k][1]) in names), None) or (same[0] if len(same) == 1 else None)


