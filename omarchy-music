    def time_items(self, what, tt, period):
        """Listening time's songs or albums, each with a song of yours (or one to find) for its cover and to play:
        [{"title", "artist", "secs", "track", "tracks"}], longest first."""
        a = self.app
        mine = a.song_index()
        out = []
        if what == "songs":
            for title, artist, album, v in tt.get("songs") or []:
                t = a.fm_song(title, artist, "", mine, album)
                out.append({"title": title, "artist": artist, "secs": v, "track": t, "tracks": [t]})
            return out
        by_key = {al["key"]: al for al in a.top_albums(period)}
        for row in tt.get("albums") or []:
            al_name, artist, v = row[0], row[1], row[2]
            key = row[3] if len(row) > 3 else ""
            al = by_key.get(key)
            if al:
                tracks = sorted(al["tracks"], key=lambda t: (track_no(t), norm(t["title"])))
            else:   # an album of the period's plays that Most played's songs don't reach: your copy's songs, else one to find
                base = norm(clean_title(album_edition(al_name)[0]))
                tracks = [t for k, ts in mine.items() if k[:1] == ("L",) for t in ts if norm(clean_title(album_edition(t.get("album") or "")[0])) == base
                          and artist_key(t.get("albumartist") or t.get("artist") or "") == artist_key(artist)][:30]
                tracks = sorted({t["id"]: t for t in tracks}.values(), key=lambda t: (track_no(t), norm(t["title"]))) \
                    or [a.fm_song(al_name, artist, "", {}, al_name)]
            cover = next((t for t in tracks if t.get("thumb") or source_of(t) == "file"), tracks[0])
            out.append({"title": al_name, "artist": artist, "secs": v, "track": cover, "tracks": tracks, "key": key})
        return out

    def time_rows(self, lst, what="artists"):
