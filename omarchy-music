def read_edit_tags(paths):
    """The tags of TAG_FIELDS the files have: {field: value}, None where the files disagree."""
    out = {}
    for i, path in enumerate(paths):
        try:
            f = easy_audio(path)
            tags = (f.tags if f is not None else None) or {}
        except Exception:  # noqa: BLE001 -- unreadable: as if untagged
            tags = {}
        for k, _label in TAG_FIELDS:
            v = ", ".join(tags.get(k) or []) if k == "artist" else (tags.get(k) or [""])[0]
            out[k] = v if i == 0 else (out[k] if out[k] == v else None)
    return out


def write_tags(path, changes):
    """Write changes {field: value} to the file's tags ("" takes the tag off). Artists are
    separated by commas, one tag each, the way Tidal's files have them."""
    f = easy_audio(path)
    if f is None:
        raise ValueError(f"{Path(path).name} isn't a file whose tags can be written")
    if f.tags is None:
        f.add_tags()
    for k, v in changes.items():
        v = v.strip()
        if not v:
            if k in f.tags:
                del f.tags[k]
        elif k == "artist":
            f[k] = [a.strip() for a in v.split(",") if a.strip()]
        else:
            f[k] = [v]
    f.save()


def put_lyrics(path, text):
    """The words as the file's own lyrics, if it has none yet: a FLAC's or Ogg's LYRICS, an MP3's
    (or WAV's, AIFF's) ID3 lyrics frame, an M4A's lyrics. Only the words. Returns whether it wrote."""
    import mutagen
    from mutagen.id3 import ID3, USLT
    from mutagen.mp4 import MP4
    text = (text or "").strip()
    if not text:
        return False
    f = mutagen.File(path)
    if f is None:
        return False
    if isinstance(f, MP4):
        if f.tags is None:
            f.add_tags()
        if f.tags.get("\xa9lyr"):
            return False
        f.tags["\xa9lyr"] = [text]
    elif isinstance(f.tags, ID3) or (f.tags is None and Path(path).suffix.lower() in (".mp3", ".wav", ".aiff", ".aif")):
        if f.tags is None:
            f.add_tags()
        if any(str(k).startswith(("USLT", "SYLT")) for k in f.tags.keys()):
            return False
        f.tags.add(USLT(encoding=3, lang="eng", desc="", text=text))
    else:   # Vorbis comments: FLAC, Ogg, Opus
        if f.tags is None:
            f.add_tags()
        if f.tags.get("LYRICS") or f.tags.get("UNSYNCEDLYRICS"):
            return False
        f.tags["LYRICS"] = [text]
    f.save()
    return True


def file_lyrics(path):
    """The lyrics inside a file (a FLAC's or Ogg's LYRICS, an MP3's ID3 lyrics, an M4A's), or ""."""
    import mutagen
    try:
        f = mutagen.File(path)
    except Exception:  # noqa: BLE001 -- unreadable: none
        return ""
    tags = getattr(f, "tags", None) if f is not None else None
    if not tags:
        return ""
    try:
        for k in list(tags.keys()):
            if str(k).startswith("USLT"):
                return str(tags[k].text or "").strip()
    except Exception:  # noqa: BLE001
        pass
    for k in ("\xa9lyr", "LYRICS", "UNSYNCEDLYRICS"):   # M4A's, then Vorbis comments' (any case)
        try:
            v = tags[k] if k in tags else None
        except Exception:  # noqa: BLE001 -- not a key this kind of tags can have
            continue
        if v:
            return str(v[0] if isinstance(v, list) else v).strip()
    return ""


def set_file_lyrics(path, text):
    """The file's lyrics replaced by text ("" takes them off)."""
    import mutagen
    from mutagen.id3 import ID3, USLT
    from mutagen.mp4 import MP4
    text = (text or "").strip()
    f = mutagen.File(path)
    if f is None:
        raise ValueError(f"{Path(path).name} isn't a file whose tags can be written")
    if f.tags is None:
        f.add_tags()
    if isinstance(f, MP4):
        f.tags.pop("\xa9lyr", None)
        if text:
            f.tags["\xa9lyr"] = [text]
    elif isinstance(f.tags, ID3):
        f.tags.delall("USLT")
        if text:
            f.tags.add(USLT(encoding=3, lang="eng", desc="", text=text))
    else:
        for k in ("LYRICS", "UNSYNCEDLYRICS"):
            if k in f.tags:
                del f.tags[k]
        if text:
            f.tags["LYRICS"] = [text]
    f.save()


def file_metadata(path):
    """Everything a file says about itself, for the Tagger's Info: [(name, value)]."""
    import mutagen
    facts = file_facts(path)
    out = [("File", str(path)), ("Format", facts["format"]), ("Quality", facts["quality"]),
           ("Length", fmt_time(facts["duration"]) if facts["duration"] else ""),
           ("Bitrate", f"{facts['bitrate']} kbps" if facts["bitrate"] else ""),
           ("Size", f"{facts['size'] / 1e6:.1f} MB" if facts["size"] else "")]
    try:
        f = mutagen.File(path)
        tags = getattr(f, "tags", None) if f is not None else None
        for k in sorted(tags.keys(), key=str) if tags else []:
            name = str(k)
            if name.startswith(("APIC", "USLT", "SYLT")) or name.lower() in (
                    "covr", "metadata_block_picture", "lyrics", "unsyncedlyrics", "\xa9lyr"):
                continue
            v = tags[k]
            v = getattr(v, "text", v)
            v = ", ".join(str(x) for x in v) if isinstance(v, list) else str(v)
            out.append((name, v[:300]))
    except Exception:  # noqa: BLE001 -- the facts alone
        pass
    return [(k, v) for k, v in out if v]


def cover_image(data):
    """Picture bytes as a cover: (bytes, mime). A JPEG or PNG stays as it is; anything else
    (WebP, GIF…) becomes a JPEG. ValueError if it isn't a picture."""
    if data[:3] == b"\xff\xd8\xff":
        return data, "image/jpeg"
    if data[:8] == b"\x89PNG\r\n\x1a\n":
        return data, "image/png"
    try:
        from gi.repository import GdkPixbuf
        loader = GdkPixbuf.PixbufLoader()
        loader.write(data)
        loader.close()
        ok, buf = loader.get_pixbuf().save_to_bufferv("jpeg", ["quality"], ["92"])
        if ok:
            return bytes(buf), "image/jpeg"
    except (GLib.Error, AttributeError):
        pass
    raise ValueError("that isn't a picture")


def write_cover(path, data, mime):
    """Put data in the audio file at path as its front cover, in place of the one it has. The
    file is changed in a copy that then takes its place, so a song playing from it plays on."""
    import mutagen
    from mutagen.flac import Picture
    path = Path(path)
    tmp = path.with_name(f".{path.name}.cover")
    shutil.copyfile(path, tmp)
    try:
        f = mutagen.File(tmp)
        kind = type(f).__name__ if f is not None else ""
        pic = Picture()
        pic.type, pic.mime, pic.data = 3, mime, data   # 3: front cover
        if kind == "FLAC":
            f.clear_pictures()
            f.add_picture(pic)
        elif kind in ("MP3", "EasyMP3", "WAVE", "AIFF", "DSF"):   # ID3: an MP3's, or in a WAV's or AIFF's chunk
            from mutagen.id3 import APIC
            if f.tags is None:
                f.add_tags()
            f.tags.delall("APIC")
            f.tags.add(APIC(encoding=3, mime=mime, type=3, desc="Cover", data=data))
        elif kind == "MP4":
            from mutagen.mp4 import MP4Cover
            if f.tags is None:
                f.add_tags()
            f.tags["covr"] = [MP4Cover(data, MP4Cover.FORMAT_PNG if mime == "image/png" else MP4Cover.FORMAT_JPEG)]
        elif kind in ("OggVorbis", "OggOpus"):
            f["metadata_block_picture"] = [base64.b64encode(pic.write()).decode()]
        else:
            raise ValueError(f"{path.suffix or 'these'} files can't hold a cover")
        f.save()
        try:
            os.replace(tmp, path)
        except PermissionError:   # Windows, while it plays: in place after all
            shutil.copyfile(tmp, path)
    finally:
        tmp.unlink(missing_ok=True)


