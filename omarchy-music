            self.lazy(lst, len(artists), add)
            self.pictures_for([n for n, _v in artists[:400]])
            return
        items = self.time_items(what, tt, a.top_period)
        self.section(lst, f"{len(items)} {'SONGS' if what == 'songs' else 'ALBUMS'} · LISTENED TO LONGEST FIRST")
        if what == "songs":
            tracks = [x["track"] for x in items]

            def add_song(i):
                self.add_track(lst, tracks[i], i, tracks, extra=fmt_hours(items[i]["secs"]))
