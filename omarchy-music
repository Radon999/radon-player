    def track_list(self, key):
        lst = SongList(self, lambda row: self.on_row(key, row))
        lst.add_css_class("tracks")
        setattr(self, f"{key}_list", lst)
        return lst

    def shown(self, tab):
        """Whether tab is what you see now: the window open and that tab in front."""
        return self.get_visible() and self.stack.get_visible_child_name() == tab

    def when_shown(self, tab, rebuild):
        """rebuild now if tab is in view, else once you go to it: rebuilding lists nobody sees,
        on every song and every download, made the window lag (most on Windows)."""
        if self.shown(tab):
            self.stale.pop(tab, None)
            rebuild()
        else:
            self.stale[tab] = rebuild

    def run_stale(self, tab):
        rebuild = self.stale.pop(tab, None)
        if rebuild:
            rebuild()

    def mark_rows(self):
        """What's playing and what's saved, on the rows there are, without rebuilding the lists."""
        cur = (self.app.current_track() or {}).get("id")
        for key in ("search", "account", "music", "artist"):
            for r in self.rows(getattr(self, f"{key}_list", None)):
                (r.add_css_class if r.track["id"] == cur else r.remove_css_class)("playing")
                r.update_mark()

    def redraw_art(self, ids):
        """Songs ids got a new cover: forget the old one and show the new one on the rows there are."""
        for v in ids:
            self.art.textures.pop(v, None)
            self.art.paths.pop(v, None)
            self.art.none.discard(v)
        for key in ("search", "account", "music", "artist", "queue"):
            for r in self.rows(getattr(self, f"{key}_list", None)):
                if r.track["id"] in ids and r.cell is not None and r.cell.row is r:
                    r.cell.pic.clear()
                    self.art.apply(r.cell.pic, r.track)

    def song_changed(self):
        """Another song plays: the marks move, and Up next starts from it."""
        self.mark_rows()
        self.refresh_queue()
        self.update_saved()

    def show_tab(self, key):
        if key == "lyrics":   # 1.4: the lyrics are in Now playing, in the cover's place
            self.show_tab("nowplaying")
            self.show_np_lyrics(True)
            return
        if key in self.tab_buttons and not self.tab_buttons[key].get_active():
            self.tab_buttons[key].set_active(True)
        if key == "settings" and self.stack.get_visible_child_name() != "settings":
            self.settings_open = set(getattr(self, "settings_section", None) or ())   # opened: every section folded
        self.settings_section = None
        if self.stack.get_visible_child_name() == "eq" and key != "eq":
            self.app.eq_settled()   # done adjusting: the filters rebuilt with the new gains
        self.stack.set_visible_child_name(key)
        self.run_stale(key)
        (self.visualizer.start if key == "visualizer" else self.visualizer.stop)()
        if key == "settings":
            self.app.updater.check_soon()
            self.refresh_accounts()
        elif key == "search":
            GLib.idle_add(lambda: (self.entry.grab_focus(), False)[1])
        if key == "lyrics":
