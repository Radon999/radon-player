    def artist_found(self, name, info):
        """An artist's picture came in: on their tile, and on their page if it's open."""
        pic = self.artist_tiles.get(norm(name))
        if pic is not None and info.get("image"):
            pic.set_pixel_size({"list": 42, "grid": 148, "compact": 112}[self.page_layout("artists")])   # (the stand-in icon is smaller)
            pic.set_hexpand(False)
            self.art.apply(pic, artist_picture(name, info["image"]), 320)
        page = self.artist_pages[-1] if getattr(self, "artist_pages", None) else None
