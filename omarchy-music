    def library_artists(self):
        """Every artist in your songs (album artist, else artist; "A & B" as both), kept until your songs change."""
        try:
            lib_t = os.stat(LIBRARY).st_mtime
        except OSError:
            lib_t = 0
        loc = self.app.local
        picks = getattr(self.app, "artist_picks", {}) or {}
        sig = (len(self.lib.items), lib_t, len(loc.files), loc.scanned, json.dumps(picks, sort_keys=True))
        got = self.__dict__.get("_lib_artists")
        if got and got[0] == sig:
            return got[1]
        names = {}
        merged = {k: v for k, v in picks.items() if v}   # Merge into…: an artist's songs show under the one merged into
        for t in self.app.my_songs():
            for n in own_artists(t.get("albumartist") or t.get("artist") or ""):
                n = merged.get(pair_key(n), n)
                if norm(n) not in VARIOUS and n != "Unknown artist":
                    names.setdefault(norm(n), n)
        self._lib_artists = (sig, names)
        return names

    def refresh_artists(self):
        a = self.app
        a.stats.refresh()
        # Your most played (as many as ARTISTS_SHOWN), then every other artist you have songs of: by plays, then name.
        top = list(a.stats.artists[:self.ARTISTS_SHOWN])
        have = {norm(x["name"]) for x in top}
        plays = {norm(x["name"]): x for x in a.stats.artists}
        rest = []
        for k, n in self.library_artists().items():
            if k not in have:
                x = plays.get(k)
                rest.append(dict(x) if x else {"name": n, "plays": 0})
        rest.sort(key=lambda x: (-x["plays"], norm(x["name"])))
        top += rest
        sig = (tuple((x["name"], x["plays"]) for x in top), a.stats.busy)
        if sig == self._artists_sig:
            return
        self._artists_sig = sig
        lay = self.page_layout("artists")
        self.artists_flow.set_max_children_per_line(1 if lay == "list" else 30)
        self.artists_flow.set_min_children_per_line(1 if lay == "list" else 2)
        self.artists_flow.set_homogeneous(lay != "list")
        self.artists_flow.set_column_spacing({"list": 0, "grid": 22, "compact": 12}[lay])
        self.artists_flow.set_row_spacing({"list": 0, "grid": 16, "compact": 10}[lay])
        self.artists_flow.remove_all()
        self.artist_tiles = {}
        if not top:
            self.artists_note.set_label("WORKING YOUR PLAYS OUT…" if a.stats.busy else
                                        "NO PLAYS YET: CONNECT LAST.FM, IMPORT YOUR SPOTIFY HISTORY, OR PLAY A FEW SONGS")
            return
        self.artists_note.set_label(" · ".join([f"{len(top)} ARTISTS, YOUR MOST PLAYED FIRST"]
                                               + [" + ".join(s.upper() for s in a.stats.sources)] * bool(a.stats.sources)))
        for x in top:
            self.artists_flow.append(self.artist_tile(x))
        a.look_up_artists([x["name"] for x in top], self.artist_found)

