    def cleanup_start(self):
        """Empty folders: the folders with no music left in them, each with its size and files, picked to delete."""
        a = self.app
        roots = list(a.folders)
        if not roots:
            self.toast("Add your music folders first (Settings › Library & playback › Folders)")
            return
        dlg, body, status = self.work_dialog("Empty folders", full=True)
        status.set_label("Looking through your folders…")
        body.append(Gtk.Spinner(spinning=True, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER, vexpand=True))

        def found(res, err):
            res = [x for x in res or [] if not in_folders(x[0], a.fixup_skip)]   # Folders to leave alone: not offered
            if err is not None or not res:
                self.report(body, status, f"Couldn't look: {str(err)[:200]}" if err else "No empty folders: every folder has music in it.", [], dlg.close)
                return
            status.set_label(f"{len(res)} folder{'s' if len(res) != 1 else ''} with no songs in them. Untick the ones to keep, then Delete "
                             "(they go to the Recycle Bin).")

            def size(n):
                return f"{n / 1e6:.1f} MB" if n >= 1e5 else f"{n / 1e3:.0f} KB" if n else "empty"
            rows = [(self.in_music(d), [f"{size(n)} · " + (", ".join(files[:6]) + (f" and {len(files) - 6} more" if len(files) > 6 else "")
                                                         if files else "no files")]) for d, n, files in res]
            self.choices(body, rows, "Delete", "Leave alone", "Delete",
                         lambda picked: delete([d for (d, _n, _f), p in zip(res, picked) if p]))

        def delete(chosen):
            if not chosen:
                self.report(body, status, "Nothing deleted.", [], dlg.close)
                return
            status.set_label(f"Deleting {len(chosen)} folders…")

            def gone(res, err):
                n, failed = res or (0, [str(err)])
                bad = {f.split(":")[0] for f in failed}
                self.report(body, status, f"Deleted {n} folder{'s' if n != 1 else ''}.",
                            [f"Deleted {self.in_music(d)}" for d in chosen if Path(d).name not in bad]
                            + [f"Couldn't delete {f}" for f in failed], dlg.close)
                a.rescan()
            in_thread(a.delete_folders, chosen, done=gone)
        in_thread(empty_folders, roots, done=found)

