    def eq_fullscreen(self, on):
        """The window maximized (or full screen): the EQ's bands stretch as wide and tall as there is
        room; back to their usual size when it's not. (The window's own maximize button does it.)"""
        if on == self.eq_full or not hasattr(self, "eq_clamp"):
            return
        self.eq_full = on
        self.eq_clamp.set_maximum_size(100000 if on else 640)
        self.build_eq_bands()
        self.update_eq()
        if on:
            GLib.timeout_add(300, lambda: (self.eq_full and self.build_eq_bands(), self.update_eq(), False)[2])   # once the size is known

    def build_eq_bands(self):
        """The band sliders, as many as the EQ has (3 to 31)."""
        a = self.app
        n = a.eq["count"]
        bands = Gtk.Box(homogeneous=True, spacing=0 if n > 15 else 2)
        self.eq_scales, self.eq_values = [], []
        for i, hz in enumerate(eq_bands_for(n)):
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            value = Gtk.Label(width_chars=3 if n > 15 else 4)
            value.add_css_class("time")
            sc = Gtk.Scale(orientation=Gtk.Orientation.VERTICAL, inverted=True, draw_value=False,
                           halign=Gtk.Align.CENTER, tooltip_text=f"{eq_label(hz)} Hz")
            sc.add_css_class("volume")
            sc.add_css_class("eqband")
            sc.set_range(-EQ_RANGE, EQ_RANGE)
            sc.set_increments(0.5, 1)
            sc.connect("value-changed", lambda s, i=i: self.syncing_eq or a.set_eq_band(i, s.get_value()))
            reset = Gtk.GestureClick(button=Gdk.BUTTON_MIDDLE)  # middle-click a band: back to 0
            reset.connect("pressed", lambda *_, i=i: a.set_eq_band(i, 0))
            sc.add_controller(reset)
            hz_label = Gtk.Label(label=eq_label(hz))
            hz_label.add_css_class("hz")
            for w in (value, sc, hz_label):
                col.append(w)
            bands.append(col)
            self.eq_scales.append(sc)
            self.eq_values.append(value)
        if getattr(self, "eq_full", False):   # as tall as the screen allows, the full width
            tall = max(180, self.get_height() - 520)
            for sc in self.eq_scales:
                sc.set_size_request(-1, tall)
        elif n > 15:
            bands.set_size_request(n * 26, -1)
        self.eq_bands_box.set_child(bands)

    def boost_fader(self):
        """Boost: a fader beside the bands, from normal (the bottom) to 12 dB louder. A line marks how far it goes
        cleanly; above it the limiter has to squash the peaks."""
        a = self.app
        col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
        col.set_tooltip_text("Boost: louder than normal, for quiet headphones, on everything you play (each output its "
                             "own). Up to the line it stays clean; above it the limiter squashes the peaks")
        value = Gtk.Label(width_chars=5)
        value.add_css_class("time")
