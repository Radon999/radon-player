class SpotifyHistory:
    """What you played on Spotify, from the zip its privacy page gives you (the extended
    streaming history, or the past year's), as the phone reads it. A play counts from 30
    seconds, as Spotify counts streams; podcasts and videos are left out."""
    @staticmethod
    def default_path():
        return SPOTIFY_HISTORY

    def __init__(self, path=None):
        self.lock = threading.Lock()
        self.path = path or self.default_path()
        self.plays = [tuple(p) for p in read_json(self.path, {}).get("plays", [])]   # (start, artist, title, album, ms)

    def add(self, new):
        """Add plays, but not those here already: the same song starting or stopping
        within two minutes. How many were new."""
        with self.lock:
            have = {}
            for p in self.plays:
                have.setdefault(norm(clean_title(p[2])), []).append(p)
            fresh = []
            for p in new:
                same = have.setdefault(norm(clean_title(p[2])), [])
                end = p[0] + p[4] // 1000
                if all(abs(q[0] - p[0]) >= 120 and abs(q[0] + q[4] // 1000 - end) >= 120 for q in same):
                    same.append(p)
                    fresh.append(p)
            if fresh:
                self.plays = sorted(self.plays + fresh)
                write_atomic(self.path, json.dumps({"plays": self.plays}))
            return len(fresh)

    def clear(self):
        with self.lock:
            self.plays = []
            self.path.unlink(missing_ok=True)

    @staticmethod
    def parse(entries):
        """The plays in one history file. The extended history: ts (when it stopped, UTC),
        ms_played, master_metadata_*; the past year's: endTime ("2024-01-31 18:02", UTC),
        artistName, trackName, msPlayed."""
        out = []
        for e in entries if isinstance(entries, list) else []:
            if not isinstance(e, dict):
                continue
            ms = int(e.get("ms_played") or e.get("msPlayed") or 0)
            title = e.get("master_metadata_track_name") or e.get("trackName")
            artist = e.get("master_metadata_album_artist_name") or e.get("artistName")
            try:
                if e.get("ts"):
                    end = int(datetime.fromisoformat(e["ts"].replace("Z", "+00:00")).timestamp())
                elif e.get("endTime"):
                    end = int(datetime.strptime(e["endTime"], "%Y-%m-%d %H:%M").replace(tzinfo=timezone.utc).timestamp())
                else:
                    continue
            except (TypeError, ValueError):
                continue
            if ms >= 30000 and title and artist and artist != "Unknown Artist":
                out.append((end - ms // 1000, artist, title, e.get("master_metadata_album_album_name") or "", ms))
        return out

    @staticmethod
    def wanted(path):
        name = path.replace("\\", "/").rsplit("/", 1)[-1]
        return name.endswith(".json") and (name.startswith("Streaming_History_Audio") or (
            name.startswith("StreamingHistory") and "podcast" not in name.lower() and "video" not in name.lower()))

    def import_file(self, path):
        """Read Spotify's zip (or one of its .json files); how many plays were new (blocking)."""
        out = []
        if zipfile.is_zipfile(path):
            with zipfile.ZipFile(path) as z:
                names = [n for n in z.namelist() if self.wanted(n)]
                if not names:
                    raise ValueError("there's no streaming history in that zip: Spotify's download has "
                                     "Streaming_History_Audio files (or StreamingHistory_music)")
                for n in names:
                    with z.open(n) as f:
                        try:
                            out += self.parse(json.load(f))
                        except ValueError:
                            pass   # not a history file after all
        else:
            out = self.parse(read_json(Path(path), []))
        if not out:
            raise ValueError("no songs played for 30 seconds or more in it")
        return self.add(out)


