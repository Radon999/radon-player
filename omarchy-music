    "google_cx": ("Google search engine ID", "A Programmable Search Engine (programmablesearchengine.google.com) set to search the whole web"),
    "autoeq_api": ("AutoEq server", "The address of an AutoEqApi server of your own (github.com/timschneeb/AutoEqApi)"),
