    def load_big_art(self, t):
        """The cover at full size for Now playing (rows use a small copy)."""
        if not hasattr(self, "big_pic") or self.stack.get_visible_child_name() != "nowplaying":
            return
        vid = t["id"]
        if getattr(self, "big_vid", None) == vid:
            return
        lib = self.lib.items.get(vid)
        path = self.art.paths.get(vid) or (Path(lib["art"]) if lib and lib.get("art") else None)
        self.big_pic.set_paintable(self.art.textures.get(vid))
        if not path:
            return
        self.big_vid = vid

        def done(tex, _err):
            cur = self.app.current_track()
            if tex is not None and cur and cur["id"] == vid:
                self.big_pic.set_paintable(tex)
        in_thread(load_texture, path, 900, done=done)

