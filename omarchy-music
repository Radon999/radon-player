    def work_dialog(self, title, width=640, full=False):
        """A dialog for a job in steps: (dialog, its body box, a status label). The body is swapped at each step.
        full: a borderless window filling the screen instead (long lists to read: Fix albums and artists, Empty
        folders); Esc closes it."""
        page = Adw.ToolbarView()
        bar = Adw.HeaderBar()
        page.add_top_bar(bar)
        if full:
            dlg = Adw.Window(title=title, transient_for=self, modal=True, decorated=False)
            bar.set_title_widget(Adw.WindowTitle(title=title))
            esc = Gtk.ShortcutController(scope=Gtk.ShortcutScope.GLOBAL)
            esc.add_shortcut(Gtk.Shortcut(trigger=Gtk.ShortcutTrigger.parse_string("Escape"),
                                          action=Gtk.CallbackAction.new(lambda *_: (dlg.close(), True)[1])))
            dlg.add_controller(esc)
        else:
            dlg = Adw.Dialog(title=title, content_width=width, content_height=680)
        m = 32 if full else 14
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_start=m, margin_end=m, margin_bottom=14)
        status = Gtk.Label(xalign=0, wrap=True)
        status.add_css_class("sub")
        body = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, vexpand=True)
        outer.append(status)
        outer.append(body)
        page.set_content(outer)
        if full:
            dlg.set_content(page)
            try:   # the size of the screen, then maximized: borderless, not true full screen (which stuttered on Windows)
                mon = self.get_display().get_monitor_at_surface(self.get_surface())
                g = mon.get_geometry()
                dlg.set_default_size(g.width, g.height)
            except Exception:  # noqa: BLE001 -- maximized alone
                pass
            dlg.maximize()
            dlg.present()
        else:
            dlg.set_child(page)
            dlg.present(self)
        return dlg, body, status

