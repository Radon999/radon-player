            b.set_child(inner)
            b.add_css_class("menu-item")
            b.add_css_class("option")
            if cb is None:   # a playlist: picked from a menu of them, by the Options button
                b.connect("clicked", lambda *_: (dlg.close(), self.playlist_menu(self.sel_options, tracks, after=self.after_option)))
            elif isinstance(cb, str):   # a dialog of its own: the selection waits for it
                b.connect("clicked", lambda *_, k=cb: (dlg.close(), dialogs[k]()))
            else:
