    def suggest_box(self, entry, names, several=False):
        """entry with a live list under it of names (a function giving them) that match what's typed, best
        first: a box holding both. several: an entry of "A, B": suggests for the part after the last comma
        or "&", keeping the ones before it."""
        matches = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        matches.add_css_class("boxed-list")
        pop = Gtk.Revealer(child=Gtk.ScrolledWindow(child=matches, propagate_natural_height=True, max_content_height=220,
                                                    hscrollbar_policy=Gtk.PolicyType.NEVER),
                           transition_type=Gtk.RevealerTransitionType.SLIDE_DOWN)
        holder = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, hexpand=True)
        holder.append(entry)
        holder.append(pop)
        chosen, cache = [False], []

        def split(text):
            if not several:
                return "", text
            m = re.match(r"^(.*(?:,|\s&)\s*)([^,&]*)$", text)
            return (m.group(1), m.group(2)) if m else ("", text)

        def take(_lst, row):
            if row is None:
                return
            chosen[0] = True
            before, _q = split(entry.get_text())
            entry.set_text(before + row.get_child().get_label())
            entry.set_position(-1)
            pop.set_reveal_child(False)
        matches.connect("row-activated", take)

        def changed(_e):
            if chosen[0]:
                chosen[0] = False
                return
            q = norm(split(entry.get_text())[1].strip())
            self.clear_box(matches)
            if not q:
                pop.set_reveal_child(False)
                return
            if not cache:
                cache.append(sorted(set(n for n in names() if n), key=norm))
            ranked = sorted(((0 if norm(n).startswith(q) else 1 if any(w.startswith(q) for w in norm(n).split()) else 2,
                              norm(n), n) for n in cache[0] if q in norm(n)))[:10]
            for _r, _k, n in ranked:
                if norm(n) == norm(entry.get_text().strip()):
                    continue
                matches.append(Gtk.ListBoxRow(child=Gtk.Label(label=n, xalign=0, margin_start=8, margin_end=8,
                                                              margin_top=4, margin_bottom=4)))
            pop.set_reveal_child(matches.get_row_at_index(0) is not None)
        entry.connect("changed", changed)
        entry.connect("activate", lambda *_: take(matches, matches.get_row_at_index(0)) if pop.get_reveal_child() else None)
        focus = Gtk.EventControllerFocus()
        focus.connect("leave", lambda *_: GLib.timeout_add(200, lambda: (pop.set_reveal_child(False), False)[1]))
        entry.add_controller(focus)
        return holder

