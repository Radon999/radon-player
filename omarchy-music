            lst.append(Gtk.ListBoxRow(activatable=False, selectable=False, child=box))
        bars("By hour of the day", tt.get("hours") or [0] * 24, [str(h) if h % 3 == 0 else "" for h in range(24)])
        bars("By day of the week", tt.get("days") or [0] * 7, ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"])
        if what == "artists":
            artists = tt.get("artists") or []
            self.section(lst, f"{len(artists)} ARTISTS · LISTENED TO LONGEST FIRST")

            def add(i):
                n, v = artists[i]
