        dupes.add(Adw.Toggle(label="Replace", name="replace",
                             tooltip="Download it, your copy to the trash; playlists get the download"))
        dupes.set_active_name(a.dupe_action)
        dupes.connect("notify::active-name", lambda g, _p: g.get_active_name() and a.set_dupe_action(g.get_active_name()))
        line("Copies", "Downloading a song you have already", False, dupes)
        remote = Gtk.Switch(active=a.remote_on, valign=Gtk.Align.CENTER)
        remote.connect("notify::active", lambda sw, _p: sw.get_active() != a.remote_on and a.set_remote(sw.get_active()))
        paired = len(a.remote_tokens)
