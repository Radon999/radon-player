    def cover_album(self, groups, i):
        a, songs = self.app, groups[i]
        t = songs[0]
        album = t.get("album") or ""
        name = f"“{album}”" if album else f"“{t['title']}”"

        rest = [x for g in groups[i:] for x in g]   # this album's songs and the ones after it
        applied_all = []

        def next_album():
            if i + 1 < len(groups) and not applied_all:
                GLib.idle_add(lambda: (self.cover_album(groups, i + 1), False)[1])
        # The whole album: every song of yours from it, not only the ones picked.
        whole = [x for x in a.my_songs() if album and album_key(x) == album_key(t)] if album else []
        every = Gtk.CheckButton(label=f"Apply the cover to all songs on this album ({len(whole)})", active=True,
                                visible=len(whole) > len(songs))
        # Several albums picked: one cover for every song picked at once (on), or album by album (off)
        all_of = Gtk.CheckButton(label=f"Use this cover for all {len(rest)} songs picked, not one album at a time",
                                 active=True, visible=len(groups) - i > 1)
        extras = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        extras.append(all_of)
        extras.append(every)
        lead = t["artist"].split(",")[0].strip()

        def use(src, done):
            if all_of.get_active() and all_of.get_visible():
                applied_all.append(1)
                targets = rest
            else:
                targets = whole if every.get_active() and whole else songs
            a.set_cover_soon(targets, src, done=done)

        def find(q=None):
            if q:   # searched by hand: "Artist - Album", or any words
                artist, _sep, rest = q.partition(" - ")
                return a.pictures.cover_choices(artist.strip(), rest.strip()) if rest.strip() else \
                    a.pictures.cover_choices("", q)
            return a.pictures.cover_choices(lead, album or t["title"])
        self.pick_picture("Cover", f"Cover of {name}" + (f" · {i + 1} of {len(groups)}" if len(groups) > 1 else ""),
                          f"{t['artist']}" + (" · found automatically, or search below" if album else ""),
                          find, use, "Skip" if i + 1 < len(groups) else "Cancel", next_album,
                          query=f"{lead} - {album or t['title']}", extra=extras)

    def pick_picture(self, title, heading, sub, find, use, skip_label="Cancel", after=None, query=None, extra=None):
        """A dialog of pictures to pick one from: find() (blocking) gives [{"url", "thumb", "from"}];
        use(url or file, done) puts the one picked to use and calls done when it has. after() runs
        once the dialog is through (picked or skipped)."""
        dlg = Adw.Dialog(title=title, content_width=560, content_height=560)
        page = Adw.ToolbarView()
        page.add_top_bar(Adw.HeaderBar())
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_start=14, margin_end=14, margin_bottom=14)
        head = Gtk.Label(label=heading, xalign=0, wrap=True)
        head.add_css_class("title-4")
        subl = Gtk.Label(label=sub, xalign=0, wrap=True)
        subl.add_css_class("service")
        status = Gtk.Label(label="Looking on Google, Genius and Wikipedia…", xalign=0, wrap=True)
        status.add_css_class("service")
        flow = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=4, min_children_per_line=3,
                           column_spacing=8, row_spacing=8, homogeneous=True, valign=Gtk.Align.START)
        scroll = Gtk.ScrolledWindow(child=flow, vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        buttons = Gtk.Box(spacing=8, halign=Gtk.Align.END)
        busy = []

        def through():
            dlg.close()
            if after:
                after()

        def picked(source):
            if busy:
                return
            busy.append(1)
            status.set_label("Putting it to use…")
            use(source, through)

        def pick_file(_b):
            filt = Gtk.FileFilter(name="Pictures")
            filt.add_mime_type("image/*")
            filters = Gio.ListStore.new(Gtk.FileFilter)
            filters.append(filt)
            fd = Gtk.FileDialog(title="Choose a picture", filters=filters, default_filter=filt)

            def chosen(d, res):
                try:
                    f = d.open_finish(res)
                except GLib.Error:
                    return
                if f and f.get_path():
                    picked(f.get_path())
            fd.open(self, None, chosen)
        for label, cb in (("Choose a file…", pick_file), (skip_label, lambda _b: through())):
            b = Gtk.Button(label=label)
            b.connect("clicked", cb)
            buttons.append(b)
        search = None
        if query is not None:   # search by hand: other words, when the ones found aren't right
            search = Gtk.SearchEntry(text=query, placeholder_text="Artist - Album", hexpand=True)
            search.add_css_class("search")
        for w in (head, subl, search, status, scroll, extra, buttons):
            if w is not None:
                box.append(w)
        page.set_content(box)
        dlg.set_child(page)
        seq = [0]

        def tile(c):
            pic = Gtk.Picture(content_fit=Gtk.ContentFit.COVER, width_request=120, height_request=120)
            pic.add_css_class("art")
            lab = Gtk.Label(label=c["from"])
            lab.add_css_class("service")
            col = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2)
            col.append(pic)
            col.append(lab)
            btn = Gtk.Button(child=col, tooltip_text=c["url"])
            btn.add_css_class("flat")
            btn.connect("clicked", lambda _b: picked(c["url"]))
            dest = CACHE / "covers" / (hashlib.sha1(c["thumb"].encode()).hexdigest()[:16] + ".jpg")
            in_thread(lambda: dest.exists() or fetch_url(c["thumb"], dest),
                      done=lambda _r, err: pic.set_paintable(load_texture(dest, 240)) if not err else btn.set_visible(False))
            return btn

        def found(choices, err, n=0):
            if n != seq[0]:
                return
            choices = choices or []
            for c in choices[:12]:
                flow.append(tile(c))
            status.set_label(f"Pick the right one ({len(choices[:12])} found), or choose a file." if choices else
                             "Nothing found: unreleased songs often have none. Search other words, choose a file, or skip it.")
        in_thread(find, done=found)
        if search is not None:
            def again(e):
                q = e.get_text().strip()
                if not q:
                    return
                seq[0] += 1
                n = seq[0]
                while (child := flow.get_first_child()):
                    flow.remove(child)
                status.set_label(f"Looking for “{q}”…")
                in_thread(find, q, done=lambda c, err: found(c, err, n))
            search.connect("activate", again)
        dlg.present(self)

