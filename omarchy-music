    if art:
        try:
            pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(art), 132, 132, False)
            cr.save()
            r = 14
            cr.new_sub_path()
            for cx, cy, a0 in ((x + 132 - r, y + r, -math.pi / 2), (x + 132 - r, y + 132 - r, 0), (x + r, y + 132 - r, math.pi / 2), (x + r, y + r, math.pi)):
                cr.arc(cx, cy, r, a0, a0 + math.pi / 2)
            cr.close_path()
            cr.clip()
            Gdk.cairo_set_source_pixbuf(cr, pb, x, y)
            cr.paint()
            cr.restore()
