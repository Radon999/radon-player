                 2000, 2500, 3150, 4000, 5000, 6300, 8000, 10000, 12500, 16000, 20000)}.get(n, EQ_BANDS)


def eq_q_for(n):
    """Each band's width: narrower the more bands there are, so they still blend."""
    return {3: 0.45, 5: 0.75, 15: 2.15, 31: 4.32}.get(n, EQ_Q)


def eq_label(hz):
    return (f"{hz // 1000}k" if hz % 1000 == 0 else f"{hz / 1000:.1f}k") if hz >= 1000 else str(hz)


def eq_resample(gains, frm, n):
    """gains (at the frequencies frm) moved onto n bands: read off the curve, in log frequency."""
    to = eq_bands_for(n)
    if len(gains) == len(to) and tuple(frm) == tuple(to):
        return [float(g) for g in gains]
    xs = [math.log(f) for f in frm]
    out = []
    for hz in to:
        x = math.log(hz)
        if x <= xs[0]:
            out.append(float(gains[0]))
        elif x >= xs[-1]:
            out.append(float(gains[-1]))
        else:
            j = next(k for k in range(1, len(xs)) if xs[k] >= x)
            t = (x - xs[j - 1]) / (xs[j] - xs[j - 1])
            out.append(round((gains[j - 1] + (gains[j] - gains[j - 1]) * t) * 2) / 2)
    return out


def eq_preset_bands(key, n):
    """A preset's bands on n bands (None for Custom)."""
    g = EQ_PRESETS.get(key, (None, None))[1]
    return None if g is None else eq_resample(list(g), EQ_BANDS, n)


