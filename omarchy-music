    def pin_of_row(self, pl):
        """The pin for a row of a list (a playlist, an album, genre or folder of yours, an artist or album
        from a service, or a folder of playlists); None for what can't be pinned."""
        a, k = self.app, pl.get("kind")
        if pl.get("pin") is not None:
            return a.pins[pl["pin"]] if pl["pin"] < len(a.pins) else None
        if k == "group":
            return {"kind": "group", "view": self.music_view, "id": pl["id"], "title": pl["title"]}
        if k == "artist":
            return {"kind": "artist", "name": pl["title"], "source": pl.get("source"), "thumb": pl.get("thumb") or ""}
        if k == "album":
            return {"kind": "album", "album": {x: pl.get(x) for x in ("id", "title", "sub", "thumb", "source", "artist") if pl.get(x)},
                    "title": pl["title"]}
        if k == "folder":
            return {"kind": "listfolder", "id": pl["id"], "where": self.folder_in or "music", "title": pl["title"]}
        item = pl.get("folder_item") or PlaylistFolders.item(a.lists.get(pl["id"]) or pl, a.source)
        return {"kind": "playlist", "item": item, "title": pl["title"]}

