            pic.set_pixel_size(18)
        box.append(frame)
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, valign=Gtk.Align.CENTER, hexpand=True)
        title = Gtk.Label(label=playlist["title"], xalign=0, ellipsize=Pango.EllipsizeMode.END)
        title.add_css_class("title")
