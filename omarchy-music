def path_part(name, fallback="Unknown"):
    """name made safe as one folder or file name, on Windows too."""
    name = re.sub(r'[<>:"/\\|?*\x00-\x1f]', "_", str(name or "")).strip().rstrip(". ")
    return (name or fallback)[:120]


