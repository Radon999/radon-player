def similar_artists(library, played, titles, picks=None, kept=(), counts=None):
    """Similar artists…: artists that look like another one of yours, [(name, theirs, plays, [the same songs' titles])],
    the ones with songs of the same name first. One is "theirs" when all of its name is inside the other's
    ("cavetown offline" and Cavetown), when they're spelt nearly the same (Bad Sons and Bad Suns), or when they share a
    word that names something and a song of the same name (Forrest and Forrest Frank; never "the", "young", "lil" or
    another common word: NAME_WORDS). The one with fewer songs here goes into the other. library: your artists' names; played: {name:
    plays}; titles: {artist key: {song title keys}}; counts: {artist key: your songs}. Pairs ("A & B"), merged ones
    and ones you kept apart are left out."""
    picks, counts = picks or {}, counts or {}
    key = lambda n: re.sub(r"[\W_]+", "", norm(n))   # noqa: E731
    words = lambda n: re.findall(r"\w+", norm(n))      # noqa: E731
    names = {}
    for n in list(library) + list(played):
        if n and len(duo_parts(n)) == 1 and pair_key(n) not in picks and len(key(n)) >= 3:
            names.setdefault(key(n), n)
    mine = {key(n) for n in library}
    by_word = collections.defaultdict(set)
    for k, n in names.items():
        for w in set(words(n)):
            if len(w) >= 4 and w not in NAME_WORDS and not w.isdigit():
                by_word[w].add(k)
    by_start = collections.defaultdict(list)
    for k in names:
        by_start[k[:2]].append(k)
    seen, out = set(), []
    keys = list(names)
    for i, ka in enumerate(keys):
        cands = set()
        for w in set(words(names[ka])):
            cands |= by_word.get(w, set())
        for kb in by_start.get(ka[:2], ()):   # spelt nearly the same: only names starting alike, of about the same length
            if kb != ka and kb not in cands and abs(len(ka) - len(kb)) <= 2 and min(len(ka), len(kb)) >= 5:
                m = difflib.SequenceMatcher(None, ka, kb)
                if m.quick_ratio() >= 0.85 and m.ratio() >= 0.85:
                    cands.add(kb)
        for kb in cands:
            if kb == ka or (ka, kb) in seen or (kb, ka) in seen:
                continue
            seen.add((ka, kb))
            if ka not in mine and kb not in mine:
                continue   # neither has songs here: nothing to put together
            a, b = names[ka], names[kb]
            wa, wb = words(a), words(b)
            inside = any(wa[j:j + len(wb)] == wb for j in range(len(wa) - len(wb) + 1)) or \
                any(wb[j:j + len(wa)] == wa for j in range(len(wb) - len(wa) + 1))
            shared = {w for w in set(wa) & set(wb) if len(w) >= 4 and w not in NAME_WORDS and not w.isdigit()}
            close = abs(len(ka) - len(kb)) <= 2 and min(len(ka), len(kb)) >= 5 and similar(ka, kb) >= 0.85
            same_songs = titles.get(ka, set()) & titles.get(kb, set())
            short = min((wa, wb), key=len)
            # A name inside the other counts when it's a name of its own (two words, or a long one) or they have a
            # song in common; a shared word only with a song in common (Jack Johnson isn't Jack Harlow).
            if not ((inside and (len(short) >= 2 or len(min(ka, kb, key=len)) >= 6 or same_songs)) or close
                    or (shared and same_songs)):
                continue
            # The one with fewer of your songs (then fewer plays) goes into the other.
            src, dst = (a, b) if (counts.get(ka, 0), played.get(a, 0)) < (counts.get(kb, 0), played.get(b, 0)) else (b, a)
            if key(dst) not in mine or f"{key(src)}>{key(dst)}" in kept:
                continue
            same = sorted(titles.get(key(src), set()) & titles.get(key(dst), set()))
            out.append((src, dst, played.get(src, 0), same))
    out.sort(key=lambda x: (not x[3], -x[2], norm(x[0])))
    return out


def resolver_of(app):
    """The app's artist_resolver; one made from its songs where it has none of its own (the tests' stand-ins)."""
    try:
        return app.artist_resolver()
    except Exception:  # noqa: BLE001
        try:
            return artist_resolver(app.my_songs(), getattr(app, "artist_picks", None))
        except Exception:  # noqa: BLE001 -- no songs to ask: each credit's first artist
            return lambda c: artist_resolver([], {})(c)


def resolved_key(name):
    """The key an artist's plays are added up under: a pair kept as a pair is its own (not its first artist's)."""
    if len(duo_parts(name)) > 1:
        return re.sub(r"[\W_]+", "", norm(name))
    return stats_key(name, name)[1]


def joint_credits(credits, songs, picks=None):
    """The pairs (or more) in credits that Most played can't tell the main artist of: [(credit, [their names],
    what's picked or None)], for Joint artists…, the most played first (credits: {credit: plays})."""
    picks = picks or {}
    solo = solo_artists(songs)
    spelt = solo_spellings(songs)
    alone = {k: spelt[k] for k in solo if k in spelt} or {k: k for k in solo}
    counts = credit_counts(songs)
    out, seen = [], set()
    for credit, _n in sorted(credits.items(), key=lambda kv: -kv[1]):
        lead = re.split(r"\s+(?:feat\.?|ft\.?|featuring|with)\s+", credit or "", flags=re.I)[0].strip()
        parts = duo_parts(lead)
        pk = pair_key(lead)
        if len(parts) <= 1 or pk in seen:
            continue
        seen.add(pk)
        _main, sure = pick_main(lead, alone, counts)
        if not sure or pk in picks:
            out.append((lead, parts, picks.get(pk)))
    return out


def duo_parts(credit):
    """The artists of a credit joined by "&", "x" or commas ("Phoebe Ryan x Quinn XCII"); a band's own name stays whole
    ("Of Monsters and Men", "Lil Nas X", "Tyler, The Creator")."""
    credit = (credit or "").strip()
    if not re.search(r" & | x |,|;", credit) or (credit.count(",") == 1 and not re.search(r" & | x |;", credit)):
        return [credit] if credit else []
    return [p.strip() for p in re.split(r" & | x |,|;", credit) if p.strip()]


def solo_spellings(songs):
    """{artist key: how they're spelt on the songs credited to them alone, the most common}: K.Flay and KFlay are one."""
    seen = collections.defaultdict(Counter)
    for t in songs:
        for credit in (t.get("albumartist"), t.get("artist")):
            if credit and len(duo_parts(credit)) == 1 and not re.search(r"\s(?:feat\.?|ft\.?|featuring|with)\s", credit, re.I):
                seen[re.sub(r"[\W_]+", "", norm(credit))][credit.strip()] += 1
    return {k: c.most_common(1)[0][0] for k, c in seen.items()}


def credit_names(credit):
    """Each artist in a credit: "A & B feat. C" -> [A, B, C]."""
    parts = re.split(r",|;|\s+(?:feat\.?|ft\.?|featuring|with)\s+| & | x | X | and ", credit or "", flags=re.I)
    return [p.strip() for p in parts if p.strip()]


def fixup_other(c, other, own=False):
    """A change (fixup_plan's) with its album credited to other instead of the main artist picked: the songs
    other is credited on become theirs; the rest keep their artist and get other as album artist, so the
    album stays together under other. own: a name you typed for this song: its artist too. The change's album
    and track fixes stay."""
    old = c["old"]
    new = {k: v for k, v in c["new"].items() if k not in ("artist", "albumartist")}
    if own or any(artist_key(n) == artist_key(other) for n in credit_names(old["artist"])):
        artist = other
    else:
        artist = old["artist"]
    albumartist = other if (old["albumartist"] or artist != other) else ""
    for k, v in (("artist", artist), ("albumartist", albumartist)):
        if v != old[k]:
            new[k] = v
    return {**c, "new": new, "kinds": sorted(set(c["kinds"]) | {"artist"}),
            "why": f"“{old['albumartist'] or old['artist']}” → “{other}”"}


def fixup_album_row(c):
    """Whether a change (fixup_plan's) is one of an album only (an edition, a single, a remix, parts): its
    third choice is Other album, not Other artist."""
    return "artist" not in c["kinds"] and ("album" in c["new"] or bool(c.get("unfound")))


def fixup_with_others(changes, picked):
    """The changes to make: picked, for each change, True (as planned), False (left alone) or an artist's name
    (Other artist: fixup_other, and the album's songs that needed nothing moved to that artist too)."""
    out, done_groups = [], set()
    for c, p in zip(changes, picked):
        if not p:
            continue
        if p is True:
            if c["new"]:   # (a single with nothing found: nothing to change unless you pick an album)
                out.append(c)
            continue
        if fixup_album_row(c):   # Other album: onto the one picked instead (its number left as it was)
            new = {k: v for k, v in c["new"].items() if k not in ("album", "tracknumber")}
            if str(p) != c["old"]["album"]:
                new["album"] = str(p)
            if new:
                out.append({**c, "new": new, "why": f"“{c['old']['album'] or '(no album)'}” → “{p}”"})
            continue
        out.append(fixup_other(c, p, own=isinstance(p, OwnName)))
        if c.get("group") is not None and c["group"] not in done_groups:
            done_groups.add(c["group"])
            for s in c.get("siblings") or []:
                if s["file"] in {x["file"] for x in changes}:
                    continue
                d = fixup_other({**s, "kinds": [], "new": {}, "cover": None}, str(p))
                if d["new"]:
                    out.append(d)
    return out


def in_folders(path, folders):
    """Whether path is one of folders or inside one (Windows: any case, either slash)."""
    p = os.path.normcase(os.path.normpath(str(path)))
    for f in folders or ():
        f = os.path.normcase(os.path.normpath(str(f)))
        if p == f or p.startswith(f.rstrip(os.sep) + os.sep):
            return True
    return False


def fixup_moves(changes, songs, roots, skip=()):
    """Where each changed file goes after its tags are fixed: [(file, new path)], only those that move. Your
    folders are Artist/…/Album/song: the artist's folder becomes the main artist's (theirs if they have one),
    and an album's song goes to the folder its album's other songs are in. Never onto a file that's there, and
    nothing out of or into skip (the folders Fix albums and artists leaves alone)."""
    by_album = collections.defaultdict(collections.Counter)   # (album, artist) -> the folders its songs are in
    final = {t["file"]: dict(t) for t in songs}
    for c in changes:
        final[c["file"]].update({("track" if k == "tracknumber" else k): v for k, v in c["new"].items()})
    moving = {c["file"] for c in changes}
    for f, t in final.items():
        if f not in moving and t.get("album"):
            by_album[(norm(clean_title(t["album"])), artist_key(t.get("albumartist") or t.get("artist")))][str(Path(f).parent)] += 1
    out, taken = [], set()
    for c in changes:
        src = Path(c["file"])
        t = final[c["file"]]
        root = next((Path(r) for r in roots if str(src).startswith(str(Path(r)) + os.sep)), None)
        if root is None:
            continue
        there = by_album.get((norm(clean_title(t.get("album") or "")), artist_key(t.get("albumartist") or t.get("artist"))))
        if there:
            folder = Path(there.most_common(1)[0][0])
        else:
            parts = list(src.parent.relative_to(root).parts)
            if not parts:
                continue
            old, new = c["old"], {**c["old"], **c["new"]}
            for i, p in enumerate(parts):   # the artist's folder: the main artist's
                if norm(p) in (norm(old["artist"]), norm(old["albumartist"])) and norm(p) != norm(new["albumartist"] or new["artist"]):
                    mine = root.joinpath(*parts[:i], path_part(new["albumartist"] or new["artist"]))
                    sib = next((d for d in (root.joinpath(*parts[:i]).iterdir() if root.joinpath(*parts[:i]).is_dir() else [])
                                if d.is_dir() and norm(d.name) == norm(new["albumartist"] or new["artist"])), None)
                    parts[i] = (sib or mine).name
            if old["album"] != new["album"]:   # the album's folder: the album's new name
                for i, p in enumerate(parts):
                    if norm(p) == norm(old["album"]):
                        parts[i] = path_part(new["album"])
            folder = root.joinpath(*parts)
        dest = folder / src.name
        if dest == src or dest.exists() or str(dest).lower() in taken or in_folders(src, skip) or in_folders(dest, skip):
            continue
        taken.add(str(dest).lower())
        out.append((str(src), str(dest)))
    return out


def move_song(src, dest):
    """Move a song (and its .lrc beside it) to dest, making the folders; never over a file that's there."""
    src, dest = Path(src), Path(dest)
    if dest.exists():
        raise FileExistsError(f"{dest.name} is in {dest.parent.name} already")
    dest.parent.mkdir(parents=True, exist_ok=True)
    shutil.move(str(src), str(dest))
    for ext in (".lrc", ".LRC"):
        side = src.with_suffix(ext)
        if side.exists() and not dest.with_suffix(ext).exists():
            try:
                shutil.move(str(side), str(dest.with_suffix(ext)))
            except OSError:
                pass


# =============================================================================
# Tag scanner (Settings › Tags › Tagger › Scan…, the PC only): your songs' tags checked against Deezer's
# catalogue. What's missing (no year, no genre, no track number, no album…) or different (a misspelt title,
# the wrong album) is listed, an album at a time, each one Replace or Keep; an album with no cover (or a
# small one) gets up to three covers found for it to pick from, or Keep. Nothing is written until Apply.
# =============================================================================

SCAN_ALBUM_FIELDS = (("album", "Album"), ("albumartist", "Album artist"), ("date", "Year"), ("genre", "Genre"))
SCAN_SONG_FIELDS = (("title", "Title"), ("artist", "Artist"), ("tracknumber", "Track"))
SCAN_FIELDS = dict(SCAN_ALBUM_FIELDS + SCAN_SONG_FIELDS)
SCAN_SMALL_COVER = 500   # a cover smaller than this (pixels across) gets others offered


def scan_read(path):
    """The tags a song's file has: {title, artist, album, albumartist, date, genre, tracknumber} ("" for none)."""
    out = {k: "" for k in SCAN_FIELDS}
    try:
        f = easy_audio(path)
        tags = (f.tags if f is not None else None) or {}
        for k in out:
            v = tags.get(k)
            if v:
                out[k] = ", ".join(str(x) for x in v) if k == "artist" else str(v[0]).strip()
    except Exception:  # noqa: BLE001 -- unreadable: as if untagged
        pass
    out["tracknumber"] = out["tracknumber"].split("/")[0].strip().lstrip("0") or out["tracknumber"].split("/")[0].strip()
    return out


def picture_hash(data):
    """A picture's look as 64 bits (a difference hash of it at 9×8, in grey): pictures that look the same
    (a deluxe's cover with a sticker or a line of text more) have bits nearly the same. None for one that's
    nearly blank (a grey placeholder: every album without art would look alike) or isn't a picture."""
    from gi.repository import GdkPixbuf
    try:
        loader = GdkPixbuf.PixbufLoader()
        loader.write(data)
        loader.close()
        pb = loader.get_pixbuf().scale_simple(9, 8, GdkPixbuf.InterpType.BILINEAR)
    except (GLib.Error, AttributeError, TypeError):
        return None
    px, rs, nc = pb.get_pixels(), pb.get_rowstride(), pb.get_n_channels()
    grey = [[px[y * rs + x * nc] * 30 + px[y * rs + x * nc + 1] * 59 + px[y * rs + x * nc + 2] * 11 for x in range(9)]
            for y in range(8)]
    flat = [v for row in grey for v in row]
    mean = sum(flat) / len(flat)
    if sum((v - mean) ** 2 for v in flat) / len(flat) < (6 * 100) ** 2:   # hardly any light and dark: blank
        return None
    bits = 0
    for y in range(8):
        for x in range(8):
            bits = bits << 1 | (grey[y][x] > grey[y][x + 1])
    return bits


COVER_ALIKE = 10   # of picture_hash's 64 bits: this many or fewer different, the same cover


def embedded_cover(path):
    """The cover inside the audio file (not one beside it), as bytes, or None."""
    import mutagen
    try:
        f = mutagen.File(path)
        if f is None:
            return None
        if getattr(f, "pictures", None):
            return f.pictures[0].data
        tags = getattr(f, "tags", None) or {}
        for k in list(tags.keys()):
            if str(k).startswith("APIC"):
                return tags[k].data
        if "covr" in tags:
            return bytes(tags["covr"][0])
        if "metadata_block_picture" in tags:
            from mutagen.flac import Picture
            return Picture(base64.b64decode(tags["metadata_block_picture"][0])).data
    except Exception:  # noqa: BLE001 -- as if it had none
        return None
    return None


def picture_width(data):
    """How many pixels across a picture is (0 if it can't be read)."""
    try:
        from gi.repository import GdkPixbuf
        loader = GdkPixbuf.PixbufLoader()
        loader.write(data)
        loader.close()
        pb = loader.get_pixbuf()
        return min(pb.get_width(), pb.get_height())
    except Exception:  # noqa: BLE001
        return 0


def path_hints(path):
    """What a song's place says of it, for one with no tags: Artist/Album/03 Title.flac."""
    p = Path(path)
    title = re.sub(r"^\s*\d{1,3}\s*[-._)]?\s*", "", p.stem).strip() or p.stem
    return {"title": title, "album": p.parent.name, "artist": p.parent.parent.name}


_deezer_gap = threading.Lock()
_deezer_last = [0.0]


def deezer_get(url):
    """Deezer's API, at most about nine requests a second (it allows fifty in five seconds)."""
    with _deezer_gap:
        wait = _deezer_last[0] + 0.11 - time.monotonic()
        if wait > 0:
            time.sleep(wait)
        _deezer_last[0] = time.monotonic()
    data = http_json(url)
    if isinstance(data, dict) and (data.get("error") or {}).get("code") == 4:   # over the limit: once more, slower
        time.sleep(5)
        data = http_json(url)
    return data


def deezer_find_track(artist, title, album=""):
    """(blocking) The song on Deezer: {"id", "title", "artist", "album_id", "album"}, or None if nothing is
    close enough (the title, and the artist when there is one, as good as the same)."""
    want_t, want_a, want_al = norm(clean_title(title)), norm(lead_artist(artist) or artist), norm(bare_title(album or ""))
    queries = ([f'artist:"{lead_artist(artist) or artist}" track:"{bare_title(title) or title}"'] if artist else []) + \
              [f"{lead_artist(artist) or artist} {bare_title(title) or title}".strip()]
    for q in queries:
        res = deezer_get("https://api.deezer.com/search?" + urllib.parse.urlencode({"q": q, "limit": 15})) or {}
        if isinstance(res, dict) and res.get("error"):   # busy, or down: not "not found"
            raise RuntimeError(f"Deezer: {res['error']}")
        found = res.get("data") or []
        best, score = None, 0.0
        for d in found:
            s = similar(norm(clean_title(d.get("title") or "")), want_t)
            if artist:
                s = min(s, max(similar(norm(lead_artist((d.get("artist") or {}).get("name") or "")), want_a),
                               similar(norm((d.get("artist") or {}).get("name") or ""), norm(artist))))
            if want_al and similar(norm(bare_title((d.get("album") or {}).get("title") or "")), want_al) > 0.85:
                s += 0.05   # on the album the file says
            if not has_live(title) and (has_live(d.get("title") or "") or has_live((d.get("album") or {}).get("title") or "")):
                s -= 0.1   # a live recording, for a song that isn't one: the studio one first
            if s > score:
                best, score = d, s
        if best and score >= (0.85 if artist else 0.92):
            return {"id": best.get("id"), "title": best.get("title") or "", "artist": (best.get("artist") or {}).get("name") or "",
                    "album_id": (best.get("album") or {}).get("id"), "album": (best.get("album") or {}).get("title") or ""}
    return None


def deezer_song_albums(artist, title):
    """(blocking) Every album on Deezer the song is on (its single too), best match first: ["Persona", "Songs"]."""
    want_t, want_a = norm(clean_title(title)), norm(lead_artist(artist) or artist)
    q = f'artist:"{lead_artist(artist) or artist}" track:"{bare_title(title) or title}"'
    found = (deezer_get("https://api.deezer.com/search?" + urllib.parse.urlencode({"q": q, "limit": 25})) or {}).get("data") or []
    out = []
    for d in found:
        s = min(similar(norm(clean_title(d.get("title") or "")), want_t),
                max(similar(norm(lead_artist((d.get("artist") or {}).get("name") or "")), want_a),
                    similar(norm((d.get("artist") or {}).get("name") or ""), norm(artist))))
        name = (d.get("album") or {}).get("title") or ""
        if s >= 0.85 and name and name not in out:
            out.append(name)
    return out


def deezer_album_info(aid):
    """(blocking) A Deezer album: {"title", "artist", "date", "genre", "cover", "positions": {track id: number}}."""
    d = deezer_get(f"https://api.deezer.com/album/{aid}") or {}
    if not d.get("id"):
        return None
    tracks = (d.get("tracks") or {}).get("data") or []
    if (d.get("nb_tracks") or 0) > len(tracks) or any("track_position" not in t for t in tracks):   # all of them, numbered
        tracks = (deezer_get(f"https://api.deezer.com/album/{aid}/tracks?limit=300") or {}).get("data") or tracks
    return {"title": d.get("title") or "", "artist": (d.get("artist") or {}).get("name") or "",
            "date": d.get("release_date") or "", "genre": ((d.get("genres") or {}).get("data") or [{}])[0].get("name") or "",
            "cover": d.get("cover_xl") or d.get("cover_big") or "", "kind": d.get("record_type") or "",
            "positions": {t.get("id"): t.get("track_position") or i + 1 for i, t in enumerate(tracks)}}


def single_home_pick(title, found):
    """The album or EP a single is on, of found [{"album", "artist", "kind", "n", "date", "cover", "source"}] (kind:
    album, ep, single or compile): an album over an EP, its deluxe or extended edition over the plain one, the first
    one out over a reissue; never a single, a compilation, a best-of or sessions record, or a live album (for a song
    that isn't live). None if there's none."""
    good = []
    for h in found:
        name = (h.get("album") or "").strip()
        if not name or h.get("kind") in ("single", "compile") or is_single(name, title):
            continue
        if (has_live(name) or re.search(r"\blive (?:at|from|in|on)\b|\b(?:unplugged|in concert)\b", name, re.I)) and not has_live(title):
            continue   # a live album, for a studio song
        k = album_kind(name, title)
        if h.get("kind") == "ep" or is_ep(name):
            k = 1
        elif re.search(r"\bsessions?\b|\bgreatest hits\b|\bbest of\b", name, re.I):
            continue
        good.append((k, h))
    if not good:
        return None
    best = max(good, key=lambda x: (x[0], -int(re.sub(r"\D", "", x[1].get("date") or "")[:8] or 99999999)))[1]
    return {**best, "kind": "ep" if best.get("kind") == "ep" or is_ep(best["album"]) else "album"}


def deezer_single_homes(artist, title):
    """(blocking) The albums and EPs on Deezer a song is on: [{"album", "artist", "kind", "n", "date", "cover",
    "source"}]. Raises if Deezer is busy or down (not "not found")."""
    want_t, want_a = norm(clean_title(title)), norm(lead_artist(artist) or artist)
    q = f'artist:"{lead_artist(artist) or artist}" track:"{bare_title(title) or title}"'
    res = deezer_get("https://api.deezer.com/search?" + urllib.parse.urlencode({"q": q, "limit": 25})) or {}
    if isinstance(res, dict) and res.get("error"):
        raise RuntimeError(f"Deezer: {res['error']}")
    seen, out = set(), []
    for d in res.get("data") or []:
        s = min(similar(norm(clean_title(d.get("title") or "")), want_t),
                max(similar(norm(lead_artist((d.get("artist") or {}).get("name") or "")), want_a),
                    similar(norm((d.get("artist") or {}).get("name") or ""), norm(artist))))
        al = d.get("album") or {}
        if s < 0.85 or not al.get("id") or al["id"] in seen or is_single(al.get("title"), title):
            continue
        seen.add(al["id"])
        if len(seen) > 8:
            break
        info = deezer_album_info(al["id"])
        if info:
            out.append({"album": info["title"], "artist": info["artist"], "kind": info["kind"],
                        "n": info["positions"].get(d.get("id")), "date": info["date"], "cover": info["cover"], "source": "Deezer"})
    return out


def itunes_single_homes(artist, title):
    """(blocking) The albums and EPs on Apple Music (iTunes) a song is on, like deezer_single_homes."""
    want_t, want_a = norm(clean_title(title)), norm(lead_artist(artist) or artist)
    res = http_json("https://itunes.apple.com/search?" + urllib.parse.urlencode(
        {"term": f"{lead_artist(artist) or artist} {bare_title(title) or title}", "entity": "song", "limit": 25})) or {}
    out, seen = [], set()
    for r in res.get("results") or []:
        s = min(similar(norm(clean_title(r.get("trackName") or "")), want_t),
                max(similar(norm(lead_artist(r.get("artistName") or "")), want_a), similar(norm(r.get("artistName") or ""), norm(artist))))
        name = r.get("collectionName") or ""
        if s < 0.85 or not name or name in seen:
            continue
        seen.add(name)
        various = norm(r.get("collectionArtistName") or "") in VARIOUS
        kind = "compile" if various else "single" if re.search(r"\s-\sSingle$", name) else "ep" if re.search(r"\s-\sEP$", name) else "album"
        art = (r.get("artworkUrl100") or "").replace("100x100bb", "1200x1200bb")
        out.append({"album": name, "artist": r.get("collectionArtistName") or r.get("artistName") or artist, "kind": kind,
                    "n": r.get("trackNumber"), "date": (r.get("releaseDate") or "")[:10], "cover": art, "source": "Apple Music"})
    return out


def deezer_artist_releases(artist):
    """(blocking) The names of an artist's albums and EPs on Deezer (not singles or compilations), or []."""
    res = deezer_get("https://api.deezer.com/search/artist?" + urllib.parse.urlencode({"q": lead_artist(artist) or artist, "limit": 5})) or {}
    want = norm(lead_artist(artist) or artist)
    hit = next((d for d in res.get("data") or [] if norm(d.get("name") or "") == want), None)
    if not hit:
        return []
    found = (deezer_get(f"https://api.deezer.com/artist/{hit['id']}/albums?limit=200") or {}).get("data") or []
    return list(dict.fromkeys(d.get("title") or "" for d in found if d.get("record_type") in ("album", "ep") and d.get("title")))


def single_home(artist, title):
    """(blocking) Where a single belongs: single_home_pick of Deezer's albums, else Apple Music's; None if neither has
    one. Raises only if both couldn't be asked."""
    errors = []
    for look in (deezer_single_homes, itunes_single_homes):
        try:
            home = single_home_pick(title, look(artist, title))
        except Exception as e:  # noqa: BLE001 -- the next service
            errors.append(e)
            continue
        if home:
            return home
    if len(errors) == 2:
        raise errors[0]
    return None


def deezer_album_covers(artist, album, n=3):
    """(blocking) Covers of albums on Deezer named like this one, by this artist: [url]."""
    q = f'artist:"{artist}" album:"{bare_title(album) or album}"'
    found = (deezer_get("https://api.deezer.com/search/album?" + urllib.parse.urlencode({"q": q, "limit": 10})) or {}).get("data") or []
    good = [d for d in found if similar(norm(bare_title(d.get("title") or "")), norm(bare_title(album))) > 0.7]
    return [d.get("cover_xl") or d.get("cover_big") for d in good if d.get("cover_xl") or d.get("cover_big")][:n]


LIVE_PART = re.compile(r"\s*[(\[][^)\]]*\blive\b[^)\]]*[)\]]|\s+[-–—]\s+[^-–—]*\blive\b.*$", re.I)


def strip_live(title):
    """A song's name without its live part: "Song (Live)", "Song - Live at Red Rocks", "Song [Live]" -> "Song". A
    name that's only "Live…" ("Live Forever", "Live Your Life") stays as it is."""
    t = title or ""
    out = LIVE_PART.sub("", t).strip()
    return out if out else t


def has_live(title):
    return bool(LIVE_PART.search(title or ""))


def scan_differs(field, old, new):
    """Whether a tag the file has really differs from Deezer's (not only in case, punctuation or "feat.")."""
    if field == "title":
        return norm(clean_title(old)) != norm(clean_title(new))
    if field in ("artist", "albumartist"):
        return norm(lead_artist(old) or old) != norm(lead_artist(new) or new)
    if field == "album":
        return norm(bare_title(old)) != norm(bare_title(new))
    if field == "date":
        return old[:4] != new[:4]
    if field == "tracknumber":
        return old.lstrip("0") != new.lstrip("0")
    return False   # a genre the file has is kept: genres are a matter of taste


TAGSCAN_DONE = CACHE / f"tagscan-done{SUFFIX}.json"   # songs the tag scanner has been through, as they were then


class TagScanDone:
    """The songs the tag scanner has checked (and you went through), each as it was then (its size and
    time changed): a scan again checks only the new ones and the ones changed since."""

    def __init__(self, path=TAGSCAN_DONE):
        self.path = path
        try:
            self.files = json.loads(Path(path).read_text())
        except (OSError, ValueError):
            self.files = {}
        if not isinstance(self.files, dict):
            self.files = {}

    @staticmethod
    def key(f):
        return os.path.normcase(os.path.normpath(str(f)))

    @staticmethod
    def stamp(f):
        try:
            st = os.stat(f)
        except OSError:
            return None
        return [st.st_size, round(st.st_mtime, 3)]

    def done(self, f):
        """Whether f was checked as it is now."""
        st = self.stamp(f)
        return st is not None and self.files.get(self.key(f)) == st

    def mark(self, files):
        for f in files:
            st = self.stamp(f)
            if st is not None:
                self.files[self.key(f)] = st
        self.save()

    def forget(self):
        self.files = {}
        self.save()

    def save(self):
        try:
            gone = [k for k in self.files if not os.path.exists(k)]   # deleted songs: not kept for ever
            for k in gone:
                self.files.pop(k, None)
            write_file(Path(self.path), json.dumps(self.files).encode())
        except OSError:
            pass


def tag_scan_plan(files, find_track, album_info, covers=None, progress=None, read=scan_read, cover_of=embedded_cover,
                  width=picture_width, failed=None):
    """What the scanner offers: [{"key", "album", "artist", "folder", "songs": [{"file", "title", "changes":
    {field: (old, new, replace by default)}}], "covers": [url], "cover_note"}], albums with something to offer only.
    A missing tag is replaced by default; one that differs is kept by default. find_track(artist, title, album)
    and album_info(id) look things up (Deezer's); covers(artist, album, found) gives covers to pick from. failed: a
    set the files whose looking up failed (offline, Deezer busy) are added to: not checked, so not done."""
    groups = {}
    album_cache, track_cache = {}, {}
    for i, path in enumerate(files):
        if progress:
            progress(i, len(files))
        old = read(path)
        hint = path_hints(path)
        artist = old["artist"] or old["albumartist"] or hint["artist"]
        title = old["title"] or hint["title"]
        album = old["album"] or hint["album"]
        key = (norm(lead_artist(artist) or artist), norm(clean_title(title)))
        if key not in track_cache:
            try:
                track_cache[key] = find_track(artist, title, album)
            except Exception:  # noqa: BLE001 -- not found, then
                track_cache[key] = None
                if failed is not None:
                    failed.add(path)
        m = track_cache[key]
        al = None
        if m and m.get("album_id"):
            if m["album_id"] not in album_cache:
                try:
                    album_cache[m["album_id"]] = album_info(m["album_id"])
                except Exception:  # noqa: BLE001
                    album_cache[m["album_id"]] = None
            al = album_cache[m["album_id"]]
        folder = str(Path(path).parent)
        gkey = f"{folder}|{norm(bare_title(old['album'] or hint['album']))}"   # an album in a folder (a folder may hold several)
        g = groups.setdefault(gkey, {"key": gkey, "album": old["album"] or hint["album"], "artist": old["albumartist"] or
                                     lead_artist(old["artist"]) or hint["artist"], "folder": folder, "songs": [], "found": Counter(),
                                     "files": [], "cover_note": ""})
        g["files"].append(path)
        changes = {}
        if m:
            new = {"title": m["title"], "artist": m["artist"]}
            if has_live(m["title"]) and not has_live(title):   # a live recording found for a song that isn't: its name, no "(Live)"
                new["title"] = strip_live(m["title"])
                al = None   # (nor the live album's name, number or year)
            if al:
                new.update(album=al["title"], albumartist=al["artist"], date=al["date"], genre=al["genre"],
                           tracknumber=str(al["positions"].get(m["id"]) or ""))
                if al.get("cover"):
                    g["found"][al["cover"]] += 1
            for f in SCAN_FIELDS:
                o, n = old[f], (new.get(f) or "").strip()
                if not n:
                    continue
                if f == "albumartist" and not o and norm(lead_artist(old["artist"])) == norm(n):
                    continue   # the album artist is the song's artist: nothing to add
                if f == "tracknumber" and o and al and scan_differs("album", old["album"] or album, al["title"]):
                    continue   # another album's number: not this one's
                if not o:
                    changes[f] = (o, n, True)
                elif scan_differs(f, o, n):
                    changes[f] = (o, n, False)
        if changes:
            g["songs"].append({"file": path, "title": old["title"] or hint["title"], "changes": changes})
    out = []
    for g in groups.values():
        first = g["files"][0]
        pic = cover_of(first)
        if pic is None:
            g["cover_note"] = "No cover in the files"
        elif width(pic) and width(pic) < SCAN_SMALL_COVER:
            g["cover_note"] = f"The cover is small ({width(pic)} px)"
        found = [u for u, _n in g.pop("found").most_common()]
        g["covers"] = []
        if g["cover_note"]:
            more = []
            if covers:
                try:
                    more = covers(g["artist"], g["album"], found) or []
                except Exception:  # noqa: BLE001
                    more = []
            g["covers"] = list(dict.fromkeys(found + more))[:3]
        if g["songs"] or g["covers"]:
            out.append(g)
    out.sort(key=lambda g: (norm(g["artist"]), norm(g["album"])))
    return out


def scan_changes(groups, picked_fields, picked_covers):
    """What to write: ({file: {field: value}}, {folder: cover url}). picked_fields: {(file, field): replace?}
    (missing: the default); picked_covers: {folder: url or None}."""
    tags, cover = {}, {}
    for g in groups:
        for s in g["songs"]:
            for f, (_o, n, default) in s["changes"].items():
                if picked_fields.get((s["file"], f), default):
                    tags.setdefault(s["file"], {})[f] = n
        url = picked_covers.get(g["key"])
        if url:
            cover[g["key"]] = url
    return tags, cover


def empty_folders(roots):
    """Folders in roots with no music left in them (only pictures, lyrics and the like, or nothing), deepest
    first: [(folder, bytes, [the files in it])]. A folder holding anything else isn't empty. The roots themselves
    are never in it."""
    out = []
    for root in roots:
        root = Path(root)
        if not root.is_dir():
            continue
        keep = {}   # folder -> has something that isn't a leftover (in it or below)
        for dirpath, dirnames, filenames in os.walk(root, topdown=False):
            d = Path(dirpath)
            real = any(Path(n).suffix.lower() not in LEFTOVER_EXTS for n in filenames) \
                or any(keep.get(d / n, True) for n in dirnames)
            keep[d] = real
            if not real and d != root:
                files = []
                size = 0
                for sub, _dirs, names in os.walk(d):
                    for n in names:
                        p = Path(sub) / n
                        files.append(str(p.relative_to(d)))
                        try:
                            size += p.stat().st_size
                        except OSError:
                            pass
                out.append((str(d), size, files))
    # A folder inside one that's going too is shown once, with its parent.
    gone = {f for f, _s, _n in out}
    return [x for x in out if str(Path(x[0]).parent) not in gone]


