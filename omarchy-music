        plays += [(r[2], r[1], r[3], max(int(r[5]), 0)) for r in a.apple_history.rows]
        if a.lastfm.connected:   # Last.fm's scrobbles too, as kept here (Most played reads them all once)
            for f in WRAPPED.glob(f"{safe_name(a.lastfm.user.lower())}-[0-9][0-9][0-9][0-9].json"):
                plays += [(r[2], r[1], r[3], 1) for r in (read_json(f, {}).get("rows") or []) if len(r) > 3]
        if not plays:
            self.report(body, status, "No plays to look at yet: connect Last.fm, or import your Spotify, Apple Music or "
                                      "Deezer history (Settings › Last.fm & your stats).", [], dlg.close)
            return
        rows = album_plays_plan(plays, a.my_songs(), a.album_picks)
        if not rows:
            self.report(body, status, f"Every song's plays are on one album already ({len(plays):,} plays looked at).", [], dlg.close)
            return
        status.set_label(f"{len(rows)} song{'s' if len(rows) != 1 else ''} {'have' if len(rows) != 1 else 'has'} plays on more than one of their releases (a single, an EP, the album). "
                         "Merge plays counts them all for the album shown (a deluxe or extended edition first); Leave alone "
                         "keeps them apart and isn't asked again; Other album: the one you pick. The plays stay the song's "
                         "either way: this is which album they count for (Most played albums, Albums time).")
        lines = []
        for r in rows:
            ln = [f"{name}: {n:,} play{'s' if n != 1 else ''}" + ("  (you have it)" if not n else "") for name, n in r["albums"]]
            ln.append(f"→ all for “{r['to']}”")
