def styled_css(c):
    """A colourful look's gradient window (and stars), and Stellio's cards and round buttons."""
    acc, fg, light, bg = c["accent"], c["foreground"], c["lighter_background"], c["background"]
    light_mode = c["mode"] == "light"
    out = f"""
.player {{ background-color: {rgba(light, 0.92 if light_mode else 0.55)}; border-top: none; border-radius: 18px;
  margin: 0 10px 10px 10px; box-shadow: 0 6px 20px rgba(0, 0, 0, {0.10 if light_mode else 0.35}); }}
.player.expanded {{ margin: 0; border-radius: 0; box-shadow: none; }}
.drawer {{ background-color: {rgba(light, 0.98 if light_mode else 0.96)}; }}
.bigart {{ border-radius: 22px; }}
"""
    if c.get("gradient"):
        cols = c["gradient"].split(",")
        stops = ", ".join(f"{col} {round(i * 100 / (len(cols) - 1))}%" for i, col in enumerate(cols))
        layers = []
        if c.get("stars"):
            import random as _r
            rnd = _r.Random(7)   # the same sky each time
            for _ in range(46):
                x, y, size = rnd.randint(0, 100), rnd.randint(0, 100), rnd.choice((1, 1, 1, 1.5, 2))
                alpha = rnd.choice((0.35, 0.5, 0.7, 0.9))
                layers.append(f"radial-gradient(circle {size}px at {x}% {y}%, rgba(255,255,255,{alpha}), rgba(255,255,255,0))")
        layers.append(f"linear-gradient(165deg, {stops})")
        out += f"window.main {{ background-image: {', '.join(layers)}; }}\n"
        out += f".drawer {{ background-image: linear-gradient(180deg, {rgba(cols[0], 0.97)}, {rgba(cols[-1], 0.97)}); }}\n"
    return out


def system_dark():
    """Whether Windows is set to dark apps (on Linux: whether the desktop asks for dark)."""
    if WINDOWS:
        try:
            import winreg
            with winreg.OpenKey(winreg.HKEY_CURRENT_USER,
                                r"Software\Microsoft\Windows\CurrentVersion\Themes\Personalize") as k:
                return winreg.QueryValueEx(k, "AppsUseLightTheme")[0] == 0
        except OSError:
            return False
    try:
        return Adw.StyleManager.get_default().get_system_supports_color_schemes() and \
            Adw.StyleManager.get_default().get_dark()
    except Exception:  # noqa: BLE001 -- before a display: light
        return False


def load_theme(look="default"):
    colors = dict(DEFAULT_COLORS)
    try:
        with open(THEME_DIR / "colors.toml", "rb") as f:
            colors.update({k: v for k, v in tomllib.load(f).items() if isinstance(v, str)})
    except (OSError, tomllib.TOMLDecodeError):
        pass
    if isinstance(look, dict):
        colors = dict(look)
    elif look in LOOKS:
        colors = dict(LOOKS[look])
    # A clean sans-serif and rounded corners, Poweramp-like (the colours are the look's, as ever).
    if WINDOWS:
        return {"c": colors, "font": "Segoe UI", "radius": 10}
    try:
        font = subprocess.run(["fc-match", "sans-serif", "-f", "%{family}"], capture_output=True,
                              text=True, timeout=2).stdout.split(",")[0] or "sans-serif"
    except (OSError, subprocess.SubprocessError):
        font = "sans-serif"
    radius = 10
    try:
        out = subprocess.run(["hyprctl", "-j", "getoption", "decoration:rounding"],
                             capture_output=True, text=True, timeout=2).stdout
        radius = max(10, min(int(json.loads(out).get("int", 0)), 16))
    except (OSError, ValueError, subprocess.SubprocessError):
        pass
    return {"c": colors, "font": font, "radius": radius}


