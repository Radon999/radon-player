    def playlist_row_menu(self, row, x, y, anchor=None):
        """Right-click on a playlist: put it in a folder (or take it out); on a folder: rename or delete it."""
        a, pl = self.app, row.playlist
        if self.selecting:
            if self.selected:
                self.options_dialog()
            return
        if self.group_selecting and pl.get("kind") == "group":   # albums picked: Options for them (this one too)
            if pl["id"] not in self.group_picked:
                self.group_toggle(row)
            self.group_options()
            return
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        pop = Gtk.Popover(child=box, has_arrow=False, position=Gtk.PositionType.BOTTOM)
        pop.set_parent(anchor or row)
        spot = Gdk.Rectangle()
        spot.x, spot.y, spot.width, spot.height = int(x), int(y), 1, 1
        pop.set_pointing_to(spot)

        def item(label, cb):
            b = Gtk.Button(label=label)
            b.add_css_class("menu-item")
            b.get_child().set_xalign(0)
            b.connect("clicked", lambda *_: (pop.popdown(), cb()))
            box.append(b)
        if pl.get("nr_key"):   # New releases: a discovery playlist of it, or pick several (no pins or folders here)
            rs = [pl["release"]] if pl.get("release") else [r for r in a.new_releases.found if r["artist"] == pl.get("nr_artist")]
            item("Discovery playlist…", lambda: self.release_picker(rs))
            if not self.nr_selecting:
                item("Select", lambda: (self.nr_select(True), self.nr_picked.__setitem__(
                    pl["nr_key"], {"release": pl["release"]} if pl.get("release") else {"artist": pl["nr_artist"]}), self.refresh_music()))
            pop.connect("closed", lambda p: GLib.idle_add(lambda: (p.unparent(), False)[1]))
            pop.popup()
            return
        pin = self.pin_of_row(pl)
        if pin:
            item("Unpin" if a.pinned(pin) else "Pin", lambda: a.toggle_pin(pin))
        if pl.get("kind") == "artist" and pl.get("pin") is None:   # Most played, Artists: a picture of them to pick
            name = pl.get("title") or pl.get("id") or ""
            if name:
                item("Change picture…", lambda: self.pick_artist_picture(name))
                item("Merge into…", lambda: self.merge_artist_dialog(name))
        if pl.get("pin") is not None or pl.get("kind") in ("artist", "album"):
            pass
        elif pl.get("kind") == "group":   # an album, genre or folder of yours: add its songs to a playlist
            songs = self.song_groups(self.music_view).get(pl["id"], (None, None, []))[2]
            if songs:
                item("Add to a playlist…", lambda: self.playlist_menu(anchor or row, songs, x, y))
                item("Options…", lambda: (setattr(self, "selected", {t["id"]: t for t in songs}),
                                          setattr(self, "select_list", None), self.options_dialog()))
            if not self.group_selecting:
                item("Select", lambda: self.group_select(True, first=pl["id"]))
        elif pl.get("kind") == "folder":
            f = a.folders_of_lists.get(pl["id"])
            if not f:
                return
            item("Rename folder…", lambda: self.ask_name("Rename folder", f["name"], lambda n: a.rename_folder(f["id"], n)))
            item("Delete folder", lambda: self.delete_folder(f))
        else:
            if pl.get("folder_item"):
                it = pl["folder_item"]
                item("Remove from this folder", lambda: a.remove_from_folder(self.open_folder, it))
            else:
                mine = a.lists.get(pl["id"])   # one of yours (their ids are ours), else the service's in view
                it = PlaylistFolders.item(mine or pl, a.source)
            head = Gtk.Label(label="ADD TO FOLDER", xalign=0)
            head.add_css_class("section")
            box.append(head)
            for f in a.folders_of_lists.all():
                if f["id"] != self.open_folder:
                    item(f["name"], lambda f=f: a.add_to_folder(f["id"], it))
            item("＋  New folder…", lambda: self.ask_name("New folder", "", lambda n: a.new_folder(n, it), ok="Make it"))
        pop.connect("closed", lambda p: GLib.idle_add(lambda: (p.unparent(), False)[1]))
        pop.popup()

