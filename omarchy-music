    def similar_artists_now(self):
        a = self.app
        try:
            songs = a.my_songs()
        except Exception:  # noqa: BLE001
            songs = []
        library = set(self.library_artists().values())
        played = Counter()
        titles = collections.defaultdict(set)
        key = lambda n: re.sub(r"[\W_]+", "", norm(n))   # noqa: E731
        for t in songs:
            for n in own_artists(t.get("albumartist") or t.get("artist") or ""):
                played[n] += 0
                titles[key(n)].add(norm(clean_title(t.get("title") or "")))
        for st in a.stats.songs:
            for n in own_artists(st.get("artist") or ""):
                played[n] += st.get("plays", 0)
                titles[key(n)].add(norm(clean_title(st.get("title") or "")))
        counts = Counter()
        for t in songs:
            for n in own_artists(t.get("albumartist") or t.get("artist") or ""):
                counts[key(n)] += 1
        return similar_artists(library, played, titles, a.artist_picks, set(a.similar_kept), counts)

    def similar_artists_dialog(self):
        """Settings › Similar artists…: artists that look like another of yours (cavetown offline and Cavetown), each
        Merge or Keep apart; merged ones' songs get the other artist in their tags, and their plays (songs' too) go with them."""
        a = self.app
        dlg, body, status = self.work_dialog("Similar artists", full=True)
        rows = self.similar_artists_now()
        if not rows:
            self.report(body, status, "No artists that look like another of yours.", [], dlg.close)
            return
        status.set_label(f"{len(rows)} artists look like another of yours. Merge puts the first's songs and plays (each "
                         "song's too) under the second; \"The other way\" merges the second into the first; Keep apart leaves "
                         "them as they are, and they aren't asked about again. Ticked: the ones with songs of the same name.")
        lines = []
        for name, to, plays, same in rows:
            ln = [f"{plays:,} play{'s' if plays != 1 else ''} as {name}" if plays else f"No plays as {name}"]
            if same:
                ln.append(f"{len(same)} song{'s' if len(same) != 1 else ''} of the same name: " + ", ".join(x.title() for x in same[:6])
                          + ("…" if len(same) > 6 else ""))
            lines.append((f"{name}  →  {to}", ln))

        def apply(picked):
            # Merge: name into theirs; the other way (picked: theirs' name): theirs into name; typed: name into that.
            merge = [((t, n) if isinstance(p, str) and not isinstance(p, OwnName) and p == n else
                      (n, str(p)) if isinstance(p, str) else (n, t)) for (n, t, _p, _s), p in zip(rows, picked) if p]
            key = lambda n: re.sub(r"[\W_]+", "", norm(n))   # noqa: E731
            for (n, t, _p, _s), p in zip(rows, picked):
                if not p:
                    a.similar_kept = list(dict.fromkeys(list(a.similar_kept) + [key(n) + ">" + key(t)]))
            a.save_soon()
            if not merge:
                self.report(body, status, "Nothing merged.", [], dlg.close)
                return
            self.clear_box(body)
            body.append(Gtk.Spinner(spinning=True, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER, vexpand=True))
            status.set_label(f"Merging {len(merge)} artists…")

            def work():
                out = []
                for n, t in merge:
                    done, failed = a.merge_artist(n, t)
                    out.append(f"{n} → {t}: {done} song{'s' if done != 1 else ''} retagged" + (f", {len(failed)} couldn't be" if failed else ""))
                return out

            def finished(res, err):
                self.report(body, status, "Merged. Most played is counting again.", res or [str(err)], dlg.close)
                a.refresh_everywhere()
                GLib.timeout_add(500, lambda: (a.stats.refresh(force=True), False)[1])
            in_thread(work, done=finished)
        self.choices(body, lines, "Merge", "Keep apart", "Apply", apply, defaults=[bool(r[3]) for r in rows],
                     alts=[(None, [n]) for n, _t, _p, _s in rows], alt_label="The other way: into",
                     own_names=sorted(set(self.library_artists().values()), key=norm))

