    def refresh_repeat(self):
        """Repeat: what you've had on repeat this week, month and year, as charts."""
        lst, a = self.music_list, self.app
        self._music_sig = None
        period = a.repeat_period
        got = a.repeat_cache.get(period)
        if not got or time.time() - got[0] > STATS_FOR:
            if not getattr(a, "_repeat_busy", None) == period:
                a._repeat_busy = period

                def done(res, err, period=period):
                    a._repeat_busy = None
                    if err is not None:
                        a.toast(f"Couldn't add up your plays: {str(err)[:100]}")
                        res = []
                    a.repeat_cache[period] = (time.time(), res or [])
                    if self.music_view == "repeat":
                        self.refresh_music()
                in_thread(a.repeat_top, period, done=done)
            if not got:
                lst.remove_all()
                lst.append(Gtk.ListBoxRow(activatable=False, selectable=False, child=self.sort_chips(
                    self.REPEAT_PERIODS, "repeat_period")))
                self.section(lst, "ADDING UP YOUR PLAYS…")
                return
        tracks = got[1]
        lst.remove_all()
        lst.append(Gtk.ListBoxRow(activatable=False, selectable=False, child=self.sort_chips(
            self.REPEAT_PERIODS, "repeat_period")))
        if not tracks:
            hint = Gtk.Label(label="Nothing played in this time yet. Play some songs (or connect Last.fm, or import your "
                                   "Spotify, Deezer or Apple Music history in Settings) and your charts show up here.", wrap=True, xalign=0)
            hint.add_css_class("sub")
            hint.set_margin_start(12)
            lst.append(Gtk.ListBoxRow(activatable=False, selectable=False, child=hint))
            return
        days = a.REPEAT[period][0]
        self.section(lst, f"YOUR TOP {len(tracks)} · THE LAST {days} DAYS")
        self.lazy(lst, len(tracks), lambda i: self.add_track(
            lst, tracks[i], i, tracks, extra=f"#{i + 1} · {tracks[i]['plays']} play{'s' if tracks[i]['plays'] != 1 else ''}"))

    def refresh_music(self):
        """The Music tab, as the chips above it say (once you can see it)."""
        self.when_shown("music", self._refresh_music)

    def _refresh_music(self):
        lst, view, a = self.music_list, self.music_view, self.app
        self.count_label = None
        lst.set_layout(self.page_layout(self.layout_page()))
        if view in self.GROUP_VIEWS:
            self.refresh_groups(view)
            return
        if view == "playlists":
            self.refresh_playlists()
            return
        if view == "dj":
            self.refresh_dj()
            return
        if view == "dupes":
            self.refresh_dupes()
            return
        if view in ("pinned", "newreleases", "discovery", "repeat"):
            getattr(self, f"refresh_{view}")()
            return
        sort = a.music_sort
        if view == "all":
            tracks = a.my_songs()
            lead = lambda t: norm(t["artist"].split(",")[0]) or "~"   # noqa: E731 -- songs without an artist go last
            tracks.sort(key={
                "title": lambda t: (norm(t["title"]), norm(t["artist"])),
                "artist": lambda t: (lead(t), norm(t.get("album")), norm(t["title"])),
                "album": lambda t: (norm(t.get("album")) or "~", lead(t), norm(t["title"])),
                "added": lambda t: -(t.get("added") or 0),
            }.get(sort, lambda t: norm(t["title"])))
        elif view == "recent":
            tracks = a.plays.recent()
        elif view == "favorites":
            tracks = a.favorites.tracks()
        elif view == "unfavorited":
            tracks = sorted((t for t in a.my_songs() if not a.favorites.has(t)),
                            key=lambda t: (norm(t["title"]), norm(t["artist"])))
        elif view == "skips":
            days = {"week": 7, "month": 30, "year": 365}.get(a.skip_period)
            rows = a.song_stats.rows(time.time() - days * 86400 if days else 0)
            rate = SongStats.rate
            order = {"least": lambda r: (rate(r[1], r[2]), -r[2], r[1]),
                     "heard": lambda r: (-r[2], r[1])}.get(a.skip_order, lambda r: (-r[1], -rate(r[1], r[2])))
            tracks = [dict(t, skips=n, full=f) for t, n, f in sorted(rows, key=order)]
        elif view == "top":
            tracks = a.most_played(a.top_period)
        else:
            tracks = a.most_played()
        # The same songs in the same order as shown: only the marks may have changed.
        sig = (view, sort if view not in ("skips", "top") else (a.skip_order, a.skip_period) if view == "skips" else (a.top_period, a.top_kind),
               tuple((t["id"], t.get("plays"), t.get("skips"), t.get("full")) for t in tracks), tuple(a.stats.sources),
               a.stats.busy if view == "top" else None)
        if sig == getattr(self, "_music_sig", None) and not lst.is_empty():
            self.refresh_count()
            self.mark_rows()
            return
        same_view = (getattr(self, "_music_sig", None) or (None, None))[:2] == sig[:2]
        self._music_sig = sig
        sw = lst.get_ancestor(Gtk.ScrolledWindow)
        keep = sw.get_vadjustment().get_value() if sw and same_view else 0
        made = sum(1 for _ in self.rows(lst)) if keep else 0
        if not tracks and not (view == "skips" and a.skip_period != "all") and not (view == "top" and a.top_period != "all"):   # (a period with none: its chips stay)
            folders = ", ".join(short_path(f) for f in a.folders) or "no folders yet"
            title, body = {
                "all": ("No music yet", f"Songs you download, and the music in your folders\n({folders}), show up here."),
                "recent": ("Nothing played yet", "The songs you listen to show up here, the last one first."),
                "top": ("Nothing played yet", "The songs you play most show up here."),
                "favorites": ("No favorites yet", "Right-click a song (or select a few) and pick Favorite,\n"
                              "or press the star by the song playing."),
                "unfavorited": ("Every song is a favorite", "Your songs you haven't starred show up here."),
                "skips": ("No skips counted yet", f"Go on to the next song with more than {SKIP_LEFT} seconds left and "
                          "it counts as a skip;\nhear it to the end and it counts as heard out. Last.fm keeps no skips, "
                          "so this starts now."),
            }[view]
            self.set_empty(lst, title, body)
            return
        lst.remove_all()
        if view == "all":
            if tracks:   # My music: play it all, shuffled, or as a DJ set
                self.actions_row(lst, [("Play", lambda _b, ts=tracks: self.app.play_list(ts), False),
                                       ("Shuffle", lambda _b, ts=tracks: self.app.play_list(ts, shuffled=True), False),
                                       ("DJ", lambda _b: self.dj_from({"kind": "mine"}), True)])
            self.count_label = Gtk.Label(xalign=0, ellipsize=Pango.EllipsizeMode.END)
            self.count_label.add_css_class("section")
            lst.append(Gtk.ListBoxRow(activatable=False, selectable=False, child=self.count_label))
            self.refresh_count()
            lst.append(Gtk.ListBoxRow(activatable=False, selectable=False, child=self.sort_chips()))
        elif view == "skips":
            self.section(lst, f"{len(tracks)} SONGS · SKIPPED OR HEARD OUT")
            lst.append(Gtk.ListBoxRow(activatable=False, selectable=False, child=self.sort_chips(
                self.SKIP_PERIODS, "skip_period")))
            lst.append(Gtk.ListBoxRow(activatable=False, selectable=False, child=self.sort_chips(
                self.SKIP_SORTS, "skip_order")))
        else:
            if view == "recent":
                self.actions_row(lst, [("Refresh", lambda _b: (setattr(self, "_music_sig", None), self.refresh_music(),
                                                              self.toast("Recently played is up to date")), True)])
            self.section(lst, {"recent": f"RECENTLY PLAYED · THE LAST {len(tracks)} SONG{'S' if len(tracks) != 1 else ''}", "top": "MOST PLAYED · STATS" if a.stats.songs and (
                a.lastfm.connected or a.spotify_history.plays or a.deezer_history.plays or a.apple_history.rows) else "MOST PLAYED",
                "favorites": f"{len(tracks)} FAVORITES", "unfavorited": f"{len(tracks)} SONGS NOT FAVORITED"}[view])
            if view == "top" and (a.lastfm.connected or a.spotify_history.plays or a.deezer_history.plays or a.apple_history.rows):
                lst.append(Gtk.ListBoxRow(activatable=False, selectable=False, child=self.sort_chips(
                    self.TOP_KINDS, "top_kind")))
                lst.append(Gtk.ListBoxRow(activatable=False, selectable=False, child=self.sort_chips(
                    self.SKIP_PERIODS, "top_period")))
                self.stats_bar(lst, len(tracks))
                self.milestone_rows(lst)
            if view == "top" and a.top_kind.startswith("time"):   # Listening time: songs, albums or artists
                self.time_rows(lst, a.top_kind[5:])
                return
            if view == "top" and a.top_kind == "albums":   # Most played albums: the songs above, added up by album
                self.top_albums_rows(lst)
                return
            if view == "top" and a.top_kind == "artists":   # Most played artists: every play of theirs
                self.top_artists_rows(lst)
                return
        group = [None]

        def add(i):
            t = tracks[i]
            if view == "all" and sort in ("artist", "album"):
                artist = t["artist"].split(",")[0].strip() or "Unknown artist"
                g = norm(artist) if sort == "artist" else norm(t.get("album"))
                if g != group[0]:
                    group[0] = g
                    self.group_head(lst, artist if sort == "artist" else t.get("album") or "No album",
                                    None if sort == "artist" else artist)
            extra = f"{t['plays']} play{'s' if t['plays'] != 1 else ''}" if view == "top" else ""
            if view == "skips":
                n, f = t.get("skips", 0), t.get("full", 0)
                extra = (f"{n} skip{'s' if n != 1 else ''}" if n else "never skipped") + (f" · heard out {f}×" if f else "")
            self.add_track(lst, t, i, tracks, removable=view == "all" and self.lib.has(t["id"]), extra=extra)
        self.lazy(lst, len(tracks), add, first=made)
        if keep:   # the same list with a song more or less: stay where you were in it
            lst.flush()
            GLib.idle_add(lambda: (sw.get_vadjustment().set_value(keep), False)[1])

    def refresh_dupes(self):
        """Duplicates: songs you have more than once, each copy with what it is, to delete the ones you don't want."""
        lst, a = self.music_list, self.app
        self._music_sig = None
        lst.remove_all()
        if getattr(a, "_dupe_scanning", False):
            self.section(lst, "LOOKING FOR DUPLICATES…")
            return
        if a.dupes is None:
            self.set_empty(lst, "Duplicates", "Look through all your songs (downloads and your folders) for ones you have "
                           "more than once.\nYou'll see each copy's name, artist and file, and say which to delete.")
            self.actions_row(lst, [("Look for duplicates", lambda _b: a.scan_dupes(), False)])
            return
        if not a.dupes:
            self.set_empty(lst, "No duplicates", "Every song you have is there once.")
            self.actions_row(lst, [("Look again", lambda _b: a.scan_dupes(), True)])
            return
        extra = sum(len(g) - 1 for g in a.dupes)
        self.section(lst, f"{len(a.dupes)} SONG{'S' if len(a.dupes) != 1 else ''} · {extra} EXTRA COP{'IES' if extra != 1 else 'Y'} · THE BEST COPY FIRST")
        self.actions_row(lst, [("Go through them…", lambda _b: self.review_dupes(0), False),
                               ("Look again", lambda _b: a.scan_dupes(), True)])
        for group in a.dupes:
            t0 = group[0][0]
            self.group_head(lst, t0["title"], t0["artist"])
            for i, (t, f) in enumerate(group):
                lst.append(self.dupe_row(group, t, f, best=i == 0))

    def dupe_row(self, group, t, f, best=False):
        box = Gtk.Box(spacing=10)
        box.add_css_class("actions")
        text = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True, spacing=2)
        name = Gtk.Label(label=f"{t['title']} · {t['artist']}" + (f" · {t['album']}" if t.get("album") else ""),
                         xalign=0, ellipsize=Pango.EllipsizeMode.END)
        text.append(name)
        info = Gtk.Label(label=("★ best · " if best else "") + facts_text(f), xalign=0, ellipsize=Pango.EllipsizeMode.END)
        info.add_css_class("sub")
        text.append(info)
        where = Gtk.Label(label=short_path(f["path"]), xalign=0, ellipsize=Pango.EllipsizeMode.MIDDLE,
                          tooltip_text=f["path"])
        where.add_css_class("service")
        text.append(where)
        box.append(text)
        play = Gtk.Button(icon_name="media-playback-start-symbolic", valign=Gtk.Align.CENTER, tooltip_text="Play this copy")
        play.add_css_class("flat")
        play.connect("clicked", lambda _b: self.app.play_from([t], 0, radio=False))
        box.append(play)
        rm = Gtk.Button(label="Delete…", valign=Gtk.Align.CENTER)
        rm.add_css_class("pill")
        rm.add_css_class("quiet")
        rm.connect("clicked", lambda _b: self.confirm_dupe(group, t, f))
        box.append(rm)
        return Gtk.ListBoxRow(activatable=False, selectable=False, child=box)

    def dupe_body(self, group, marked=None):
        """Every copy of a song: names, artists and what the file is."""
        lines = []
        for i, (t, f) in enumerate(group):
            mark = "✕ " if marked and t["id"] in marked else "• "
            lines.append(f"{mark}{t['title']} — {t['artist']}" + (f" ({t['album']})" if t.get("album") else "")
                         + f"\n    {facts_text(f)}" + ("  ← best" if i == 0 else "") + f"\n    {short_path(f['path'])}")
        return "\n".join(lines)

    def confirm_dupe(self, group, t, f):
        """Are you sure: the copy to delete and the copies it's a duplicate of."""
        others = [(c, cf) for c, cf in group if c["id"] != t["id"]]
        dlg = Adw.AlertDialog(heading=f"Delete this copy of “{t['title']}”?",
                              body=f"To the trash:\n• {t['title']} — {t['artist']}\n    {facts_text(f)}\n    "
                                   f"{short_path(f['path'])}\n\nIt's a duplicate of:\n" + self.dupe_body(others)
                                   + "\n\nYour playlists get the copy you keep in its place.")
        dlg.add_response("cancel", "Keep it")
        dlg.add_response("delete", "Delete")
        dlg.set_response_appearance("delete", Adw.ResponseAppearance.DESTRUCTIVE)
        dlg.set_close_response("cancel")
        dlg.connect("response", lambda _d, r: r == "delete" and self.app.delete_dupe(group, t) and self.refresh_music())
        dlg.present(self)

    def review_dupes(self, i):
        """Go through the duplicates one song at a time: keep the best copy and delete the rest, pick another to
        keep, or leave them."""
        a = self.app
        groups = a.dupes or []
        if i >= len(groups):
            self.refresh_music()
            return
        group = groups[i]
        t0 = group[0][0]
        dlg = Adw.AlertDialog(heading=f"{i + 1} of {len(groups)} · “{t0['title']}”",
                              body=f"You have {len(group)} copies of this song. Keep:")
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        pick, first = {}, None
        for j, (t, f) in enumerate(group):
            b = Gtk.CheckButton(group=first, active=j == 0)
            first = first or b
            lab = Gtk.Label(label=f"{t['title']} — {t['artist']}" + (f" ({t['album']})" if t.get("album") else "")
                            + f"\n{facts_text(f)}" + ("  ← best" if j == 0 else "") + f"\n{short_path(f['path'])}",
                            xalign=0, wrap=True, wrap_mode=Pango.WrapMode.WORD_CHAR)
            b.set_child(lab)
            pick[j] = b
            box.append(b)
        dlg.set_extra_child(box)
        dlg.add_response("stop", "Stop")
        dlg.add_response("skip", "Leave them")
        dlg.add_response("delete", "Delete the others")
        dlg.set_response_appearance("delete", Adw.ResponseAppearance.DESTRUCTIVE)
        dlg.set_close_response("stop")

        def answered(_d, r):
            if r == "stop":
                self.refresh_music()
                return
            nxt = i + 1
            if r == "delete":
                keep = next(j for j, b in pick.items() if b.get_active())
                for j, (t, _f) in enumerate(list(group)):
                    if j != keep:
                        a.delete_dupe([group[keep]] + [c for c in group if c[0]["id"] != t["id"]], t)
                nxt = i if len(a.dupes) < len(groups) else i + 1   # the song's gone from the list: same index
            GLib.idle_add(lambda: (self.review_dupes(nxt), False)[1])
        dlg.connect("response", answered)
        dlg.present(self)

    def dupe_download_dialog(self, new, dupes):
        """Before downloading songs you have: which ones, and what you have of them."""
        a = self.app
        lines = []
        for t, copies in dupes[:6]:
            lines.append(f"“{t['title']}” — {t['artist']}\n  you have:")
            for c in copies[:3]:
                path = song_file(a.lib, c)
                lines.append(f"  • {c['title']} — {c['artist']}" + (f" ({c['album']})" if c.get("album") else "")
                             + (f"\n     {facts_text(file_facts(path))}\n     {short_path(path)}" if path else ""))
        if len(dupes) > 6:
            lines.append(f"…and {len(dupes) - 6} more")
        n = len(dupes)
        dlg = Adw.AlertDialog(heading=f"You may have {'this song' if n == 1 else f'{n} of these songs'} already",
                              body="\n".join(lines) + "\n\nThese look like the same song (the name, artist or album "
                              "match closely). Download anyway?")
        dlg.add_response("cancel", "Cancel")
        if len(new) > n:
            dlg.add_response("skip", "Only the new ones")
        dlg.add_response("keep", "Download, keep both")
        dlg.add_response("replace", "Download and replace")
        dlg.set_response_appearance("replace", Adw.ResponseAppearance.SUGGESTED)
        dlg.set_close_response("cancel")

        def answered(_d, r):
            if r == "cancel":
                return
            have = {t["id"] for t, _c in dupes}
            if r == "replace":
                for t, c in dupes:
                    a.replace_after[t["id"]] = c
            a.download([t for t in new if r != "skip" or t["id"] not in have], checked=True)
        dlg.connect("response", answered)
        dlg.present(self)

