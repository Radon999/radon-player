    def import_report(self, pid, name, missed):
        """What an imported playlist's songs weren't found (import_m3u's missed): look for each on
        another service, and add the right one to the playlist where it was, or download it too."""
        a = self.app
        sources = a.report_sources()
        left, placed = list(missed), []
        dlg = Adw.Dialog(title="Not found", content_width=600, content_height=640)
        page = Adw.ToolbarView()
        page.add_top_bar(Adw.HeaderBar())
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=8, margin_start=14, margin_end=14, margin_bottom=14)
        head = Gtk.Label(xalign=0, wrap=True)
        head.add_css_class("title-4")
        sub = Gtk.Label(label="Look for them on another service, then pick the right one: it goes into the playlist "
                              "where it was.", xalign=0, wrap=True)
        sub.add_css_class("service")
        bar = Gtk.Box(spacing=8)
        bar.append(Gtk.Label(label="Look on"))
        pick = Gtk.DropDown.new_from_strings([n for _k, n in sources] or ["YouTube Music"])
        bar.append(pick)
        try_all = Gtk.Button(label="Try them all")
        bar.append(try_all)
        status = Gtk.Label(xalign=0, wrap=True)
        status.add_css_class("service")
        rows = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=10)
        scroll = Gtk.ScrolledWindow(child=rows, vexpand=True, hscrollbar_policy=Gtk.PolicyType.NEVER)
        buttons = Gtk.Box(spacing=8, halign=Gtk.Align.END)
        copy, done = Gtk.Button(label="Copy the list"), Gtk.Button(label="Done")
        done.add_css_class("suggested-action")
        buttons.append(copy)
        buttons.append(done)
        for w in (head, sub, bar, status, scroll, buttons):
            box.append(w)
        page.set_content(box)
        dlg.set_child(page)
        can_download = bool(a.dl.tidal and a.dl.tidal.connected)

        def counted():
            head.set_label(f"{len(left)} of {len(missed)} songs in “{name}” weren't found" if left else
                           f"Every song in “{name}” is in it now")
            try_all.set_sensitive(bool(left) and bool(sources))

        def source():
            k, n = sources[pick.get_selected()] if sources else ("ytm", "YouTube Music")
            return k, n, a.sources.get(k)

        def add(item, parts, track, download):
            if not a.place_missed(pid, item, track, placed):
                status.set_label("That one's in the playlist already")
                return
            left.remove(item)
            parts["name"].set_label(f"Added: {track['title']}")
            parts["about"].set_label(track["artist"] + (" · downloading" if download else ""))
            parts["find"].set_visible(False)
            parts["hits"].set_visible(False)
            if download:
                a.download([track])
            counted()

        def show_hits(item, parts, found, err, n):
            hits = parts["hits"]
            while c := hits.get_first_child():
                hits.remove(c)
            best, all_ = found or (None, [])
            all_ = ([best] if best else []) + [h for h in all_ if h is not best]
            if err or not all_:
                note = Gtk.Label(label=f"{n} didn't answer: {str(err)[:80]}" if err else f"Nothing on {n}",
                                 xalign=0, wrap=True)
                note.add_css_class("service")
                hits.append(note)
            for h in all_[:6]:
                line = Gtk.Box(spacing=6)
                lab = Gtk.Label(label=f"{h['title']} · {h['artist']}" + (f" · {fmt_time(h['duration'])}" if h.get("duration") else ""),
                                xalign=0, hexpand=True, ellipsize=Pango.EllipsizeMode.END, tooltip_text=h.get("album") or None)
                if h is best:
                    lab.add_css_class("accent")
                line.append(lab)
                b = Gtk.Button(label="Add", valign=Gtk.Align.CENTER)
                b.connect("clicked", lambda _b, h=h: add(item, parts, h, False))
                line.append(b)
                if can_download:
                    d = Gtk.Button(icon_name="folder-download-symbolic", valign=Gtk.Align.CENTER,
                                   tooltip_text="Add it and download it")
                    d.connect("clicked", lambda _b, h=h: add(item, parts, h, True))
                    line.append(d)
                hits.append(line)
            hits.set_visible(True)

        def find(item, parts):
            k, n, src = source()
            if not src:
                status.set_label(f"{n} isn't connected")
                return
            parts["find"].set_sensitive(False)
            status.set_label(f"Looking for “{item['title']}” on {n}…")

            def found(res, err):
                parts["find"].set_sensitive(True)
                status.set_label("")
                show_hits(item, parts, res, err, n)
            in_thread(a.match_song, src, item["artist"], item["title"], item["secs"], done=found)

        parts_of = {}
        for item in missed:
            row = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
            top = Gtk.Box(spacing=8)
            words = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True)
            nm = Gtk.Label(label=item["title"], xalign=0, ellipsize=Pango.EllipsizeMode.END)
            nm.add_css_class("heading")
            about = Gtk.Label(label=" · ".join(x for x in (item["artist"], item["why"]) if x), xalign=0,
                              ellipsize=Pango.EllipsizeMode.END, tooltip_text=item["loc"])
            about.add_css_class("service")
            words.append(nm)
            words.append(about)
            top.append(words)
            fb = Gtk.Button(label="Find", valign=Gtk.Align.CENTER, sensitive=bool(item["title"]))
            top.append(fb)
            hits = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4, margin_start=12, visible=False)
            row.append(top)
            row.append(hits)
            rows.append(row)
            parts = {"name": nm, "about": about, "find": fb, "hits": hits}
            parts_of[item["n"]] = parts
            fb.connect("clicked", lambda _b, item=item, parts=parts: find(item, parts))

        def all_of_them(_b):
            k, n, src = source()
            if not src:
                status.set_label(f"{n} isn't connected")
                return
            todo = list(left)
            try_all.set_sensitive(False)
            status.set_label(f"Looking for {len(todo)} song{'s' if len(todo) != 1 else ''} on {n}…")

            def work():
                out = []
                for item in todo:
                    try:
                        out.append((item, a.match_song(src, item["artist"], item["title"], item["secs"]), None))
                    except Exception as e:  # noqa: BLE001 -- that one says why
                        out.append((item, None, e))
                return out

            def finished(res, _err):
                got = 0
                for item, found, err in res or []:
                    if item not in left:
                        continue   # picked by hand meanwhile
                    if found and found[0] and item["artist"]:   # (a title alone, "track07", is anyone's)
                        add(item, parts_of[item["n"]], found[0], False)
                        got += 1
                    else:
                        show_hits(item, parts_of[item["n"]], found, err, n)
                status.set_label(f"Found {got} of {len(todo)} on {n}" + (": the rest show what came closest." if got < len(todo) else "."))
                counted()
            in_thread(work, done=finished)
        try_all.connect("clicked", all_of_them)
        copy.connect("clicked", lambda _b: (self.get_clipboard().set_content(Gdk.ContentProvider.new_for_value(
            "\n".join(missed_name(m) for m in left))), status.set_label("Copied the list of what's still missing")))
        done.connect("clicked", lambda _b: dlg.close())
        if not sources:
            status.set_label("Connect a service in Settings to look for these.")
        counted()
        dlg.present(self)

