    gi.require_version("PangoCairo", "1.0")
    from gi.repository import PangoCairo, GdkPixbuf, Gdk
    rgb = art_color(art) if art else None
    h, l, sat = colorsys.rgb_to_hls(*(c / 255 for c in (rgb or (70, 70, 90))))
    bg = colorsys.hls_to_rgb(h, 0.30, min(0.7, max(sat, 0.2)) if sat > 0.08 else sat)
    surf = cairo.ImageSurface(cairo.FORMAT_ARGB32, CARD_W, CARD_H)
    cr = cairo.Context(surf)
    grad = cairo.LinearGradient(0, 0, 0, CARD_H)
    grad.add_color_stop_rgb(0, *(min(1, c * 1.25) for c in bg))
    grad.add_color_stop_rgb(1, *(c * 0.7 for c in bg))
    cr.set_source(grad)
    cr.paint()
    pad, x = 96, 96
