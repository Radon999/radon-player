            line("Phone", f"Remote on · pair the Android app with code {a.remote.code} at {lan_address()}:{REMOTE_PORT}"
                 + (f" · {paired} phone{'s' if paired != 1 else ''} paired" if paired else ""), True, remote)
            if paired:
                across(pill("Forget the paired phones", a.forget_phones, quiet=True))
        else:
