    @staticmethod
    def pin_key(p):
        """What makes a pin the same thing pinned again."""
        k = p["kind"]
        if k == "artist":
            return ("artist", norm(p["name"]))
        if k == "album":
            return ("album", p["album"].get("id"))
        if k == "playlist":
            return ("playlist", p["item"].get("kind"), p["item"].get("id"))
        if k == "group":
            return ("group", p["view"], p["id"])
        return (k, p.get("id"))

    def pinned(self, p):
        return any(self.pin_key(x) == self.pin_key(p) for x in self.pins)

    def toggle_pin(self, p):
        """Pin it (to the top of Pinned), or unpin it if it's pinned."""
        key = self.pin_key(p)
        if self.pinned(p):
            self.pins = [x for x in self.pins if self.pin_key(x) != key]
            self.toast(f"Unpinned {p.get('title') or p.get('name') or 'it'}")
        else:
            self.pins = [p] + self.pins
            self.toast(f"Pinned {p.get('title') or p.get('name') or 'it'}: it's in Pinned, at the top of the menu (☰)")
        self.save_soon()
        if self.win and self.win.music_view == "pinned":
            self.win.refresh_music()

