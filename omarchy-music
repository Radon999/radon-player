class MediaKeys:
    """Windows: the keyboard's play/pause, next, previous and stop keys, taken system-wide
    (RegisterHotKey) on a thread of their own. MPRIS's counterpart, without the overlay."""
    KEYS = {0xB3: "toggle_pause", 0xB0: "next", 0xB1: "previous", 0xB2: "stop"}

    def __init__(self, app):
        self.app = app
        if os.environ.get("OMARCHY_MUSIC_MPRIS") == "0":
            return
        threading.Thread(target=self._listen, daemon=True).start()

    def _listen(self):
        import ctypes
        from ctypes import wintypes
        user32 = ctypes.WinDLL("user32", use_last_error=True)
        keys = {}
        for i, (vk, act) in enumerate(self.KEYS.items(), 1):
            if user32.RegisterHotKey(None, i, 0x4000, vk):   # MOD_NOREPEAT; fails if another app has the key
                keys[i] = act
        msg = wintypes.MSG()
        while user32.GetMessageW(ctypes.byref(msg), None, 0, 0) > 0:
            if msg.message == 0x0312 and msg.wParam in keys:   # WM_HOTKEY
                act = keys[msg.wParam]
                GLib.idle_add(lambda act=act: (self._do(act), False)[1])

    def _do(self, act):
        a = self.app
        if act == "stop":
            a.set_paused(True)
        else:
            getattr(a, act)()

    def changed(self):
        pass


class TrayIcon:
    """Windows: Radon Player's icon by the clock, so closing the window keeps the music playing. Click it
    for the window; right-click for Play/Pause, Next, Previous, the mini player and Quit. Its own thread,
    with a hidden window for the taskbar's messages (Shell_NotifyIcon, through ctypes)."""
    MENU = ((1, "Open Radon Player"), (2, "Play / Pause"), (3, "Next"), (4, "Previous"), (5, "Mini player"),
            (0, None), (9, "Quit"))

    def __init__(self, app):
        self.app, self.hwnd, self.ready, self.told = app, None, False, False
        self.lock = threading.Lock()
        threading.Thread(target=self._run, daemon=True).start()

    def _run(self):
        import ctypes
        from ctypes import wintypes
        u32, s32, k32 = (ctypes.WinDLL(n, use_last_error=True) for n in ("user32", "shell32", "kernel32"))
        LRESULT = ctypes.c_ssize_t
        WNDPROC = ctypes.WINFUNCTYPE(LRESULT, wintypes.HWND, wintypes.UINT, wintypes.WPARAM, wintypes.LPARAM)
        u32.DefWindowProcW.argtypes = (wintypes.HWND, wintypes.UINT, wintypes.WPARAM, wintypes.LPARAM)
        u32.DefWindowProcW.restype = LRESULT
        u32.CreateWindowExW.restype = wintypes.HWND
        u32.CreateWindowExW.argtypes = (wintypes.DWORD, wintypes.LPCWSTR, wintypes.LPCWSTR, wintypes.DWORD, ctypes.c_int,
                                        ctypes.c_int, ctypes.c_int, ctypes.c_int, wintypes.HWND, wintypes.HMENU,
                                        wintypes.HINSTANCE, wintypes.LPVOID)
        u32.LoadImageW.restype = wintypes.HANDLE
        u32.LoadImageW.argtypes = (wintypes.HINSTANCE, wintypes.LPCWSTR, wintypes.UINT, ctypes.c_int, ctypes.c_int, wintypes.UINT)
        u32.LoadIconW.restype = wintypes.HICON
        u32.LoadIconW.argtypes = (wintypes.HINSTANCE, wintypes.LPVOID)
        u32.CreatePopupMenu.restype = wintypes.HMENU
        u32.AppendMenuW.argtypes = (wintypes.HMENU, wintypes.UINT, ctypes.c_size_t, wintypes.LPCWSTR)
        u32.TrackPopupMenu.argtypes = (wintypes.HMENU, wintypes.UINT, ctypes.c_int, ctypes.c_int, ctypes.c_int,
                                       wintypes.HWND, wintypes.LPVOID)
        u32.PostMessageW.argtypes = (wintypes.HWND, wintypes.UINT, wintypes.WPARAM, wintypes.LPARAM)
        k32.GetModuleHandleW.restype = wintypes.HMODULE

        class WNDCLASSW(ctypes.Structure):
            _fields_ = [("style", wintypes.UINT), ("lpfnWndProc", WNDPROC), ("cbClsExtra", ctypes.c_int),
                        ("cbWndExtra", ctypes.c_int), ("hInstance", wintypes.HINSTANCE), ("hIcon", wintypes.HICON),
                        ("hCursor", wintypes.HANDLE), ("hbrBackground", wintypes.HBRUSH), ("lpszMenuName", wintypes.LPCWSTR),
                        ("lpszClassName", wintypes.LPCWSTR)]

        class NOTIFYICONDATAW(ctypes.Structure):
            _fields_ = [("cbSize", wintypes.DWORD), ("hWnd", wintypes.HWND), ("uID", wintypes.UINT),
                        ("uFlags", wintypes.UINT), ("uCallbackMessage", wintypes.UINT), ("hIcon", wintypes.HICON),
                        ("szTip", wintypes.WCHAR * 128), ("dwState", wintypes.DWORD), ("dwStateMask", wintypes.DWORD),
                        ("szInfo", wintypes.WCHAR * 256), ("uVersion", wintypes.UINT), ("szInfoTitle", wintypes.WCHAR * 64),
                        ("dwInfoFlags", wintypes.DWORD), ("guidItem", ctypes.c_byte * 16), ("hBalloonIcon", wintypes.HICON)]
        CALLBACK, QUIT_MSG, TIP_MSG = 0x8001, 0x8002, 0x8003   # WM_APP + …
        taskbar_created = u32.RegisterWindowMessageW("TaskbarCreated")
        hinst = k32.GetModuleHandleW(None)
        icon = None
        here = Path(__file__).resolve().parent
        for ico in (here / "omarchy-music.ico", here.parent / "omarchy-music.ico", here / "packaging" / "windows" / "omarchy-music.ico"):
            if ico.exists():
                icon = u32.LoadImageW(None, str(ico), 1, 0, 0, 0x10 | 0x40)   # IMAGE_ICON, LR_LOADFROMFILE | LR_DEFAULTSIZE
                if icon:
                    break
        icon = icon or u32.LoadIconW(None, ctypes.c_void_p(32512))   # IDI_APPLICATION
        nid = NOTIFYICONDATAW()
        nid.cbSize = ctypes.sizeof(NOTIFYICONDATAW)
        nid.uID, nid.uFlags, nid.uCallbackMessage, nid.hIcon = 1, 0x1 | 0x2 | 0x4, CALLBACK, icon   # MESSAGE, ICON, TIP
        nid.szTip = "Radon Player"

        def add():
            s32.Shell_NotifyIconW(0, ctypes.byref(nid))   # NIM_ADD

        def menu(hwnd):
            h = u32.CreatePopupMenu()
            for cmd, label in self.MENU:
                u32.AppendMenuW(h, 0x800 if label is None else 0, cmd, label)   # MF_SEPARATOR / MF_STRING
            pt = wintypes.POINT()
            u32.GetCursorPos(ctypes.byref(pt))
            u32.SetForegroundWindow(hwnd)   # (else the menu doesn't close when you click elsewhere)
            cmd = u32.TrackPopupMenu(h, 0x100 | 0x80 | 0x2, pt.x, pt.y, 0, hwnd, None)   # RETURNCMD, NONOTIFY, RIGHTBUTTON
            u32.PostMessageW(hwnd, 0, 0, 0)
            u32.DestroyMenu(h)
            if cmd:
                GLib.idle_add(lambda: (self._do(cmd), False)[1])

        def proc(hwnd, msg, wp, lp):
            if msg == CALLBACK:
                ev = lp & 0xFFFF
                if ev in (0x0202, 0x0203):   # WM_LBUTTONUP, WM_LBUTTONDBLCLK
                    GLib.idle_add(lambda: (self._do(1), False)[1])
                elif ev == 0x0205:   # WM_RBUTTONUP
                    menu(hwnd)
                return 0
            if msg == taskbar_created and taskbar_created:   # Explorer restarted: the icon again
                add()
                return 0
            if msg == TIP_MSG:
                with self.lock:
                    title, text = getattr(self, "balloon", ("", ""))
                nid.uFlags = 0x1 | 0x2 | 0x4 | 0x10   # …and NIF_INFO
                nid.szInfoTitle, nid.szInfo, nid.dwInfoFlags = title[:63], text[:255], 0x1   # NIIF_INFO
                s32.Shell_NotifyIconW(1, ctypes.byref(nid))   # NIM_MODIFY
                nid.uFlags = 0x1 | 0x2 | 0x4
                return 0
            if msg == QUIT_MSG:
                s32.Shell_NotifyIconW(2, ctypes.byref(nid))   # NIM_DELETE
                u32.DestroyWindow(hwnd)
                u32.PostQuitMessage(0)
                return 0
            return u32.DefWindowProcW(hwnd, msg, wp, lp)
        self._proc = WNDPROC(proc)   # kept: Windows calls it for as long as the window lives
        wc = WNDCLASSW()
        wc.lpfnWndProc, wc.hInstance, wc.lpszClassName = self._proc, hinst, "RadonPlayerTray"
        u32.RegisterClassW(ctypes.byref(wc))
        self.hwnd = u32.CreateWindowExW(0, "RadonPlayerTray", "Radon Player", 0, 0, 0, 0, 0, None, None, hinst, None)
        if not self.hwnd:
            return
        nid.hWnd = self.hwnd
        add()
        self.ready = True
        self._post = lambda m: u32.PostMessageW(self.hwnd, m, 0, 0)
        self._quit_msg, self._tip_msg = QUIT_MSG, TIP_MSG
        msg = wintypes.MSG()
        while u32.GetMessageW(ctypes.byref(msg), None, 0, 0) > 0:
            u32.TranslateMessage(ctypes.byref(msg))
            u32.DispatchMessageW(ctypes.byref(msg))

    def _do(self, cmd):
        a = self.app
        if cmd == 1:
            a.show_window()
        elif cmd == 2:
            a.toggle_pause()
        elif cmd == 3:
            a.next()
        elif cmd == 4:
            a.previous()
        elif cmd == 5:
            a.toggle_mini()
        elif cmd == 9:
            a.quit_app()

    def tell(self, title, text):
        """A note by the clock (the first time the window goes to the tray, say)."""
        if self.ready:
            with self.lock:
                self.balloon = (title, text)
            self._post(self._tip_msg)

    def remove(self):
        if self.ready:
            self.ready = False
            self._post(self._quit_msg)


class Mpris:
    def __init__(self, app):
        self.app = app
        self.conn = None
        self.node = Gio.DBusNodeInfo.new_for_xml(MPRIS_XML)
        if os.environ.get("OMARCHY_MUSIC_MPRIS") == "0":   # a test copy: leave the media keys alone
            return
        Gio.bus_own_name(Gio.BusType.SESSION, "org.mpris.MediaPlayer2.omarchy_music" + (f"_{PROFILE}" if PROFILE else ""),
                         Gio.BusNameOwnerFlags.NONE, self._acquired, None, None)

    def _acquired(self, conn, _name):
        self.conn = conn
        for iface in self.node.interfaces:
            conn.register_object(MPRIS_PATH, iface, self._call, self._get, self._set)

    def _call(self, _c, _s, _p, _iface, method, params, inv):
        a = self.app
        if method == "Raise":
            a.show_window()
        elif method == "Quit":
            a.quit_app()
        elif method == "Next":
            a.next()
        elif method == "Previous":
            a.previous()
        elif method == "Pause":
            a.set_paused(True)
        elif method == "Play":
            a.set_paused(False)
        elif method == "PlayPause":
            a.toggle_pause()
        elif method == "Stop":
            a.set_paused(True)
        elif method == "Seek":
            a.player.seek(max(0, a.position + params.unpack()[0] / 1e6))
        elif method == "SetPosition":
            a.player.seek(params.unpack()[1] / 1e6)
        inv.return_value(None)

    def _props(self):
        a = self.app
        t = a.current_track()
        meta = {"mpris:trackid": GLib.Variant("o", "/org/omarchy/music/" + (t["id"].encode().hex() if t else "none"))}
        if t:
            meta["xesam:title"] = GLib.Variant("s", t["title"])
            meta["xesam:artist"] = GLib.Variant("as", [t["artist"]])
            meta["xesam:album"] = GLib.Variant("s", t.get("album") or "")
            meta["mpris:length"] = GLib.Variant("x", int((a.duration or t.get("duration") or 0) * 1e6))
            art = a.lib.items.get(t["id"], {}).get("art") or str(thumb_path(t['id']))
            if Path(art).exists():
                meta["mpris:artUrl"] = GLib.Variant("s", Path(art).as_uri())
        status = "Stopped" if not t else ("Paused" if a.paused else "Playing")
        return {
            "CanQuit": GLib.Variant("b", True), "CanRaise": GLib.Variant("b", True),
            "HasTrackList": GLib.Variant("b", False), "Identity": GLib.Variant("s", "Radon Player"),
            "DesktopEntry": GLib.Variant("s", APP_ID), "SupportedUriSchemes": GLib.Variant("as", []),
            "SupportedMimeTypes": GLib.Variant("as", []),
            "PlaybackStatus": GLib.Variant("s", status),
            "LoopStatus": GLib.Variant("s", {"all": "Playlist", "one": "Track"}.get(a.repeat, "None")),
            "Rate": GLib.Variant("d", 1.0), "Shuffle": GLib.Variant("b", False),
            "Metadata": GLib.Variant("a{sv}", meta), "Volume": GLib.Variant("d", 0.0 if a.muted else a.volume / 100),
            "Position": GLib.Variant("x", int(a.position * 1e6)),
            "MinimumRate": GLib.Variant("d", 1.0), "MaximumRate": GLib.Variant("d", 1.0),
            "CanGoNext": GLib.Variant("b", True), "CanGoPrevious": GLib.Variant("b", True),
            "CanPlay": GLib.Variant("b", True), "CanPause": GLib.Variant("b", True),
            "CanSeek": GLib.Variant("b", True), "CanControl": GLib.Variant("b", True),
        }

    def _get(self, _c, _s, _p, _iface, prop):
        return self._props().get(prop)

    def _set(self, _c, _s, _p, _iface, prop, value):
        if prop == "Volume":   # playerctl volume 0.5
            self.app.set_volume(value.unpack() * 100)
        return True

    def changed(self):
        if not self.conn:
            return
        p = self._props()
        changed = {k: p[k] for k in ("PlaybackStatus", "LoopStatus", "Metadata", "Volume")}
        self.conn.emit_signal(None, MPRIS_PATH, "org.freedesktop.DBus.Properties", "PropertiesChanged",
                              GLib.Variant("(sa{sv}as)", (PLAYER_IFACE, changed, [])))


