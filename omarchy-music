class MiniBars(Gtk.Widget):
    """The mini player's bars: the Visualizer's levels, in the cover's colour, as on the phone's Now playing."""
    __gtype_name__ = "RadonMiniBars"

    def __init__(self, mini):
        super().__init__(hexpand=True, height_request=56)
        self.mini = mini

    def do_snapshot(self, snap):
        w, h = self.get_width(), self.get_height()
        vis = self.mini.vis
        if w <= 0 or h <= 0 or vis is None:
            return
        cr = SnapPainter(snap, w, h)
        r, g, b = self.mini.color
        n = VIS_BANDS
        gap = max(1.0, w / n * 0.28)
        bw = max(1.0, w / n - gap)
        for i, lv in enumerate(vis.levels):
            bh = max(2.0, lv * h)
            cr.set_source_rgba(r, g, b, 0.35 + 0.65 * lv)
            x = i * (bw + gap)
            cr.rectangle(x, h - bh, bw, bh)
            cr.fill()


