                "eq": "Equalizer"}.get(key, "Library")

    def page_changed(self):
        """The stack moved: remember where from (for ‹), and the header says where you are."""
        key = self.stack.get_visible_child_name() or "home"
        if (key, self.music_view, self.open_group, self.open_mine) != getattr(self, "_filter_page", None):
            self._filter_page = (key, self.music_view, self.open_group, self.open_mine)
            self.clear_filter()
        self.update_layout_btn()
        if key != self.nav_last and not self.nav_back_going:
            self.nav.append(self.nav_last)
            del self.nav[:-30]
        self.nav_last = key
        now = key == "nowplaying"
        inside = key in ("artist", "settings", "eq") or (key == "music" and bool(self.open_mine or self.open_group)) \
            or (key in ("lyrics", "visualizer", "queue") and self.nav[-1:] == ["nowplaying"])
        self.back_btn.set_visible(inside)   # ☰ stays, always: it opens and closes the menu
        self.search_btn.set_visible(key != "search")
        self.search_bar.set_visible(key == "search")
        self.nav_title.set_label(self.page_title(key))
        self.update_nav_sub()
        if self.split.get_show_sidebar():
            self.refresh_drawer()
        self.set_now_mode(now)
        if now:
            self.nav.clear()
        if now:
            self.update_now_page(self.app.current_track())
            self.wave.set_position(self.scale.get_value(), self.scale.get_adjustment().get_upper())
            self.np_times[0].set_label(self.t_pos.get_label())
            self.np_times[1].set_label("-" + fmt_time(max(0, self.scale.get_adjustment().get_upper() - self.scale.get_value())))

    def set_now_mode(self, now):
        """Now playing: the backdrop shows under everything, the bar at the bottom goes and its controls
        move into the page; anywhere else they're back in the bar."""
        if getattr(self, "now_mode", None) == now or not hasattr(self, "drawer_box"):
            return   # (the menu is made last: page_changed runs again then)
        self.now_mode = now
        self.backdrop.set_active(now)
        for w in (self.top_bar, self.drawer_box, self.np_scroll, getattr(self, "win_bar", None) or self.top_bar):
            (w.add_css_class if now else w.remove_css_class)("on-np")
        ctl = self.player_controls
        parent = ctl.get_parent()
        want = self.np_ctl_slot if now else self.player_bar
        if parent is not want:
            if parent is not None:
                parent.remove(ctl)
            want.append(ctl)
        ctl.set_hexpand(True)
        self.player_bar.set_visible(not now)
        for w in (ctl.get_start_widget(), ctl.get_end_widget()):   # here: just ⏮ ⏯ ⏭ (the rest is on the page)
            if w is not None:
                w.set_visible(not now)
        (self.player_bar.add_css_class if now else self.player_bar.remove_css_class)("expanded")
        self.play_btn.icon.set_size(30 if now else 18)
        self.prev_btn.icon.set_size(28 if now else 18)
        self.next_btn.icon.set_size(28 if now else 18)
        if now and self.np_views.get_visible_child_name() == "queue":
            self.run_stale("np-queue")

    def nav_back(self):
        key = self.stack.get_visible_child_name()
        self.nav_back_going = True
        try:
            if key == "artist" and len(self.artist_pages) > 1:
                self.artist_back()
                return
            if key == "music" and self.open_mine:
                self.open_mine = None
                self.refresh_music()
                return
            if key == "music" and self.open_group is not None:
                self.open_group = None
                self.refresh_music()
                self.page_changed()
                return
            while self.nav and self.nav[-1] in (key, "artist"):
                self.nav.pop()
            if key == "artist":
                self.artist_pages.clear()
            self.show_tab(self.nav.pop() if self.nav else "nowplaying")
        finally:
            self.nav_back_going = False

