    # ---- Spotify: a developer app of yours, then Spotify's consent page ----
    def spotify_connect(self, client_id):
        sp = self.sources.get("spotify")
        if not sp or self.spotify_connecting:
            return
        if not re.fullmatch(r"[0-9a-f]{32}", (client_id or "").strip()):
            self.toast("That isn't a Spotify Client ID: 32 letters and digits")
            return
        self.spotify_connecting = True
        self.accounts_changed("spotify")

        def done(_res, err):
            self.spotify_connecting = False
            if err:
                if str(err) != "cancelled":
                    self.toast(f"Couldn't connect Spotify: {str(err)[:90]}")
            else:
                self.toast("Spotify connected" + (f" as {sp.user}" if sp.user else ""))
                if self.win and self.win.playlists:
                    self.win.playlists.pop("spotify", None)
                in_thread(sp.liked_ids, done=lambda ids, _e: self.got_likes("spotify", ids))
            self.accounts_changed("spotify")
        in_thread(sp.login, client_id, lambda url: GLib.idle_add(lambda: (self.open_uri(url), False)[1]), done=done)

    def spotify_cancel(self):
        sp = self.sources.get("spotify")
        if sp:
            sp.cancelled = True   # the login stops waiting within a second

    def spotify_disconnect(self):
        sp = self.sources.get("spotify")
        if sp:
            sp.disconnect()
        self.likes.pop("spotify", None)
        self.liked = set().union(*self.likes.values())
        if self.win and self.win.playlists:
            self.win.playlists.pop("spotify", None)
        self.accounts_changed("spotify")

    # ---- your music: the folders, the songs you have, an artist's page ----
    def my_songs(self):
        """Every song you have: downloaded here (once each, whichever service it was saved from) and in your folders."""
        seen, out = set(), []
        same = lambda f: os.path.normcase(os.path.normpath(f or ""))   # noqa: E731 -- C:\a and c:/A are one file
        for t in sorted(self.lib.items.values(), key=lambda t: -t.get("added", 0)):
            if same(t["file"]) not in seen:
                seen.add(same(t["file"]))
                out.append(dict(t))
        return out + [t for t in self.local.tracks() if same(t["file"]) not in seen]

    def genres_here(self, n=30):
        """Your songs' genres, the most common first."""
        c = Counter(g for g in (self.genre_of(t) for t in self.my_songs()) if g)
        return [g for g, _n in c.most_common(n)]

    # ---- Discovery: an artist's songs you haven't got, heard one by one ----
    discovering = set()   # the artists whose discovery playlist is being made
    nr_kind = "album"     # New releases' tab: album, single, ep, artists

    def discovery_lists(self):
        """[(artist, the discovery playlist, the discovered one)] of every artist you're discovering, newest first."""
        out, by = [], {}
        for pl in self.lists.all():
            d = pl.get("discovery")
            if d:
                by.setdefault(norm(d["artist"]), {})[d["role"]] = pl
        for k, pair in by.items():
            first = pair.get("discover") or pair.get("discovered")
            out.append((first["discovery"]["artist"], pair.get("discover"), pair.get("discovered")))
        return out

    def make_discovery(self, artist):
        """A discovery playlist for artist: every song of theirs the services have that you don't,
        album by album ("Artist Discovery playlist"), and one for the songs you hear to the end
        ("Artist discovered")."""
        artist = (artist or "").split(",")[0].strip()
        if not artist or norm(artist) in self.discovering:
            return
        self.discovering.add(norm(artist))
        self.toast(f"Finding {artist}'s songs you haven't got…")

        def work():
            info = self.artist_info(artist)
            if not info:
                raise RuntimeError(f"no service knows {artist}")
            src = self.sources.get(info["source"])
            have = set(self.song_index())
            pair = next((p for p in self.discovery_lists() if norm(p[0]) == norm(artist)), None)
            for pl in (pair[1], pair[2]) if pair else ():
                for t in (pl or {}).get("tracks") or []:
                    have.add(song_key(t))
            out, seen = [], set()
            for al in info.get("albums") or []:
                try:
                    songs = src.album(al["id"]) if src else []
                except Exception:  # noqa: BLE001 -- the next album
                    continue
                for t in songs:
                    k = song_key(t)
                    if k in have or k in seen:
                        continue
                    seen.add(k)
                    out.append(dict(t, album=t.get("album") or al.get("title") or ""))
            for t in info.get("top") or []:   # songs on no album the service listed
                k = song_key(t)
                if k not in have and k not in seen:
                    seen.add(k)
                    out.append(t)
            return info.get("name") or artist, out

        def done(res, err):
            self.discovering.discard(norm(artist))
            if err is not None:
                self.toast(f"Couldn't make it: {str(err)[:100]}")
                return
            name, songs = res
            pair = next((p for p in self.discovery_lists() if norm(p[0]) == norm(name)), None)
            disc = pair[1] if pair else None
            if disc is None:
                disc = self.lists.create(f"{name} Discovery playlist")
                disc["discovery"] = {"artist": name, "role": "discover"}
            if not (pair and pair[2]):
                done_pl = self.lists.create(f"{name} discovered")
                done_pl["discovery"] = {"artist": name, "role": "discovered"}
            n = self.lists.add(disc["id"], songs)
            self.lists.save()
            self.toast(f"“{disc['name']}”: {n} song{'s' if n != 1 else ''} of {name}'s you haven't got" if n
                       else f"You have every song of {name}'s the services list")
            if self.win:
                self.win.drawer_go("music", "discovery")
        in_thread(work, done=done)


    release_found = {}   # a new release -> where it is on the services (found once a session)

    def release_find(self, r):
        """(blocking) Where a new release is on the streaming services (never your files): (service, its album
        entry, None) for the album (or single, or EP) by its name and artist, else (service, None, [the song of
        that name]) for a single, else None."""
        ck = (norm(r["artist"]), r.get("link") or norm(r["title"]))
        if ck in self.release_found:
            return self.release_found[ck]
        want, by = norm(clean_title(r["title"])), r["artist"]
        last, single = None, None
        for key in [k for k in dict.fromkeys((self.source, "tidal", "ytm")) if k in SOURCES]:
            src = self.wait_source(key, 10)
            if not src or (key == "tidal" and not src.signed_in):
                continue
            try:
                res = src.find(f"{by} {r['title']}")
            except Exception as e:  # noqa: BLE001 -- the next service
                last = e
                continue
            for al in res.get("albums") or []:
                if norm(clean_title(al.get("title") or "")) == want and (
                        NewReleases.same_name(by, (al.get("sub") or "").split(" · ")[0].split(",")[0]) or norm(by) in norm(al.get("sub") or "")):
                    found = self.release_found[ck] = (key, dict(al, source=key), None)
                    return found
            songs = [t for t in res.get("songs") or [] if norm(clean_title(t.get("title") or "")) == want
                     and NewReleases.same_name(by, lead_artist(t.get("artist") or ""))]
            if songs and single is None:
                single = (key, None, songs[:1])
        if last and not single:
            print(f"release {r['title']}: {last!r}", file=sys.stderr)
        if single:
            self.release_found[ck] = single
        return single

    def release_tracks(self, r):
        """(blocking) A new release's songs (from the services: see release_find)."""
        found = self.release_find(r)
        if not found:
            return []
        key, album, songs = found
        if album:
            src = self.sources.get(key)
            songs = src.album(album["id"]) if src else []
        return [dict(t, album=t.get("album") or r["title"]) for t in songs or []]

    album_missing_seen = {}   # (artist, album) -> the album's songs you haven't got (looked up once a session)

    def album_missing(self, album, artist, tracks):
        """(blocking) The songs of your album that you haven't got, from the album's tracklist on Deezer:
        [{"n", "title", "secs"}] in order ([] if you have them all, or the album isn't found)."""
        k = (norm(artist), norm(album))
        if k not in self.album_missing_seen:
            try:
                self.album_missing_seen[k] = deezer_album_tracks(artist, album) or []
            except Exception:  # noqa: BLE001 -- offline: nothing shown
                return []
        have = {norm(clean_title(t.get("title") or "")) for t in tracks} | {norm(bare_title(t.get("title") or "")) for t in tracks}
        return [m for m in self.album_missing_seen[k]
                if norm(clean_title(m["title"])) not in have and norm(clean_title(m["short"])) not in have
                and norm(bare_title(m["title"])) not in have]

    @staticmethod
    def release_name(r):
        """A release's discovery playlist's name: “Persona (Extended) from half•alive”."""
        return f"{r['title']} from {r['artist']}"

    def make_release_discoveries(self, chosen, quiet=False):
        """A discovery playlist (and its discovered one) for each release, with the songs picked: [(release, songs)].
        They work as an artist's do: a song heard to the end moves to the discovered one."""
        made = []
        for r, songs in chosen:
            name = self.release_name(r)
            pair = next((p for p in self.discovery_lists() if norm(p[0]) == norm(name)), None)
            disc = pair[1] if pair else None
            if disc is None:
                disc = self.lists.create(f"{name} Discovery playlist")
                disc["discovery"] = {"artist": name, "role": "discover", "release": True}
            if not (pair and pair[2]):
                done_pl = self.lists.create(f"{name} discovered")
                done_pl["discovery"] = {"artist": name, "role": "discovered", "release": True}
            self.lists.add(disc["id"], songs)
            made.append(name)
        self.lists.save()
        if quiet:
            return made
        self.toast(f"Made “{made[0]} Discovery playlist”" if len(made) == 1 else f"Made {len(made)} discovery playlists")
        if self.win:
            self.win.drawer_go("music", "discovery")
        return made

    def discovered(self, t):
        """A song heard to the end: out of its discovery playlist, into the discovered one."""
        for artist, disc, done_pl in self.discovery_lists():
            if disc and done_pl and any(x["id"] == t["id"] for x in disc["tracks"]):
                self.lists.remove(disc["id"], {t["id"]})
                self.lists.add(done_pl["id"], [t])
                if self.win and self.win.music_view == "discovery":
                    self.win.refresh_music()
                return

    def review_discovered(self, pid, download, remove):
        """The discovered list's review: download some songs, take some out."""
        pl = self.lists.get(pid)
        if not pl:
            return
        get = [t for t in pl["tracks"] if t["id"] in download]
        if get:
            self.download(get)
        gone = set(remove)
        if gone:
            self.lists.remove(pid, gone)
        if self.win:
            self.win.refresh_music()

    REPEAT = {"week": (7, 50), "month": (30, 100), "year": (365, 200)}   # days back, songs
    repeat_cache = {}

    def repeat_top(self, period):
        """(blocking) Repeat: your most played songs of the last week (50), month (100) or year (200):
        your scrobbles (or the plays here, without Last.fm), and Spotify's and Apple Music's plays, added up."""
        days, n = self.REPEAT[period]
        now = time.time()
        since = now - days * 86400
        fm = self.lastfm
        rows = []
        if fm.connected:
            first = datetime.fromtimestamp(since)
            if period == "year":
                keys = sorted({first.year, datetime.now().year})
            else:
                keys, d = [], first.replace(day=1)
                while d <= datetime.now():
                    keys.append(f"m{d:%Y-%m}")
                    d = add_months(d, 1)
            for k in keys:
                rows += [r for r in scrobble_rows(fm, k) if r[0] >= since]
        else:
            for e in list(self.plays.items.values()):
                t = e.get("track") or {}
                rows += [(x, t.get("artist", ""), t.get("title", ""), t.get("album", ""), "") for x in e.get("at") or [] if x >= since]
        extra = [p for p in self.imported_plays() if p[0] >= since]
        rows += [(p[0], p[1], p[2], p[3], "") for p in extra]
        songs = {}
        for r in rows:
            add_plays(songs, r[2], r[1], r[3], r[4] if len(r) > 4 else "", 1, "here")
        mine = self.song_index()
        top = sorted(songs.values(), key=lambda s: -s["plays"])[:n]
        return [dict(self.fm_song(s["title"], s["artist"], s["thumb"], mine, s["album"]), plays=s["plays"]) for s in top]

    def genre_of(self, t):
        """A song's genre: from its tags (your own files), or the one the tagger found for a download."""
        g = t.get("genre") or (self.lib.items.get(t.get("id")) or {}).get("genre") or ""
        if isinstance(g, list):
            g = g[0] if g else ""
        return str(g).strip()

    def most_played(self, period="all"):
        """The Music tab's Most played: every play added up (see Stats): Last.fm's, your Spotify
        history's and, without Last.fm, the plays here; period: "week", "month" or "year" for those
        days' plays only. Until the counts are in, the plays here stand in."""
        self.stats.refresh()
        if not self.stats.songs:
            return self.plays.top(None) if period == "all" else []
        mine = self.song_index()
        out, at = [], {}
        for st in self.stats.songs if period == "all" else self.stats.periods.get(period, []):
            t = self.fm_song(st["title"], st["artist"], st["thumb"], mine, st.get("album"))
            i = at.get(t["id"])
            if i is not None:   # two names for one song of yours (a remaster's, a feat.'s): one row, plays added up
                o = out[i]
                o["plays"] += st["plays"]
                for k in STAT_SOURCES:
                    if st.get(k):
                        o["plays_from"][k] = o["plays_from"].get(k, 0) + st[k]
                continue
            at[t["id"]] = len(out)
            out.append(dict(t, plays=st["plays"], plays_from={k: st[k] for k in STAT_SOURCES if st.get(k)}))
        if getattr(self, "top_mine_only", False):   # your files only (matched by song name, artist and album: see fm_song)
            out = [t for t in out if source_of(t) == "file" or self.lib.has(t["id"])]
        out.sort(key=lambda t: -t["plays"])
        return out

    def top_albums(self, period="all"):
        """Most played albums: Most played's songs (the same period, the same "only songs on this device")
        added up by album. [{"key", "title", "artist", "plays", "tracks"}], most played first. An album and its
        deluxe, extended or anniversary edition are one, under the edition's name; an album split by featured
        artists ("half•alive & The Walters") is one; a single's plays count for the album it's on, when you
        have that album's copy of the song."""
        songs = self.most_played(period)
        mine = self.song_index() if songs else {}
        groups = {}
        for t in songs:
            album = (t.get("album") or "").strip()
            if not album:
                continue
            credit = t.get("albumartist") or t.get("artist") or ""
            if is_single(album, t.get("title")):   # the album's copy of the song, if you have one
                k = stats_key(t.get("title"), t.get("artist"))
                on = [c for c in mine.get(("L",) + k) or [] if c.get("album") and not is_single(c["album"], c.get("title"))]
                if on:
                    album, credit = on[0]["album"].strip(), on[0].get("albumartist") or on[0].get("artist") or credit
            base, edition = album_edition(album)
            key = f"{norm(clean_title(album_part(base)[0]))}|{artist_key(credit)}"   # its parts (Pt. 1, Pt. 2) one too
            g = groups.setdefault(key, {"key": key, "names": collections.Counter(), "credits": collections.Counter(),
                                        "plays": 0, "tracks": {}})
            g["names"][album] += 1 + (1000 if edition else 0)   # the edition's name wins
            g["credits"][main_artist(credit) or credit] += 1
            g["plays"] += t.get("plays") or 0
            sk = stats_key(t.get("title"), t.get("artist"))
            have = g["tracks"].get(sk)
            if have is None:
                g["tracks"][sk] = t
            else:   # the same song on both editions: one, its plays added up
                g["tracks"][sk] = dict(have, plays=(have.get("plays") or 0) + (t.get("plays") or 0))
        out = []
        for g in groups.values():
            credit = min(g["credits"], key=lambda c: (-g["credits"][c], len(c)))
            out.append({"key": g["key"], "title": g["names"].most_common(1)[0][0], "artist": credit,
                        "plays": g["plays"], "tracks": list(g["tracks"].values())})
        return sorted(out, key=lambda a: -a["plays"])

    def top_artists(self, period="all"):
        """Most played artists over a period: every play of theirs (every source with a time, as Most played
        counts them), by lead artist. [{"name", "plays", "thumb"}], most played first. All time: the Artists tab's."""
        if period == "all":
            return list(self.stats.artists)
        out, called = {}, collections.defaultdict(collections.Counter)
        resolve = self.artist_resolver()
        for st in self.stats.periods.get(period, []):
            lead = resolve(st["artist"]) or lead_artist(st["artist"]) or st["artist"]
            k = resolved_key(lead)
            x = out.setdefault(k, {"name": lead, "plays": 0, "thumb": ""})
            x["plays"] += st["plays"]
            x["thumb"] = x["thumb"] or st.get("thumb") or ""
            called[k][lead] += st["plays"]
        for k, x in out.items():   # named as resolved ("Quinn XCII & Jeremy Zucker" is Quinn XCII)
            x["name"] = max(called[k], key=called[k].get)
        return sorted(out.values(), key=lambda x: -x["plays"])

    def collage_art(self, it):
        """(blocking) A picture on disk for a collage tile: a song's (or an album's first song's) cover, an
        artist's picture; downloaded if it has to be. Its path, or None."""
        t = it.get("track")
        if t is not None:
            lib = self.lib.items.get(t["id"]) or {}
            for p in (lib.get("art"), self.win.art.paths.get(t["id"]) if self.win else None, thumb_path(t["id"])):
                if p and Path(p).exists():
                    return str(p)
            f = song_file(self.lib, t)
            if f:
                data = file_cover(f)
                if data:
                    dest = CACHE / "collage" / (hashlib.sha1(str(f).encode()).hexdigest() + ".jpg")
                    if not dest.exists():
                        write_file(dest, data)
                    return str(dest)
            url = sized_thumb(t["thumb"], 600) if t.get("thumb") else ""
            return cached_image(url) or None
        url = it.get("image") or it.get("thumb") or ""
        return cached_image(url) or None

    def song_index(self):
        """Song key -> your copy of it. Files on your device win over songs only played (streamed): each
        is kept under ("L", stats key) and ("T", title) too, so fm_song can pick the right one by album."""
        mine = {}
        for t in [e["track"] for e in self.plays.items.values()]:
            mine[song_key(t)] = t
            mine[stats_key(t.get("title"), t.get("artist"))] = t
        for t in self.my_songs():
            k = stats_key(t.get("title"), t.get("artist"))
            mine[song_key(t)] = mine[k] = t
            mine.setdefault(("L",) + k, []).append(t)
            mine.setdefault(("T", k[0]), []).append(t)
        return mine

    @staticmethod
    def best_copy(copies, album=""):
        """Of your copies of a song, the one on the album asked for, then the best file (FLAC first)."""
        rank = {"flac": 0, "wav": 1, "aiff": 1, "alac": 1, "m4a": 2, "ogg": 3, "opus": 3, "mp3": 4}
        want = norm(clean_title(album or ""))

        def score(t):
            ext = str(t.get("file") or "").rsplit(".", 1)[-1].lower()
            on_album = bool(want) and norm(clean_title(t.get("album") or "")) == want
            return (not on_album, rank.get(ext, 5))
        return min(copies, key=score)

    @staticmethod
    def fm_song(name, artist, img, mine, album=""):
        """A song Last.fm (or Spotify, or Apple Music) named: your file of it when you have one (the same
        song name and artist; the one on the same album first), else a song played here, else one to be
        found on Tidal or YouTube Music when it plays."""
        k = stats_key(name, artist)
        copies = mine.get(("L",) + k)
        if not copies:   # the artist written differently: one of the song's artists is one of your file's
            theirs = {re.sub(r"[\W_]+", "", norm(a)) for a in split_artists(artist)} - {""}
            copies = [t for t in mine.get(("T", k[0])) or []
                      if theirs & {re.sub(r"[\W_]+", "", norm(a)) for a in split_artists(t.get("artist") or "")}]
        if not copies and album:   # the artist tagged another way still: the same song name on the same album
            want = norm(clean_title(album))
            copies = [t for t in mine.get(("T", k[0])) or [] if want and norm(clean_title(t.get("album") or "")) == want]
        if copies:
            return dict(MusicApp.best_copy(copies, album))
        t = mine.get(song_key({"title": name, "artist": artist})) or mine.get(k)
        if t is not None:
            return dict(t)
        return {"id": "lfm-" + hashlib.sha1(f"{norm(artist)}|{norm(name)}".encode()).hexdigest()[:16], "source": "lastfm",
                "title": name, "artist": artist, "album": album or "",
                "thumb": img if img and LASTFM_BLANK not in img else ""}

    # ---- the DJ ----
    def dj_source(self, src):
        """What the DJ plays from, as dj["from"] keeps it: (name, songs), or None if it's gone.
        {"kind": "playlist", "id"}, {"kind": "folder", "path"}, {"kind": "mine"} (all your songs),
        or {"kind": "songs", "name", "songs"} (an album, a service's playlist, the phone's)."""
        kind = (src or {}).get("kind")
        if kind == "playlist":
            pl = self.lists.get(src.get("id"))
            return (pl["name"], [dict(t) for t in pl["tracks"]]) if pl else None
        if kind == "folder":
            root = str(Path(src.get("path") or "").expanduser()).rstrip("/\\")
            inside = [t for t in self.my_songs() if str(t.get("file") or "").startswith(root + os.sep)]
            return Path(root).name or root, inside
        if kind == "mine":
            return "your music", self.my_songs()
        if kind == "songs":
            return src.get("name") or "these songs", [dict(t) for t in src.get("songs") or []]
        return None

    def dj_ready(self):
        """The DJ playing from what dj["from"] says (after a restart, say)."""
        src = self.dj.get("from")
        if src and not self.djs.scope:
            got = self.dj_source(src)
            if got and got[1]:
                self.djs.play_from(*got)

    def dj_start(self, src="keep"):
        """Start the DJ: a first set of what you've had on repeat (or whatever it can make). src: what
        it plays from (see dj_source), {"kind": "all"} for everything, "keep" for what it played from."""
        if self.dj_busy:
            return
        if src == "keep":
            src = self.dj.get("from")
        if not self.dj_new and (not src or src.get("kind") == "all"):
            src = {"kind": "mine"}   # only your songs: everything you have
        if src and src.get("kind") != "all":
            got = self.dj_source(src)
            if not got or not got[1]:
                self.toast(f"No songs of yours in {got[0]}: add the folder under Folders in Settings (⚙) first"
                           if src.get("kind") == "folder" and got else
                           f"There are no songs in {got[0] if got else 'that'} for the DJ to play")
                return
            self.djs.play_from(*got)
        else:
            src = None
            self.djs.play_from(None, None)
        self.dj_busy = f"Picking your first set from {self.djs.scope[0]}…" if self.djs.scope else "Picking your first set…"
        self.dj_changed()

        def done(res, err):
            self.dj_busy = None
            if not res:
                self.toast("The DJ couldn't find songs yet. Play a few, or connect Last.fm." if not err
                           else f"The DJ couldn't start: {str(err)[:100]}")
                self.dj_changed()
                return
            kind, songs, line = res
            self.dj = {"on": False, "sets": {}, "shown": None, "from": src}
            self.dj_tag(kind, songs, line)   # before play_from, which copies them
            self.play_from(songs, 0, radio=False)
            self.dj["on"] = True
            self.dj_announce(self.current_track())
        in_thread(lambda: self.djs.build(first=True), done=done)

    def dj_stop(self):
        self.dj["on"] = False
        self.save_state()
        self.dj_changed()

    def dj_tag(self, kind, songs, line):
        """Mark songs as set n of the DJ's (n: the next number), with its line."""
        n = max([int(k) for k in self.dj["sets"]] + [0]) + 1
        self.dj["sets"][str(n)] = {"kind": kind, "line": line}
        if len(self.dj["sets"]) > 30:
            del self.dj["sets"][min(self.dj["sets"], key=int)]
        for t in songs:
            t["dj"] = n
            self.djs.used.add(song_key(t))
        return n

    def dj_announce(self, t):
        """A set begins: its line, where you see it."""
        n = str((t or {}).get("dj", ""))
        if not self.dj["on"] or n not in self.dj["sets"] or n == self.dj.get("shown"):
            return
        self.dj["shown"] = n
        self.toast("DJ · " + self.dj["sets"][n]["line"])
        self.dj_changed()

    def dj_more(self):
        """Near the end of the queue: the DJ's next set after it."""
        if self.dj_busy:
            return
        self.dj_ready()
        self.dj_busy = "Picking the next set…"
        context = self.context

        def done(res, _err):
            self.dj_busy = None
            if res and context == self.context and self.dj["on"]:
                kind, songs, line = res
                self.dj_tag(kind, songs, line)
                self.queue.extend(songs)
                self.after_queue_change()
            self.dj_changed()
        in_thread(lambda: self.djs.build(avoid=self.dj_kind()), done=done)

    def dj_kind(self):
        n = str((self.current_track() or {}).get("dj", ""))
        return (self.dj["sets"].get(n) or {}).get("kind")

    def dj_switch(self, ask=None):
        """Switch it up (or play what you asked for): a new set now, in place of the rest of this one."""
        if self.dj_busy:
            return
        if not self.dj["on"] and not ask:
            self.dj_start()
            return
        self.dj_ready()
        self.dj_busy = f"Looking for {ask.strip()}…" if ask else "Switching it up…"
        self.dj_changed()

        def done(res, err):
            self.dj_busy = None
            if not res:
                self.toast(f"The DJ found nothing for “{ask.strip()}”. Try an artist, a genre, a decade or a vibe." if ask
                           else "The DJ has nothing else right now" + (f": {str(err)[:80]}" if err else "."))
                self.dj_changed()
                return
            kind, songs, line = res
            if not self.dj["on"]:
                self.dj = {"on": True, "sets": {}, "shown": None, "from": self.dj.get("from")}
            self.dj_tag(kind, songs, line)
            queued = [t for t in self.queue[self.index + 1:] if t.get("queued")]
            keep = self.queue[:self.index + 1] if self.current_track() else []
            self.queue = keep + queued + songs
            self.index = len(keep) + len(queued)
            self.radio_from = None
            self.context += 1
            self.load_current()
            self.dj["on"] = True
        in_thread(lambda: self.djs.ask(ask) if ask else self.djs.build(avoid=self.dj_kind()), done=done)

    def dj_set_new(self, on):
        """Only my songs (off), or new ones too (on): the DJ starts again with it."""
        self.dj_new = self.djs.new = bool(on)
        src = self.dj.get("from")
        if on and src and src.get("kind") == "mine":
            src = {"kind": "all"}   # everything again: your history and new songs
        self.save_state()
        if self.dj.get("on"):
            self.dj_start(src or {"kind": "all"})
        else:
            self.dj["from"] = src
            self.dj_changed()

    def dj_changed(self):
        if self.win and self.win.music_view == "dj":
            self.win.refresh_music()

    # ---- importing an .m3u8 playlist ----
    def import_m3u(self, path, progress=lambda i, n: None):
        """(blocking) The songs of the .m3u/.m3u8 playlist at path: (name, songs, missed).
        Each is a file of yours (where the playlist says, else the same file name in your folders),
        else the same song in your music, else the best match on Tidal (YouTube Music without it).
        missed: the songs that weren't found, each {"n" (its line), "at" (where in songs it goes),
        "artist", "title", "secs", "loc", "why"} (see the import report)."""
        path = Path(path)
        entries = read_m3u(path)
        mine = self.my_songs()
        by_file = {str(Path(t["file"]).resolve()): t for t in mine if t.get("file")}
        tails = {}
        for t in mine:
            if t.get("file"):
                parts = [x.lower() for x in Path(t["file"]).parts]
                tails.setdefault(tuple(parts[-2:]), t)
                tails.setdefault(tuple(parts[-1:]), t)
        by_key = {song_key(t): t for t in mine}
        tidal = self.sources.get("tidal")
        src = tidal if tidal and tidal.signed_in else self.wait_source("ytm")
        out, missed = [], []
        for i, (loc, artist, title, secs) in enumerate(entries):
            progress(i, len(entries))
            t, why = None, "not found"
            if re.match(r"https?://", loc):
                try:
                    t = (self.resolve_query(loc) or [None])[0] if link_source(loc) else None
                except Exception as e:  # noqa: BLE001 -- by its name, then
                    t, why = None, f"its link didn't open ({str(e)[:60]})"
            else:
                where = urllib.parse.unquote(loc[7:]) if loc.startswith("file://") else loc
                where = where.replace("\\", "/")
                f = Path(where) if where.startswith("/") else path.parent / where
                if not re.match(r"[A-Za-z]:/", where) and f.suffix.lower() in AUDIO_EXT and f.is_file():
                    t = by_file.get(str(f.resolve())) or track_from_file(f)
                if t is None:
                    parts = [x.lower() for x in where.split("/") if x]
                    t = tails.get(tuple(parts[-2:])) or tails.get(tuple(parts[-1:]))
                if not title:   # no #EXTINF: the file's name, as "Artist - Title" or "01 Title"
                    stem = re.sub(r"^\d{1,3}[\s.\-_]+", "", Path(where).stem)
                    artist, dash, title = stem.partition(" - ")
                    artist, title = (artist, title) if dash else ("", stem)
            if t is None and title:
                t = by_key.get(song_key({"title": title, "artist": artist}))
            if t is None and title and src:
                try:
                    t = self.match_song(src, artist, title, secs)[0]
                except Exception as e:  # noqa: BLE001 -- not found, then: the report says why
                    why = f"{'Tidal' if src is tidal else 'YouTube Music'} didn't answer ({str(e)[:60]})"
            if t is not None:
                out.append(t)
            else:
                missed.append({"n": i, "at": len(out), "artist": artist, "title": title or Path(loc).stem or loc,
                               "secs": secs, "loc": loc, "why": why if title else "the playlist doesn't name it"})
        progress(len(entries), len(entries))
        return path.stem, out, missed

    @staticmethod
    def match_song(src, artist, title, secs=0):
        """(blocking) The song on src, the service: (its best match or None, what the search
        found). A match is near enough in title, by the same lead artist (when there's one),
        and as long give or take 8 s (when that's known). Raises when src can't be reached."""
        hits = src.search(f"{artist} {bare_title(title)}".strip())[:8]
        best, best_score = None, 0.0
        for h in hits:
            if secs and h.get("duration") and abs(h["duration"] - secs) > 8:
                continue
            score = similar(clean_title(title), clean_title(h["title"]))
            if artist:
                lead = max((similar(x, y) for x in artist_names([artist]) for y in artist_names(h["artist"].split(","))),
                           default=0.0)
                if lead < 0.6:
                    continue
                score = 0.6 * score + 0.4 * lead
            if score >= 0.7 and score > best_score:
                best, best_score = h, score
        return best, hits

    def report_sources(self):
        """[(key, name)] of the services a song that wasn't found can be looked for on."""
        return [(k, SOURCES[k]) for k in ("ytm", "tidal", "apple", "spotify")
                if k in self.sources and (k != "tidal" or self.sources[k].signed_in)]

    def place_missed(self, pid, item, track, placed):
        """Put track, found for item (one import_m3u missed), where it was in the playlist;
        placed: the items put back already (it's added to them)."""
        at = item["at"] + sum(1 for o in placed if o["n"] < item["n"])
        if self.lists.add(pid, [track], at=at):
            placed.append(item)
            self.playlists_changed()
            return True
        return False

    def songs_by(self, name):
        """Your songs by the artist called name: downloaded, in your folders or playlists, or played."""
        want, seen, out = norm(name), set(), []
        pool = self.my_songs() + [t for pl in self.lists.items for t in pl["tracks"]] + self.plays.recent(2000)
        for t in pool:
            if want in {norm(a) for a in split_artists(t.get("artist", ""))} and song_key(t) not in seen:
                seen.add(song_key(t))
                out.append(dict(t))
        return out

    def artist_songs(self, name):
        """The artist's songs you played or have, each with how often you played it (every play
        added up: see Stats): the counted ones, then the rest of yours."""
        mine, out, seen = self.song_index(), [], set()
        for st in self.stats.artist_songs(name):
            t = dict(self.fm_song(st["title"], st["artist"], st.get("thumb", ""), mine, st.get("album")), plays=st["plays"])
            if song_key(t) not in seen:
                seen.add(song_key(t))
                out.append(t)
        here = {song_key(e["track"]): e.get("plays", 0) for e in self.plays.items.values()}
        for t in self.songs_by(name):
            if song_key(t) not in seen:
                seen.add(song_key(t))
                out.append(dict(t, plays=here.get(song_key(t), 0)))
        return out

    def look_up_artists(self, names, found):
        """Look up the pictures and bios of the artists named (one after another, off the UI
        thread), handing each found(name, info) on the UI thread; ones known already are skipped."""
        looking = self.__dict__.setdefault("_looking_up", set())
        todo = list(dict.fromkeys(n for n in names if norm(n) not in looking and not self.pictures.known(n)))
        if not todo:
            return
        looking.update(norm(n) for n in todo)

        def work():
            for n in todo:
                try:
                    info = self.pictures.artist(n)
                except Exception:  # noqa: BLE001 -- the next one
                    continue
                finally:
                    looking.discard(norm(n))
                GLib.idle_add(lambda n=n, info=info: (found(n, info), False)[1])
        threading.Thread(target=work, daemon=True).start()

    def set_artist_picture(self, name, source, done=None):
        """Keep source (a picture's web address or a file) as the artist's picture."""
        url = Path(source).as_uri() if Path(source).is_file() else source
        self.pictures.choose_artist(name, url)
        info = self.pictures.artists.get(norm(name)) or {}
        if self.win:
            self.win.artist_found(name, info)
            page = self.win.artist_pages[-1] if self.win.artist_pages else None
            if page and page["kind"] == "artist" and norm(page["name"]) == norm(name):
                page["pic"] = info
                self.win.render_artist()
        self.toast(f"New picture for {name}")
        if done:
            done()

    def artist_info(self, name, prefer=None):
        """(blocking) The artist's page from the first service that knows them: the one the song you
        clicked is from, then the one you browse, then the rest. Top songs come from the next one
        when that service has none to give (Spotify)."""
        info, last = None, None
        names = [name] + ([name.split(" & ")[0]] if " & " in name else [])
        for key in [k for k in dict.fromkeys((prefer, self.source, "ytm", "tidal", "apple", "spotify")) if k in SOURCES]:
            src = self.wait_source(key, 10)
            if not src or (key in ("tidal", "spotify") and not src.signed_in):
                continue
            found = None
            for n in names:
                try:
                    found = src.artist(n)
                except Exception as e:  # noqa: BLE001 -- the next service, then
                    last = e
                if found:
                    break
            if not found:
                continue
            if info is None:
                info = dict(found, source=key, top_source=key)
            elif found["top"]:
                info["top"], info["top_source"] = found["top"], key
            if info["top"]:
                break
        if info is None and last:
            raise last
        return info

    def rescan(self):
        """Read your folders again, in the background."""
        if self.local.scanning:
            return
        self.local.scanning = True

        def done(changed, err):
            self.local.scanning = False
            if err:
                self.toast(f"Couldn't read your folders: {str(err)[:80]}")
            if self.win:
                self.win.refresh_accounts()
                if changed:
                    self.win.refresh_music()
            if not err and changed:
                GLib.timeout_add_seconds(5, lambda: (self.prune_pictures(), False)[1])
        in_thread(self.local.scan, list(self.folders), done=done)

    def prune_pictures(self):
        """The pictures of artists gone from your music (no songs of theirs left, and no plays of theirs in
        your stats): forgotten, and their files deleted. Not while a folder of yours can't be read (a drive
        unplugged: its songs would look gone)."""
        if not self.folders or not all(Path(f).expanduser().is_dir() for f in self.folders) or not self.local.scanned:
            return
        keep = {norm(n) for t in self.my_songs() for c in (t.get("artist"), t.get("albumartist")) for n in own_artists(c)}
        try:
            keep |= {norm(x["name"]) for x in self.top_artists("all")}
        except Exception:  # noqa: BLE001 -- stats not ready: next time
            return
        if not keep:
            return
        in_thread(self.pictures.prune, keep)

    def rescan_soon(self):
        """When the Music tab opens: your folders again, at most every couple of minutes."""
        if time.time() - self.local.scanned > 120:
            self.rescan()

    def add_folder(self, path):
