        def add_album(i):
            x = items[i]
            lst.append(PlaylistRow(self, {"kind": "album", "id": "time-al-" + (x.get("key") or x["title"]), "title": x["title"],
                                          "thumb": "", "sub": x["artist"], "more": fmt_hours(x["secs"]), "tracks": x["tracks"],
                                          "source": "local"}, cover=x["track"], icon="media-optical-symbolic"))
        self.lazy(lst, len(items), add_album)

