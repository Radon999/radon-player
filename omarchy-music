    def current_list_name(self):
        """The list you're playing from, as its queue is called: an album, an artist, a playlist, My music…"""
        key = self.stack.get_visible_child_name()
        a = self.app
        if key == "music":
            if self.music_view in self.GROUP_VIEWS and self.open_group is not None:
                g = self.song_groups(self.music_view).get(self.open_group)
                return g[0] if g else self.GROUP_VIEWS[self.music_view]
            if self.open_mine:
                pl = a.lists.get(self.open_mine)
                return pl["name"] if pl else "Playlist"
            return self.page_title("music")
        if key == "artist" and self.artist_pages:
            return self.artist_pages[-1].get("name") or "Artist"
        if key == "account" and getattr(self, "open_playlist", None):
            return self.open_playlist[0].get("title") or "Playlist"
        if key == "search":
            q = self.entry.get_text().strip()
            return f"Search: {q}" if q else "Search"
        if key in ("queue", "nowplaying", "lyrics", "visualizer"):
            return a.queue_name_s or "Songs"
        return self.page_title(key)

