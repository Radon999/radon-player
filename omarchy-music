def output_info():
    """(blocking) Where the sound goes now: (key, name, kind), kind one of speaker, wired, bluetooth,
    car or usb; None if it can't be told. The speakers and the headphone jack of one sound card are
    two outputs (each keeps its own EQ)."""
    try:
        if WINDOWS:
            return windows_output()
        out = subprocess.run(["wpctl", "inspect", "@DEFAULT_AUDIO_SINK@"], capture_output=True, text=True, timeout=5).stdout
    except (OSError, subprocess.SubprocessError):
        return None
    props = dict(re.findall(r'^\s*\*?\s*([\w.\-]+) = "([^"]*)"', out, re.M))
    name = props.get("node.description") or props.get("device.description") or props.get("node.nick")
    if not name:
        return None
    bus, ff = props.get("device.bus", ""), props.get("device.form-factor", "")
    if bus == "bluetooth" or props.get("device.api") == "bluez5":
        return f"bt:{name}", name, "car" if ff == "car" or CAR_WORDS.search(name) else "bluetooth"
    if bus == "usb":
        return f"usb:{name}", name, "usb"
    port = ""
    try:   # a sound card's jack or its speakers: which port is on
        sink = subprocess.run(["pactl", "get-default-sink"], capture_output=True, text=True, timeout=5).stdout.strip()
        listing = subprocess.run(["pactl", "list", "sinks"], capture_output=True, text=True, timeout=5).stdout
        for block in listing.split("\nSink #"):
            if f"Name: {sink}" in block:
                m = re.search(r"Active Port:\s*(\S+)", block)
                port = m.group(1) if m else ""
    except (OSError, subprocess.SubprocessError):
        pass
    if "headphone" in port or ff in ("headphone", "headset"):
        return f"wired:{name}", f"{name} · headphones", "wired"
    return f"out:{name}" + (f":{port}" if port else ""), name, "speaker"


def windows_output():
    """Windows' default output, from the registry: the active one most recently made the default."""
    import winreg
    base = r"SOFTWARE\Microsoft\Windows\CurrentVersion\MMDevices\Audio\Render"
    best = None
    with winreg.OpenKey(winreg.HKEY_LOCAL_MACHINE, base) as root:
        for i in range(winreg.QueryInfoKey(root)[0]):
            guid = winreg.EnumKey(root, i)
            try:
                with winreg.OpenKey(root, guid) as k:
                    if winreg.QueryValueEx(k, "DeviceState")[0] != 1:
                        continue
                    try:
                        raw = winreg.QueryValueEx(k, "Role:0")[0]
                        st = struct.unpack("<8H", raw[:16])
                        when = (st[0], st[1], st[3], st[4], st[5], st[6], st[7])
                    except OSError:
                        when = (0,)
                    with winreg.OpenKey(k, "Properties") as pk:
                        def prop(name):
                            try:
                                return winreg.QueryValueEx(pk, name)[0]
                            except OSError:
                                return None
                        desc = prop("{a45c254e-df1c-4efd-8020-67d146a850e0},2") or "Speakers"
                        iface = prop("{b3f8fa53-0004-438e-9003-51a46e139bfc},6") or ""
                        form = prop("{1da5d803-d492-4edd-8c23-e0c0ffee7f0e},0")
                        everything = " ".join(str(prop(n) or "") for n in (
                            "{b3f8fa53-0004-438e-9003-51a46e139bfc},2", "{a45c254e-df1c-4efd-8020-67d146a850e0},24",
                            "{233164c8-1b2c-4c7d-bc68-b671687a2567},1")) + " " + iface
                    if best is None or when > best[0]:
                        best = (when, desc, iface, form, everything)
            except OSError:
                continue
    if not best:
        return None
    _w, desc, iface, form, everything = best
    name = f"{desc} ({iface})" if iface else desc
    low = everything.lower()
    if "bth" in low or "bluetooth" in low:
        kind = "car" if CAR_WORDS.search(iface) else "bluetooth"
    elif "usb" in low:
        kind = "usb"
    elif form in (3, 5):   # headphones, a headset
        kind = "wired"
    else:
        kind = "speaker"
    return f"{kind}:{name}", name, kind


def biquad_db(kind, hz, gain, q, f, rate=48000):
    """The gain in dB at f Hz of one filter, as libavfilter builds it (the RBJ cookbook)."""
    a, w0 = 10 ** (gain / 40), 2 * math.pi * hz / rate
    cw, alpha = math.cos(w0), math.sin(w0) / (2 * q)
    if kind == "pk":
        b, d = (1 + alpha * a, -2 * cw, 1 - alpha * a), (1 + alpha / a, -2 * cw, 1 - alpha / a)
    else:
        sa = 2 * math.sqrt(a) * alpha
        s = 1 if kind == "ls" else -1  # the high shelf is the low one mirrored
        b = (a * ((a + 1) - s * (a - 1) * cw + sa), s * 2 * a * ((a - 1) - s * (a + 1) * cw),
             a * ((a + 1) - s * (a - 1) * cw - sa))
        d = ((a + 1) + s * (a - 1) * cw + sa, -s * 2 * ((a - 1) + s * (a + 1) * cw), (a + 1) + s * (a - 1) * cw - sa)
    z = cmath.exp(-1j * 2 * math.pi * f / rate)
    return 20 * math.log10(abs((b[0] + b[1] * z + b[2] * z * z) / (d[0] + d[1] * z + d[2] * z * z)))


def eq_preamp(filters):
    """The cut that keeps the EQ's biggest boost from clipping: dB, 0 or below."""
    freqs = [20 * 1000 ** (i / 299) for i in range(300)]  # 20 Hz to 20 kHz
    peak = max(sum(biquad_db(*flt, f) for flt in filters) for f in freqs)
    return -math.ceil(max(0.0, peak) * 10) / 10


# Headphone crossfeed: a little of each side into the other, its highs softened, as you'd hear speakers across a
# room (ffmpeg's crossfeed, built into every ffmpeg and so every mpv). Hard-panned old records stop tiring the ears.
CROSSFEED = "crossfeed=strength=0.3:range=0.5"
# Clip guard (Sound): a limiter just under full scale instead of clipping, when the EQ, ReplayGain or a song's volume
# would push a peak over. It only ever touches a peak that would clip.
CLIP_GUARD = "alimiter=limit=0.97:attack=1:release=80:level=disabled"
# High-quality resampling (Sound): a longer, sharper resampling filter when a song's rate has to change for the output.
HQ_RESAMPLE = "filter_size=64,phase_shift=12,cutoff=0.97"


def crossfeed_graph(k):
    """Crossfeed at strength k (0.2 light, 0.3 medium, 0.45 strong)."""
    return f"crossfeed=strength={k:g}:range=0.5"


def balance_graph(b):
    """Balance b (-1 all left … 1 all right): the other side turned down, never up."""
    left, right = (1 - b if b > 0 else 1.0), (1 + b if b < 0 else 1.0)
    return f"pan=stereo|c0={left:.3f}*c0|c1={right:.3f}*c1"


def loudness_gains(volume):
    """Loudness compensation for mpv's volume (0–100, a cube law): (bass dB, treble dB) to lift, 0 at full volume."""
    down = max(0.0, -60 * math.log10(max(1, volume) / 100))
    return min(10.0, down * 0.3), min(4.0, down * 0.12)


def tilt_graph(t):
    """Tilt t dB (Sound): brighter (t > 0) turns everything below 1 kHz down by t, warmer (t < 0) everything above;
    only ever down, so it can't clip."""
    if t > 0:
        return f"lowshelf@tilt=f=1000:t=q:w=0.5:g={-t:.1f}"
    return f"highshelf@tilt=f=1000:t=q:w=0.5:g={t:.1f}" if t < 0 else ""


def parse_eq_file(text):
