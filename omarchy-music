    def singles_scan_dialog(self):
        """Singles › Single scan…: each of your singles (the Singles tab's songs) looked up on Deezer (else Apple Music)
        for the album or EP it's on; each Change (its album, album artist, track number, year and the album's cover),
        Leave alone (not asked again) or Other album (a dropdown, or one you type, albums and EPs suggested)."""
        a = self.app
        dlg, body, status = self.work_dialog("Single scan", full=True)
        kept = set(a.singles_kept)
        seen, songs, mine, files_of = set(), [], {}, {}
        for t in a.my_songs():
            f = song_file(a.lib, t)
            if not f or os.path.normcase(f) in seen:
                continue
            seen.add(os.path.normcase(f))
            album = t.get("album") or ""
            credit = t.get("albumartist") or t.get("artist") or ""
            if album and not is_single(album, t.get("title")):   # your albums and EPs: a home with your own name and cover
                k = (norm(clean_title(album_edition(album)[0])), artist_key(credit))
                if k not in mine or (album_edition(album)[1] and not album_edition(mine[k])[1]):
                    mine[k] = album
                files_of.setdefault(album, (f, credit))
                continue
            if in_folders(f, a.fixup_skip) or TagScanDone.key(f) in kept:
                continue
            songs.append(({**t, "file": f}, f))
        if not songs:
            self.report(body, status, "No singles to look up (other than ones you left alone).", [], dlg.close)
            return
        body.append(Gtk.Spinner(spinning=True, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER, vexpand=True))
        status.set_label(f"Looking up {len(songs)} single{'s' if len(songs) != 1 else ''} on Deezer (and Apple Music)…")

        def yours(name, artist):
            return mine.get((norm(clean_title(album_edition(name)[0])), artist_key(artist)))

        def look():
            found, failed, releases = [], 0, {}
            for t, f in songs:
                artist = lead_artist(t.get("artist") or "") or t.get("artist") or ""
                try:
                    home = single_home(artist, t["title"])
                except Exception:  # noqa: BLE001 -- offline or busy: asked again next time
                    failed += 1
                    continue
                if not home:
                    continue
                own = yours(home["album"], home["artist"]) or yours(home["album"], artist)
                if own:   # an album you have: your name for it (your edition) and its cover
                    home = {**home, "album": own, "artist": files_of[own][1], "cover": files_of[own][0], "source": "your songs"}
                if norm(home["album"]) == norm(t.get("album") or ""):
                    continue
                ak = artist_key(artist)
                if ak not in releases:
                    try:
                        releases[ak] = deezer_artist_releases(artist)
                    except Exception:  # noqa: BLE001
                        releases[ak] = []
                found.append((t, f, home, releases[ak]))
            return found, failed
        in_thread(look, done=lambda res, err: GLib.idle_add(show, res, err))

        def show(res, err):
            found, failed = res or ([], len(songs))
            if not found:
                self.report(body, status, "Every single checked: none is on an album or EP"
                            + (f" ({failed} couldn't be looked up: try again later)." if failed else "."), [], dlg.close)
                return False
            status.set_label(f"{len(found)} single{'s are' if len(found) != 1 else ' is'} on an album or EP. Change puts it there: "
                             "its album, album artist, track number and year, and the album's cover; Leave alone keeps it a "
                             "single (not asked again); Other album: one you pick or type (albums and EPs suggested)."
                             + (f" {failed} couldn't be looked up (asked again next time)." if failed else ""))
            own_names = sorted(set(mine.values()), key=norm)
            rows, alts = [], []
            for t, f, home, rel in found:
                kind = "EP" if home["kind"] == "ep" else "album"
                ln = [self.in_music(f), f"Album: {t.get('album') or '(none)'}  →  {home['album']} ({kind}, {home['source']})"]
                if home.get("n"):
                    ln.append(f"Track {home['n']}" + (f" · {home['date'][:4]}" if home.get("date") else ""))
                rows.append((f"{t['title']} — {t.get('artist') or ''}", ln))
                alts.append((None, [home["album"]] + [r for r in rel if r != home["album"]], "Other album",
                             list(dict.fromkeys(rel + own_names))))

            def apply(picked):
                todo = []
                for (t, f, home, _rel), p in zip(found, picked):
                    if not p:
                        a.singles_kept = list(dict.fromkeys(list(a.singles_kept) + [TagScanDone.key(f)]))
                        continue
                    todo.append((t, f, home if p is True or str(p) == home["album"] else str(p).strip()))
                a.save_soon()
                if not todo:
                    self.report(body, status, "Nothing changed.", [], dlg.close)
                    return
                self.clear_box(body)
                body.append(Gtk.Spinner(spinning=True, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER, vexpand=True))
                status.set_label(f"Moving {len(todo)} single{'s' if len(todo) != 1 else ''} onto their albums…")

                def work():
                    lines = []
                    for t, f, home in todo:
                        artist = lead_artist(t.get("artist") or "") or t.get("artist") or ""
                        if isinstance(home, str):   # Other album: yours, else Deezer's (its number and cover)
                            name = home
                            if name in files_of:
                                home = {"album": name, "artist": files_of[name][1], "cover": files_of[name][0]}
                            else:
                                home = {"album": name, "artist": artist}
                                try:
                                    n = (deezer_tracklist(artist, name) or {}).get(norm(clean_title(t["title"])))
                                    covers = deezer_album_covers(artist, name, 1)
                                    home.update(n=n, cover=covers[0] if covers else "")
                                except Exception:  # noqa: BLE001 -- just the name, then
                                    pass
                        ch = {"album": home["album"], "albumartist": home.get("artist") or artist}
                        if home.get("n"):
                            ch["tracknumber"] = str(home["n"])
                        if home.get("date"):
                            ch["date"] = home["date"][:4]
                        n, bad = a.edit_tags_each([(t, ch)])
                        if not n:
                            lines.append(f"Couldn't change {t['title']}: {bad[0] if bad else 'not found'}")
                            continue
                        msg = f"{t['title']}: “{t.get('album') or '(no album)'}” → “{home['album']}”"
                        src = home.get("cover")
                        if src:
                            try:
                                if Path(src).is_file():   # your album's song: its cover (none: left as it is)
                                    data = embedded_cover(src) or file_cover(src)
                                    src = None
                                    if data:
                                        tmp = CACHE / "single-cover.jpg"
                                        write_file(tmp, data)
                                        src = str(tmp)
                                if src:
                                    a.set_cover([{**t, **{k: v for k, v in ch.items() if k in ("album", "albumartist")}}], src)
                            except Exception:  # noqa: BLE001 -- the tags are changed anyway
                                msg += " (its cover couldn't be changed)"
                        lines.append(msg)
                    return lines

                def done(res, err):
                    lines = res or [str(err)]
                    moved = sum(1 for x in lines if "→" in x)
                    self.report(body, status, f"{moved} single{'s' if moved != 1 else ''} put on {'their albums' if moved != 1 else 'its album'}.",
                                lines, dlg.close)
                    a.refresh_everywhere()
                in_thread(work, done=done)
            self.choices(body, rows, "Change", "Leave alone", "Apply", apply, alts=alts)
            return False

    def duplicates_dialog(self):
        """Settings › Duplicates in Most played…: songs that may be one song counted twice (the same name but for what's
        after it, or its punctuation), and versions of a song; each Merge (counted as the other), Leave alone (not asked
        again) or Other song. Artists: Similar artists and Joint artists; albums: Plays on singles and albums."""
