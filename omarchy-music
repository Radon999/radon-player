    def missing_picker(self, artist, album, missing):
        """Download missing tracks…: each one Download or Leave alone; the ones to download are found on Tidal (or
        YouTube Music) and saved."""
        a = self.app
        dlg, body, status = self.work_dialog(f"Missing from “{album}”")
        status.set_label(f"{len(missing)} song{'s' if len(missing) != 1 else ''} of the album you haven't got. Pick the ones "
                         "to download.")
        rows = [(m["title"], [f"Track {m['n']}" + (f" · {fmt_time(m['secs'])}" if m["secs"] else "")]) for m in missing]

        def go(ticks):
            want = [m for m, on in zip(missing, ticks) if on]
            if not want:
                dlg.close()
                return
            self.clear_box(body)
            body.append(Gtk.Spinner(spinning=True, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER, vexpand=True))
            status.set_label(f"Finding {len(want)} songs…")

            def work():
                key = "tidal" if a.dl.tidal and a.dl.tidal.connected else "ytm"
                src = a.sources.get(key) or a.wait_source(key, 10)
                if not src:
                    raise RuntimeError("connect Tidal or YouTube Music in Settings to download")
                found, lost = [], []
                for m in want:
                    try:
                        best = a.match_song(src, artist, m["title"], m["secs"])[0]
                    except Exception:  # noqa: BLE001 -- that one isn't found
                        best = None
                    (found.append(dict(best, album=best.get("album") or album)) if best else lost.append(m["title"]))
                return found, lost

            def done(res, err):
                if err:
                    self.report(body, status, f"Couldn't download: {str(err)[:160]}", [], dlg.close)
                    return
                found, lost = res
                if found:
                    a.download(found)
                self.report(body, status, f"Downloading {len(found)} song{'s' if len(found) != 1 else ''}"
                            + (f"; {len(lost)} not found" if lost else "") + ". They join the album when they're saved.",
                            [f"Downloading {t['title']}" for t in found] + [f"Not found: {x}" for x in lost], dlg.close)
            in_thread(work, done=done)
        self.choices(body, rows, "Download", "Leave alone", "Download", go)

    def release_picker(self, releases):
        """A discovery playlist for each release (“Persona (Extended) from half•alive”), its songs checked first, one
        release after another: each song Add or Leave out (the ones you have already start out left out)."""
        a = self.app
        releases = list(releases)
        if not releases:
            return
        dlg, body, status = self.work_dialog("Discovery playlist")
        made = []
        have = {}

        def show(i):
            if i >= len(releases):
                dlg.close()
                if made:
                    a.toast(f"Made “{made[0]} Discovery playlist”" if len(made) == 1 else
                            f"Made {len(made)} discovery playlists, one for each release")
                    if a.win:
                        a.win.drawer_go("music", "discovery")
                return
            r = releases[i]
            self.clear_box(body)
            body.append(Gtk.Spinner(spinning=True, halign=Gtk.Align.CENTER, valign=Gtk.Align.CENTER, vexpand=True))
            status.set_label(f"{i + 1} of {len(releases)} · “{r['title']}” by {r['artist']}: getting its songs…")

            def got(res, err):
                songs, mine = res or ([], set())
                have.setdefault("keys", mine)
                if not songs:
                    status.set_label(f"Couldn't find “{r['title']}” on your services" + (f": {str(err)[:80]}" if err else "")
                                     + (": skipped." if i + 1 < len(releases) else "."))
                    GLib.timeout_add(1600, lambda: (show(i + 1), False)[1])
                    return
                status.set_label(f"{i + 1} of {len(releases)} · “{a.release_name(r)}”: Add the songs you want in it, leave "
                                 "out the rest (the ones you have already are left out).")
                rows = [(t["title"], [" · ".join(x for x in (t.get("artist"), "you have it" if song_key(t) in have["keys"] else "")
                                                  if x)]) for t in songs]
                last = i + 1 == len(releases)

                def picked(ticks):   # this release's own playlist, made now; then the next release
                    keep = [t for t, on in zip(songs, ticks) if on]
                    if keep:
                        made.extend(a.make_release_discoveries([(r, keep)], quiet=True))
                    show(i + 1)
                self.choices(body, rows, "Add", "Leave out", "Make the playlist" if last else "Make the playlist, then the next",
                             picked,
                             defaults=[song_key(t) not in have["keys"] for t in songs])

            def fetch():
                mine = have.get("keys") or {song_key(t) for t in a.my_songs()}   # your own songs
                return a.release_tracks(r), mine
            in_thread(fetch, done=got)
        show(0)

    def nr_scan(self):
        a, nr = self.app, self.app.new_releases
        n = nr.read_artists(a.my_songs())   # every artist with songs on your device, read again each time
        if not n:
            a.toast("There are no artists in your songs yet: add a music folder in Settings (⚙), or download some")
            return
        dlg = Adw.AlertDialog(heading="Look for new releases", body=f"What the {n:,} artists with songs on your device put out in…")
        dlg.add_response("cancel", "Cancel")
        for k, label in (("week", "The last week"), ("month", "The last month"), ("year", "The last year")):
            dlg.add_response(k, label)
        dlg.set_response_appearance("month", Adw.ResponseAppearance.SUGGESTED)

        def answered(_d, r):
            if r not in NR_RANGES:
                return
            nr.busy, nr.status = True, "Looking…"

            def progress(text):   # (on the scan's thread) the line over the list, now and then
                nr.status = text
                if time.time() - getattr(self, "_nr_tick", 0) > 1.5:
                    self._nr_tick = time.time()
                    GLib.idle_add(lambda: (self.music_view == "newreleases" and self.refresh_music(), False)[1])

            def done(n, err):
                nr.busy, nr.status = False, ""
                a.toast(f"Couldn't look: {str(err)[:100]}" if err else f"{n} new release{'s' if n != 1 else ''}")
                if self.music_view == "newreleases":
                    self.refresh_music()
            in_thread(nr.scan, r, progress, done=done)
            self.refresh_music()
        dlg.connect("response", answered)
        dlg.present(self)

