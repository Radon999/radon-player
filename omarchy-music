def cover_palette(rgb, base="apple-dark"):
    """The Now playing look's colours from a cover's main colour (r, g, b) 0..255: a gradient in it,
    deep enough for white text, like Now playing's own; the accent a light, vivid version of it."""
    h, _l, sat = colorsys.rgb_to_hls(*(c / 255 for c in rgb))
    sat = min(0.75, max(sat, 0.25)) if sat > 0.08 else sat   # a grey cover stays grey

    def shade(light, s_=sat):
        r, g, b = (round(c * 255) for c in colorsys.hls_to_rgb(h, light, s_))
        return f"#{r:02x}{g:02x}{b:02x}"
    c = dict(LOOKS[base])
    top, bottom = shade(0.34), shade(0.12)
    c.update({"mode": "dark", "accent": shade(0.74, min(1.0, sat + 0.15)) if sat > 0.08 else "#fa2d48",
              "selection": shade(0.30), "muted": mix_hex("#f5f5f7", bottom, 0.42), "background": shade(0.20),
              "dark_background": shade(0.14), "darker_background": shade(0.10), "lighter_background": shade(0.26),
              "foreground": "#f5f5f7", "apple": "yes", "styled": "yes", "npl": f"{top},{bottom}"})
    return c


