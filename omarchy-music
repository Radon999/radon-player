    def auto_eq_box(self):
        """Auto EQ: find any headphones in AutoEq's results (as you type), or Detect the ones the
        sound goes to now, and their correction is added to Headphones and used."""
        a = self.app
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=4)
        row = Gtk.Box(spacing=6)
        entry = Gtk.SearchEntry(placeholder_text="Auto EQ: find your headphones", hexpand=True)
        detect = Gtk.Button(label="Detect", tooltip_text="Find the headphones the sound goes to now")
        detect.add_css_class("pill")
        detect.add_css_class("quiet")
        imp = Gtk.Button(label="Import…", tooltip_text="An EQ file: AutoEq's ParametricEQ.txt, a Squiglink or "
                         "Equalizer APO export, or Wavelet's GraphicEQ")
        imp.add_css_class("pill")
        imp.add_css_class("quiet")
        imp.connect("clicked", lambda _b: self.pick_eq_file())
        row.append(entry)
        row.append(detect)
        row.append(imp)
        results = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        results.add_css_class("tracks")
        scroll = Gtk.ScrolledWindow(child=results, hscrollbar_policy=Gtk.PolicyType.NEVER, max_content_height=180,
                                    propagate_natural_height=True, visible=False)
        note = Gtk.Label(xalign=0, wrap=True, max_width_chars=44, visible=False)
        note.add_css_class("sub")
        for w in (row, note, scroll):
            box.append(w)
        seq = [0]

        def say(text):
            note.set_label(text)
            note.set_visible(bool(text))

        def show(found, lead=""):
            results.remove_all()
            for e in found:
                b = Gtk.Button(label=f"{e['name']} · {e.get('source', '')}")
                b.add_css_class("menu-item")
                b.get_child().set_xalign(0)
                b.get_child().set_ellipsize(Pango.EllipsizeMode.END)
                b.connect("clicked", lambda _b, e=e: use(e))
                results.append(b)
            scroll.set_visible(bool(found))
            say(lead or ("" if found else "Nothing in AutoEq by that name"))

        def use(e):
            say(f"Getting {e['name']}…")

            def done(filters, err):
                if err:
                    say(f"Couldn't get it: {str(err)[:80]}")
                    return
                show([])
                say("")
                a.add_autoeq(e, filters)
            in_thread(autoeq_profile, e, a.api_keys.get("autoeq_api", ""), done=done)

        def search(q):
            api = a.api_keys.get("autoeq_api", "")
            return autoeq_api_search(api, q) if api else autoeq_search(autoeq_index(), q)

        def changed(_e):
            q = entry.get_text().strip()
            seq[0] += 1
            n = seq[0]
            if len(q) < 2:
                show([])
                say("")
                return

            def go():
                if n == seq[0]:
                    in_thread(search, q, done=lambda found, err: n == seq[0] and (
                        say(f"AutoEq couldn't be reached: {str(err)[:80]}") if err else show(found or [])))
                return False
            GLib.timeout_add(300, go)

        def detected(res, err):
            names, match = res or ([], None)
            if err:
                say(f"AutoEq couldn't be reached: {str(err)[:80]}")
            elif match:
                show([match], f"The sound goes to {names[0] if not WINDOWS else 'these outputs'}: AutoEq has")
            elif names:
                say(f"The sound goes to {', '.join(names[:2])}: AutoEq has nothing by that name. Look yours up above"
                    " (headphones on a mixer or DAC are found by their own name).")
            else:
                say("Couldn't tell where the sound goes. Look your headphones up above.")

        def detect_now(_b):
            say("Looking…")
            in_thread(lambda: (lambda names: (names, match_device(names, autoeq_index())))(output_devices()), done=detected)
        entry.connect("search-changed", changed)
        detect.connect("clicked", detect_now)
        return box

    def pick_eq_file(self):
        """Pick an EQ file to import (Auto EQ's Import…)."""
        filt = Gtk.FileFilter(name="EQ files (.txt)")
        for pat in ("*.txt", "*.TXT", "*.csv"):
            filt.add_pattern(pat)
        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(filt)
        dlg = Gtk.FileDialog(title="Import an EQ file", filters=filters, default_filter=filt)

        def chosen(d, res):
            try:
                f = d.open_finish(res)
            except GLib.Error:
                return   # cancelled
            if f and f.get_path():
                self.app.import_eq_file(f.get_path())
        dlg.open(self, None, chosen)

