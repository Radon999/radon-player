        (self.like_btn.add_css_class if liked else self.like_btn.remove_css_class)("liked")
        if can:
            tip = self.LIKE_WORDS[source_of(t)][liked]
            if self.app.lastfm.connected:
                tip += " (and " + ("unlove" if liked else "love") + " it on Last.fm)"
            self.like_btn.set_tooltip_text(tip + "  (l)")

    def update_repeat(self):
        mode = self.app.repeat
        self.repeat_btn.icon.set_name("repeat_one" if mode == "one" else "repeat")
        (self.repeat_btn.add_css_class if mode != "off" else self.repeat_btn.remove_css_class)("on")
        self.repeat_btn.set_tooltip_text({"off": "Repeat: off", "all": "Repeat: all",
                                          "one": "Repeat: this song"}[mode] + " (r)")
        # The one over the queue too (it showed the old mode until the queue changed).
        if not hasattr(self, "np_repeat"):
            return
        self.np_repeat.icon.set_name("repeat_one" if mode == "one" else "repeat")
        (self.np_repeat.add_css_class if mode != "off" else self.np_repeat.remove_css_class)("on")
        self.np_repeat.set_tooltip_text({"off": "Repeat: off", "all": "Repeat: all", "one": "Repeat: this song"}[mode])

    def set_status(self, text):
        self.np_status.set_label(text or "")
        self.np_status.set_visible(bool(text))

    def update_position(self, pos, dur):
        if time.monotonic() < self.dragging_until:
            return
        self.scale.set_range(0, max(dur or 1, 1))
        self.scale.set_value(pos or 0)
        self.t_pos.set_label(fmt_time(pos))
        self.t_len.set_label(fmt_time(dur))
        if self.stack.get_visible_child_name() == "nowplaying":
            self.wave.set_position(pos, dur)
            self.np_times[0].set_label(fmt_time(pos))
            self.np_times[1].set_label("-" + fmt_time(max(0, (dur or 0) - (pos or 0))))

    def on_seek(self, _scale, _scroll, value):
        self.dragging_until = time.monotonic() + 0.4
        self.t_pos.set_label(fmt_time(value))
        self.app.player.seek(value)
        return False

    def on_key(self, _ctl, keyval, _code, state):
        ctrl = state & Gdk.ModifierType.CONTROL_MASK
        if keyval == Gdk.KEY_Escape:   # the menu stays: only ☰ (F9, Ctrl+M) closes it
            if self.selecting:
                self.stop_selecting()
            elif self.stack.get_visible_child_name() != "nowplaying":
                self.nav_back()
            else:
                self.set_visible(False)
            return True
        if keyval == Gdk.KEY_F9 or (ctrl and keyval == Gdk.KEY_m):
            self.toggle_drawer()
            return True
        if ctrl and keyval == Gdk.KEY_comma:
            self.show_tab("settings")
            return True
        if ctrl and keyval == Gdk.KEY_a and self.selecting:
            self.select_all()
            return True
        if ctrl and keyval == Gdk.KEY_q:
            self.app.quit_app()
            return True
        if ctrl and keyval in (Gdk.KEY_f, Gdk.KEY_l):
            self.entry.grab_focus()
            return True
        if state & Gdk.ModifierType.ALT_MASK and Gdk.KEY_1 <= keyval < Gdk.KEY_1 + len(self.tab_buttons):
            self.show_tab(list(self.tab_buttons)[keyval - Gdk.KEY_1])
            return True
        focus = self.get_focus()
        if focus and (focus == self.entry or focus.is_ancestor(self.entry) or isinstance(focus, Gtk.Text)):
            return False
        if keyval in (Gdk.KEY_a, Gdk.KEY_A):   # the focused song: a queues it, Shift+A plays it next
            row = self.focused_track_row()
            if row:
                self.app.enqueue([row.track], "next" if keyval == Gdk.KEY_A else "queue")
                return True
        if keyval == Gdk.KEY_s:
            keys = [*SOURCES, "local"]
            now = "local" if self.app.browse_local else self.app.source
            self.app.browse(keys[(keys.index(now) + 1) % len(keys)])
            return True
        if keyval == Gdk.KEY_w:
            self.app.open_wrapped()
            return True
        if keyval == Gdk.KEY_space:
            self.app.toggle_pause()
            return True
        if keyval in (Gdk.KEY_Right, Gdk.KEY_n):
            self.app.next()
            return True
        if keyval in (Gdk.KEY_Left, Gdk.KEY_p):
            self.app.previous()
            return True
        if keyval == Gdk.KEY_slash:
            if self.stack.get_visible_child_name() == "search":
                self.entry.grab_focus()
            else:
                self.toggle_filter(True)
            return True
        if keyval == Gdk.KEY_r:
            self.app.cycle_repeat()
            return True
        if keyval == Gdk.KEY_l:
            self.app.toggle_like()
            return True
        if keyval == Gdk.KEY_f:
            self.app.toggle_favorite_playing()
            return True
        if keyval in (Gdk.KEY_plus, Gdk.KEY_equal, Gdk.KEY_KP_Add):
            self.app.set_volume(self.app.volume + 5)
            return True
        if keyval in (Gdk.KEY_minus, Gdk.KEY_KP_Subtract):
            self.app.set_volume(self.app.volume - 5)
            return True
        if keyval == Gdk.KEY_m:
            self.app.toggle_mute()
            return True
        if keyval == Gdk.KEY_e:
            self.eq_btn.popup()
            return True
        return False


