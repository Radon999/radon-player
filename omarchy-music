    def download_folder(self):
        """Where downloads go: the folder you picked, else the first of your music folders."""
        return self.download_dir or (self.folders[0] if self.folders else str(HOME / "Music"))

    def set_download_dir(self, path):
        self.download_dir = str(Path(path).expanduser().resolve()) if path else None
        self.dl.folder = self.download_folder()
        self.save_state()
        self.toast(f"Downloads go to {short_path(self.download_folder())}, by artist and album")
        if self.win:
            self.win.refresh_accounts()

    def set_dupe_action(self, action):
        self.dupe_action = action
        self.save_state()

    def copy_index(self):
        """Your songs on disk by the first letters of their title (squashed): kept until your songs change."""
        sig = (len(self.lib.items), len(self.local.files), self.local.scanned)
        if getattr(self, "_copy_sig", None) != sig:
            index = {}
            for m in self.my_songs():
                if not is_phone_song(m):
                    index.setdefault(squash(clean_title(m.get("title") or ""))[:4], []).append(m)
            self._copy_index, self._copy_sig = index, sig
        return self._copy_index

    def copies_of(self, t, mine=None):
        """Your songs on disk that are likely t (see maybe_same: close is enough, it's asked about),
        t itself left out."""
        pool = mine if mine is not None else self.copy_index().get(squash(clean_title(t.get("title") or ""))[:4], [])
        return [m for m in pool if m["id"] != t["id"] and maybe_same(t, m) and song_file(self.lib, m)]

    def auto_save_ok(self, t):
        """Whether a song may be saved without asking (Keep, or a service's sync): yes unless you
        have it already and Copies says Ask (then it streams, and Download asks). With Replace,
        your copy goes once the download is in."""
        if self.dupe_action == "keep" or self.lib.has(t["id"]):
            return True
        copies = self.copies_of(t)
        if not copies:
            return True
        if self.dupe_action == "replace":
            self.replace_after[t["id"]] = copies
            return True
        return False

    def after_saved(self, vid):
        """A download is in: your copies of it go, if you said to replace them."""
        old = self.replace_after.pop(vid, None)
        if old and self.lib.has(vid):
            self.replace_copies(old, dict(self.lib.items[vid]))

    def download(self, tracks, checked=False):
        """Download the songs you picked, in FLAC, one after another. A song you have already
        (in your folders, or downloaded from another service) is asked about first."""
        waiting = {t["id"] for t in self.downloads}
        new = [t for t in tracks if source_of(t) != "file" and not self.lib.has(t["id"]) and t["id"] not in waiting]
        if not new:
            self.toast("Those are downloaded already")
            return
        if not (self.dl.tidal and self.dl.tidal.connected):
            self.toast("Connect Tidal in Settings first: downloads come from there, in FLAC")
            return
        if not checked and self.dupe_action != "keep":
            mine = self.my_songs()
            dupes = [(t, c) for t in new if (c := self.copies_of(t, mine))]
            if dupes:
                if self.dupe_action == "replace":
                    for t, c in dupes:
                        self.replace_after[t["id"]] = c
                elif self.win:
                    self.win.dupe_download_dialog(new, dupes)
                    return
        self.downloads += new
        self.toast(f"Downloading {len(new)} song{'s' if len(new) != 1 else ''} in FLAC")
        if self.win:
            self.win.update_saved()
        if not self.downloading:
            self.download_next()

    def download_next(self):
        if not self.downloads:
            if self.downloading:
                self.tagger.resume()
            self.downloading = False
            if self.win:
                self.win.refresh_all()
            return
        if not self.downloading:
            self.tagger.pause()   # the songs are tagged together once the last is in
        self.downloading = True
        batch, self.downloads = self.downloads, []

        def done(out, err):
            self.toast(download_summary(out) if out else f"Couldn't download: {str(err)[:90]}")
            for t in batch:   # your old copies of the songs that came in, when you said to replace them
                old = self.replace_after.pop(t["id"], None)
                if old and self.lib.has(t["id"]):
                    self.replace_copies(old, dict(self.lib.items[t["id"]]))
            self.download_next()
        in_thread(self.dl.sync, batch, lambda: self.win and self.win.refresh_all(), True, done=done)

    def upgrade_songs(self, tracks=None, force=False):
        """Upgrade: every song in your folders (or tracks) that Tidal has better (force: every one
        it has), downloaded and put in its place (playlists, queue, plays and stars go with it);
        the old files to the trash. Songs kept as good already are offered afterwards."""
        if self.upgrading:
            return
        if not (self.dl.tidal and self.dl.tidal.connected):
            self.toast("Connect Tidal in Settings first: the new copies come from there, in FLAC")
            return
        tracks = [t for t in (tracks if tracks is not None else self.local.tracks())
                  if not is_phone_song(t) and Path(t["file"]).exists()]
        if not tracks:
            self.toast("No songs in your folders to upgrade")
            return
        self.upgrading = {"total": len(tracks), "n": 0, "stop": False}
        self.tagger.pause()   # the new FLACs are tagged together at the end
        self.refresh_accounts_soon()

        def progress(n):
            if self.upgrading:
                self.upgrading["n"] = n
                if self.win:
                    self.win.set_status(f"Upgrading your songs · {n} of {len(tracks)}")
                self.refresh_accounts_soon()

        def done(out, err):
            self.upgrading = None
            self.tagger.resume()
            if self.win:
                self.win.set_status("")
            if err:
                self.toast(f"Couldn't upgrade: {str(err)[:90]}")
                return
            cur = self.current_track()
            replaced, failed = 0, len(out["failed"])
            for old, vid in out["done"]:
                if not self.lib.has(vid):
                    failed += 1
                    continue
                if cur and cur["id"] == old["id"]:   # playing: the new one takes over where you are, then the old goes
                    self.swap_playing(old, vid)
                    replaced += 1
                    continue
                if self.put_away(old):
                    failed += 1
                    continue
                self.tidy_name(vid)
                self.retarget([old["id"]], dict(self.lib.items[vid]))
                replaced += 1
            self.toast(f"Upgraded {replaced} song{'s' if replaced != 1 else ''} to FLAC (the old files are in the trash)"
                       + (f" · {len(out['missing'])} not on Tidal" if out["missing"] else "")
                       + (f" · {len(out['kept'])} as good already" if out["kept"] else "")
                       + (f" · {failed} couldn't" if failed else ""))
            self.rescan()
            if self.win:
                self.win.refresh_all()
                self.refresh_accounts_soon()
                if out["kept"] and not force:
                    self.win.confirm_upgrade_kept(out["kept"])
        in_thread(self.dl.upgrade, tracks, progress, lambda: bool(self.upgrading and self.upgrading["stop"]), force,
                  list(self.folders), done=done)

    def swap_playing(self, old, vid):
        """The song playing (old) was upgraded to vid: carry on in the new file from the same moment, then put the old file
        away once the player has let go of it."""
        pos = self.position + (0.0 if self.paused else time.monotonic() - self.position_at)
        paused, listen = self.paused, self.listen
        self.tidy_name(vid)
        new = dict(self.lib.items[vid])
        self.retarget([old["id"]], new)
        self.resume_at = max(0.0, pos)
        self._going_back = True   # not a skip
        self.load_current(autoplay=not paused)
        if listen:
            listen["track"] = self.current_track() or listen["track"]
            self.listen = listen

        def away(tries=[0]):
            err = self.put_away(old)
            tries[0] += 1
            if err and tries[0] < 5:
                return True   # still open (Windows holds a playing file): again in a moment
            if err:
                self.toast(f"Upgraded “{old['title']}”, but couldn't put the old file away: {err[:80]}")
            return False
        GLib.timeout_add(1500, away)

    def tidy_name(self, vid):
        """A download named "NN Title (td123).flac" because your file had its name: now that
        that's gone, it takes the plain name."""
        e = self.lib.items.get(vid)
        path = Path(e["file"]) if e else None
        m = path and re.match(r"^(.*) \([\w-]{1,8}\)$", path.stem)
        if not m or not self.dl.folder:
            return
        plain = path.with_name(m.group(1) + path.suffix)
        if plain.exists():
            return
        try:
            path.rename(plain)
        except OSError:
            return
        for v, x in self.lib.items.items():
            if x.get("file") == str(path):
                x["file"] = str(plain)
                self.lib._seen.pop(v, None)
        self.lib.save()

    def stop_upgrade(self):
        if self.upgrading:
            self.upgrading["stop"] = True

    def retarget(self, old_ids, new):
        """Songs going away for new: your playlists and the queue get new in their place,
        their plays and stars go with it."""
        old_ids = set(old_ids) - {new["id"]}
        if not old_ids:
            return
        keep = slim(new)
        for pl in self.lists.items:
            if any(t["id"] in old_ids for t in pl["tracks"]):
                have, out = set(), []
                for t in pl["tracks"]:
                    t = keep if t["id"] in old_ids else t
                    if t["id"] not in have:
                        have.add(t["id"])
                        out.append(t)
                pl["tracks"], pl["updated"] = out, time.time()
        self.lists.save()
        for i, t in enumerate(self.queue):
            if t["id"] in old_ids and i != self.index:
                self.queue[i] = dict(keep)
        moved = [self.plays.items.pop(v) for v in old_ids if v in self.plays.items]
        if moved:
            e = self.plays.items.setdefault(new["id"], {"plays": 0, "last": 0, "track": keep})
            e["plays"] = e.get("plays", 0) + sum(m.get("plays", 0) for m in moved)
            e["last"] = max([e.get("last", 0)] + [m.get("last", 0) for m in moved])
            write_atomic(PLAYS, json.dumps(self.plays.items))

    def put_away(self, t):
        """t's file to the trash (a download: out of the library too). Returns an error, or None."""
        path = song_file(self.lib, t)
        if not path:
            return None
        cur = self.current_track()
        if cur and song_file(self.lib, cur) == path:
            return "it's playing"
        try:
            Gio.File.new_for_path(path).trash(None)
        except GLib.Error:
            try:
                Path(path).unlink()   # no trash there (some drives)
            except OSError as e:
                return str(e)
        for v in [v for v, e in self.lib.items.items() if e.get("file") == path]:
            self.lib.items.pop(v, None)
            self.lib._seen.pop(v, None)
        self.lib.save()
        if self.local.files.pop(str(Path(path).resolve()), None):
            write_atomic(LOCAL_INDEX, json.dumps({"files": self.local.files}))
        return None

    def replace_copies(self, old, new):
        """Put old (your copies of new) away, new taking their place in playlists and the queue."""
        gone, failed = [], []
        for t in old:
            err = self.put_away(t)
            (failed.append(f"{t['title']}: {err}") if err else gone.append(t))
        self.retarget([t["id"] for t in gone], new)
        if gone:
            self.toast(f"Replaced {len(gone)} cop{'ies' if len(gone) != 1 else 'y'} of “{new['title']}” (in the trash)")
        if failed:
            self.toast(f"Couldn't replace {failed[0][:100]}")
        if self.win:
            self.win.refresh_all()

    def find_dupes(self):
        """Your songs on disk that are there more than once (the same name and lead artist):
        [[(track, facts)]], the copy best to keep first in each. Blocking."""
        groups = {}
        for t in self.my_songs():
            if not is_phone_song(t):
                groups.setdefault(loose_key(t), []).append(t)
        out = []
        for key, ts in groups.items():
            if len(ts) < 2 or not key[0]:
                continue
            seen, copies = set(), []
            for t in ts:
                path = song_file(self.lib, t)
                if path and path not in seen:
                    seen.add(path)
                    copies.append((t, file_facts(path) | {"path": path}))
            if len(copies) > 1:
                copies.sort(key=lambda c: copy_rank(c[1]), reverse=True)
                out.append(copies)
        out.sort(key=lambda g: (norm(g[0][0]["artist"]), norm(g[0][0]["title"])))
        return out

    def scan_dupes(self):
        if getattr(self, "_dupe_scanning", False):
            return
        self._dupe_scanning = True
        if self.win:
            self.win.refresh_music()

        def done(res, err):
            self._dupe_scanning = False
            self.dupes = res or []
            if err:
                self.toast(f"Couldn't look for duplicates: {str(err)[:90]}")
            if self.win:
                self.win.refresh_music()
        in_thread(self.find_dupes, done=done)

    def delete_dupe(self, group, t):
        """Put t (one copy in group) away; the copy kept takes its place in playlists."""
        err = self.put_away(t)
        if err:
            self.toast(f"Couldn't delete “{t['title']}”: {err[:90]}")
            return False
        keep = next((c for c, _f in group if c["id"] != t["id"]), None)
        if keep:
            self.retarget([t["id"]], keep)
        for g in self.dupes or []:
            g[:] = [c for c in g if c[0]["id"] != t["id"]]
        self.dupes = [g for g in self.dupes or [] if len(g) > 1]
        self.toast(f"“{t['title']}” is in the trash")
        return True

    # ---- Tidal and the FLAC sync of your whole library ----
    def connect_tidal(self):
        """Open Tidal's sign-in page; Settings then asks for the address it ends on."""
        tidal = self.dl.tidal
        if not tidal or tidal.connected:
            return
        self.tidal_link = self.tidal_link or tidal.login_url()
        self.open_uri(self.tidal_link)
        self.accounts_changed("tidal")

    def finish_tidal_login(self, oops_url):
        def done(_res, err):
            if err:
                self.toast(f"Tidal didn't accept that: {str(err)[:80]}")
                return
            self.tidal_link = None
            self.source_ready("tidal", self.dl.tidal, None)
            self.toast("Tidal connected: everything plays in FLAC")
            self.sync_library()
        in_thread(self.dl.tidal.finish_login, oops_url, done=done)

    def sync_library(self):
        """Download every song in your playlists and favourites, on each service you
        sync, in FLAC; and replace songs saved lossy before."""
        tidal = self.dl.tidal
        if not (tidal and tidal.connected):
            return
        if self.syncing:
            self.sync_again = True   # a service signed in meanwhile: go again after
            return
        self.syncing, self.sync_again = True, False
        self.tagger.pause()   # what comes in is tagged together at the end
        self.update_sync()
        lossy = self.lib.lossy()
        sources = [s for k, s in self.sources.items() if s.signed_in and self.sync_sources.get(k, False)]

        def work():
            tracks, seen = [], set()
            for src in sources:
                try:
                    found = src.library_tracks()
                except Exception:  # noqa: BLE001 -- that service's songs wait for the next sync
                    continue
                for t in found:
                    if t["id"] not in seen:
                        seen.add(t["id"])
                        tracks.append(t)
                GLib.idle_add(lambda now=list(tracks): (setattr(self, "sync_tracks", now), self.update_sync(), False)[2])
            todo = [t for t in tracks if self.auto_save_ok(t)]   # songs you have already: not unless Copies says so
            self.dl.sync(todo + [t for t in lossy if t["id"] not in seen], self.update_sync)

        def done(_res, err):
            self.syncing = False
            self.update_sync()
            if err:
                self.toast(f"FLAC sync stopped: {str(err)[:80]}")
            if self.win:
                self.win.refresh_all()
            self.tagger.resume()
            self.tagger.start()
            if self.sync_again:
                self.sync_library()
        in_thread(work, done=done)

    def sync_status(self):
        tidal = self.dl.tidal
        if not tidal:
            return f"Tidal isn't available: {str(self.tidal_error)[:80]}" if self.tidal_error else "Connecting to Tidal…"
        if not tidal.connected:
            return ("Sign in on the Tidal page that opened. It ends on an “Oops” page:\n"
                    "copy that page's address and paste it below." if self.tidal_link
                    else "Connect Tidal to download your music in FLAC  ›")
        tracks = self.sync_tracks
        if not tracks:
            return "FLAC · reading your playlists…" if self.syncing else "FLAC · Tidal connected"
        flac = sum(self.lib.is_flac(t["id"]) for t in tracks)
        missing = sum(self.lib.recently_missing(t["id"]) and not self.lib.is_flac(t["id"]) for t in tracks)
        text = f"FLAC · {flac} of {len(tracks)} songs saved"
        if missing:
            text += f" · {missing} not on Tidal"
        return text + (" · downloading…" if self.syncing else "")

