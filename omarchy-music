        if not rows:
            self.report(body, status, f"No duplicates: {len(a.stats.songs):,} songs, each counted once.", [], dlg.close)
            return
        nv = sum(1 for r in rows if r["version"])
        status.set_label(f"{len(rows)} songs may be another one counted twice. Merge counts its plays as the one shown "
                         f"(the song's name in Most played); Leave alone keeps it apart and isn't asked again; Other song: "
                         f"the one you pick. Ticked: the same name written another way. "
                         + (f"{nv} {'is a version' if nv == 1 else 'are versions'} (acoustic, live, remix…): left alone unless you tick Merge. " if nv else "")
                         + "Artists: Similar artists and Joint artists; albums: Plays on singles and albums.")
