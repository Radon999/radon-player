def artist_picture(name, url):
    """An artist's picture as the cover cache takes one: a new picture is a new name, so the old one isn't shown."""
    return {"id": "pic-" + hashlib.sha1(f"{norm(name)}|{url}".encode()).hexdigest()[:16], "thumb": url}


def scroll_sideways(row):
    """row in a strip that scrolls sideways (the mouse wheel too) when the window is too
    narrow for all of it, with no scrollbar."""
    sw = Gtk.ScrolledWindow(child=row, hscrollbar_policy=Gtk.PolicyType.EXTERNAL, vscrollbar_policy=Gtk.PolicyType.NEVER,
                            propagate_natural_height=True)
    wheel = Gtk.EventControllerScroll(flags=Gtk.EventControllerScrollFlags.VERTICAL)

    def scrolled(_c, _dx, dy):
        adj = sw.get_hadjustment()
        if adj.get_upper() - adj.get_page_size() <= 0:
            return False
        adj.set_value(adj.get_value() + dy * 40)
        return True
    wheel.connect("scroll", scrolled)
    sw.add_controller(wheel)
    return sw


