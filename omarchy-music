        if cur and any(SongSpeeds.key(t) == SongSpeeds.key(cur) for t in tracks):
            self.player.set_speed(*self.speeds.get(cur))
            self.discord.changed()
        speed = self.speeds.get(tracks[0])[0] if tracks else 1.0
        what = f"“{tracks[0]['title']}”" if len(tracks) == 1 else f"{len(tracks)} songs"
        self.toast(f"{what} back to normal speed" if speed == 1.0 else f"{what} at {speed:g}×")
        if self.win:
            self.win.update_now_playing()

    # ---- deleting songs ----
    def delete_files(self, tracks):
        """Delete tracks' files: a download for good (it can be downloaded again), a
        song in your folders to the trash. Returns (the ids whose file went, what failed)."""
        gone, failed = set(), []
        for t in tracks:
            path = song_file(self.lib, t)
            if not path:
                continue
            ids = {v for v, e in self.lib.items.items() if e.get("file") == path}
            try:
                if ids:
                    for v in ids:
                        self.lib.remove(v)
                else:
                    Gio.File.new_for_path(path).trash(None)
                    self.local.files.pop(str(Path(path).resolve()), None)
            except Exception as e:  # noqa: BLE001 -- the next song
                failed.append(f"{Path(path).name}: {e}")
                continue
            gone |= ids | {t["id"]}
        if gone:
            write_atomic(LOCAL_INDEX, json.dumps({"files": self.local.files}))
        return gone, failed

    def delete_songs(self, tracks):
        """Delete the files of tracks, all but the playing song's, and take the songs that were
        only files out of the queue and your playlists."""
        cur = self.current_track()
        todo = [t for t in tracks if not cur or t["id"] != cur["id"]]
        if len(todo) < len(tracks):
            self.toast("The playing song is left as it is: skip it first")
        # Here, not in a thread: the library changes under the rows being drawn otherwise. A
        # delete (or a move to the trash) takes a moment each.
        gone, failed = self.delete_files(todo)
        if failed:
            self.toast(f"Couldn't delete {failed[0][:100]}" + (f" (and {len(failed) - 1} more)" if len(failed) > 1 else ""))
        files = {t["id"] for t in todo if t["id"] in gone and source_of(t) == "file"}
        if files:
            self.unqueue_many([i for i, t in enumerate(self.queue) if t["id"] in files])
            for pl in self.lists.items:
                if any(t["id"] in files for t in pl["tracks"]):
                    self.lists.remove(pl["id"], files)
        n = len({t["id"] for t in todo} & gone)
        if n:
            self.toast(f"Deleted {n} song{'s' if n != 1 else ''}")
        if self.win:
            self.win.refresh_all()
        return n

    def refresh_everywhere(self):
