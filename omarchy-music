            self.lyrics.show_for(t)

    def file_facts_now(self, path):
        """A file's format, bits and kHz (mutagen, in a thread the first time: None until then)."""
        cache = self.__dict__.setdefault("_facts", {})
        if not path:
            return None
        if path in cache:
            return cache[path]
        cache[path] = None

        def done(res, _err):
            cache[path] = res or {"format": Path(path).suffix.lstrip(".").upper(), "quality": ""}
            self.update_saved()
            t = self.app.current_track()
            if t and t.get("file") == path:
                self.update_now_page(t)
        in_thread(file_facts, path, done=done)
        return None

    def update_bitperfect(self):
        """Bit-perfect on: the volume can't move (it's 100%), the EQ says it's bypassed."""
        on = self.app.bitperfect
        if hasattr(self, "eq_bitperfect"):
            self.eq_bitperfect.set_visible(on)
        for sc in (getattr(self, "vol_scale", None), getattr(self, "np_vol", None)):
            if sc is not None:
                sc.set_sensitive(not on)
                sc.set_tooltip_text("Bit-perfect: the volume stays at 100% (turn it down on your DAC or amp)" if on else None)
        if on:
            self.vol_scale.get_adjustment().set_value(100)

    def update_saved(self):
        """The FLAC mark by the controls: on disk, being saved, or streaming (click to download)."""
        a = self.app
        t = a.current_track()
        if not t:
            return
        saved = self.lib.items.get(t["id"]) if self.lib.has(t["id"]) else None
        flac = bool(saved) and saved.get("format") == "flac"
        saving = t["id"] in a.dl.active or any(d["id"] == t["id"] for d in a.downloads)
        stream = not saved and source_of(t) != "file"
        quality = a.dl.stream_quality(t["id"])
        lossy = stream and a.dl.stream_lossy(t["id"])
        local = source_of(t) == "file" and not is_phone_song(t) and t.get("file")
        if local:
            facts = self.file_facts_now(t["file"])
            label = " · ".join(x for x in (facts["format"], facts["quality"]) if x) if facts else ""
        elif flac:
            label = "FLAC" + (f" · {saved['quality']}" if saved.get("quality") else "")
        elif saved:
            label = "✓ offline"
        elif saving:
            label = "Saving…"
        elif lossy:
            label = quality
        else:
            label = f"󰇚 FLAC · {quality}" if stream and quality else "󰇚 FLAC" if stream else ""
        self.saved_label.set_label(label)
        self.save_btn.set_can_target(stream and not saving and not lossy)
        self.save_btn.set_tooltip_text(f"FLAC {saved.get('quality', '')} on disk: plays without data" if flac
                                       else "Saved on disk: plays without data" if saved
                                       else "Downloading it in FLAC" if saving
                                       else f"Streaming {quality} from {lossy}: Tidal has no FLAC of this song"
                                       if lossy
                                       else f"Streaming FLAC{' ' + quality if quality else ''} from Tidal. "
                                            "Click to download it" if stream else None)

