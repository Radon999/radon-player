# Apple Music: your library through the API music.apple.com's own player
# uses, signed in the way your browser is. Apple Music's audio is
# copy-protected, so its songs play from Tidal in FLAC, matched by ISRC.
# =============================================================================

APPLE_TOKEN = CACHE / "apple-token.json"
APPLE_API = "https://amp-api.music.apple.com"


def jwt_claims(token):
    try:
        part = token.split(".")[1]
        return json.loads(base64.urlsafe_b64decode(part + "=" * (-len(part) % 4)))
    except (IndexError, ValueError):
        return {}


def apple_web_token(refresh=False):
    """The token music.apple.com's player sends to Apple's API. It is in the
    player's script and lasts a couple of months; kept until it expires."""
    saved = read_json(APPLE_TOKEN, {})
    if not refresh and saved.get("token") and saved.get("exp", 0) > time.time() + 86400:
        return saved["token"]
    page = http("https://music.apple.com/us/browse").decode("utf-8", "replace")
    for path in dict.fromkeys(re.findall(r'(/assets/[^"\'\s]+\.js)', page)):
        script = http("https://music.apple.com" + path).decode("utf-8", "replace")
        for tok in re.findall(r"eyJ[\w-]{10,}\.[\w-]{10,}\.[\w-]{10,}", script):
            claims = jwt_claims(tok)
            if claims.get("iss") and claims.get("exp", 0) > time.time():
                write_atomic(APPLE_TOKEN, json.dumps({"token": tok, "exp": claims["exp"]}))
                return tok
    raise RuntimeError("couldn't find Apple Music's web token")


def apple_art(url, px):
    return (url or "").replace("{w}", str(px)).replace("{h}", str(px)).replace("{f}", "jpg").replace("{c}", "bb")


def track_from_apple(res):
    """Normalise an Apple Music song, from the catalogue or your library, into our track dict."""
    a = res.get("attributes") or {}
    rel = ((res.get("relationships") or {}).get("catalog") or {}).get("data") or []
    cat = rel[0] if rel else {}
    cid = (a.get("playParams") or {}).get("catalogId") or cat.get("id") or (res["id"] if res.get("type") == "songs" else None)
    return {"id": f"am{cid or res.get('id')}", "source": "apple", "apple": cid,
            "isrc": a.get("isrc") or (cat.get("attributes") or {}).get("isrc"),
            "title": a.get("name") or "Unknown", "artist": a.get("artistName") or "Unknown artist",
            "album": a.get("albumName") or "", "duration": round((a.get("durationInMillis") or 0) / 1000),
            "thumb": apple_art((a.get("artwork") or (cat.get("attributes") or {}).get("artwork") or {}).get("url"), 226)}


class AppleMusic:
    """Your Apple Music library: playlists, favourites and search. Without a
    sign-in it still searches the catalogue, which the tagger uses too."""
    key, name = "apple", "Apple Music"
    hint = "Sign in at music.apple.com in Chromium,\nthen pick “Check again” below."

    def __init__(self):
        self.token = apple_web_token()
        self.browser, cookies = find_signed_in_browser("apple.com", "media-user-token")
        self.user_token = (cookies or {}).get("media-user-token")
        self.storefront, self.signed_in = "us", False
        if self.user_token:
            try:
                data = self.get("/v1/me/storefront").get("data") or []
                self.storefront = data[0]["id"] if data else "us"
                self.signed_in = True
            except Exception:  # noqa: BLE001 -- expired login: the catalogue only
                self.user_token = None

    def headers(self, body=False):
        h = {"Authorization": f"Bearer {self.token}", "Origin": "https://music.apple.com",
             "Referer": "https://music.apple.com/"}
        if self.user_token:
            h["media-user-token"] = self.user_token
        if body:
            h["Content-Type"] = "application/json"
        return h

    def request(self, path, params=None, method=None, body=None):
        url = path if path.startswith("http") else APPLE_API + path
        if params:
            url += ("&" if "?" in url else "?") + urllib.parse.urlencode(params)
        data = json.dumps(body).encode() if body is not None else None
        try:
            return http_json(url, self.headers(data is not None), data, method)
        except urllib.error.HTTPError as e:
            if e.code != 401:
                raise
            self.token = apple_web_token(refresh=True)   # Apple moved to a new token
            return http_json(url, self.headers(data is not None), data, method)

    def get(self, path, params=None):
        return self.request(path, params)

    def pages(self, path, params=None, cap=5000):
        """Every item of a list Apple hands out a page at a time."""
        out, url = [], path
        while url and len(out) < cap:
            page = self.get(url, params)
            out += page.get("data") or []
            url = page.get("next")
            params = {k: v for k, v in (params or {}).items() if k != "offset"}   # the next link has its own
        return out

    def search(self, q):
        m = re.search(r"music\.apple\.com/(?:(\w\w)/)?(song|album|playlist)/(?:[^/?#]+/)?([\w.-]+)(?:\?i=(\d+))?", q)
        if not m:
            res = self.get(f"/v1/catalog/{self.storefront}/search", {"term": q, "types": "songs", "limit": 25})
            return [track_from_apple(s) for s in ((res.get("results") or {}).get("songs") or {}).get("data") or []]
        sf, kind, ident, song = m.groups()
        sf = sf or self.storefront
        if song or kind == "song":
            return [track_from_apple(s) for s in self.get(f"/v1/catalog/{sf}/songs/{song or ident}").get("data") or []]
        if kind == "album":
            tracks = [track_from_apple(s) for s in self.pages(f"/v1/catalog/{sf}/albums/{ident}/tracks")]
            self.fill_isrcs(tracks)
            return tracks
        return self.playlist(ident)

    def radio(self, track):
        raise NotImplementedError   # Apple's stations stream only to its own players: Tidal or YouTube Music fill in

    def my_playlists(self):
        out = []
        for p in self.pages("/v1/me/library/playlists", {"limit": 100}):
            a = p.get("attributes") or {}
            out.append({"id": p["id"], "title": a.get("name") or "Playlist", "count": "",
                        "thumb": apple_art((a.get("artwork") or {}).get("url"), 226)})
        return out

    def playlist(self, pid):
        if pid.startswith("p."):   # one of yours
            items = self.pages(f"/v1/me/library/playlists/{pid}/tracks", {"limit": 100, "include": "catalog"})
        else:                      # a public one, from a link
            items = self.pages(f"/v1/catalog/{self.storefront}/playlists/{pid}/tracks", {"limit": 100})
        tracks = [track_from_apple(s) for s in items]
        self.fill_isrcs(tracks)
        return tracks

    def fill_isrcs(self, tracks):
        """Library songs often come without their ISRC: ask the catalogue, 100 at a time."""
        need = [t for t in tracks if t.get("apple") and not t.get("isrc")]
        for i in range(0, len(need), 100):
            chunk = need[i:i + 100]
            try:
                data = self.get(f"/v1/catalog/{self.storefront}/songs",
                                {"ids": ",".join(str(t["apple"]) for t in chunk)}).get("data") or []
            except Exception:  # noqa: BLE001 -- they match by name instead
                continue
            isrcs = {s["id"]: (s.get("attributes") or {}).get("isrc") for s in data}
            for t in chunk:
                t["isrc"] = isrcs.get(str(t["apple"])) or t.get("isrc")

    def liked_ids(self):
        """Apple Music keeps the songs you favourite in a playlist of their own."""
        for p in self.my_playlists():
            if norm(p["title"]) in ("favorite songs", "favourite songs"):
                return {t["id"] for t in self.playlist(p["id"])}
        return set()

    def rate(self, track, like):
        if not track.get("apple"):
            raise RuntimeError("that song isn't in Apple's catalogue")
        path = f"/v1/me/ratings/songs/{track['apple']}"
        if like:
            self.request(path, method="PUT", body={"type": "rating", "attributes": {"value": 1}})
        else:
            self.request(path, method="DELETE")

    def library_tracks(self):
        """Every song in your playlists, each once."""
        seen, out = set(), []
        for pl in self.my_playlists():
            try:
                tracks = self.playlist(pl["id"])
            except Exception:  # noqa: BLE001 -- skip a playlist that won't load
                continue
            for t in tracks:
                if t["id"] not in seen:
                    seen.add(t["id"])
                    out.append(t)
        return out

    def artist(self, name):
        res = self.get(f"/v1/catalog/{self.storefront}/search", {"term": name, "types": "artists", "limit": 5})
        a = best_named(((res.get("results") or {}).get("artists") or {}).get("data") or [], name,
                       lambda x: (x.get("attributes") or {}).get("name") or "")
        if not a:
            return None
        base = f"/v1/catalog/{self.storefront}/artists/{a['id']}"
        top = [track_from_apple(s) for s in self.get(f"{base}/view/top-songs", {"limit": 20}).get("data") or []]
        albums = []
        for x in self.pages(f"{base}/albums", {"limit": 25}, cap=100):
            at = x.get("attributes") or {}
            albums.append(album_entry(x["id"], at.get("name"), "Single" if at.get("isSingle") else (at.get("releaseDate") or "")[:4],
                                      apple_art((at.get("artwork") or {}).get("url"), 226)))
        at = a.get("attributes") or {}
        return {"name": at.get("name") or name, "thumb": apple_art((at.get("artwork") or {}).get("url"), 320),
                "top": top, "albums": albums}

    def album(self, aid):
        tracks = [track_from_apple(s) for s in self.pages(f"/v1/catalog/{self.storefront}/albums/{aid}/tracks")]
        self.fill_isrcs(tracks)
        return tracks

    def catalog_song(self, isrc, album=""):
        """Apple's catalogue entry for the recording with this ISRC, with its album
        (genres, composer, label, release date, artwork), or None."""
        data = self.get(f"/v1/catalog/{self.storefront}/songs", {"filter[isrc]": isrc, "include": "albums"}).get("data") or []
        data.sort(key=lambda s: norm((s.get("attributes") or {}).get("albumName")) != norm(album))
        return data[0] if data else None


# =============================================================================
# Spotify: your liked songs and playlists through a Spotify developer app of
# your own (Spotify hands its API only to those, and since 2026 the app's owner
# needs Premium). Its audio is copy-protected, so its songs play from Tidal in
# FLAC, matched by ISRC. Spotify no longer gives apps like this radios or an
# artist's top songs: another service fills those in.
# =============================================================================

SPOTIFY_AUTH = STATE_DIR / "omarchy-music-spotify.json"   # your app's client ID + login, mode 600
SPOTIFY_API = "https://api.spotify.com/v1"
SPOTIFY_PORT = 8898
SPOTIFY_REDIRECT = f"http://127.0.0.1:{SPOTIFY_PORT}/callback"
SPOTIFY_SCOPES = "user-library-read user-library-modify playlist-read-private playlist-read-collaborative"


def track_from_spotify(t, album=None):
    """Normalise a Spotify track (full, or an album's simplified one with its album given) into our track dict."""
    if not t or t.get("type", "track") != "track" or not t.get("id"):
        return None
    album = t.get("album") or album or {}
    imgs = album.get("images") or []
    thumb = min(imgs, key=lambda i: abs((i.get("width") or 300) - 300))["url"] if imgs else ""
    return {"id": f"sp{t['id']}", "source": "spotify", "spotify": t["id"],
            "isrc": (t.get("external_ids") or {}).get("isrc"),
            "title": t.get("name") or "Unknown",
            "artist": ", ".join(a["name"] for a in t.get("artists") or [] if a.get("name")) or "Unknown artist",
            "album": album.get("name") or "", "duration": round((t.get("duration_ms") or 0) / 1000), "thumb": thumb}


class Spotify:
    """Your Spotify library: liked songs, playlists, search and artists' albums."""
    key, name = "spotify", "Spotify"
    hint = "Connect Spotify in Settings (top right).\nIt needs a Spotify developer app of yours."

    def __init__(self):
        self.lock = threading.Lock()
        self.auth = read_json(SPOTIFY_AUTH, {})
        self.cancelled = False

    @property
    def client_id(self):
        return self.auth.get("client_id", "")

    @property
    def user(self):
        return self.auth.get("user", "")

    @property
    def signed_in(self):
        return bool(self.auth.get("refresh_token"))

    def _save(self):
        write_private(SPOTIFY_AUTH, json.dumps(self.auth))

    def disconnect(self):
        self.auth = {"client_id": self.client_id}
        self._save()

    @staticmethod
    def _token(form):
        return http_json("https://accounts.spotify.com/api/token", {"Content-Type": "application/x-www-form-urlencoded"},
                         urllib.parse.urlencode(form).encode(), "POST")

    def _take(self, tok):
        self.auth["access_token"] = tok["access_token"]
        self.auth["expires"] = time.time() + tok.get("expires_in", 3600) - 60
        if tok.get("refresh_token"):   # Spotify may hand out a new one: the old one stops working
            self.auth["refresh_token"] = tok["refresh_token"]

    def login(self, client_id, opened):
        """Connect (blocking): open Spotify's consent page (opened(url) shows it), catch the
        browser coming back to 127.0.0.1, and swap the code for a login. PKCE: no secret."""
        client_id = client_id.strip()
        if not re.fullmatch(r"[0-9a-f]{32}", client_id):
            raise ValueError("that isn't a Spotify Client ID: 32 letters and digits")
        verifier = base64.urlsafe_b64encode(os.urandom(48)).rstrip(b"=").decode()
        challenge = base64.urlsafe_b64encode(hashlib.sha256(verifier.encode()).digest()).rstrip(b"=").decode()
        state, got = secrets.token_urlsafe(16), {}

        class Back(BaseHTTPRequestHandler):
            def do_GET(h):
                url = urllib.parse.urlparse(h.path)
                if url.path != "/callback":
                    h.send_response(404)
                    h.end_headers()
                    return
                got.update({k: v[0] for k, v in urllib.parse.parse_qs(url.query).items()})
                ok = "code" in got and got.get("state") == state
                h.send_response(200)
                h.send_header("Content-Type", "text/plain; charset=utf-8")
                h.end_headers()
                h.wfile.write(("Spotify is connected to Radon Player. You can close this tab." if ok
                               else f"Spotify didn't connect: {got.get('error', 'no code came back')}").encode())

            def log_message(h, *_a):
                pass

        server = HTTPServer(("127.0.0.1", SPOTIFY_PORT), Back)
        server.timeout = 1
        self.cancelled = False
        try:
            opened("https://accounts.spotify.com/authorize?" + urllib.parse.urlencode({
                "client_id": client_id, "response_type": "code", "redirect_uri": SPOTIFY_REDIRECT, "state": state,
                "scope": SPOTIFY_SCOPES, "code_challenge_method": "S256", "code_challenge": challenge}))
            end = time.monotonic() + 180
            while not got and not self.cancelled and time.monotonic() < end:
                server.handle_request()
        finally:
            server.server_close()
        if self.cancelled:
            raise RuntimeError("cancelled")
        if not got:
            raise RuntimeError("Spotify's page wasn't approved in time")
        if got.get("state") != state or "code" not in got:
            raise RuntimeError(got.get("error") or "Spotify didn't send a login back")
        tok = self._token({"grant_type": "authorization_code", "code": got["code"], "redirect_uri": SPOTIFY_REDIRECT,
                           "client_id": client_id, "code_verifier": verifier})
        self.auth = {"client_id": client_id}
        self._take(tok)
        me = self.get("/me")
        self.auth["user"] = me.get("display_name") or me.get("id") or ""
        self._save()

    def access(self):
        with self.lock:
            if self.auth.get("access_token") and self.auth.get("expires", 0) > time.time():
                return self.auth["access_token"]
            if not self.signed_in:
                raise RuntimeError("Spotify isn't connected")
            self._take(self._token({"grant_type": "refresh_token", "refresh_token": self.auth["refresh_token"],
                                    "client_id": self.client_id}))
            self._save()
            return self.auth["access_token"]

    def request(self, path, params=None, method=None, body=None):
        url = path if path.startswith("http") else SPOTIFY_API + path
        if params:
            url += ("&" if "?" in url else "?") + urllib.parse.urlencode(params)
        data = json.dumps(body).encode() if body is not None else b"" if method in ("PUT", "DELETE", "POST") else None
        for attempt in range(3):
            headers = {"Authorization": f"Bearer {self.access()}"}
            if body is not None:
                headers["Content-Type"] = "application/json"
            try:
                return http_json(url, headers, data, method)
            except urllib.error.HTTPError as e:
                if e.code == 429 and attempt < 2:   # too fast: Spotify says how long to wait
                    time.sleep(min(int(e.headers.get("Retry-After") or 1), 10))
                elif e.code == 401 and attempt == 0:
                    self.auth["expires"] = 0
                else:
                    raise

    def get(self, path, params=None):
        return self.request(path, params)

    def pages(self, path, params=None, cap=10000):
        """Every item of a list Spotify hands out a page at a time."""
        out, url = [], path
        while url and len(out) < cap:
            page = self.get(url, params)
            params = None   # the next link carries them
            out += [i for i in page.get("items") or [] if i]
            url = page.get("next")
        return out

    def search(self, q):
        m = re.search(r"open\.spotify\.com/(?:intl-[\w-]+/)?(track|album|playlist)/(\w+)", q) \
            or re.search(r"spotify:(track|album|playlist):(\w+)", q)
        if not m:
            found = []
            for offset in (0, 10, 20):   # ten a request for apps like this one
                items = (self.get("/search", {"q": q, "type": "track", "limit": 10, "offset": offset})
                         .get("tracks") or {}).get("items") or []
                found += items
                if len(items) < 10:
                    break
            return [t for t in map(track_from_spotify, found) if t]
        kind, ident = m.groups()
        if kind == "track":
            return [t for t in [track_from_spotify(self.get(f"/tracks/{ident}"))] if t]
        if kind == "album":
            return self.album(ident)
        return self.playlist(ident)

    def radio(self, track):
        raise NotImplementedError   # Spotify stopped giving recommendations to apps like this: another service fills in

    def my_playlists(self):
        out = [{"id": "liked", "title": "Liked Songs", "count": "", "thumb": ""}]
        for p in self.pages("/me/playlists", {"limit": 50}):
            imgs = p.get("images") or []
            n = (p.get("items") or p.get("tracks") or {}).get("total", "")
            out.append({"id": p["id"], "title": p.get("name") or "Playlist", "count": n, "thumb": imgs[0]["url"] if imgs else ""})
        return out

    def playlist(self, pid):
        if pid == "liked":
            items = self.pages("/me/tracks", {"limit": 50})
        else:
            try:
                items = self.pages(f"/playlists/{pid}/items", {"limit": 50})
            except urllib.error.HTTPError as e:
                if e.code == 403:
                    raise RuntimeError("Spotify lets apps like this open only playlists you made or collaborate on") from e
                if e.code != 404:
                    raise
                items = self.pages(f"/playlists/{pid}/tracks", {"limit": 50})   # an app from before 2026
        return [t for t in (track_from_spotify(i.get("item") or i.get("track")) for i in items) if t]

    def liked_ids(self):
        return {t["id"] for t in self.playlist("liked")}

    def rate(self, track, like):
        method = "PUT" if like else "DELETE"
        try:
            self.request("/me/library", {"uris": f"spotify:track:{track['spotify']}"}, method=method)
        except urllib.error.HTTPError as e:
            if e.code not in (404, 405):
                raise
            self.request("/me/tracks", {"ids": track["spotify"]}, method=method)   # an app from before 2026

    def library_tracks(self):
        """Every song in your liked songs and playlists, each once."""
        seen, out = set(), []
        for pl in self.my_playlists():
            try:
                tracks = self.playlist(pl["id"])
            except Exception:  # noqa: BLE001 -- skip a playlist that won't load
                continue
            for t in tracks:
                if t["id"] not in seen:
                    seen.add(t["id"])
                    out.append(t)
        return out

    def artist(self, name):
        res = self.get("/search", {"q": name, "type": "artist", "limit": 5})
        a = best_named((res.get("artists") or {}).get("items") or [], name, lambda x: x.get("name") or "")
        if not a:
            return None
        albums = []
        for x in self.pages(f"/artists/{a['id']}/albums", {"include_groups": "album,single", "limit": 10}, cap=60):
            imgs = x.get("images") or []
            albums.append(album_entry(x["id"], x.get("name"), "Single" if x.get("album_type") == "single"
                                      else (x.get("release_date") or "")[:4], imgs[-2]["url"] if len(imgs) > 1 else
                                      imgs[0]["url"] if imgs else ""))
        imgs = a.get("images") or []
        return {"name": a.get("name") or name, "thumb": imgs[-2]["url"] if len(imgs) > 1 else imgs[0]["url"] if imgs else "",
                "top": [], "albums": albums}

    def album(self, aid):
        al = self.get(f"/albums/{aid}")
        items = list((al.get("tracks") or {}).get("items") or [])
        nxt = (al.get("tracks") or {}).get("next")
        if nxt:
            items += self.pages(nxt)
        return [t for t in (track_from_spotify(i, al) for i in items) if t]


