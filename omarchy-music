        self.drawer_src.add_css_class("drawer-src")
        card.append(self.drawer_src)
        card.append(scroll_sideways(self.source_group))
        box.append(card)
        self.drawer_items = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE)
        self.drawer_items.add_css_class("drawer-items")
        self.drawer_items.connect("row-activated", lambda _l, row: getattr(row, "go", None) and row.go())
        box.append(self.drawer_items)
        sw = Gtk.ScrolledWindow(hscrollbar_policy=Gtk.PolicyType.NEVER, child=box, vexpand=True)
        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL)
        outer.add_css_class("drawer")
        outer.append(sw)
        self.drawer_box = outer
        self.drawer_sig, self.drawer_rows = None, []
        self.refresh_drawer()
        return outer

    def refresh_drawer(self):
        """The menu's rows: made again only when what's in it changes (the service, Wrapped); going
        from page to page just moves which one is lit."""
        lst = getattr(self, "drawer_items", None)
        if lst is None:
            return
        a = self.app
        wrapped = bool(a.lastfm.connected or a.spotify_history.plays or a.deezer_history.plays or a.apple_history.rows)
        sig = (a.browse_local, a.source, wrapped)
        if sig != self.drawer_sig:
            self.drawer_sig = sig
            lst.remove_all()
            self.drawer_rows = []
            self.drawer_src.set_label("Your music" if a.browse_local else SOURCES.get(a.source, ""))
            self.drawer_sections = {}

            def add(label, icon, tab, view):
                if tab == "account":
                    if a.browse_local:
                        return None
                    label = f"{SOURCES.get(a.source, 'Service')} library"
                go = a.open_wrapped if tab == "wrapped" else (lambda t=tab, v=view: self.drawer_go(t, v))
                row = self.drawer_row(label, icon, False, go)
                self.drawer_rows.append((row, tab, view))
                lst.append(row)
                return row
            for item in self.DRAWER_TOP:
                add(*item)
            for key, name, items in self.DRAWER_SECTIONS:
                head = self.drawer_head(key, name)
                lst.append(head)
                rows = [r for r in (add(*item) for item in items) if r is not None]
                self.drawer_sections[key] = (head, rows)
                self.show_section(key)
            sep = Gtk.ListBoxRow(activatable=False, selectable=False, child=Gtk.Separator())
            sep.add_css_class("drawer-sep")
            lst.append(sep)
            for label, icon, tab in (("Settings", "settings", "settings"), ("Equalizer", "eq", "eq"),
                                     ("Mini player", "mini", "mini")):
                go = a.open_mini_player if tab == "mini" else (lambda t=tab: self.drawer_go(t, None))
                row = self.drawer_row(label, icon, False, go, quiet=True)
                self.drawer_rows.append((row, tab, None))
                lst.append(row)
        key = self.stack.get_visible_child_name()
        for row, tab, view in self.drawer_rows:
            on = key == tab and (view is None or view == self.music_view)
            if on != row.has_css_class("on"):
                (row.add_css_class if on else row.remove_css_class)("on")

    def drawer_head(self, key, name):
        """A section of the menu: its name and an arrow; a click folds it open or shut."""
        box = Gtk.Box(spacing=8)
        lab = Gtk.Label(label=name, xalign=0, hexpand=True, ellipsize=Pango.EllipsizeMode.END)
        arrow = Gtk.Label(label="▾")
        arrow.add_css_class("drawer-arrow")
        box.append(lab)
        box.append(arrow)
        row = Gtk.ListBoxRow(child=box)
        row.add_css_class("drawer-head")
        row.arrow = arrow
        row.go = lambda: self.fold_section(key)
        return row

    def fold_section(self, key):
        open_ = self.app.drawer_folds
        open_[key] = not open_.get(key, False)
        self.app.save_soon()
        self.show_section(key)

    def show_section(self, key):
        head, rows = self.drawer_sections.get(key, (None, ()))
        if head is None:
            return
        on = self.app.drawer_folds.get(key, False)
        head.arrow.set_label("▾" if on else "▸")
        for r in rows:
            r.set_visible(on)

    def drawer_row(self, label, icon, on, go, quiet=False):
        box = Gtk.Box(spacing=14)
        box.append(Icon(icon, 18))
        box.append(Gtk.Label(label=label, xalign=0, hexpand=True, ellipsize=Pango.EllipsizeMode.END))
        row = Gtk.ListBoxRow(child=box)
        row.add_css_class("drawer-item")
        if on:
            row.add_css_class("on")
        if quiet:
            row.add_css_class("quiet")
        row.go = go
        return row

    def drawer_go(self, tab, view):
        """A row of the menu: its page (the menu stays open: ☰ closes it)."""
        if tab == "music":
            self.open_view(view)
        else:
            self.show_tab(tab)

    # The pages with a list, grid or compact grid layout: lists of songs, albums, artists… (not the ones that
    # do something: the DJ, Duplicates, New releases…). Opened (an album's songs, a playlist's), it's a list.
    LAYOUT_VIEWS = ("all", "albums", "eps", "singles", "genres", "folders", "playlists", "recent", "top", "skips", "favorites",
                    "unfavorited", "pinned", "repeat")
    LAYOUT_ICONS = {"list": "list", "grid": "grid", "compact": "grid_small"}

    def layout_page(self):
        """The page whose layout the header's button sets, or None."""
        key = self.stack.get_visible_child_name()
        if key == "artists":
            return "artists"
        if key == "music" and self.music_view in self.LAYOUT_VIEWS and not self.open_group and not self.open_mine \
                and not (self.music_view == "playlists" and self.open_folder):
            return self.music_view
        return None

    def page_layout(self, page):
        return self.app.layouts.get(page, "list") if page else "list"

    def cycle_layout(self):
        page = self.layout_page()
        if not page:
            return
        order = ("list", "grid", "compact")
        self.app.layouts[page] = order[(order.index(self.page_layout(page)) + 1) % 3]
        self.app.save_soon()
        self.update_layout_btn()
        if page == "artists":
            self._artists_sig = None
            self.refresh_artists()
        else:
            self.music_list.set_layout(self.page_layout(page))

    def update_layout_btn(self):
        page = self.layout_page()
        self.layout_btn.set_visible(page is not None)
        if page:
            lay = self.page_layout(page)
            self.layout_btn.set_child(Icon(self.LAYOUT_ICONS[lay], 18))
            self.layout_btn.set_tooltip_text({"list": "Layout: list (click: grid)", "grid": "Layout: grid (click: compact grid)",
                                              "compact": "Layout: compact grid (click: list)"}[lay])
        if self.stack.get_visible_child_name() == "music" and getattr(self, "music_list", None) is not None:
            self.music_list.set_layout(self.page_layout(page))

    FILTER_LISTS = {"music": "music_list", "account": "account_list", "artist": "artist_list", "queue": "queue_list"}

    def filter_target(self):
        key = self.stack.get_visible_child_name()
        if key == "artists":
            return getattr(self, "artists_flow", None)
        name = self.FILTER_LISTS.get(key)
        return getattr(self, name, None) if name else None

    def toggle_filter(self, on=None):
        """The search button: on the Search page, it's that page's; elsewhere it searches the page you're on."""
        if self.stack.get_visible_child_name() == "search":
            return
        if self.filter_target() is None:   # Now playing, Settings, the Equalizer…: the services' search
            self.show_tab("search")
            return
        on = not self.filter_entry.get_visible() if on is None else on
        self.filter_entry.set_visible(on)
        if on:
            self.filter_entry.grab_focus()
        else:
            self.filter_entry.set_text("")
            self.apply_filter("")

    def apply_filter(self, q):
        target = self.filter_target()
        if isinstance(target, SongList):
            target.set_filter(q)
        elif isinstance(target, Gtk.FlowBox):
            words = norm(q).split()
            target.set_filter_func((lambda child: all(w in norm(child.get_child().get_tooltip_text() or "") for w in words))
                                   if words else None)

    def clear_filter(self):
        """Going to another page: its search starts empty."""
        if getattr(self, "filter_entry", None) is None:
            return
        if self.filter_entry.get_visible() or self.filter_entry.get_text():
            self.filter_entry.set_text("")
            self.filter_entry.set_visible(False)
        for name in self.FILTER_LISTS.values():
            lst = getattr(self, name, None)
            if isinstance(lst, SongList) and lst.filter_q:
                lst.set_filter("")
        flow = getattr(self, "artists_flow", None)
        if flow is not None:
            flow.set_filter_func(None)

    def toggle_mini(self):
        self.app.toggle_mini()

    def toggle_drawer(self):
        on = not self.split.get_show_sidebar()
        self.split.set_show_sidebar(on)
        self.app.drawer_open = on
        self.app.save_soon()

    def refresh_accounts(self):
        """Rebuild Settings (while it is open) from how things stand."""
        if not self.accounts_pop.get_visible():
            return
        a, box = self.app, self.accounts_box
        while (child := box.get_first_child()):
            box.remove(child)
        # Apple-like: sections with a heading, each a rounded group of rows (the name and what it is on
        # the left, its switch or buttons on the right).
        # Each section folds: its name and an arrow; all of them folded each time Settings opens, so you see
        # the sections and open the one you want.
        cur = None
        opened = self.__dict__.setdefault("settings_open", set())

        def group(title):
            nonlocal cur
            key = title.lower()
            on = key in opened
            row = Gtk.Box(spacing=8)
            lab = Gtk.Label(label=title, xalign=0, hexpand=True)
            lab.add_css_class("set-fold-name")
            arrow = Gtk.Label(label="▾" if on else "▸")
            arrow.add_css_class("set-fold-arrow")
            row.append(lab)
            row.append(arrow)
            head = Gtk.Button(child=row)
            head.add_css_class("flat")
            head.add_css_class("set-fold")
            box.append(head)
            cur = Gtk.ListBox(selection_mode=Gtk.SelectionMode.NONE, visible=on)
            cur.add_css_class("set-group")
            box.append(cur)

            def fold(_b, lst=cur, arrow=arrow, key=key):
                now = not lst.get_visible()
                (opened.add if now else opened.discard)(key)
                lst.set_visible(now)
                arrow.set_label("▾" if now else "▸")
            head.connect("clicked", fold)
        up = a.updater
        group("General")

        def pill(label, cb, quiet=False):
            b = Gtk.Button(label=label, valign=Gtk.Align.CENTER)
            b.add_css_class("pill")
            if quiet:
                b.add_css_class("quiet")
            b.connect("clicked", lambda *_: cb())
            return b

        def line(name, state, ok=False, *actions):
            r = Gtk.Box(spacing=14)
            r.add_css_class("set-row")
            texts = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, hexpand=True, valign=Gtk.Align.CENTER, spacing=2)
            n = Gtk.Label(label=name, xalign=0)
            n.add_css_class("service")
            s = Gtk.Label(label=state, xalign=0, wrap=True, max_width_chars=48)
            s.add_css_class("state")
            if ok:
                s.add_css_class("ok")
            s.set_visible(bool(state))
            texts.append(n)
            texts.append(s)
            r.append(texts)
            if actions:
                act = Gtk.Box(spacing=6, halign=Gtk.Align.END, valign=Gtk.Align.CENTER)
                for w in actions:
                    act.append(w)
                r.append(act)
            cur.append(Gtk.ListBoxRow(child=r, activatable=False))
            return s

        def across(widget):
            widget.add_css_class("set-across")
            cur.append(Gtk.ListBoxRow(child=widget, activatable=False))

        def sync_switch(key):
            tip = (f"Download every song in your {SOURCES[key]} {'favourites and ' if key == 'tidal' else ''}"
                   "playlists in FLAC, and keep up with them. Off: songs download only when you play or pick them.")
            box = Gtk.Box(spacing=6, tooltip_text=tip)
            label = Gtk.Label(label="Sync")
            label.add_css_class("state")
            sw = Gtk.Switch(active=a.sync_sources.get(key, False), valign=Gtk.Align.CENTER)
            sw.connect("notify::active", lambda s, _p: a.set_sync_source(key, s.get_active()))
            box.append(label)
            box.append(sw)
            return box

        if up.latest:
            new = up.latest.lstrip("v")
            if up.state == "restart":
                line("Update", f"Updated to {new}: restart to use it", True, pill("Restart", up.restart))
            elif up.state == "working":
                line("Update", f"Updating to {new}…" if not WINDOWS else f"Downloading {new}… (it reopens when it's done)")
            else:
                line("Update", up.state or f"Radon Player {new} is out (this is {VERSION})", False,
                     pill("Update", up.install))
        else:
            line("Version", f"{VERSION} · checking…" if up.checking else f"{VERSION} · {up.check_error or 'up to date'}", False,
                 *([] if up.checking else [pill("Check", lambda: up.check(quiet=False), quiet=True)]))
        group("Accounts")
        for key in ("ytm", "apple"):
            src = a.sources.get(key)
            if src and src.signed_in:
                line(SOURCES[key], f"Signed in · {src.browser.title()}", True, sync_switch(key))
            elif src or a.source_errors.get(key):
                line(SOURCES[key], f"Sign in at {'music.youtube.com' if key == 'ytm' else 'music.apple.com'} in Chromium",
                     False, pill("Check again", lambda key=key: a.recheck(key), quiet=True))
            else:
                line(SOURCES[key], "Connecting…")
        tidal = a.dl.tidal
        if tidal and tidal.connected:
            line("Tidal", "Connected · songs play in FLAC (lossy only where Tidal has no FLAC)", True, sync_switch("tidal"))
            keep = Gtk.Switch(active=a.keep_played, valign=Gtk.Align.CENTER)
            keep.connect("notify::active", lambda sw, _p: a.set_keep_played(sw.get_active()))
            line("Keep", "Save every song you play, in FLAC. Off: songs stream from Tidal and download "
                 "only when you pick Download", a.keep_played, keep)
        elif tidal:
            line("Tidal", "Sign in on the page that opened, then paste the address it ends on" if a.tidal_link
                 else "Connect to play everything in FLAC", False, pill("Connect", a.connect_tidal))
            if a.tidal_link:
                paste = Gtk.Entry(placeholder_text="The “Oops” page address, then Enter", hexpand=True)
                paste.connect("activate", lambda e: e.get_text().strip() and a.finish_tidal_login(e.get_text()))
                across(paste)
        else:
            line("Tidal", f"Not available: {str(a.tidal_error)[:60]}" if a.tidal_error else "Connecting…")
        sp = a.sources.get("spotify")
        if sp and sp.signed_in:
            line("Spotify", f"Connected as {sp.user}" if sp.user else "Connected", True, sync_switch("spotify"),
                 pill("Disconnect", a.spotify_disconnect, quiet=True))
        elif a.spotify_connecting:
            line("Spotify", "Approve Radon Player on the Spotify page that opened…", False,
                 pill("Cancel", a.spotify_cancel, quiet=True))
        elif sp:
            line("Spotify", "Spotify wants a developer app of yours (its owner needs Premium). Make one with "
                 "the Web API ticked and this redirect URI, then paste its Client ID:")
            uri = Gtk.Label(label=SPOTIFY_REDIRECT, xalign=0, selectable=True)
            uri.add_css_class("state")
            across(uri)
            cid = Gtk.Entry(placeholder_text="Client ID", hexpand=True, text=sp.client_id)
            cid.connect("activate", lambda e: a.spotify_connect(e.get_text()))
            across(cid)
            buttons = Gtk.Box(spacing=6, halign=Gtk.Align.END)
            buttons.append(pill("Make an app", lambda: a.open_uri("https://developer.spotify.com/dashboard/create"), quiet=True))
            buttons.append(pill("Connect", lambda: a.spotify_connect(cid.get_text())))
            across(buttons)
        else:
            err = a.source_errors.get("spotify")
            line("Spotify", f"Not available: {str(err)[:60]}" if err else "Connecting…")

        group("Library & playback")
        n = len(a.local.files)
        line("Folders", "Reading your folders…" if a.local.scanning else
             f"{n} song{'s' if n != 1 else ''} in your folders, in the Music tab" if a.folders else
             "Add the folders your own music is in", bool(n), pill("Add", self.add_folder))
        if a.folders or a.upgrading:
            up = a.upgrading
            line("Upgrade", f"Upgrading · {up['n']} of {up['total']} songs" if up else
                 "Swap your songs for Tidal's FLAC where it's better: MP3s and other lossy files, and 16-bit "
                 "ones Tidal has in hi-res. The old files go to the trash", bool(up),
                 pill("Stop", a.stop_upgrade, quiet=True) if up else pill("Upgrade…", self.confirm_upgrade))
        for folder in a.folders:
            fbox = Gtk.Box(spacing=6)
            name = Gtk.Label(label=short_path(folder), xalign=0, hexpand=True, ellipsize=Pango.EllipsizeMode.MIDDLE)
            name.add_css_class("state")
            fbox.append(name)
            fbox.append(pill("Remove", lambda folder=folder: a.remove_folder(folder), quiet=True))
            across(fbox)
        into = Gtk.Switch(active=a.lyrics_to_files, valign=Gtk.Align.CENTER)
        into.connect("notify::active", lambda sw, _p: sw.get_active() != a.lyrics_to_files and a.set_lyrics_to_files(sw.get_active()))
        line("Lyrics into files", "The lyrics found for each song you play go into its file's tags (MP3, FLAC, M4A, "
             "Ogg…), just the words, so they stay with it. Files that have lyrics are left as they are", a.lyrics_to_files, into)
        multi = Gtk.Switch(active=a.multi_queue, valign=Gtk.Align.CENTER)
        multi.connect("notify::active", lambda sw, _p: sw.get_active() != a.multi_queue and a.set_multi_queue(sw.get_active()))
        line("Queues", "A separate queue for each folder, album, artist and playlist you play from, each kept where you "
             "left it", a.multi_queue, multi)
        names = LOOK_NAMES
        looks = Gtk.DropDown.new_from_strings([label for _k, label in names])
        looks.set_valign(Gtk.Align.CENTER)
        looks.set_selected(next((i for i, (k, _l) in enumerate(names) if k == a.look), 0))
        looks.connect("notify::selected", lambda dd, _p: names[dd.get_selected()][0] != a.look
                      and a.set_look(names[dd.get_selected()][0]))
        line("Look", "Light, Dark, or Now playing: every page in the colours of the song that's playing, "
             "the way Now playing is", False, looks)
        fbs = FALLBACK_LOOKS
        fallback = Gtk.DropDown.new_from_strings([label for _k, label in fbs])
        fallback.set_valign(Gtk.Align.CENTER)
        fallback.set_selected(next((i for i, (k, _l) in enumerate(fbs) if k == a.np_fallback), 1))
        fallback.connect("notify::selected", lambda dd, _p: fbs[dd.get_selected()][0] != a.np_fallback
                         and a.set_np_fallback(fbs[dd.get_selected()][0]))
        line("Fallback for Now playing look", "The look the Now playing look uses while nothing is playing",
             False, fallback)
        line("Fix albums and artists", "Albums split by featured artists (“Quinn XCII & Jeremy Zucker”), albums beside their "
             "deluxe, extended or anniversary edition, and singles of songs on an album you have: fixed in the files' tags "
             "(titles are never changed), then moved to the right folders if you like. You check each one first",
             False, pill("Scan…", self.fixup_start))
        n_skip = len(a.fixup_skip)
        line("Folders to leave alone", "Folders no scan here ever touches or looks in (Fix albums and artists, the tag "
             "scanner, Empty folders, Merge into and Similar artists): their songs aren't retagged or moved, and no songs "
             "are moved into them. Unreleased songs, sessions… "
             + (f"{n_skip} folder{'s' if n_skip != 1 else ''} now" if n_skip else "None yet"), False,
