    # ---- queue ----
    def current_track(self):
        return self.queue[self.index] if 0 <= self.index < len(self.queue) else None

    # ---- queues: one for each list you play from (an album, an artist, a playlist…), each kept
    # where you left it, to go back to ----
    def queue_name(self):
        return self.queue_name_s or ""

    def snapshot_queue(self):
        """The queue playing now, into the saved ones (the newest first)."""
        if not self.queue:
            return
        if not self.queue_id:
            self.queue_id = "q" + secrets.token_hex(6)
        q = {"id": self.queue_id, "name": self.queue_name_s or "Songs", "tracks": [dict(t) for t in self.queue],
             "index": self.index, "position": round(self.position or 0.0, 1), "time": time.time()}
        at = next((k for k, x in enumerate(self.queues) if x["id"] == self.queue_id), None)
        if at is None:
            self.queues = [q] + self.queues   # a new queue: first
        else:
            self.queues[at] = q               # one you have: it stays where you put it
        del self.queues[MAX_QUEUES:]

    def move_queue(self, qid, step):
        """Move a queue up (-1) or down (+1) in Up next & queues."""
        self.saved_queues()
        k = next((k for k, x in enumerate(self.queues) if x["id"] == qid), None)
        if k is None or not 0 <= k + step < len(self.queues):
            return
        self.queues[k], self.queues[k + step] = self.queues[k + step], self.queues[k]
        self.queues_changed()

    def start_queue(self, name):
        """You play from the list name: a queue of its own (the one you had stays, to go back to).
        Returns whether it's another queue than the one playing."""
        name = name or "Songs"
        if not self.multi_queue or name == self.queue_name_s:
            self.queue_name_s = name
            return False
        self.snapshot_queue()
        same = next((q for q in self.queues if q["name"] == name), None)
        self.queue_id = same["id"] if same else "q" + secrets.token_hex(6)
        self.queue_name_s = name
        return bool(self.queue)

    def switch_queue(self, qid):
        q = next((x for x in self.queues if x["id"] == qid), None)
        if not q or qid == self.queue_id:
            return
        self.snapshot_queue()
        self.queue_id, self.queue_name_s = q["id"], q["name"]
        self.queue = [dict(t) for t in q["tracks"]]
        self.index = max(0, min(q.get("index", 0), len(self.queue) - 1))
        self.radio_from, self.shuffled = None, False
        self.resume_at = float(q.get("position") or 0.0)
        self.context += 1
        self.load_current()
        self.toast(f"Queue: {q['name']}" + (f", from {fmt_time(self.resume_at)}" if self.resume_at > 1 else ""))
        self.queues_changed()

    def rename_queue(self, qid, name):
        name = name.strip()
        if not name:
            return
        if qid == self.queue_id:
            self.queue_name_s = name
        for q in self.queues:
            if q["id"] == qid:
                q["name"] = name
        self.queues_changed()

    def delete_queue(self, qid):
        self.queues = [q for q in self.queues if q["id"] != qid]
        if qid == self.queue_id:   # the one playing: it carries on, nameless, until you play from a list
            self.queue_id, self.queue_name_s = None, ""
        self.queues_changed()

    def remove_other_queues(self):
        self.queues = []
        self.queues_changed()
        self.toast("The other queues are gone; this one plays on")

    def set_multi_queue(self, on):
        self.multi_queue = bool(on)
        self.queues_changed()

    def saved_queues(self):
        """Every queue: the one playing first (as it stands now), then the others, newest first."""
        if self.queue:
            self.snapshot_queue()
        return list(self.queues)

    def queues_changed(self):
        self.save_soon()
        if self.win:
            self.win.update_nav_sub()
            self.win.refresh_queue()

    def play_from(self, tracks, i, radio):
        """Play tracks[i], then the rest of tracks; the songs you queued come first (in the same queue)."""
        new = self.start_queue(self.win.current_list_name() if self.win else self.list_name)
        queued = [] if new else [t for t in self.queue[self.index + 1:] if t.get("queued")]
        tracks = [dict(t) for t in tracks]
        self.queue = tracks[:i + 1] + queued + tracks[i + 1:]
        self.index = i
        self.radio_from = None
        self.shuffled = False
        if self.dj["on"]:   # you picked other songs: the DJ stops
            self.dj["on"] = False
            self.dj_changed()
        self.context += 1
        self.load_current()
        if radio:
            self.extend_radio(self.queue[i], keep_until=i)

    def enqueue(self, tracks, how="queue"):
        """Your queue: "next" plays the songs right after this one, "queue" after
        the songs you queued before. Returns where they went (None: playing now)."""
        tracks = [dict(t, queued=True) for t in tracks if t]
        if not tracks:
            return None
        if not self.current_track():
            self.play_from(tracks, 0, radio=False)
            return None
        pos = self.index + 1
        if how != "next":
            while pos < len(self.queue) and self.queue[pos].get("queued"):
                pos += 1
        self.queue[pos:pos] = tracks
        self.after_queue_change()
        many = f"{len(tracks)} songs" if len(tracks) > 1 else f"“{tracks[0]['title']}”"
        self.toast(f"{many} {'play next' if how == 'next' else 'added to the queue'}" if len(tracks) > 1
                   else f"{'Playing next' if how == 'next' else 'Added to the queue'}: {many}")
        if self.ended:   # the queue had run out: carry on with these
            self.next()
        return pos

    def unqueue_many(self, indices):
        for i in sorted(set(indices), reverse=True):
            if 0 <= i < len(self.queue) and i != self.index:
                del self.queue[i]
                if i < self.index:
                    self.index -= 1
        self.after_queue_change()

    def unqueue(self, i):
        if not 0 <= i < len(self.queue) or i == self.index:
            return
        del self.queue[i]
        if i < self.index:
            self.index -= 1
        self.after_queue_change()

    def radio_tracks(self, track):
        """Songs like track, from its own service if it makes radios, else another one."""
        last = None
        for key in dict.fromkeys((source_of(track), self.source, "ytm", "tidal")):
            src = self.sources.get(key)
            if not src or key in ("apple", "spotify") or (key == "tidal" and not src.signed_in):
                continue   # Apple's stations play only in its own apps; Spotify gives apps like this none
            try:
                found = src.radio(track)
            except Exception as e:  # noqa: BLE001 -- try the next service
                last = e
                continue
            if found:
                return found
        if last:
            raise last
        return []

    def extend_radio(self, track, keep_until=None):
        self.radio_from = track["id"]
        context = self.context

        def done(res, err):
            if context != self.context or err or not res:
                return
            if keep_until is not None:
                # A song picked from results: its radio replaces the rest of the results (not your queue).
                cut = max(keep_until, self.index)
                self.queue = self.queue[:cut + 1] + [t for t in self.queue[cut + 1:] if t.get("queued")]
            ids = {t["id"] for t in self.queue}
            songs = {song_key(t) for t in self.queue}
            for t in res:
                if t["id"] not in ids and song_key(t) not in songs:   # another service's copy of a song here
                    ids.add(t["id"])
                    songs.add(song_key(t))
                    self.queue.append(t)
            self.after_queue_change()
            if self.ended and self.index + 1 < len(self.queue):   # it had stopped at the end: on it goes
                self.next()
        in_thread(self.radio_tracks, track, done=done)

    def play_index(self, i):
        if 0 <= i < len(self.queue):
            self.index = i
            self.load_current()

    def next(self):
        if self.index + 1 < len(self.queue):
            self.index += 1
            self.load_current()
            self.autoplay_soon()
        elif self.repeat == "all" and self.queue:
            if self.shuffled:   # round again in a new order, not the last one again
                self.queue = shuffle_songs(self.queue, after=self.current_track(), weight=self.shuffle_weight())
                self.after_queue_change()
            self.index = 0
            self.load_current()
        elif self.repeat == "off" and (after := self.next_queue()):
            self.switch_queue(after["id"])   # this queue is done: your next one goes on where it was
        else:
            self.ended = True
            self.set_paused(True)
            t = self.current_track()
            if self.autoplay and t and self.repeat == "off":
                self.extend_radio(t)   # ∞: songs like it, and it plays on (extend_radio)

    def next_queue(self):
        """The queue after this one in Up next & queues (round to the top) with songs still to play, or None."""
        qs = self.saved_queues() if self.multi_queue else []
        ids = [q["id"] for q in qs]
        k = ids.index(self.queue_id) if self.queue_id in ids else -1
        return next((q for q in qs[k + 1:] + qs[:max(k, 0)] if q["id"] != self.queue_id
                     and q.get("index", 0) < len(q.get("tracks") or []) - 1), None)

    def autoplay_soon(self):
        """∞: a couple of songs before the end, fetch songs like the last one so there's no gap."""
        if self.autoplay and self.repeat == "off" and self.queue and len(self.queue) - self.index <= 2 \
                and self.radio_from != self.queue[-1]["id"]:
            self.extend_radio(self.queue[-1])

    def set_autoplay(self, on):
        self.autoplay = bool(on)
        self.save_soon()
        if on:
            self.autoplay_soon()
        if self.win:
            self.win.refresh_queue()

    def clear_queued(self):
        """Queue › Clear: the songs you queued by hand go (what plays on from the list stays)."""
        self.queue = self.queue[:self.index + 1] + [t for t in self.queue[self.index + 1:] if not t.get("queued")]
        self.after_queue_change()

    def move_in_queue(self, i, j):
        """The song at i, dragged to j (both after the one playing)."""
        q = self.queue
        if i == j or not (self.index < i < len(q)) or not (self.index < j < len(q)):
            return
        t = q.pop(i)
        q.insert(j, t)
        self.after_queue_change()

    def track_ended(self):
        t = self.current_track()
        if t:
            self.song_stats.heard_out(t)
            self.discovered(t)
        self._finishing = True
        if self.repeat == "one":
            self.load_current()
        else:
            self.next()

    def cycle_repeat(self):
        self.repeat = {"off": "all", "all": "one", "one": "off"}[self.repeat]
        self.save_state()
        self.mpris.changed()
        if self.win:
            self.win.update_repeat()

    def toggle_like(self):
        """Like the song on the service it's from (and love it on Last.fm)."""
        t = self.current_track()
        key = source_of(t) if t else None
        src = self.sources.get(key)
        if not (t and src and src.signed_in):
            return
        vid, like = t["id"], t["id"] not in self.liked
        mine = self.likes.setdefault(key, set())
        for s in (mine, self.liked):   # show it now; undone if the service refuses
            (s.add if like else s.discard)(vid)

        def work():
            src.rate(t, like)
            if self.lastfm.connected:
                try:
                    self.lastfm.love(song_meta(self.lib, t), like)
                except Exception:  # noqa: BLE001 -- the like itself went through
                    pass

        def done(_res, err):
            if err:
                for s in (mine, self.liked):
                    (s.discard if like else s.add)(vid)
                self.toast(f"Couldn't {'like' if like else 'unlike'} it: {str(err)[:80]}")
            if self.win:
                self.win.update_like()
        if self.win:
            self.win.update_like()
        in_thread(work, done=done)

    def previous(self):
        """⏮: back to the start of the song; in its first 10 seconds, the song before it."""
        if self.position >= PREV_RESTARTS or self.index <= 0:
            self.player.seek(0)
            t = self.current_track()
            if t and self.listen and (self.listen["sent"] or self.listen["counted"]):
                self.begin_listen(t)   # listening again counts again
        else:
            self.index -= 1
            self._going_back = True
            self.load_current()

    def shuffle(self):
        """Shuffle what's coming up; the songs you queued stay first, in your order."""
        rest = self.queue[self.index + 1:]
        others = shuffle_songs((t for t in rest if not t.get("queued")), weight=self.shuffle_weight())
        self.queue = self.queue[:self.index + 1] + [t for t in rest if t.get("queued")] + others
        self.shuffled = True
        self.after_queue_change()

    def after_queue_change(self):
        self.save_state()
        self.prefetch()
        if self.win:
            self.win.refresh_queue()

    def load_current(self, autoplay=True):
        t = self.current_track()
        if not t:
            return
        if autoplay:
            self.note_leaving()
        self._finishing = self._going_back = False
        t.pop("queued", None)   # playing now, not waiting in your queue
        self.ended = False
        self.restore_pending = False   # something is loading now
        self.listen = None
        self.load_seq += 1
        seq = self.load_seq
        start, self.resume_at = self.resume_at, 0.0   # a queue you went back to: where you left off
        if self.lyrics_to_files:   # the song before (not playing now, so its file is free) gets its lyrics
            prev = getattr(self, "lyrics_last", None)
            if prev and prev["id"] != t["id"]:
                self.lyrics_into_files([prev], quiet=True)
            self.lyrics_last = t
            if song_file(self.lib, t):
                in_thread(self.lyrics.get, t, done=lambda *_: None)   # found now, kept for when it's written
        self.position, self.duration = 0.0, t.get("duration") or 0
        self.position_at = time.monotonic()
        on_disk = self.lib.has(t["id"]) or source_of(t) == "file"
        self.streaming = not (on_disk or (self.keep_played and self.auto_save_ok(t)))
        if self.win:
            self.win.update_now_playing()
            self.win.update_position(0, self.duration)
            self.win.set_status("" if on_disk else "Downloading FLAC…" if self.keep_played else "Loading the stream…")
            self.win.refresh_queue()

        def ready(path, err):
            if seq != self.load_seq:
                return  # user moved on while it downloaded
            if err and not self.streaming:
                self.streaming = True   # no FLAC to keep (or saving it failed): stream what there is instead
                self.dl.stream(t, ready)
                return
            if err:
                if self.win:
                    self.win.set_status("")
                    self.win.toast(f"Skipped “{t['title']}”: {err}" if isinstance(err, NoLosslessMatch)
                                   else f"Couldn't get “{t['title']}”: {err}")
                if autoplay:   # a song restored at startup stays put instead of skipping on its own
                    GLib.timeout_add(1500, lambda: (seq == self.load_seq and self.next(), False)[1])
                else:
                    self.paused = True   # nothing is loaded, whatever idle mpv says
                    if self.win:
                        self.win.update_now_playing()
                    self.mpris.changed()
                    self.discord.changed()
                return
            if self.win:
                self.win.set_status("")
            self.player.load(path, paused=not autoplay, start=start, **self.speed_opts(t))
            if self.caster.cast:   # casting: the device plays the file; mpv keeps time here, silently
                self.casting_file = bool(path) and os.path.isfile(str(path))
                if self.casting_file:
                    self.caster.play(t, path, start)
                    if not autoplay:
                        self.caster.pause(True)
                else:
                    self.toast("Streamed songs play on this computer while casting: download them to cast them")
                self.volume_changed()
            self.loaded = (t["id"], path)
            if self.win:
                self.win.visualizer.song_loaded()
            self.paused = not autoplay
            if autoplay:
                self.begin_listen(t)
            if self.win:
                self.win.song_changed()
                self.win.update_now_playing()
            self.mpris.changed()
            self.discord.changed()
            self.prefetch()
        (self.dl.stream if self.streaming else self.dl.fetch)(t, ready)
        self.save_state()
        # Keep a radio going: near the end of the queue, ask for more like the last song.
        if self.radio_from and self.index >= len(self.queue) - 2:
            self.extend_radio(self.queue[-1])
        if self.dj["on"]:
            self.dj_announce(t)
            self.dj_changed()
            if self.index >= len(self.queue) - 2:
                self.dj_more()

    def prefetch(self):
        """Get the next song ready, so it starts without a wait: its stream looked up,
        or (keeping what you play) the song downloaded."""
        nxt = self.queue[self.index + 1] if self.index + 1 < len(self.queue) else None
        if not nxt or self.lib.has(nxt["id"]) or source_of(nxt) == "file":
            return
        if self.keep_played and self.auto_save_ok(nxt):
            self.dl.fetch(nxt, lambda *_: self.win and self.win.refresh_all())
        else:
            self.dl.stream(nxt, lambda *_: None)

    def stream_broke(self):
        """Tidal's stream stopped short (its address ran out during a long pause, say):
        look it up again and carry on from the same place, once per song."""
        t = self.current_track()
        if not t or not self.streaming:
            return
        seq, pos, paused = self.load_seq, self.position, self.paused
        if self.stream_retry == seq:
            self.toast(f"Lost the stream of “{t['title']}”")
            if not paused:
                self.next()
            return
        self.stream_retry = seq
        self.dl.forget_stream(t["id"])

        def ready(path, err):
            if seq != self.load_seq:
                return
            if err:
                self.toast(f"Couldn't get “{t['title']}” back: {err}")
                return
            self.player.load(path, paused=paused, start=pos, **self.speed_opts(t))
            self.loaded = (t["id"], path)
        self.dl.stream(t, ready)

    def save_current(self):
        t = self.current_track()
        if t:
            self.download([t])

    def set_keep_played(self, on):
        self.keep_played = on
        self.save_soon()

    def set_discord(self, on):
        self.discord_on = on
        self.save_soon()
        self.discord.changed()

    def set_remote(self, on):
        self.remote_on = on
        (self.remote.start if on else self.remote.stop)()
        self.remote_on = self.remote.running
        self.save_state()
        self.accounts_changed()

    def forget_phones(self):
        self.remote_tokens = {}
        self.save_state()
        self.toast("Every paired phone has to pair again")
        self.accounts_changed()

    # ---- playback ----
    def toggle_pause(self):
        if not self.current_track():
            return
        self.set_paused(not self.paused)

    def set_paused(self, paused):
        self.player.set_pause(paused)

    def set_volume(self, volume):
        volume = round(max(0.0, min(100.0, volume)))
        if volume == self.volume and not self.muted:
            return
        self.volume, self.muted = volume, False
        self.volume_changed()

    def toggle_mute(self):
        self.muted = not self.muted
        self.volume_changed()

    def volume_changed(self):
        if self.caster.cast and getattr(self, "casting_file", False):   # casting: the device's volume; here stays silent
            self.caster.volume(0 if self.muted else self.volume)
            self.player.set_volume(self.volume, True)
            return
        self.player.set_volume(self.volume, self.muted)
        if self.opt("loudness_comp"):   # its lift follows the volume, without a gap
            lo, hi = loudness_gains(self.volume)
            self.player.filter_cmd("g", f"{lo:.1f}", "lowshelf@ldlo")
            self.player.filter_cmd("g", f"{hi:.1f}", "highshelf@ldhi")
        self.mpris.changed()
        if self.win:
            self.win.update_volume()
        self.save_soon()

    # ---- equalizer ----
    def load_eq(self, saved):
        eq = self.eq
        if isinstance(saved.get("profiles"), dict):
            eq["profiles"] = {k: v for k, v in saved["profiles"].items() if isinstance(v, list) and len(v) == 2}
        if isinstance(saved.get("devices"), dict):
            eq["devices"] = {str(k): str(v) for k, v in saved["devices"].items()}
        if saved.get("headphones") in self.headphones():
            eq["headphones"] = saved["headphones"]
        if saved.get("preset") in EQ_PRESETS:
            eq["preset"] = saved["preset"]
        if saved.get("count") in EQ_COUNTS:
            eq["count"] = saved["count"]
        for key in ("bands", "custom"):
            vals = saved.get(key)
            if isinstance(vals, list) and len(vals) == eq["count"]:
                eq[key] = [max(-EQ_RANGE, min(EQ_RANGE, float(g))) for g in vals]
            else:
                eq[key] = [0.0] * eq["count"]
        eq["per_output"] = saved.get("per_output", True) is not False
        outs = saved.get("outputs")
        if isinstance(outs, dict):
            eq["outputs"] = {str(k): v for k, v in outs.items() if isinstance(v, dict) and v.get("count") in EQ_COUNTS
                             and len(v.get("bands") or []) == v["count"]}
        for key in TONE:
            if isinstance(saved.get(key), (int, float)):
                eq[key] = max(-EQ_RANGE, min(EQ_RANGE, float(saved[key])))
        if isinstance(saved.get("boost"), (int, float)):
            eq["boost"] = max(0.0, min(BOOST_MAX, float(saved["boost"])))
        eq["on"] = bool(saved.get("on"))
        if eq["on"]:
            self.apply_eq()

    def headphones(self):
        """Every correction there is to pick: the built-in ones, then the AutoEq ones you added."""
        return {**HEADPHONES, **{k: (v[0], tuple(tuple(f) for f in v[1])) for k, v in self.eq.get("profiles", {}).items()}}

    def eq_correction(self):
        return self.headphones().get(self.eq["headphones"], HEADPHONES["off"])[1]

    def import_eq_file(self, path):
        """An EQ file of yours (AutoEq, Squiglink, Wavelet, Equalizer APO) among your headphones, and used."""
        try:
            filters = parse_eq_file(Path(path).read_text(encoding="utf-8", errors="replace"))
        except (OSError, ValueError) as e:
            self.toast(f"Couldn't import it: {str(e)[:80]}")
            return
        name = re.sub(r"\s*(ParametricEQ|GraphicEQ)$", "", Path(path).stem).strip() or "My EQ"
        self.add_autoeq({"name": name, "source": "imported"}, filters)

    def add_autoeq(self, entry, filters):
        """Keep an AutoEq profile among your headphones and use it."""
        key = "ae:" + norm(f"{entry['name']} {entry.get('source', '')}").replace(" ", "-")
        self.eq.setdefault("profiles", {})[key] = [f"{entry['name']} · {entry.get('source') or 'AutoEq'}", [list(f) for f in filters]]
        if self.win:
            self.win.update_eq()
        self.set_eq_headphones(key)
        self.toast(f"{entry['name']}: corrected with AutoEq ({entry.get('source') or 'AutoEq'})")

    def watch_output(self):
        """Every so often: if the sound goes somewhere else now, use the correction you used there
        last time, or say AutoEq has one for it."""
        def check():
            info = output_info()
            names = [info[1]] if info and WINDOWS else output_devices()
            GLib.idle_add(lambda: (self.output_changed(names, info), False)[1])
        threading.Thread(target=check, daemon=True).start()
        GLib.timeout_add_seconds(5 if WINDOWS else 10, lambda: (self.watch_output(), False)[1])

    # ---- an EQ for each output: the speakers, the headphone jack, each Bluetooth device, the car… ----
    OUT_ICONS = {"speaker": "speaker", "wired": "headphones", "bluetooth": "bluetooth", "car": "car", "usb": "usb"}

    def eq_profile(self):
        return {k: json.loads(json.dumps(self.eq[k])) for k in EQ_OUTPUT_KEYS}

    def switch_eq_output(self, old, new, label, kind):
        """The sound went from old to new: old keeps its EQ as you left it, new gets its own back (a new
        output starts from what you had)."""
        eq = self.eq
        outs = eq.setdefault("outputs", {})
        if old:
            outs[old] = dict(outs.get(old, {}), **self.eq_profile())
        mine = outs.get(new)
        if mine:
            for k in EQ_OUTPUT_KEYS:
                if k in mine:
                    eq[k] = json.loads(json.dumps(mine[k]))
            eq["boost"] = float(mine.get("boost", 0.0))   # each output its own boost; none until you set it
            if eq["headphones"] not in self.headphones():
                eq["headphones"] = "off"
            self.apply_eq()
            self.toast(f"{label}: its own equalizer" + ("" if eq["on"] else " (off)"))
        else:
            eq["boost"] = 0.0   # a new output: no boost until you want it there
            self.apply_eq()
        outs[new] = dict(self.eq_profile(), label=label, kind=kind)
        self.save_soon()

    def forget_eq_output(self, key):
        self.eq.get("outputs", {}).pop(key, None)
        if key == getattr(self, "output_key", None):   # it starts afresh from the EQ as it is
            self.eq["outputs"][key] = dict(self.eq_profile(), label=self.output_label, kind=self.output_kind)
        self.save_soon()
        if self.win:
            self.win.update_eq()

    def set_eq_per_output(self, on):
        self.eq["per_output"] = bool(on)
        self.save_soon()
        if self.win:
            self.win.update_eq()

    def set_eq_count(self, n):
        """3, 5, 10, 15 or 31 bands: the curve you had, read onto the new bands."""
        eq = self.eq
        if n not in EQ_COUNTS or n == eq["count"]:
            return
        frm = eq_bands_for(eq["count"])
        eq["bands"] = eq_resample(eq["bands"], frm, n)
        eq["custom"] = eq_resample(eq["custom"], frm, n) if len(eq["custom"]) == len(frm) else [0.0] * n
        eq["count"] = n
        self.eq_changed(rebuild=True)

    def output_changed(self, names, info=None):
        key, label, kind = info or ((f"out:{names[0]}", names[0], "speaker") if names else (None, None, None))
        if key and key != getattr(self, "output_key", None):
            old = getattr(self, "output_key", None)
            self.output_key, self.output_label, self.output_kind = key, label, kind
            if self.eq.get("per_output", True):
                self.switch_eq_output(old, key, label, kind)
            if self.win:
                self.win.update_eq()
        dev = names[0] if names else ""
        if not dev or dev == getattr(self, "output", None):
            return
        first = getattr(self, "output", None) is None
        self.output = dev
        if self.win:
            self.win.update_eq()
        known = self.eq.get("devices", {}).get(dev)
        if known and known in self.headphones():
            if known != self.eq["headphones"]:
                self.set_eq_headphones(known, remember=False)
                self.toast(f"{dev}: using {self.headphones()[known][0]}")
            return
        if first or not self.eq.get("on"):
            return

        def found(match, _err):
            if match:
                self.toast(f"AutoEq has a correction for {match['name']}: Equalizer › Auto EQ › Detect")
        in_thread(lambda: match_device(names, autoeq_index()), done=found)

    def eq_preamp(self):
        n = len(self.eq["bands"])
        return eq_preamp([*self.eq_correction(), *(("pk", hz, g, eq_q_for(n)) for hz, g in zip(eq_bands_for(n), self.eq["bands"])),
                          *((k, hz, self.eq[name], q) for name, (k, hz, q) in TONE.items())])

    def set_bitperfect(self, on):
        """Bit-perfect on or off: the EQ, the songs' own volume and speed, ReplayGain and the volume step aside."""
        self.bitperfect = bool(on)
        self.player.set_bitperfect(self.bitperfect, "no" if self.replaygain == "off" else self.replaygain)
        if not on:
            self.dac_note = ""
            self.apply_eq()
            self.player.set_volume(self.volume, self.muted)
        self.toast("Bit-perfect: the EQ, Volume…, Speed… and ReplayGain are off, and the volume stays at 100%: "
                   "turn it down on your DAC or amp" if on else "Bit-perfect off: the EQ and volume are back")
        self.save_soon()
        if self.win:
            self.win.update_bitperfect()

    def set_replaygain(self, mode):
        self.replaygain = mode
        if not self.bitperfect:
            self.player.cmd("set_property", "replaygain", "no" if mode == "off" else mode)
        self.save_soon()

    def check_dac(self):
        """Bit-perfect's check: what the song is (mpv's audio-params) against what goes to the device
        (audio-out-params). The same: bit-perfect. Not: the DAC (or Windows) can't take it as it is."""
        def got_in(src):
            def got_out(out):
                if not src or not out:
                    return
                fmt = lambda p: f"{p.get('format', '?')}/{(p.get('samplerate') or 0) / 1000:g} kHz"   # noqa: E731
                same = src.get("samplerate") == out.get("samplerate") and (
                    src.get("format") == out.get("format") or str(out.get("format", "")).startswith(
                        {"s16": "s16", "s24": "s32", "s32": "s32"}.get(str(src.get("format")), "?")))
                self.dac_note = (f"Bit-perfect: {fmt(src)} straight to the device" if same else
                                 f"Not bit-perfect for this song: it's {fmt(src)}, the device took {fmt(out)}. "
                                 "Your DAC may not take that rate or depth, or another app has the device")
                if self.win:
                    self.win.update_bitperfect()
            self.player.ask("audio-out-params", got_out)
        GLib.timeout_add(400, lambda: (self.player.ask("audio-params", got_in), False)[1])

    def maybe_crossfade(self):
        """Song crossfade (Equalizer): near a song's end, it fades out on its own (Player.tail) while the next one fades
        in. Not with bit-perfect, Repeat one, streams, or (Smart transitions) between songs of one album."""
        if not self.opt("crossfade") or self.bitperfect or self.repeat == "one" or self.streaming or self.paused:
            return
        t = self.current_track()
        n = float(self.opt("crossfade_secs") or 6)
        if not t or getattr(self, "_xfaded", None) == t["id"] or not self.duration or self.duration < n * 3 \
                or self.position < self.duration - n - 0.3:
            return
        if self.index + 1 >= len(self.queue):
            return
        nxt = self.queue[self.index + 1]
        if self.opt("smart_transitions") and same_album(t, nxt):
            return
        path = song_file(self.lib, t)
        if not path:
            return
        self._xfaded = t["id"]

        def move_on():   # the ending is playing on its own now: this one goes to the next song, fading in
            cur = self.current_track()
            if not cur or cur["id"] != t["id"]:
                return
            self.player.fade_next = n
            self.track_ended()
        # A little ahead of where this one is, as the other one starts up.
        self.player.tail(path, self.position + 0.25, n, 0 if self.muted else self.volume, move_on)

    handoff = None   # Continue where you left off: {"track", "position", "at"} the phone stopped at

    def offer_handoff(self):
        """Continue where you left off (Settings): the phone stopped in a song, and nothing plays here: offer to carry on
        with it, at the same spot (your copy of it if you have one)."""
        h = self.handoff
        if not h or not self.opt("continue_across") or time.time() - h["at"] > 12 * 3600 or not self.win:
            return
        if not self.win.is_active():
            return   # when you're back at the PC (the window comes to the front)
        cur = self.current_track()
        if cur and not self.paused:
            return
        t = h["track"]
        if cur and song_key(cur) == song_key(t) and abs(self.position - h["position"]) < 10:
            return

        def go():
            self.handoff = None
            mine = self.fm_song(t.get("title") or "", t.get("artist") or "", t.get("thumb") or "", self.song_index(), t.get("album") or "")
            self.resume_at = max(0.0, h["position"] - 2)
            self.play_from([mine], 0, False)
        self.win.toast_action(f"Continue “{t.get('title')}” at {fmt_time(h['position'])}, where your phone stopped?", "Play", go)
        h["at"] = 0   # offered once

    def cast_to(self, name, device):
        """Cast from now on (the Cast button's pick): the song playing starts on the device where it is."""
        self.toast(f"Connecting to {name}…")

        def done(_r, err):
            if err:
                self.toast(f"Couldn't cast to {name}: {str(err)[:100]}")
                return
            self.cast_name = name
            self.resume_at = self.position
            if self.current_track():
                self.load_current(autoplay=not self.paused)
            self.toast(f"Casting to {name}")
            if self.win:
                self.win.update_cast()
        in_thread(self.caster.start, device, done=done)

    def stop_cast(self):
        """Back to this computer, where the song was."""
        self.caster.stop()
        self.casting_file = False
        self.volume_changed()
        self.toast("Playing on this computer")
        if self.win:
            self.win.update_cast()

    def shuffle_weight(self):
        """Smart shuffle (Settings): a song's weight, more for the ones you love (play a lot) that you haven't heard in a
        while; None (plain chance) with it off."""
        if not self.opt("smart_shuffle"):
            return None
        plays = {}
        for st in self.stats.songs[:20000]:
            plays[stats_key(st["title"], st["artist"])] = st["plays"]
        last = {}
        for e in self.plays.items.values():
            tr = e.get("track") or {}
            k = stats_key(tr.get("title"), tr.get("artist"))
            last[k] = max(last.get(k, 0), e.get("last", 0))
        now = time.time()
        return lambda t: smart_weight(plays.get(stats_key(t.get("title"), t.get("artist")), 0),
                                      last.get(stats_key(t.get("title"), t.get("artist")), 0), now)

    def opt(self, key):
        """One of 2.0's switches (OPTS)."""
        return self.opts.get(key, OPTS[key])

    def set_opt(self, key, value):
        self.opts[key] = value
        self.save_state()
        if key in ("crossfeed", "mono", "clip_guard", "loudness_comp", "balance", "crossfeed_k", "tilt", "detail"):
            self.apply_eq()
        if key == "rg_target":
            self.apply_rg_target()
        if key == "hq_resample":
            self.player.cmd("set_property", "audio-swresample-o", HQ_RESAMPLE if value else "")
        if key == "loudness_check" and value:
            self.quality_scan()

    # ---- Loudness check (Settings): clipped songs, and files that aren't the hi-res they say ----
    qc_busy = None   # checking: "12 of 3,004"

    def qc_results(self):
        if not hasattr(self, "_qc"):
            self._qc = read_json(QUALITY_CHECKS, {})   # file -> {"mtime", "res"}
        return self._qc

    def quality_scan(self):
        """Check every song of yours not checked yet (or changed since), in the background, a song at a time."""
        if self.qc_busy is not None:
            return
        files = []
        seen = set()
        for t in self.my_songs():
            f = song_file(self.lib, t)
            if f and f not in seen:
                seen.add(f)
                files.append((f, t))
        done = self.qc_results()
        todo = []
        for f, t in files:
            try:
                m = os.stat(f).st_mtime
            except OSError:
                continue
            if (done.get(f) or {}).get("mtime") != m:
                todo.append((f, m))
        if not todo:
            return
        self.qc_busy = f"0 of {len(todo):,}"

        def work():
            for i, (f, m) in enumerate(todo):
                if not self.opt("loudness_check"):
                    break
                try:
                    done[f] = {"mtime": m, "res": quality_check(f)}
                except Exception:  # noqa: BLE001 -- unreadable: skipped
                    done[f] = {"mtime": m, "res": {"clipped": 0, "peak": None, "fake": ""}}
                self.qc_busy = f"{i + 1:,} of {len(todo):,}"
                if i % 25 == 24:
                    write_atomic(QUALITY_CHECKS, json.dumps(done))
                    GLib.idle_add(lambda: (self.refresh_accounts_soon(), False)[1])
            write_atomic(QUALITY_CHECKS, json.dumps(done))

        def finished(_r, _e):
            self.qc_busy = None
            self.refresh_accounts_soon()
        in_thread(work, done=finished)

    def qc_flagged(self):
        """[(file, its result)] of the songs the check found something in: clipped, or not the hi-res they say."""
        return sorted(((f, e["res"]) for f, e in self.qc_results().items() if e["res"].get("clipped") or e["res"].get("fake")),
                      key=lambda x: (-(x[1].get("clipped") or 0), x[0]))
        if self.win:
            self.win.update_eq()

    def apply_eq(self):
        """(Re)build mpv's filters from the settings; the music skips a beat. Headphone crossfeed goes last."""
        graph = eq_graph(self.eq_correction(), self.eq["bands"], self.eq_preamp(),
                         {name: self.eq[name] for name in TONE}) if self.eq["on"] else ""
        if self.opt("loudness_comp"):
            lo, hi = loudness_gains(self.volume)
            graph = ",".join(x for x in (graph, f"lowshelf@ldlo=f=90:t=q:w=0.71:g={lo:.1f}",
                                         f"highshelf@ldhi=f=9000:t=q:w=0.71:g={hi:.1f}") if x)
        boost = self.eq.get("boost", 0.0)
        if boost > 0:
            graph = ",".join(x for x in (graph, f"volume@boost=volume={boost:g}dB:precision=double") if x)
        if self.opt("detail"):
            graph = ",".join(x for x in (graph, DETAIL) if x)
        if self.opt("tilt"):
            graph = ",".join(x for x in (graph, tilt_graph(self.opt("tilt"))) if x)
        if self.opt("balance"):
            graph = ",".join(x for x in (graph, balance_graph(self.opt("balance"))) if x)
        if self.opt("crossfeed"):
            graph = ",".join(x for x in (graph, crossfeed_graph(self.opt("crossfeed_k"))) if x)
        if self.opt("mono"):
            graph = ",".join(x for x in (graph, MONO) if x)
        if self.opt("clip_guard") or boost > 0:   # Boost always has the limiter
            graph = ",".join(x for x in (graph, CLIP_GUARD) if x)
        self.player.set_filters(graph)
        self.player.cmd("set_property", "audio-swresample-o", HQ_RESAMPLE if self.opt("hq_resample") else "")
        self.apply_rg_target()
        self.eq_synced = True

    def apply_rg_target(self):
        """ReplayGain to the levelling target: a pre-gain on top of its own -18 LUFS. Louder than that, peaks are kept
        under full scale by ReplayGain's own clip prevention, or by Clip guard's limiter when that's on."""
        self.player.cmd("set_property", "replaygain-preamp", f"{self.opt('rg_target') + 18:g}")
        self.player.cmd("set_property", "replaygain-clip", "no" if self.opt("clip_guard") else "yes")

    def retune_eq(self):
        """Set the bands and pre-gain in the running filters, without a gap. mpv
        rebuilds its filters from the graph on a seek or a new song, so eq_settled
        rebuilds that too once you're done adjusting."""
        for i, g in enumerate(self.eq["bands"]):
            self.player.filter_cmd("g", g, f"equalizer@g{i}")
        for name, (k, _hz, _q) in TONE.items():
            self.player.filter_cmd("g", self.eq[name], f"{'lowshelf' if k == 'ls' else 'highshelf'}@{name}")
        self.player.filter_cmd("volume", f"{self.eq_preamp()}dB", "volume@pre")
        self.eq_synced = False

    def eq_settled(self):
        if not self.eq_synced:
            self.apply_eq()

    def eq_changed(self, rebuild=False):
        if rebuild or not self.eq["on"]:
            self.eq["on"] = True
            self.apply_eq()
        else:
            self.retune_eq()
        self.keep_output_eq()
        if self.win:
            self.win.update_eq()
        self.save_soon()

    def keep_output_eq(self):
        """The output playing now keeps the EQ as it is set."""
        key = getattr(self, "output_key", None)
        if key and self.eq.get("per_output", True):
            outs = self.eq.setdefault("outputs", {})
            outs[key] = dict(outs.get(key, {}), **self.eq_profile())

    def set_eq_on(self, on):
        if on != self.eq["on"]:
            self.eq["on"] = on
            self.apply_eq()
            self.keep_output_eq()
            if self.win:
                self.win.update_eq()
            self.save_soon()

    def set_eq_headphones(self, key, remember=True):
        if remember and getattr(self, "output", None):   # this output gets it again next time
            self.eq.setdefault("devices", {})[self.output] = key
        if key != self.eq["headphones"]:
            self.eq["headphones"] = key
            self.eq_changed(rebuild=True)  # a different set of filters

    def set_eq_preset(self, key):
        bands = eq_preset_bands(key, self.eq["count"]) or self.eq["custom"]
        self.eq["preset"], self.eq["bands"] = key, [float(g) for g in bands]
        self.eq_changed()

    def set_eq_tone(self, name, gain):
        """Bass or treble, dB either way."""
        gain = round(max(-EQ_RANGE, min(EQ_RANGE, gain)) * 2) / 2
        if gain == self.eq[name] and self.eq["on"]:
            return
        self.eq[name] = gain
        self.eq_changed()

    def set_eq_boost(self, db):
        """Boost (Equalizer): extra loudness, 0 to 12 dB, kept for this output."""
        db = round(max(0.0, min(BOOST_MAX, db)) * 2) / 2
        if db == self.eq.get("boost", 0.0):
            return
        was = self.eq.get("boost", 0.0)
        self.eq["boost"] = db
        if was > 0 and db > 0:   # in the running filters, without a gap
            self.player.filter_cmd("volume", f"{db:g}dB", "volume@boost")
            self.eq_synced = False
        else:
            self.apply_eq()
        self.keep_output_eq()
        self.save_soon()
        if self.win:
            self.win.show_boost()

    def boost_clean(self):
        """How far Boost goes cleanly with the EQ as it is now."""
        return boost_clean(self.eq_preamp() if self.eq["on"] else 0.0)

    def set_eq_band(self, i, gain):
        gain = round(max(-EQ_RANGE, min(EQ_RANGE, gain)) * 2) / 2
        if gain == self.eq["bands"][i] and self.eq["on"]:
            return
        self.eq["bands"][i] = gain
        self.eq["custom"] = list(self.eq["bands"])
        self.eq["preset"] = "custom"
        self.eq_changed()

    def on_mpv(self, msg):
        ev = msg.get("event")
        if ev == "property-change":
            name, data = msg.get("name"), msg.get("data")
            if name == "time-pos" and data is not None:
                if abs(data - self.position) >= 0.2 or data < self.position:
                    step = data - self.position
                    self.position, self.position_at = data, time.monotonic()
                    if 0 < step < 1.5 and not self.paused:   # playing on, not a seek
                        self.listened(step)
                        self.maybe_crossfade()
                    if self.win:
                        self.win.update_position(self.position, self.duration)
                        if self.win.get_visible() and self.win.lyrics_shown():
                            self.win.lyrics.tick(self.position)
            elif name == "duration" and data:
                self.duration = data
                self.discord.changed()
            elif name == "pause" and data is not None:
                self.paused = bool(data)
                t = self.current_track()
                if not self.paused and t and not (self.listen and self.listen["id"] == t["id"]):
                    self.begin_listen(t)   # the song you left paused last time
                if self.win:
                    self.win.update_now_playing()
                self.mpris.changed()
                self.discord.changed()
        elif ev == "playback-restart":
            self.discord.changed()   # a seek, or a song starting: Discord's bar starts from there
            if self.bitperfect:
                self.check_dac()
            if not self.eq_synced:
                self.retune_eq()  # a seek or new song rebuilt the filters from the graph, before the latest tweaks
        elif ev == "end-file" and msg.get("reason") == "eof":
            if self.streaming and self.duration and self.position < self.duration - 5:
                self.stream_broke()   # the network went away mid-song: that's not the end
            else:
                self.track_ended()
        elif ev == "end-file" and msg.get("reason") == "error":
            self.stream_broke()


def squash(s):
    """Letters and digits only, run together: "That’s All I Need" and "Thats all I need" are one."""
    return re.sub(r"[^a-z0-9]", "", unicodedata.normalize("NFKD", s or "").encode("ascii", "ignore").decode().lower())


def loose_artists(t):
    """Each artist of t, squashed, without a leading "the"."""
    return {re.sub(r"^the", "", squash(a)) for a in re.split(r",|&|\bfeat\.?\b|\bft\.?\b|\bx\b|\band\b",
                                                            t.get("artist") or "", flags=re.I)} - {""}


def loose_key(t):
    """t's song for finding duplicates: its title and lead artist, squashed (punctuation, accents,
    "the", feat. credits and (Remastered)-type notes don't count)."""
    return squash(clean_title(t.get("title") or "")), re.sub(r"^the", "", squash((t.get("artist") or "").split(",")[0]))


def maybe_same(a, b):
    """Whether a and b are likely the same song, to ask about: the same or nearly the same title,
    by an artist they share (or nearly the same name), or nearly the same title on the same album.
    Lengths and other tags aren't looked at: they differ between copies of one song."""
    ta, tb = squash(clean_title(a.get("title") or "")), squash(clean_title(b.get("title") or ""))
    if not ta or not tb:
        return False
    if re.findall(r"\d+", ta) != re.findall(r"\d+", tb):
        return False   # "Song 1" and "Song 2", "22" and "25": different songs
    title = 1.0 if ta == tb else similar(ta, tb)
    if title < 0.75 and not (min(len(ta), len(tb)) >= 4 and (ta in tb or tb in ta)):
        return False
    aa, ab = loose_artists(a), loose_artists(b)
    artist = bool(aa & ab) or any(similar(x, y) >= 0.85 or (len(x) >= 4 and len(y) >= 4 and (x in y or y in x))
                                  for x in aa for y in ab)
    album = bool(squash(a.get("album"))) and squash(a.get("album")) == squash(b.get("album"))
    return (artist and (title >= 0.85 or ta in tb or tb in ta)) or (album and title >= 0.75)


def upgradable(t):
    """Whether Upgrade can swap t: a file of yours on this computer (not a download, not the phone's)."""
    return source_of(t) == "file" and not is_phone_song(t) and bool(t.get("file")) and Path(t["file"]).exists()


def song_key(t):
    """The same song on any service: its name and lead artist, tidied."""
    return norm(clean_title(t.get("title") or "")), norm((t.get("artist") or "").split(",")[0])


# =============================================================================
# Starting up: commands run before the app was (omarchy-music play ...) start it
# in the background and then hand it the command, so the terminal gets its
# answer and is free again. Logins from a terminal.
# =============================================================================

def primary_running():
    """Whether Radon Player is running already (it owns its name on the session bus)."""
    try:
        bus = Gio.bus_get_sync(Gio.BusType.SESSION, None)
        res = bus.call_sync("org.freedesktop.DBus", "/org/freedesktop/DBus", "org.freedesktop.DBus", "NameHasOwner",
                            GLib.Variant("(s)", (APP_ID,)), GLib.VariantType.new("(b)"), Gio.DBusCallFlags.NONE,
                            2000, None)
        return res.unpack()[0]
    except GLib.Error:
        return False


def start_in_background():
    subprocess.Popen([sys.executable, os.path.abspath(__file__), "--background"], start_new_session=not WINDOWS,
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, **NO_WINDOW)
    for _ in range(150):
        if primary_running():
            return True
        time.sleep(0.1)
    return False


def tell_running(verb):
    if primary_running():
        subprocess.run([sys.executable, os.path.abspath(__file__), verb], timeout=20, check=False)


def open_url(url):
    """A page in your browser, from the terminal commands."""
    if WINDOWS:
        os.startfile(url)  # noqa: S606 -- the default browser
    else:
        subprocess.Popen(["xdg-open", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def lastfm_login():
    """--lastfm-login: connect Last.fm from a terminal."""
    import getpass
    fm = LastFM()
    if not (fm.key and fm.secret):
        print("Last.fm lets an app in through an API account of your own. Make one (free) at\n"
              "  https://www.last.fm/api/account/create\n"
              "(any application name; the callback URL can stay empty), then paste:")
        fm.set_account(input("API key: "), getpass.getpass("Shared secret (hidden): "))
    try:
        url = fm.auth_url()
    except (LastFMError, OSError) as e:
        print(f"Last.fm didn't take that key and secret: {e}", file=sys.stderr)
        if isinstance(e, LastFMError):
            fm.set_account("", "")   # ask for them again next time
        return 1
    print("Approve Radon Player on this Last.fm page (opening it in your browser):", url, sep="\n", flush=True)
    open_url(url)
    for _ in range(60):
        time.sleep(3)
        try:
            fm.finish_auth()
            break
        except LastFMError as e:
            if e.code != 14:   # 14: not approved yet
                print(e, file=sys.stderr)
                return 1
    else:
        print("Timed out waiting for the approval; run it again when you're ready.", file=sys.stderr)
        return 1
    print(f"Last.fm is connected: scrobbling as {fm.user}.")
    tell_running("reload")
    return 0


def spotify_login():
    """--spotify-login: connect Spotify from a terminal."""
    sp = Spotify()
    if sp.signed_in:
        print("Spotify is connected" + (f" as {sp.user}." if sp.user else "."))
        return 0
    print("Spotify lets an app in through a developer app of your own (its owner needs Premium).\n"
          "Make one at https://developer.spotify.com/dashboard/create with the Web API ticked\n"
          f"and this redirect URI: {SPOTIFY_REDIRECT}\nthen paste its Client ID.")
    client_id = sp.client_id or input("Client ID: ")

    def opened(url):
        print("Approve Radon Player on this Spotify page (opening it in your browser):", url, sep="\n", flush=True)
        open_url(url)
    try:
        sp.login(client_id, opened)
    except (ValueError, RuntimeError, OSError) as e:
        print(f"Couldn't connect Spotify: {e}", file=sys.stderr)
        return 1
    print("Spotify is connected" + (f" as {sp.user}." if sp.user else "."))
    tell_running("reload")
    return 0


def main():
    signal.signal(signal.SIGINT, signal.SIG_DFL)
    # Threads (yt-dlp looking up a stream, a download, Wrapped adding up a year) take turns with
    # the UI thread for Python's lock; by default each turn is 5 ms, long enough that a frame
    # waiting for a few of them stutters. A shorter turn keeps the window smooth.
    sys.setswitchinterval(0.001)
    args = sys.argv[1:]
    if args[:1] and args[0] in ("help", "--help", "-h"):
        print(__doc__.strip())
        return 0
    if "--tidal-login" in args:
        tidal = Tidal()
        if not tidal.connected:
            print("Sign in to Tidal on this page; it ends on an \"Oops\" page:", tidal.login_url(), sep="\n", flush=True)
            tidal.finish_login(input("Paste the address of that \"Oops\" page: "))
        print("Tidal is connected.")
        tell_running("reload")
        return 0
    if "--lastfm-login" in args:
        return lastfm_login()
    if "--spotify-login" in args:
        return spotify_login()
    if args and args[0] != "--background" and not primary_running():
        if args[0].lower() in ("status", "hide", "pause", "quit", "reload"):
            print("Radon Player isn't running.")
            return 1 if args[0].lower() == "status" else 0
        if not start_in_background():
            print("Radon Player didn't start.", file=sys.stderr)
            return 1
    return MusicApp().run(sys.argv)


if __name__ == "__main__":
    sys.exit(main())
