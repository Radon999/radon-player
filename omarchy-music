        names = re.findall(r'(?:node\.description|device\.description|node\.nick|device\.product\.name) = "([^"]+)"', out)
        return list(dict.fromkeys(names))
    except (OSError, subprocess.SubprocessError):
        return []


def match_device(names, entries):
    """The AutoEq profile of the headphones named in names (an output's names), or None: every
    word of the profile's name has to be in the output's name, but the brand may be left out
    of a model with a number in it ("WH-1000XM6")."""
    best, best_score = None, 0.0
    for dev in names:
        d = norm(dev)
        for e in entries:
            model = norm(re.sub(r"\(.*?\)", "", e["name"]))
            words = model.split()
            if len(words) < 2 and len(model) < 6:
                continue
            has = [w in d for w in words]
            rest = " ".join(words[1:])
            if all(has):
                score = len(model) + 1
            elif not has[0] and all(has[1:]) and len(rest) >= 5 and re.search(r"\d", rest):
                score = len(rest)   # the model without the brand (Bluetooth names are often just that)
            else:
                continue
            score += 0.5 if "(" not in e["name"] else 0
            if score > best_score:
                best, best_score = e, score
    return best


def fmt_db(g):
    return "0" if g == 0 else ("+" if g > 0 else "−") + f"{abs(g):.1f}".removesuffix(".0")


