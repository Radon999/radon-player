    else a GraphicEQ (Wavelet's, AutoEq's): its filters."""
    try:
        return parse_parametric(text)
    except ValueError:
        if "GraphicEQ" in text or re.search(r"\d+\s+-?[\d.]+\s*;", text):
            return graphic_to_filters(text)
