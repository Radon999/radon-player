        group("Playback")

        def opt_switch(key):
            sw = Gtk.Switch(active=bool(a.opt(key)), valign=Gtk.Align.CENTER)
            sw.connect("notify::active", lambda w, _p: w.get_active() != bool(a.opt(key)) and a.set_opt(key, w.get_active()))
