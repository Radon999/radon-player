        albums_all = sorted({p[2] for p in plays if p[2]} | {t.get("album") for t in a.my_songs() if t.get("album")}, key=norm)

        def apply(picked):
            n = 0
            for r, p in zip(rows, picked):
                to = r["to"] if p is True else str(p) if p else ""
                for name, _n in r["albums"]:   # every album of the song: onto to ("" left alone: not asked again)
                    a.album_picks[album_play_key(r["title"], r["artist"], name)] = "" if not to or norm(name) == norm(to) else to
                n += bool(to)
            a.save_soon()
            self.report(body, status, f"{n} song{'s' if n != 1 else ''}' plays merged onto their albums. Most played is counting again."
                        if n else "Nothing merged.", [], dlg.close)
            GLib.timeout_add(300, lambda: (a.stats.refresh(force=True), False)[1])
        self.choices(body, lines, "Merge plays", "Leave alone", "Apply", apply,
                     alts=[(None, [r["to"]] + [nm for nm, _n in r["albums"] if nm != r["to"]], "Other album", albums_all) for r in rows])

    def joint_credits_now(self):
        """Joint artists… list: the pairs in your plays (and songs) Most played can't tell the main artist of."""
        a = self.app
        sig = (id(a.stats.songs), len(a.stats.songs), len(a.local.files), json.dumps(a.artist_picks, sort_keys=True))
        got = self.__dict__.get("_joint")
        if got and got[0] == sig:
            return got[1]
        credits = Counter()
        for st in a.stats.songs:
            credits[st.get("artist") or ""] += st.get("plays", 0)
        try:
            songs = a.my_songs()
        except Exception:  # noqa: BLE001
            songs = []
        for t in songs:
            credits[t.get("albumartist") or t.get("artist") or ""] += 0
        out = joint_credits(credits, songs, a.artist_picks)
        self._joint = (sig, out)
        return out

