def write_atomic(path, text):
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_suffix(path.suffix + ".tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


def read_json(path, default):
    try:
        return json.loads(path.read_text())
    except (OSError, ValueError):
        return default


def in_thread(fn, *args, done=None):
    """Run fn(*args) off the UI thread; hand (result, error) to done on it."""
    def work():
        try:
            res, err = fn(*args), None
        except Exception as e:  # noqa: BLE001 -- surfaced to the UI
            res, err = None, e
        if done:
            GLib.idle_add(lambda: (done(res, err), False)[1])
    threading.Thread(target=work, daemon=True).start()


def fmt_time(s):
    s = int(max(0, s or 0))
    return f"{s // 60}:{s % 60:02d}"


def fmt_total(tracks):
    """How long a list of songs plays: "42 min", "2 h 5 min"."""
    m = round(sum(t.get("duration") or 0 for t in tracks) / 60)
    return f"{m // 60} h {m % 60} min" if m >= 60 else f"{m} min"


def track_no(t):
    """A song's number on its album ("3/12" is 3), for sorting; songs without one go last."""
    m = re.match(r"\s*(\d+)", str(t.get("track") or t.get("tracknumber") or ""))
    return int(m.group(1)) if m else 9999


