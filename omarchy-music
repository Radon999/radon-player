                         r"vocalist|orchestra|ensemble|guitarist|pianist|drummer", re.I)
ALBUM_WORDS = re.compile(r"album|\bep\b|mixtape|soundtrack|compilation|record", re.I)


def google_images(keys, q, n=6):
    """Google's image search for q: [{"url", "thumb", "from"}], [] without a key and engine id."""
    if not keys.get("google_key") or not keys.get("google_cx"):
        return []
    res = http_json("https://www.googleapis.com/customsearch/v1?" + urllib.parse.urlencode(
        {"key": keys["google_key"], "cx": keys["google_cx"], "q": q, "searchType": "image", "num": n,
         "imgSize": "large", "safe": "active"}), timeout=10)
    return [{"url": i["link"], "thumb": (i.get("image") or {}).get("thumbnailLink") or i["link"], "from": "Google"}
            for i in res.get("items") or [] if i.get("link")]


def genius_artist(name):
    """Genius's artist named name (near enough): {"id", "name", "image", "url"}, or None."""
    res = http_json("https://genius.com/api/search/artist?" + urllib.parse.urlencode({"q": name, "per_page": 5}), timeout=10)
    hits = [h.get("result") or {} for h in (((res.get("response") or {}).get("sections") or [{}])[0].get("hits") or [])]
    best = best_named([h for h in hits if h.get("name")], name, lambda h: h["name"])
    if not best:
        return None
    img = best.get("image_url") or ""
    return {"id": best.get("id"), "name": best["name"], "url": best.get("url") or "",
            "image": "" if GENIUS_BLANK in img else img}


def genius_bio(artist_id):
    """The artist's description on Genius, as plain text ("" if there's none)."""
    res = http_json(f"https://genius.com/api/artists/{artist_id}?text_format=plain", timeout=10)
    text = (((res.get("response") or {}).get("artist") or {}).get("description") or {}).get("plain") or ""
    return "" if text.strip() == "?" else text.strip()


def genius_covers(artist, album):
    """Genius's covers for artist's album: [{"url", "thumb", "from"}]."""
    res = http_json("https://genius.com/api/search/album?" + urllib.parse.urlencode(
        {"q": f"{artist} {album}", "per_page": 5}), timeout=10)
    out = []
    for h in (((res.get("response") or {}).get("sections") or [{}])[0].get("hits") or []):
        r = h.get("result") or {}
        who = norm((r.get("artist") or {}).get("name"))
        img = r.get("cover_art_url") or ""
        if (img and GENIUS_BLANK not in img and not who.startswith("genius")   # its translations
                and similar(norm(bare_title(r.get("name") or "")), norm(bare_title(album))) >= 0.6):
            out.append({"url": img, "thumb": r.get("cover_art_thumbnail_url") or img, "from": "Genius"})
    return out


def wikipedia_page(q, name, words):
    """The Wikipedia article a search for q finds that's titled name (near enough) and whose
    short description has one of words: {"title", "bio", "image", "url"}, or None."""
    res = http_json(WIKI_API + "?" + urllib.parse.urlencode(
        {"action": "query", "format": "json", "generator": "search", "gsrsearch": q, "gsrlimit": 5,
         "prop": "extracts|pageimages|pageprops", "exintro": 1, "explaintext": 1, "exlimit": "max",
         "piprop": "original", "ppprop": "wikibase-shortdesc|page_image|disambiguation", "redirects": 1}),
        {"User-Agent": APP_UA}, timeout=10)
    pages = sorted(((res.get("query") or {}).get("pages") or {}).values(), key=lambda p: p.get("index", 99))
    for p in pages:
        props = p.get("pageprops") or {}
        title = re.sub(r"\s*\([^)]*\)$", "", p.get("title") or "")
        about = props.get("wikibase-shortdesc") or (p.get("extract") or "")[:200]
        if "disambiguation" in props or similar(norm(title), norm(name)) < 0.85 or not words.search(about):
            continue
        image = (p.get("original") or {}).get("source") or ""
        if not image and props.get("page_image"):   # a cover that isn't free: pageimages leaves it out
            info = http_json(WIKI_API + "?" + urllib.parse.urlencode(
                {"action": "query", "format": "json", "prop": "imageinfo", "iiprop": "url",
                 "titles": "File:" + props["page_image"]}), {"User-Agent": APP_UA}, timeout=10)
            for f in ((info.get("query") or {}).get("pages") or {}).values():
                image = ((f.get("imageinfo") or [{}])[0]).get("url") or image
        return {"title": p.get("title"), "bio": wiki_text(p.get("extract") or ""), "image": image,
                "url": "https://en.wikipedia.org/wiki/" + urllib.parse.quote((p.get("title") or "").replace(" ", "_"))}
    return None


def wiki_text(text):
    """An article's opening without its pronunciation guides ("(BYURK; Icelandic: [pjœr̥k])")."""
    head, _, rest = text.partition("\n")
    head = re.sub(r"\s*\((?:\s|[^()]*[\[/;])[^()]*\)", "", head, count=2)   # where the guide was, a space is left
    return re.sub(r"  +", " ", (head + ("\n" + rest if rest else ""))).strip()


def wikipedia_artist(name):
    return wikipedia_page(f"{name} musician", name, MUSIC_WORDS) or wikipedia_page(name, name, MUSIC_WORDS)


def wikipedia_album(artist, album):
    return wikipedia_page(f"{bare_title(album)} {artist} album", bare_title(album), ALBUM_WORDS)


class Pictures:
    """Artists' pictures and bios and the covers you picked, looked for once and kept in
    PICTURES. keys() gives the API keys from Settings (Google's: google_key, google_cx).
    Everything here blocks: call it on a thread. A service that can't be reached is skipped."""

    def __init__(self, keys):
        self.keys = keys
        self.lock = threading.Lock()
        data = read_json(PICTURES, {})
        self.artists = data.get("artists") or {} if isinstance(data, dict) else {}
        self.covers = data.get("covers") or {} if isinstance(data, dict) else {}

    def save(self):
        with self.lock:
            text = json.dumps({"artists": self.artists, "covers": self.covers})
        write_atomic(PICTURES, text)

    @staticmethod
    def tried(fn, *args):
        try:
            return fn(*args)
        except Exception as e:  # noqa: BLE001 -- that service is down or turned us away: the next one
            print(f"omarchy-music: pictures: {fn.__name__}: {e}", file=sys.stderr)
            return None

    def known(self, name):
        """Whether the artist's picture needn't be looked for (again): picked by you, found (since Deezer
        was asked), or not found lately."""
        have = self.artists.get(norm(name))
        if not have:
            return False
        v = have.get("v") or 0
        if have.get("chosen") or (have.get("image") and v >= 2):
            return True
        wait = PICTURES_RETRY_FAILED if have.get("failed") else PICTURES_RETRY
        return v >= PICTURES_V and time.time() - have.get("t", 0) < wait

    def artist(self, name, refresh=False):
        """{"image", "image_from", "bio", "bio_from", "bio_url"} for the artist ("" where none was found)."""
        k = norm(name)
        have = self.artists.get(k)
        if have and not refresh and self.known(name):
            return have
        out = {"image": "", "image_from": "", "bio": "", "bio_from": "", "bio_url": "", "t": time.time()}
        if have and have.get("chosen"):   # a picture you picked stays
            out.update(image=have["image"], image_from=have.get("image_from", ""), chosen=True)
        if not out["image"]:   # Deezer first: no key needed, the artist's own photo, matched by name
            lead = (own_artists(name) or [""])[0]   # "Surfaces & Quinn XCII": Surfaces's, if the pair has none
            for n in [name] + ([lead] if lead and norm(lead) != k else []):
                try:
                    pic = deezer_artist_image(n)
                except Exception as e:  # noqa: BLE001 -- busy or down: asked again in an hour, not "none"
                    print(f"omarchy-music: pictures: deezer: {e}", file=sys.stderr)
                    out["failed"], pic = True, None
                if pic and "/artist//" not in pic:   # (Deezer's blank picture has no id in it)
                    out.update(image=pic, image_from="Deezer")
                    out.pop("failed", None)
                    break
        out["v"] = PICTURES_V
        if not out["image"]:
            for found in (self.tried(google_images, self.keys(), f"{name} musician", 1) or [None])[:1]:
                if found:
                    out.update(image=found["url"], image_from="Google")
        genius = self.tried(genius_artist, name)
        if not out["image"] and genius and genius["image"]:
            out.update(image=genius["image"], image_from="Genius")
        wiki = self.tried(wikipedia_artist, name)
        if not out["image"] and wiki and wiki["image"]:
            out.update(image=wiki["image"], image_from="Wikipedia")
        if wiki and wiki["bio"]:
            out.update(bio=wiki["bio"], bio_from="Wikipedia", bio_url=wiki["url"])
        elif genius and genius.get("id"):
            bio = self.tried(genius_bio, genius["id"])
            if bio:
                out.update(bio=bio, bio_from="Genius", bio_url=genius["url"])
        with self.lock:
            now = self.artists.get(k) or {}
            if now.get("chosen") and not (have and have.get("chosen") and have.get("image") == now.get("image")):
                # you picked one while this was being looked up: yours stays (the bio found comes along)
                out.update(image=now["image"], image_from=now.get("image_from", "you"), chosen=True)
            self.artists[k] = out
        self.save()
        return out

    def artist_choices(self, name):
        """Pictures of the artist to pick from: Deezer's, Google's, Genius's and Wikipedia's."""
        out = []
        d = self.tried(deezer_artist_image, name)
        if d:
            out.append({"url": d, "thumb": d, "from": "Deezer"})
        out += list(self.tried(google_images, self.keys(), f"{name} musician") or [])
        g = self.tried(genius_artist, name)
        if g and g["image"]:
            out.append({"url": g["image"], "thumb": g["image"], "from": "Genius"})
        w = self.tried(wikipedia_artist, name)
        if w and w["image"]:
            out.append({"url": w["image"], "thumb": w["image"], "from": "Wikipedia"})
        return list({c["url"]: c for c in out}.values())

    def cover_choices(self, artist, album):
        """Covers for artist's album to pick from: Google's, then Genius's, then Wikipedia's."""
        out = list(self.tried(google_images, self.keys(), f"{artist} {bare_title(album)} album cover") or [])
        out += self.tried(genius_covers, artist, album) or []
        w = self.tried(wikipedia_album, artist, album)
        if w and w["image"]:
            out.append({"url": w["image"], "thumb": w["image"], "from": "Wikipedia"})
        return list({c["url"]: c for c in out}.values())

    def prune(self, keep):
        """(blocking) Forget the artists not in keep (their names, normed), and delete their pictures' files
        (the cached copy shown, and one you picked from your files into the app). Returns how many."""
        with self.lock:
            gone = {k: v for k, v in self.artists.items() if k not in keep}
            for k in gone:
                self.artists.pop(k, None)
        for k, v in gone.items():
            url = v.get("image") or ""
            if url:
                thumb_path(artist_picture(k, url)["id"]).unlink(missing_ok=True)
        if gone:
            self.save()
        return len(gone)

    def choose_artist(self, name, url, source="you"):
        """Keep url (a web address or a file) as the artist's picture."""
        with self.lock:
            a = self.artists.setdefault(norm(name), {"bio": "", "bio_from": "", "bio_url": "", "t": time.time()})
            a.update(image=url, image_from=source, chosen=True)
        self.save()

    def cover(self, artist, album):
        """The cover you picked for artist's album, or ""."""
        return self.covers.get(self.cover_key(artist, album), "") or \
            self.covers.get(f"{norm(artist.split(',')[0])}|{norm(bare_title(album))}", "")   # (one picked before)

    @staticmethod
    def cover_key(artist, album):
        """An album's key for a cover you picked: its lead artist ("A & B" as A: the album's songs with someone
        featured get it too) and its name."""
        lead = re.split(r",| & | x | feat\.? | ft\.? | featuring | with ", artist or "", flags=re.I)[0]
        return f"{norm(lead)}|{norm(bare_title(album))}"

    def choose_cover(self, artist, album, url):
        with self.lock:
            self.covers[self.cover_key(artist, album)] = url
        self.save()


