def hex_rgb(h):
    h = h.lstrip("#")
    return tuple(int(h[i:i + 2], 16) / 255 for i in (0, 2, 4)) if len(h) >= 6 else (1.0, 1.0, 1.0)


class Fg:
    """A colour as a widget's get_color() gives it (red, green, blue, alpha)."""
    __slots__ = ("red", "green", "blue", "alpha")

    def __init__(self, r, g, b, a=1.0):
        self.red, self.green, self.blue, self.alpha = r, g, b, a


def gdk_rgba(r, g, b, a=1.0):
    c = Gdk.RGBA()
    c.red, c.green, c.blue, c.alpha = r, g, b, a
    return c


def rect(x, y, w, h):
    return Graphene.Rect().init(x, y, w, h)


def blurred_cover(path):
    """Now playing's background from the cover at path, Apple Music's way: a gradient in the cover's main
    colour (lighter at the top, deeper at the bottom), with the cover itself, slightly blurred, faintly in
    it. (cover rgb bytes, w, h, top colour, bottom colour, bars colour), colours (r, g, b) 0..1."""
    from gi.repository import GdkPixbuf
    try:
        pb = GdkPixbuf.Pixbuf.new_from_file_at_scale(str(path), 64, 64, False)
    except GLib.Error:
        return None
    if pb.get_has_alpha():
        pb = pb.composite_color_simple(64, 64, GdkPixbuf.InterpType.BILINEAR, 255, 64, 0, 0)
    small = pb.scale_simple(16, 16, GdkPixbuf.InterpType.HYPER)      # slightly blurred: its shapes, softly
    soft = small.scale_simple(64, 64, GdkPixbuf.InterpType.BILINEAR)
    px, n, stride = soft.get_pixels(), soft.get_n_channels(), soft.get_rowstride()
    data = bytearray(64 * 64 * 3)
    for y in range(64):
        row = px[y * stride:y * stride + 64 * n]
        for c in range(3):
            data[y * 192 + c:y * 192 + 192:3] = row[c::n]
    data = bytes(data)
    rgb = art_color(path) or (60, 60, 70)
    h, l, sat = colorsys.rgb_to_hls(*(c / 255 for c in rgb))
    sat = min(0.75, max(sat, 0.25)) if sat > 0.08 else sat   # a grey cover stays grey

    def shade(light, s_=sat):
        return colorsys.hls_to_rgb(h, light, s_)
    return data, 64, 64, shade(0.46), shade(0.20), shade(0.80, min(1.0, sat + 0.1))


def texture_rgb(data, w, h):
    return Gdk.MemoryTexture.new(w, h, Gdk.MemoryFormat.R8G8B8, GLib.Bytes.new(data), w * 3)


class SnapGradient:
    """A linear gradient for SnapPainter (cairo.LinearGradient's way)."""
    __slots__ = ("x0", "y0", "x1", "y1", "stops")

    def __init__(self, x0, y0, x1, y1):
        self.x0, self.y0, self.x1, self.y1, self.stops = x0, y0, x1, y1, []

    def add_color_stop_rgba(self, off, r, g, b, a=1.0):
        st = Gsk.ColorStop()
        st.offset, st.color = off, gdk_rgba(r, g, b, a)
        self.stops.append(st)


class SnapPainter:
    """The bit of cairo the visualizer draws with, drawn as GTK's own (GPU) shapes instead. With cairo
    the whole picture was painted on the processor and handed to the graphics card every frame: at 4K,
    32 MB sixty times a second, the visualizer's lag on Windows when the window was big. Rectangles and
    gradients go in as they are; curves and circles as paths."""

    def __init__(self, snap, w, h):
        self.snap, self.w, self.h = snap, w, h
        self.src = (0.0, 0.0, 0.0, 1.0)
        self.rects = []
        self.builder = None
        self.width = 2.0
        self.cap = Gsk.LineCap.BUTT

    @staticmethod
    def linear_gradient(x0, y0, x1, y1):
        return SnapGradient(x0, y0, x1, y1)

    def set_source_rgba(self, r, g, b, a=1.0):
        self.src = (r, g, b, a)

    def set_source_rgb(self, r, g, b):
        self.src = (r, g, b, 1.0)

    def set_source(self, grad):
        self.src = grad

    def set_line_width(self, w):
        self.width = w

    def set_line_cap(self, cap):
        self.cap = Gsk.LineCap.ROUND if cap == 1 else Gsk.LineCap.SQUARE if cap == 2 else Gsk.LineCap.BUTT

    def rectangle(self, x, y, w, h):
        self.rects.append(rect(x, y, w, h) if w >= 0 and h >= 0 else rect(min(x, x + w), min(y, y + h), abs(w), abs(h)))

    def _path(self):
        if self.builder is None:
            self.builder = Gsk.PathBuilder.new()
        return self.builder

    def move_to(self, x, y):
        self._path().move_to(x, y)

    def line_to(self, x, y):
        self._path().line_to(x, y)

    def curve_to(self, x1, y1, x2, y2, x3, y3):
        self._path().cubic_to(x1, y1, x2, y2, x3, y3)

    def close_path(self):
        self._path().close()

    def arc(self, cx, cy, r, _a0, _a1):   # (only whole circles here)
        self._path().add_circle(Graphene.Point().init(cx, cy), r)

    def _paint_in(self, bounds):
        src = self.src
        if isinstance(src, SnapGradient):
            if len(src.stops) >= 2:
                self.snap.append_linear_gradient(bounds, Graphene.Point().init(src.x0, src.y0),
                                                 Graphene.Point().init(src.x1, src.y1), src.stops)
        else:
            self.snap.append_color(gdk_rgba(*src), bounds)

    def paint(self):
        self._paint_in(rect(0, 0, self.w, self.h))

    def fill(self):
        self.fill_preserve()
        self.rects, self.builder = [], None

    def fill_preserve(self):
        for r in self.rects:
            self._paint_in(r)
        if self.builder is not None:
            path = self.builder.to_path()
            self.builder = Gsk.PathBuilder.new()
            self.builder.add_path(path)
            self.snap.push_fill(path, Gsk.FillRule.WINDING)
            self._paint_in(rect(0, 0, self.w, self.h))
            self.snap.pop()

    def stroke(self):
        if self.builder is not None:
            path = self.builder.to_path()
            st = Gsk.Stroke.new(self.width)
            st.set_line_cap(self.cap)
            self.snap.push_stroke(path, st)
            self._paint_in(rect(-self.width, -self.width, self.w + 2 * self.width, self.h + 2 * self.width))
            self.snap.pop()
        self.rects, self.builder = [], None


class VisArea(Gtk.Widget):
    """Where the Visualizer tab draws (GTK's own shapes, through SnapPainter)."""
    __gtype_name__ = "VarMusicVisArea"

    def __init__(self, vis):
