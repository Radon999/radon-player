        (self.fav_btn.add_css_class if on else self.fav_btn.remove_css_class)("liked")
        self.fav_btn.set_tooltip_text("In your favorites (f)" if on else "Favorite (f)")
        self.set_tool(self.tool_fav, "star" if on else "star_line", on)
