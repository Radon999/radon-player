    def toggle_search(self, show=None):
        t = self.app.current_track()
        show = not self.search_box.get_visible() if show is None else show
        if show and t:
            m = song_meta(self.app.lib, t)
            self.s_artist.set_text(m["artist"] or t["artist"])
            self.s_title.set_text(m["title"] or t["title"])
        self.search_box.set_visible(show and t is not None)

    def search_now(self):
        t = self.app.current_track()
        artist, title = self.s_artist.get_text().strip(), self.s_title.get_text().strip()
        if not t or not title:
            return
        self.seq += 1
        seq = self.seq
        self.message("Searching…", f"{title} · {artist}")

        def done(got, err):
            if seq != self.seq:
                return
            if got:
                self.search_box.set_visible(False)
                self.app.toast("Found: kept for offline")
            self.render(got, err, searched=True)
        in_thread(self.app.lyrics.search, t, artist, title, done=done)

    def clear(self):
        while (child := self.body.get_first_child()):
            self.body.remove(child)
        self.times, self.labels, self.cur = [], [], -1
        self.text_label = None
        self.card.set_visible(False)

    def message(self, title, body=""):
        self.clear()
        self.from_label.set_label("")
        self.mode.set_visible(False)
        box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        box.add_css_class("empty")
        t = Gtk.Label(label=title, wrap=True, justify=Gtk.Justification.CENTER)
        t.add_css_class("empty-title")
        box.append(t)
        if body:
            box.append(Gtk.Label(label=body, wrap=True, justify=Gtk.Justification.CENTER))
        self.body.append(box)

    def show_for(self, track, refresh=False):
        if not track:
            self.track_id = None
            self.message("Nothing playing", "The lyrics of the song that's playing show up here.")
            return
        if track["id"] == self.track_id and not refresh:
            return
        self.track_id, self.got, self.notes = track["id"], None, []
        self.seq += 1
        seq = self.seq
        self.message("Finding the lyrics…", f"{track['title']} · {track['artist']}")
        in_thread(self.app.lyrics.get, track, refresh, done=lambda got, err: seq == self.seq and self.render(got, err))

    def render(self, got, err, searched=False):
        if err:
            self.message("Couldn't get the lyrics", str(err)[:140])
            return
        if not got:
            self.message("No lyrics found", ("Genius, Tidal and LRCLIB don't have this song by those names."
                         if searched else "Genius, Tidal and LRCLIB don't have this song.") + "\nSearch by another artist or title:")
            if not self.search_box.get_visible():   # what you typed stays, to change and try again
                self.toggle_search(True)
            return
        if got.get("instrumental") and not (got.get("plain") or got.get("synced")):
            self.message("Instrumental", "No words in this one.")
            return
        self.got = got
        synced, plain = bool(parse_lrc(got.get("synced"))), bool(got.get("plain"))
        mode = self.app.lyrics_mode
        if mode == "synced" and not synced:
            mode = "genius"
        if mode == "genius" and not plain:
            mode = "synced"
        self.mode.set_visible(synced and plain)
        self.syncing = True
        self.mode.set_active_name(mode)
        self.syncing = False
        self.draw(mode)
        if plain:
            seq = self.seq
            in_thread(self.app.lyrics.notes, got, done=lambda notes, _e: seq == self.seq and self.got_notes(notes or []))

    def got_notes(self, notes):
        self.notes = notes
        if self.text_label and notes:   # the words as written, showing: their links now
            adj = self.scroller.get_vadjustment()
            keep = adj.get_value()
            self.text_label.set_markup(self.markup(self.got["plain"]))
            self.from_label.set_label(self.plain_heading())
            GLib.idle_add(lambda: (adj.set_value(keep), False)[1])

    def plain_heading(self):
        n = len(self.notes)
        return f"LYRICS · {(self.got.get('plain_from') or '').upper()}" + (
            f" · {n} NOTE{'S' if n != 1 else ''}: CLICK AN UNDERLINED LINE" if n else "")

    def show_note(self, _label, uri):
        if not uri.startswith("note:"):
            return False   # a link of the lyrics' own, if any
        n = self.notes[int(uri[5:])]
        best = max(n["notes"], key=lambda a: (a["verified"], a["state"] == "accepted", a["votes"]))
        self.card_words.set_label(" / ".join(x.strip() for x in n["fragment"].splitlines() if x.strip()))
        self.card_text.set_label(best["text"])
        about = [f"{best['votes']:+,} votes" if best["votes"] else "",
                 "verified by the artist" if best["verified"] else "" if best["state"] == "accepted" else "not reviewed yet",
                 f"{len(n['notes']) - 1} more on Genius" if len(n["notes"]) > 1 else ""]
        self.card_about.set_label(" · ".join(x for x in about if x))
        self.card_link.set_uri(n["url"] or self.got.get("url") or "https://genius.com/")
        self.card_scroll.get_vadjustment().set_value(0)
        self.card.set_visible(True)
        return True

    def on_mode(self, group, _p):
        if not self.syncing and self.got:
            self.app.set_lyrics_mode(group.get_active_name())
            self.draw(group.get_active_name())

    def draw(self, mode):
        self.clear()
        got = self.got
        if mode == "synced":
            self.from_label.set_label(f"TIMED · {(got.get('synced_from') or '').upper()}")
            for t, words in parse_lrc(got["synced"]):
                lab = Gtk.Label(label=words or "♪", xalign=0, wrap=True, wrap_mode=Pango.WrapMode.WORD_CHAR)
                lab.add_css_class("lyric-line")
                lab.set_cursor_from_name("pointer")
                click = Gtk.GestureClick()
                click.connect("released", lambda *_, t=t: self.app.player.seek(t))
                lab.add_controller(click)
                self.body.append(lab)
                self.times.append(t)
                self.labels.append(lab)
            GLib.timeout_add(60, lambda: (self.tick(self.app.position, jump=True), False)[1])   # once laid out
        else:
            self.from_label.set_label(self.plain_heading())
            lab = Gtk.Label(xalign=0, wrap=True, selectable=True, wrap_mode=Pango.WrapMode.WORD_CHAR)
            lab.add_css_class("lyrics-text")
            lab.set_markup(self.markup(got["plain"]))
            lab.connect("activate-link", self.show_note)
            self.text_label = lab
            self.body.append(lab)
            self.scroller.get_vadjustment().set_value(0)

    def markup(self, text):
        muted = self.app.theme["c"]["muted"]
        noted = place_notes(text, self.notes) if self.notes else {}
        out = []
        for i, line in enumerate(text.splitlines()):
            esc = GLib.markup_escape_text(line)
            if re.fullmatch(r"\s*\[[^\]]+\]\s*", line):   # [Verse 1], [Chorus]: Genius's section names
                esc = f'<span foreground="{muted}" size="small" weight="bold">{esc.upper()}</span>'
            elif i in noted and line.strip():
                esc = f'<a href="note:{noted[i]}" title="Genius annotation">{esc}</a>'
            out.append(esc)
        return "\n".join(out)

    def tick(self, pos, jump=False):
        """Light up the line being sung at pos seconds."""
        if not self.times:
            return
        i = bisect.bisect_right(self.times, pos + 0.25) - 1   # a quarter second early, as you read ahead
        if i == self.cur and not jump:
            return
        if jump or i < self.cur:
            for j, lab in enumerate(self.labels):
                (lab.add_css_class if j < i else lab.remove_css_class)("past")
                (lab.add_css_class if j == i else lab.remove_css_class)("now")
        else:
            for j in range(max(self.cur, 0), i):
                self.labels[j].remove_css_class("now")
                self.labels[j].add_css_class("past")
            if i >= 0:
                self.labels[i].add_css_class("now")
        self.cur = i
        self.scroll_to(i, jump)

    def scroll_to(self, i, jump):
        if not jump and time.monotonic() - self.user_scrolled < 4:   # you're reading ahead: leave it
            return
        adj = self.scroller.get_vadjustment()
        target = 0.0
        if i >= 0:
            lab = self.labels[i]
            ok, pt = lab.compute_point(self.body, Graphene.Point().init(0, 0))
            if not ok:
                return
            target = max(0.0, pt.y + lab.get_height() / 2 - self.scroller.get_height() * 0.38)
        if self.anim:
            self.anim.pause()
        if jump:
            adj.set_value(target)
            return
        self.anim = Adw.TimedAnimation.new(self.scroller, adj.get_value(), target, 450,
                                           Adw.CallbackAnimationTarget.new(adj.set_value))
        self.anim.set_easing(Adw.Easing.EASE_OUT_CUBIC)
        self.anim.play()


class PagePop:
    """What was a popover and is a page of the window now (Settings): popup shows it, popdown leaves it."""

    def __init__(self, win, key):
        self.win, self.key = win, key

    def popup(self, section=None):
        """section: Settings' section to unfold (the rest start folded, each time Settings opens)."""
        if section and self.get_visible():
            self.win.settings_open.add(section)
        self.win.settings_section = {section} if section else None
        self.win.show_tab(self.key)

    def popdown(self):
        if self.win.shown(self.key):
            self.win.nav_back()

    def get_visible(self):
        return self.win.stack.get_visible_child_name() == self.key


