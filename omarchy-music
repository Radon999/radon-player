def discord_ipc_paths():
    """Where the Discord app (or Vesktop, or another client with Rich Presence) listens on this computer."""
    if WINDOWS:
        return [rf"\\.\pipe\discord-ipc-{i}" for i in range(10)]
    bases = [os.environ.get(k) for k in ("XDG_RUNTIME_DIR", "TMPDIR", "TMP", "TEMP")] + ["/tmp"]
    subs = ("", "app/com.discordapp.Discord/", "app/com.discordapp.DiscordCanary/", "app/dev.vencord.Vesktop/",
            ".flatpak/dev.vencord.Vesktop/xdg-run/", "snap.discord/")
    return [f"{b.rstrip('/')}/{sub}discord-ipc-{i}" for i in range(10) for b in dict.fromkeys(filter(None, bases)) for sub in subs]


def song_page(t):
    """(the service's name, the song's page there), or None for a song only you have."""
    src = source_of(t)
    if src == "ytm":
        return "YouTube Music", f"https://music.youtube.com/watch?v={t['id']}"
    if src == "tidal" and t.get("tidal"):
        return "Tidal", f"https://tidal.com/browse/track/{t['tidal']}"
    if src == "apple" and t.get("apple"):
        return "Apple Music", f"https://music.apple.com/song/{t['apple']}"
    if src == "spotify" and t.get("spotify"):
        return "Spotify", f"https://open.spotify.com/track/{t['spotify']}"
    return None


def discord_activity(t, position, duration, speed=1.0, now=None):
    """The Rich Presence activity for t, playing position seconds in: "Listening to
    Radon Player", the song and its artists, its cover, a bar of how far in it is, and buttons to
    open the song and to get the app."""
    now = time.time() if now is None else now

    def text(v):   # Discord takes 2 to 128 characters
        return (v or "").strip()[:128].ljust(2, "\u2800")
    start = now - position / speed
    act = {"type": 2, "status_display_type": 0, "details": text(t.get("title")), "state": text(t.get("artist")),
           "timestamps": {"start": int(start * 1000)},
           "assets": {"large_image": t["thumb"] if str(t.get("thumb") or "").startswith("https://") else ICON_URL,
                      "small_image": ICON_URL, "small_text": "Radon Player"}}
    if duration:
        act["timestamps"]["end"] = int((start + duration / speed) * 1000)
    if t.get("album"):
        act["assets"]["large_text"] = text(t["album"])
    page = song_page(t)
    if page:
        act["details_url"] = page[1]
    act["buttons"] = ([{"label": f"Play on {page[0]}", "url": page[1]}] if page else []) + \
        [{"label": "Get Radon Player", "url": DOWNLOAD_PAGE}]
    return act


def same_activity(a, b):
    """Whether Discord showing b is as good as a: the same, give or take 2 s on the bar."""
    if a is None or b is None:
        return a is b
    ta, tb = a.get("timestamps", {}), b.get("timestamps", {})
    return ({**a, "timestamps": None} == {**b, "timestamps": None} and ta.keys() == tb.keys()
            and all(abs(ta[k] - tb[k]) <= 2000 for k in ta))


class DiscordPresence:
    """What you're playing on your Discord profile, as Spotify does, through the Discord app's
    own Rich Presence socket on this computer (nothing goes anywhere else). Paused or stopped,
    it's cleared. With Discord closed it looks for it again every so often."""
    RETRY = 20     # seconds between looks for Discord while it's closed
    GAP = 4.0      # Discord takes 5 updates a 20 s: one every 4 s at most

    def __init__(self, app):
        self.app = app
        self.want, self.sent = None, None   # the activity to show, and what Discord shows (None: nothing)
        self.conn = None
        self.status = ""                    # for Settings: "" (not tried yet), "on", or why not
        self.cond = threading.Condition()
        self.soon = None
        threading.Thread(target=self.run, daemon=True, name="discord").start()

    def app_id(self):
        return self.app.api_keys.get("discord_app_id") or DISCORD_APP_ID

    def changed(self):
        """Something about what's playing changed: tell Discord in a moment (once the position has caught up)."""
        if self.soon is None:
            self.soon = GLib.timeout_add(800, self._update)

    def _update(self):
        self.soon = None
        a = self.app
        t = a.current_track()
        want = None
        if a.discord_on and self.app_id() and t and not a.paused and a.loaded and a.loaded[0] == t["id"]:
            want = discord_activity(t, a.position, a.duration or t.get("duration") or 0, a.speeds.get(t)[0])
        with self.cond:
            self.want = want
            self.cond.notify()
        return False

    # ---- the socket (a named pipe on Windows) ----
    def connect(self):
        for path in discord_ipc_paths():
            try:
                if WINDOWS:
                    conn = open(path, "r+b", buffering=0)  # noqa: SIM115 -- kept open while Discord is
                else:
                    if not os.path.exists(path):
                        continue
                    conn = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
                    conn.settimeout(10)
                    conn.connect(path)
                break
            except OSError:
                continue
        else:
            raise OSError("Discord isn't open")
        self.conn = conn
        self.send(0, {"v": 1, "client_id": self.app_id()})
        self.reply()

    def close(self):
        if self.conn:
            try:
                self.conn.close()
            except OSError:
                pass
        self.conn, self.sent = None, None

    def send(self, op, data):
        body = json.dumps(data).encode()
        frame = struct.pack("<II", op, len(body)) + body
        if WINDOWS:
            self.conn.write(frame)
        else:
            self.conn.sendall(frame)

    def recv(self, n):
        out = b""
        while len(out) < n:
            part = self.conn.read(n - len(out)) if WINDOWS else self.conn.recv(n - len(out))
            if not part:
                raise OSError("Discord closed the connection")
            out += part
        return out

    def reply(self):
        op, n = struct.unpack("<II", self.recv(8))
        data = json.loads(self.recv(n) or b"{}")
        if op == 2 or data.get("evt") == "ERROR":   # 2: Discord closed it, saying why
            raise ValueError((data.get("data") or {}).get("message") or data.get("message") or "Discord said no")
        return data

    def run(self):
        last = 0.0
        while True:
            with self.cond:
                self.cond.wait_for(lambda: not same_activity(self.want, self.sent), timeout=self.RETRY)
                want = self.want
            if same_activity(want, self.sent):
                continue
            wait = last + self.GAP - time.monotonic()
            if wait > 0:
                time.sleep(wait)
                continue   # (what to show may have changed meanwhile)
            last = time.monotonic()
            try:
                if not self.conn:
                    if want is None:
                        self.sent = None
                        continue
                    self.connect()
                args = {"pid": os.getpid()} | ({"activity": want} if want else {})
                self.send(1, {"cmd": "SET_ACTIVITY", "args": args, "nonce": secrets.token_hex(8)})
                self.reply()
                self.sent, self.status = want, "on"
            except (OSError, ValueError, struct.error) as e:
                self.close()
                self.status = str(e)[:80] or "Discord isn't open"
                with self.cond:
                    self.cond.wait(self.RETRY)   # look again in a while (or when something changes)
            GLib.idle_add(lambda: (self.app.refresh_accounts_soon(), False)[1])


# =============================================================================
# A song's names at their cleanest: the saved file's tags (Tidal's, then the
# tagger's) beat a YouTube title like "Song (Official Video)"
# =============================================================================

_TAGS_SEEN = collections.OrderedDict()   # path: (mtime, tags): reading a FLAC's tags took up to 0.2 s


def file_tags(path):
    """The Vorbis comments of a FLAC file as {name: [values]}, {} if unreadable."""
    try:
        mtime = os.stat(path).st_mtime
    except OSError:
        return {}
    seen = _TAGS_SEEN.get(path)
    if seen and seen[0] == mtime:
        return seen[1]
    try:
        from mutagen.flac import FLAC
        tags = {k.lower(): v for k, v in (FLAC(path).tags or {}).as_dict().items()}
    except Exception:  # noqa: BLE001 -- not there, or not a FLAC
        tags = {}
    _TAGS_SEEN[path] = (mtime, tags)
    try:
        while len(_TAGS_SEEN) > 300:
            _TAGS_SEEN.popitem(last=False)
    except KeyError:   # another thread got there first
        pass
    return tags


def tidy_title(s):
    """A title without what YouTube adds, keeping its case."""
    s2 = re.sub(r"\s*[(\[][^)\]]*\b(official|video|audio|lyrics?|visuali[sz]er|hd|4k|mv)\b[^)\]]*[)\]]", "", s, flags=re.I)
    return s2.strip() or s


def song_meta(lib, track):
    entry = lib.items.get(track["id"]) or {}
    path = entry.get("file") if entry.get("format") == "flac" else (
        track.get("file") if source_of(track) == "file" and not is_phone_song(track) else None)
    tags = file_tags(path) if path else {}

    def one(k):
        return (tags.get(k) or [""])[0]
    title = one("title") or track.get("title") or ""
    artists = tags.get("artist") or [a.strip() for a in (track.get("artist") or "").split(",") if a.strip()]
    if not tags and source_of(track) == "ytm":
        title = tidy_title(title)
    return {"title": title, "artist": artists[0] if artists else "", "artists": artists,
            "album": one("album") or track.get("album") or "", "albumartist": one("albumartist"),
            "duration": entry.get("duration") or track.get("duration") or 0,
            "tidal": one("tidal_id") or entry.get("tidal") or track.get("tidal"),
            "mbid": one("musicbrainz_trackid"), "file": path, "tags": tags}


# =============================================================================
# Lyrics: Genius's text, and lines timed to the music (Tidal's, which come
# from Musixmatch, else LRCLIB's) to follow along. The tagger puts both in the
# saved songs, so lyrics work offline too.
# =============================================================================

LYRICS_CACHE = CACHE / "lyrics"
LYRICS_RETRY = 7 * 86400    # look again for lyrics nobody had, after a week
GENIUS_NOTES = CACHE / "genius-notes"
NOTES_KEEP = 14 * 86400     # Genius's annotations are looked at again after two weeks
# Genius swaps a few letters of its lyrics for look-alikes from other alphabets
# (to spot copies). In a word that is otherwise Latin, put the real letter back.
HOMOGLYPHS = str.maketrans({"а": "a", "е": "e", "о": "o", "р": "p", "с": "c", "у": "y", "х": "x", "і": "i",
                            "ј": "j", "ѕ": "s", "һ": "h", "ԁ": "d", "ɡ": "g", "А": "A", "В": "B", "Е": "E",
                            "К": "K", "М": "M", "Н": "H", "О": "O", "Р": "P", "С": "C", "Т": "T", "Х": "X",
                            "І": "I", "Ј": "J", "Ѕ": "S", "ο": "o", "α": "a", "ν": "v", "Ο": "O", "Α": "A"})
LRC_TIME = re.compile(r"\[(\d+):(\d+(?:[.:]\d+)?)\]")


def degenius(text):
    def fix(m):
        word = m.group(0)
        letters = [c for c in word if c.isalpha()]
        return word.translate(HOMOGLYPHS) if 2 * sum(c.isascii() for c in letters) >= len(letters) else word
    text = re.sub(r"[  -   ]", " ", text)   # odd spaces
    text = re.sub(r"[​-‍⁠﻿]", "", text)          # invisible ones
    return re.sub(r"\w+", fix, text)


class _GeniusLyrics(HTMLParser):
    """The text of a Genius song page's lyrics, without the header Genius puts inside them."""
    VOID = {"br", "img", "hr", "input", "meta", "link", "source", "wbr", "area", "col", "embed", "param", "track"}

    def __init__(self):
        super().__init__(convert_charrefs=True)
        self.depth = self.skip = 0
        self.parts = []

    def handle_starttag(self, tag, attrs):
        if tag in self.VOID:
            if self.depth and tag == "br" and not self.skip:
                self.parts.append("\n")
            return
        a = dict(attrs)
        if self.depth:
            self.depth += 1
            if self.skip or a.get("data-exclude-from-selection") == "true":
                self.skip += 1
        elif a.get("data-lyrics-container") == "true":
            self.depth = 1
            if self.parts:
                self.parts.append("\n")

    def handle_startendtag(self, tag, attrs):
        if self.depth and tag == "br" and not self.skip:
            self.parts.append("\n")

    def handle_endtag(self, tag):
        if self.depth and tag not in self.VOID:
            self.depth -= 1
            if self.skip:
                self.skip -= 1

    def handle_data(self, data):
        if self.depth and not self.skip:
            self.parts.append(data)

    def text(self):
        return re.sub(r"\n{3,}", "\n\n", "".join(self.parts)).strip()


def genius_lyrics(artist, title):
    """(text, page address, song id) of the song on Genius, or None if Genius hasn't got it."""
    lead = artist.split(",")[0].strip()
    want = clean_title(title)
    best, best_score = None, 0.0
    for q in dict.fromkeys((f"{lead} {bare_title(title)}", f"{lead} {want}")):
        res = http_json("https://genius.com/api/search/song?" + urllib.parse.urlencode({"q": q, "per_page": 5}))
        sections = (res.get("response") or {}).get("sections") or [{}]
        for hit in sections[0].get("hits") or []:
            r = hit.get("result") or {}
            names = artist_names([r.get("artist_names") or "", (r.get("primary_artist") or {}).get("name") or ""])
            if any(n.startswith("genius") for n in names):   # its translations and romanizations
                continue
            t = similar(want, clean_title(r.get("title") or ""))
            a = max((similar(x, y) for x in artist_names([lead]) for y in names), default=0.0)
            if t >= 0.6 and a >= 0.7 and 0.6 * t + 0.4 * a > best_score:
                best, best_score = r, 0.6 * t + 0.4 * a
        if best_score >= 0.9:
            break
    if not best or not best.get("url"):
        return None
    page = _GeniusLyrics()
    page.feed(http(best["url"]).decode("utf-8", "replace"))
    text = degenius(page.text())
    return (text, best["url"], best.get("id")) if text else None


def genius_song_id(url):
    """The id of the Genius song whose page is at url (songs whose lyrics were kept before ids were)."""
    html = http(url).decode("utf-8", "replace")
    m = re.search(r"genius://songs/(\d+)", html) or re.search(r'"song_id\\?"\s*:\s*(\d+)', html)
    return int(m.group(1)) if m else None


def genius_notes(song_id, pages=4):
    """Genius's annotations of the song: [{"fragment" (the words they're about), "url",
    "notes": [{"text", "votes", "verified", "state"}]}], in the song's order. Genius's
    description of the whole song isn't one of them."""
    out = []
    for page in range(1, pages + 1):
        res = http_json("https://genius.com/api/referents?" + urllib.parse.urlencode(
            {"song_id": song_id, "text_format": "plain", "per_page": 50, "page": page}), timeout=15)
        refs = (res.get("response") or {}).get("referents") or []
        for r in refs:
            if r.get("is_description") or not (r.get("fragment") or "").strip():
                continue
            notes = [{"text": degenius(a["body"]["plain"].strip()), "votes": a.get("votes_total") or 0,
                      "verified": bool(a.get("verified")), "state": a.get("state") or ""}
                     for a in r.get("annotations") or [] if ((a.get("body") or {}).get("plain") or "").strip()]
            if notes:
                out.append({"fragment": degenius(r["fragment"]).strip(), "url": r.get("url") or "", "notes": notes})
        if len(refs) < 50:
            break
    return out


def note_key(text):
    """Words to compare a line of lyrics and an annotation's by: no case, quotes or punctuation."""
    return re.sub(r"\W+", " ", text.lower().replace("’", "").replace("'", "")).strip()


def place_notes(text, notes):
    """Which lines of text (lyrics) each of notes (genius_notes) is about: {line index: note index}.
    The words of an annotation are whole lines, or part of one; a chorus sung again gets the
    note each time; a line two notes are about gets the first."""
    keys = [note_key(line) for line in text.splitlines()]
    at = {}
    for k, n in enumerate(notes):
        frag = [f for f in (note_key(x) for x in n["fragment"].splitlines()) if f]
        if not frag:
            continue
        for i, first in enumerate(keys):
            if not first or frag[0] not in first and not (len(first) >= 6 and first in frag[0]):
                continue
            lines, j = [i], i + 1
            for f in frag[1:]:
                while j < len(keys) and not keys[j]:   # a blank line inside the words
                    j += 1
                if j >= len(keys) or not (f in keys[j] or (len(keys[j]) >= 6 and keys[j] in f)):
                    lines = None
                    break
                lines.append(j)
                j += 1
            for x in lines or []:
                at.setdefault(x, k)
    return at


def lrclib_lyrics(artist, title, album, duration):
    """(timed LRC text, plain text, instrumental) from LRCLIB, or None."""
    hdr = {"User-Agent": APP_UA}
    lead = artist.split(",")[0].strip()
    found = None
    try:
        found = http_json("https://lrclib.net/api/get?" + urllib.parse.urlencode(
            {"artist_name": lead, "track_name": title, "album_name": album or "", "duration": int(duration or 0)}), hdr)
    except urllib.error.HTTPError as e:
        if e.code != 404:
            raise
    if not found:
        hits = http_json("https://lrclib.net/api/search?" + urllib.parse.urlencode(
            {"track_name": title, "artist_name": lead}), hdr) or []
        hits = [h for h in hits if not duration or abs((h.get("duration") or 0) - duration) <= 3]
        hits.sort(key=lambda h: -similar(clean_title(title), clean_title(h.get("trackName") or "")))
        found = hits[0] if hits and similar(clean_title(title), clean_title(hits[0].get("trackName") or "")) > 0.7 else None
    if not found:
        return None
    return found.get("syncedLyrics") or None, found.get("plainLyrics") or None, bool(found.get("instrumental"))


def parse_lrc(text):
    """[(seconds, line)] from LRC text, in order; [] if it has no timed lines."""
    m = re.search(r"\[offset:\s*([+-]?\d+)\]", text or "", re.I)
    offset = int(m.group(1)) / 1000 if m else 0.0   # + shows the lines sooner
    lines = []
    for raw in (text or "").splitlines():
        stamps = LRC_TIME.findall(raw)
        if not stamps:
            continue
        words = re.sub(r"<\d+:\d+(?:\.\d+)?>", "", LRC_TIME.sub("", raw)).strip()   # drops word timings
        for mm, ss in stamps:
            lines.append((max(0.0, int(mm) * 60 + float(ss.replace(":", ".")) - offset), words))
    return sorted(lines, key=lambda x: x[0])


class Lyrics:
    """Finds the lyrics of each song once and keeps them."""

    def __init__(self, app):
        self.app = app
        LYRICS_CACHE.mkdir(parents=True, exist_ok=True)

    @staticmethod
    def has(got):
        return bool(got and (got.get("plain") or got.get("synced") or got.get("instrumental")))

    def get(self, track, refresh=False):
        """{"plain", "plain_from", "synced", "synced_from", "url", "instrumental"} for track,
        or None if nobody has its lyrics. It blocks: run it off the UI thread."""
        m = song_meta(self.app.lib, track)
        if m["file"] and not refresh:
            got = self.from_file(m["file"], self.app.lib.items.get(track["id"]) or {})
            if got:
                return got
        path = LYRICS_CACHE / f"{safe_name(track['id'])}.json"
        cached = read_json(path, None)
        if cached and not refresh and (self.has(cached) or time.time() - cached.get("time", 0) < LYRICS_RETRY):
            return cached if self.has(cached) else None
        got, reached = self.fetch(m)
        if reached:   # offline, every lookup failed: don't remember that as "no lyrics"
            write_atomic(path, json.dumps(got | {"time": time.time()}))
        return got if self.has(got) else None

    @staticmethod
    def from_file(path, entry):
        tags = file_tags(path)
        plain = (tags.get("lyrics") or tags.get("unsyncedlyrics") or [None])[0]
        lrc = Path(path).with_suffix(".lrc")
        synced = lrc.read_text(errors="replace") if lrc.exists() else None
        if plain and not synced and parse_lrc(plain):   # timed lines kept in the tag itself
            synced, plain = plain, None
        if not (plain or synced):
            return None
        info = entry.get("lyrics") or {}
        return {"plain": plain, "plain_from": info.get("plain_from") or "the file", "synced": synced,
                "synced_from": info.get("synced_from") or "the file", "url": info.get("url"), "instrumental": False}

    def fetch(self, m):
        got = {"plain": None, "plain_from": None, "synced": None, "synced_from": None, "url": None, "instrumental": False}
        reached = False
        try:
            g = genius_lyrics(m["artist"], m["title"])
            reached = True
            if g:
                got.update(plain=g[0], plain_from="Genius", url=g[1], genius_id=g[2])
        except (OSError, ValueError):   # offline, or Genius changed: the others may still have them
            pass
        tidal = self.app.dl.tidal
        if m["tidal"] and tidal and tidal.connected:
            try:
                synced, plain = tidal.lyrics(m["tidal"])
                reached = True
                if synced:
                    got.update(synced=synced, synced_from="Musixmatch, through Tidal")
                if plain and not got["plain"]:
                    got.update(plain=plain, plain_from="Musixmatch, through Tidal")
            except Exception:  # noqa: BLE001 -- Tidal has none for it
                pass
        if not got["synced"]:
            try:
                r = lrclib_lyrics(m["artist"], m["title"], m["album"], m["duration"])
                reached = True
                if r:
                    synced, plain, instrumental = r
                    if synced:
                        got.update(synced=synced, synced_from="LRCLIB")
                    if plain and not got["plain"]:
                        got.update(plain=plain, plain_from="LRCLIB")
                    got["instrumental"] = instrumental and not (got["plain"] or got["synced"])
            except (OSError, ValueError):
                pass
        return got, reached

    def search(self, track, artist, title):
        """(blocking) The lyrics by another artist and title (a song whose names don't match what the
        lyrics sites have), kept as the song's own, offline too. None if nobody has them."""
        m = dict(song_meta(self.app.lib, track), artist=artist.strip(), title=title.strip(), tidal=None)
        got, reached = self.fetch(m)
        if reached and self.has(got):
            write_atomic(LYRICS_CACHE / f"{safe_name(track['id'])}.json", json.dumps(got | {"time": time.time()}))
        return got if self.has(got) else None

    @staticmethod
    def words(got):
        """Just the words of what was found: the plain lyrics, else the timed ones without their times."""
        if not got:
            return ""
        plain = (got.get("plain") or "").strip()
        if plain:
            return plain
        return "\n".join(line for _t, line in parse_lrc(got.get("synced") or "")).strip()

    def notes(self, got):
        """(blocking) Genius's annotations of the song whose lyrics are got (see genius_notes),
        [] if they aren't Genius's or it has none. Kept a while, each song's in a file."""
        url = got.get("url") or ""
        if not url.startswith("https://genius.com/"):
            return []
        sid = got.get("genius_id")
        path = GENIUS_NOTES / f"{safe_name(url.rsplit('/', 1)[-1])}.json"
        cached = read_json(path, None)
        if cached and time.time() - cached.get("time", 0) < NOTES_KEEP:
            return cached["notes"]
        try:
            sid = sid or genius_song_id(url)
            notes = genius_notes(sid) if sid else []
        except (OSError, ValueError):
            return cached["notes"] if cached else []   # offline: what was found last time
        path.parent.mkdir(parents=True, exist_ok=True)
        write_atomic(path, json.dumps({"time": time.time(), "notes": notes}))
        return notes


# =============================================================================
# Auto-tagger: what Tidal's tags leave out, for every saved song
# =============================================================================

TAGGER_VERSION = 2   # 2: Genius's notes on the lyrics go in too


def notes_text(notes):
    """Genius's annotations (genius_notes) as text for a file's tags: each quoted line, then what it means."""
    out = []
    for n in notes:
        best = max(n["notes"], key=lambda x: (x["verified"], x["votes"]))
        out.append(f"“{n['fragment']}”\n{best['text']}")
    return "\n\n".join(out)
MB_API = "https://musicbrainz.org/ws/2"


def lucene(s):
    return re.sub(r'([+\-&|!(){}\[\]^"~*?:\\/])', r"\\\1", s)


class Tagger:
    """Fills in, for each saved FLAC: genre, composer, label, barcode, original
    release date and track total (Apple's catalogue, by ISRC), MusicBrainz IDs
    (so other apps and Last.fm know the exact recording), a 1280 px cover, and
    lyrics: Genius's text in the file, the timed lines beside it as a .lrc
    (Poweramp and most players read those). A few songs at a time, in the
    background. A playing song is safe: each file is tagged as a copy that is
    then swapped in."""

    WORKERS = 3   # songs at once: MusicBrainz is slow to answer, so overlap its waits

    def __init__(self, app):
        self.app = app
        self.queue, self.current = [], set()
        self.done = self.total = self.workers = 0
        self.running = False
        self.lock = threading.Lock()
        self.apple = None          # Apple's catalogue, opened on first use
        self.mb_lock = threading.Lock()
        self.mb_next = 0.0         # MusicBrainz takes one request a second
        self.last_error = None
        self.full = set()          # songs to tag from scratch (Retag), not just brought up to date
        self.hold = 0              # downloads or an upgrade going on: songs wait in held, tagged together at the end
        self.held = []

    def untagged(self):
        return [vid for vid, t in list(self.app.lib.items.items())
                if t.get("format") == "flac" and t.get("tagged", 0) < TAGGER_VERSION]

    def start(self, ids=None, full=False):
        """Tag ids (default: every saved song not tagged yet), after what is already waiting. full: from
        scratch, as if never tagged. While downloads are going on (hold), ids wait for the end."""
        if full and ids:
            self.full.update(ids)
        if self.hold and ids is not None:
            self.held += ids
            return
        with self.lock:
            files = {self.app.lib.items[i]["file"] for i in [*self.queue, *self.current] if i in self.app.lib.items}
            for vid in self.untagged() if ids is None else ids:
                t = self.app.lib.items.get(vid)
                if t and t.get("format") == "flac" and t["file"] not in files:
                    self.queue.append(vid)
                    files.add(t["file"])   # one file saved from two services is tagged once
                    self.total += 1
            more = min(self.WORKERS - self.workers, len(self.queue))
            if more <= 0:
                return
            self.workers += more
            self.running = True
        for _ in range(more):
            threading.Thread(target=self._run, daemon=True).start()
        self.app.update_sync()

    def pause(self):
        """Downloads or an upgrade start: what comes in is tagged together once they're done."""
        self.hold += 1

    def resume(self):
        self.hold = max(0, self.hold - 1)
        if not self.hold and self.held:
            ids, self.held = list(dict.fromkeys(self.held)), []
            self.start(ids)

    def status(self):
        if not self.running:
            return ""
        return f"Tagging · {self.done} of {self.total}"

    def _run(self):
        while True:
            with self.lock:
                if not self.queue:
                    self.workers -= 1
                    last = not self.workers
                    if last:
                        self.running, self.done, self.total = False, 0, 0
                    break
                vid = self.queue.pop(0)
                self.current.add(vid)
            try:
                self.tag(vid)
            except Exception as e:  # noqa: BLE001 -- the next song; this one is tried again next time
                self.last_error = f"{vid}: {e}"
            with self.lock:
                self.current.discard(vid)
                self.done += 1
            GLib.idle_add(lambda: (self.app.update_sync(), False)[1])
        if last:
            GLib.idle_add(lambda: (self.app.tagging_finished(), False)[1])

    def apple_song(self, isrc, album):
        if not isrc:
            return None
        if not self.apple:
            self.apple = self.app.sources.get("apple") or AppleMusic()
        try:
            return self.apple.catalog_song(isrc, album)
        except urllib.error.HTTPError as e:
            if e.code == 404:
                return None
            raise

    def mb(self, path, **params):
        with self.mb_lock:   # the songs being tagged take turns: a request a second between them
            wait = self.mb_next - time.monotonic()
            if wait > 0:
                time.sleep(wait)
            self.mb_next = time.monotonic() + 1.1
        try:
            return http_json(f"{MB_API}/{path}?" + urllib.parse.urlencode({**params, "fmt": "json"}),
                             {"User-Agent": APP_UA})
        except urllib.error.HTTPError as e:
            if e.code == 404:
                return {}
            raise

    def musicbrainz(self, isrc, title, artist, album, duration):
        """MusicBrainz's IDs for the recording, its release, release group and artists."""
        recs = self.mb(f"isrc/{isrc}").get("recordings") or [] if isrc else []
        if not recs and title and artist:
            q = f'recording:"{lucene(title)}" AND artist:"{lucene(artist)}"'
            recs = [r for r in self.mb("recording", query=q, limit=5).get("recordings") or [] if r.get("score", 0) >= 95]
        if not recs:
            return {}
        best = min(recs, key=lambda r: abs((r.get("length") or 0) / 1000 - duration) if duration and r.get("length") else 999)
        # The ISRC lookup leaves the releases out whatever it's asked for: the recording's own lookup has them all.
        rec = self.mb(f"recording/{best['id']}", inc="releases+release-groups+artist-credits") or best
        out = {"musicbrainz_trackid": best["id"]}
        ids = [c["artist"]["id"] for c in rec.get("artist-credit") or [] if c.get("artist")]
        if ids:
            out["musicbrainz_artistid"] = ids
        releases = rec.get("releases") or []
        if releases:
            rel = max(releases, key=lambda r: (similar(norm(r.get("title")), norm(album)), r.get("status") == "Official",
                                               bool(r.get("date"))))
            out["musicbrainz_albumid"] = rel["id"]
            if (rel.get("release-group") or {}).get("id"):
                out["musicbrainz_releasegroupid"] = rel["release-group"]["id"]
            ids = [c["artist"]["id"] for c in rel.get("artist-credit") or [] if c.get("artist")]
            if ids:
                out["musicbrainz_albumartistid"] = ids
        return out

    def mb_genres(self, artist_ids):
        """The genres MusicBrainz lists for the song's first artist, most voted first."""
        if not artist_ids:
            return []
        found = self.mb(f"artist/{artist_ids[0]}", inc="genres").get("genres") or []
        return [g["name"].title() for g in sorted(found, key=lambda g: -g.get("count", 0)) if g.get("count", 0) > 0][:2]

    def tag(self, vid):
        e = self.app.lib.items.get(vid) or {}
        plan = self.plan(vid, light=e.get("tagged", 0) >= 1 and vid not in self.full)   # tagged before: just Genius's notes
        self.full.discard(vid)
        if plan:
            self.write(plan)

    def plan(self, vid, light=False):
        """(blocking) What tagging vid would do, nothing written: {"path", "old" (its tags), "fill" (the tags
        it adds or changes), "cover" (a bigger one, or None), "lrc", "credit"}; None if it isn't a saved FLAC."""
        from mutagen.flac import FLAC
        lib = self.app.lib
        entry = lib.items.get(vid)
        if not entry or entry.get("format") != "flac" or not Path(entry["file"]).exists():
            return None
        path = Path(entry["file"])
        m = song_meta(lib, entry)
        tags = m["tags"]
        isrc = (tags.get("isrc") or [entry.get("isrc") or ""])[0]
        new = {}

        song = None if light else self.apple_song(isrc, m["album"])
        artwork = None
        if song:
            a = song.get("attributes") or {}
            albums = ((song.get("relationships") or {}).get("albums") or {}).get("data") or [{}]
            aa = albums[0].get("attributes") or {}
            genres = [g for g in a.get("genreNames") or [] if g != "Music"][:3]
            new.update({k: v for k, v in {
                "genre": genres, "composer": a.get("composerName"), "label": aa.get("recordLabel"),
                "barcode": aa.get("upc"), "originaldate": a.get("releaseDate"),
                "tracktotal": str(aa["trackCount"]) if aa.get("trackCount") else None,
                "apple_music_id": song.get("id"),
            }.items() if v})
            artwork = (a.get("artwork") or {}).get("url")
        try:
            if not light:
                new.update(self.musicbrainz(isrc, m["title"], m["artist"], m["album"], m["duration"]))
        except (OSError, ValueError):   # MusicBrainz is down: the rest still goes in
            pass
        if not new.get("genre") and not light:
            try:
                new["genre"] = self.mb_genres(new.get("musicbrainz_artistid")) or None
            except (OSError, ValueError):
                pass

        got = self.app.lyrics.get(entry)
        lrc = credit = None
        if got:
            if got.get("plain"):
                new["lyrics"] = got["plain"]
            lrc = got.get("synced")
            credit = {"plain_from": got.get("plain_from"), "synced_from": got.get("synced_from"), "url": got.get("url")}
            try:
                notes = self.app.lyrics.notes(got)
            except Exception:  # noqa: BLE001 -- the lyrics without them
                notes = []
            if notes:
                new["genius_notes"] = notes_text(notes)

        cover = None
        f = FLAC(path)
        if not light and max((len(p.data) for p in f.pictures), default=0) < 120_000:   # 640 px from before: get 1280
            try:
                tidal = self.app.dl.tidal
                if m["tidal"] and tidal and tidal.connected:
                    with tidal.lock:
                        url = tidal.session.track(int(m["tidal"])).album.image(1280)
                else:
                    url = apple_art(artwork, 1280) if artwork else None
                cover = fetch_bytes(url) if url else None
            except Exception:  # noqa: BLE001 -- keep the cover it has
                cover = None

        # Keep what the file already says (Tidal's names, numbers, date); add the rest.
        fill = {k: v for k, v in new.items() if v and (k in ("lyrics", "genre", "genius_notes") or not tags.get(k))
                and [v] != tags.get(k) and v != tags.get(k)}
        return {"vid": vid, "path": path, "old": tags, "fill": fill, "cover": cover, "lrc": lrc, "credit": credit}

    def write(self, plan):
        """Put plan (see plan) into the file, and the library."""
        from mutagen.flac import FLAC, Picture
        lib = self.app.lib
        path, fill, cover, lrc, credit, tags = (plan[k] for k in ("path", "fill", "cover", "lrc", "credit", "old"))
        if fill or cover:
            tmp = path.with_name(path.stem + ".tagging.flac")
            import shutil
            shutil.copyfile(path, tmp)
            try:
                f = FLAC(tmp)
                for k, v in fill.items():
                    f[k] = v
                if cover:
                    f.clear_pictures()
                    pic = Picture()
                    pic.type, pic.mime, pic.data = 3, "image/jpeg", cover   # 3: front cover
                    f.add_picture(pic)
                f.save()
                os.replace(tmp, path)
            finally:
                tmp.unlink(missing_ok=True)
        if lrc:
            write_atomic(path.with_suffix(".lrc"), lrc)
        genres = fill.get("genre") or tags.get("genre") or []
        with lib.lock:   # not while another song's tagging is saving the library
            for e in [e for e in list(lib.items.values()) if e.get("file") == str(path)]:   # every service's entry for it
                e["tagged"] = TAGGER_VERSION
                if genres:
                    e["genre"] = genres[0]
                if credit:
                    e["lyrics"] = credit
        lib.save()


