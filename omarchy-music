def fmt_hours(secs):
    """Listening time as said: "312 h", "4 h 20 min", "45 min"."""
    m = round((secs or 0) / 60)
    if m >= 6000:
        return f"{m // 60:,} h"
    return f"{m // 60} h {m % 60} min" if m >= 60 else f"{m} min"


def card_png(title, when, rows, out, big_art=None, lead=None):
    """A stat card to share, phone-story size (1080×1920): title and time at the top, the first one's picture big, then
    rows [{"title", "sub", "value", "art"}] numbered; or lead (a big line: "312 h") with the rows under it. PNG to out."""
    import cairo
    gi.require_version("PangoCairo", "1.0")
    from gi.repository import PangoCairo, GdkPixbuf, Gdk
    W, H = 1080, 1920
    surf = cairo.ImageSurface(cairo.FORMAT_RGB24, W, H)
    cr = cairo.Context(surf)
    rgb = (art_color(big_art) if big_art else None) or (90, 60, 140)
    h, l, sat = colorsys.rgb_to_hls(*(c / 255 for c in rgb))
    top = colorsys.hls_to_rgb(h, 0.42, min(0.8, max(sat, 0.3)))
    bottom = colorsys.hls_to_rgb(h, 0.12, min(0.8, max(sat, 0.3)))
    g = cairo.LinearGradient(0, 0, 0, H)
    g.add_color_stop_rgb(0, *top)
    g.add_color_stop_rgb(1, *bottom)
    cr.set_source(g)
    cr.paint()

    def text(t, size, weight, alpha, x, y, width, align=Pango.Alignment.LEFT):
        lay = PangoCairo.create_layout(cr)
        lay.set_width(int(width * Pango.SCALE))
        lay.set_alignment(align)
        lay.set_ellipsize(Pango.EllipsizeMode.END)
        lay.set_font_description(Pango.FontDescription.from_string(f"Inter, Sans {weight} {size}px"))
        lay.set_text(t, -1)
        cr.set_source_rgba(1, 1, 1, alpha)
        cr.move_to(x, y)
        PangoCairo.show_layout(cr, lay)

    def picture(path, x, y, side, radius):
        pb = None
        if path:
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file(str(path))
            except GLib.Error:
                pb = None
        cr.save()
        cr.new_sub_path()
        cr.arc(x + side - radius, y + radius, radius, -math.pi / 2, 0)
        cr.arc(x + side - radius, y + side - radius, radius, 0, math.pi / 2)
        cr.arc(x + radius, y + side - radius, radius, math.pi / 2, math.pi)
        cr.arc(x + radius, y + radius, radius, math.pi, 3 * math.pi / 2)
        cr.close_path()
        cr.clip()
        if pb is not None:
            k = side / min(pb.get_width(), pb.get_height())
            cr.translate(x + (side - pb.get_width() * k) / 2, y + (side - pb.get_height() * k) / 2)
            cr.scale(k, k)
            Gdk.cairo_set_source_pixbuf(cr, pb, 0, 0)
        else:
            cr.set_source_rgba(1, 1, 1, 0.12)
        cr.paint()
        cr.restore()
    text(title, 64, "Bold", 1, 80, 110, W - 160)
    text(when, 40, "", 0.75, 80, 200, W - 160)
    y = 300
    if lead:
        text(lead, 150, "Heavy", 1, 80, y, W - 160)
        y += 260
    elif rows:
        picture(rows[0].get("art"), 190, y, 700, 36)
        y += 760
    for i, r in enumerate(rows[:5], 1):
        text(f"{i}", 52, "Bold", 0.6, 80, y + 20, 70)
        picture(r.get("art"), 160, y, 120, 16)
        text(r.get("title") or "", 46, "Bold", 1, 310, y + 8, 430)
        text(r.get("sub") or "", 34, "", 0.75, 310, y + 70, 430)
        text(r.get("value") or "", 36, "Bold", 0.9, 740, y + 36, 260, Pango.Alignment.RIGHT)
        y += 160
    text("Radon Player", 32, "Bold", 0.5, 80, H - 110, W - 160)
    surf.write_to_png(str(out))
    return str(out)


def collage_png(items, n, labels, out, cell=None):
    """A collage: the first n×n of items [{"title", "sub", "plays", "art": a picture's path or None}] as covers in a
    square grid, most played first, each with its name and plays over its bottom (labels), written to out (PNG)."""
    import cairo
    gi.require_version("PangoCairo", "1.0")
    from gi.repository import PangoCairo, GdkPixbuf, Gdk
    cell = cell or max(120, min(300, 3000 // n))
    side = cell * n
    surf = cairo.ImageSurface(cairo.FORMAT_RGB24, side, side)
    cr = cairo.Context(surf)
    cr.set_source_rgb(0.07, 0.07, 0.08)
    cr.paint()

    def text(t, size, weight, alpha, x, y, width):
        lay = PangoCairo.create_layout(cr)
        lay.set_width(int(width * Pango.SCALE))
        lay.set_ellipsize(Pango.EllipsizeMode.END)
        lay.set_font_description(Pango.FontDescription.from_string(f"Inter, Sans {weight} {size:.1f}px"))
        lay.set_text(t, -1)
        cr.set_source_rgba(1, 1, 1, alpha)
        cr.move_to(x, y)
        PangoCairo.show_layout(cr, lay)
    for i, it in enumerate(items[:n * n]):
        x, y = (i % n) * cell, (i // n) * cell
        pb = None
        if it.get("art"):
            try:
                pb = GdkPixbuf.Pixbuf.new_from_file(str(it["art"]))
            except GLib.Error:
                pb = None
        cr.save()
        cr.rectangle(x, y, cell, cell)
        cr.clip()
        if pb is not None:   # filled, the middle kept (a cover that isn't square is cut, not squashed)
            k = cell / min(pb.get_width(), pb.get_height())
            w, h = pb.get_width() * k, pb.get_height() * k
            cr.translate(x + (cell - w) / 2, y + (cell - h) / 2)
            cr.scale(k, k)
            Gdk.cairo_set_source_pixbuf(cr, pb, 0, 0)
            cr.paint()
        else:   # no picture: a quiet tile with the name big
            cr.set_source_rgb(0.16, 0.16, 0.19)
            cr.paint()
        cr.restore()
        if labels:
            pad = cell * 0.06
            grad = cairo.LinearGradient(0, y + cell * 0.45, 0, y + cell)
            grad.add_color_stop_rgba(0, 0, 0, 0, 0)
            grad.add_color_stop_rgba(1, 0, 0, 0, 0.85)
            cr.rectangle(x, y + cell * 0.45, cell, cell * 0.55)
            cr.set_source(grad)
            cr.fill()
            big, small = cell * 0.105, cell * 0.088
            plays = it.get("plays") or 0
            lines = [(it.get("title") or "", big, "Bold", 1.0)]
            if it.get("sub"):
                lines.append((it["sub"], small, "", 0.8))
            lines.append((f"{plays:,} play{'s' if plays != 1 else ''}", small, "", 0.8))
            yy = y + cell - pad - sum(sz * 1.25 for _t, sz, _w, _a in lines)
            for t, sz, w, alpha in lines:
                text(t, sz, w, alpha, x + pad, yy, cell - 2 * pad)
                yy += sz * 1.25
    surf.write_to_png(str(out))
    return out


