        line("Loudness check", (f"Checking your songs · {a.qc_busy}" if a.qc_busy else
                                f"{checked:,} songs checked: {clipped} clipped, {fake} not the hi-res they say" if checked else
                                "Checks your songs for clipping (distorted, too loud) and for files that aren't the hi-res they "
