def draw_icon(cr, name, size):
    """One of the app's icons on a 24 x 24 grid scaled to size, in the current colour (the phone draws the same)."""
    import math
    u = size / 24.0
    cr.set_line_width(2 * u)
    cr.set_line_cap(1)    # round
    cr.set_line_join(1)

    def line(*p, close=False, fill=False):
        cr.move_to(p[0] * u, p[1] * u)
        for i in range(2, len(p), 2):
            cr.line_to(p[i] * u, p[i + 1] * u)
        if close:
            cr.close_path()
        cr.fill() if fill else cr.stroke()

    def rect(x, y, w, h, r=1.2):
        x, y, w, h, r = x * u, y * u, w * u, h * u, r * u
        cr.new_sub_path()
        cr.arc(x + w - r, y + r, r, -math.pi / 2, 0)
        cr.arc(x + w - r, y + h - r, r, 0, math.pi / 2)
        cr.arc(x + r, y + h - r, r, math.pi / 2, math.pi)
        cr.arc(x + r, y + r, r, math.pi, 1.5 * math.pi)
        cr.close_path()
        cr.fill()

    def ring(x, y, r):
        cr.new_sub_path()
        cr.arc(x * u, y * u, r * u, 0, 2 * math.pi)
        cr.stroke()

    def dot(x, y, r):
        cr.new_sub_path()
        cr.arc(x * u, y * u, r * u, 0, 2 * math.pi)
        cr.fill()

    def arc(x, y, r, a0, a1):
        cr.new_sub_path()
        cr.arc(x * u, y * u, r * u, math.radians(a0), math.radians(a1))
        cr.stroke()

    def heart(fill):
        cr.move_to(12 * u, 20.5 * u)
        cr.curve_to(5 * u, 15 * u, 2 * u, 11.5 * u, 2 * u, 8.2 * u)
        cr.curve_to(2 * u, 5.5 * u, 4.2 * u, 3.5 * u, 6.8 * u, 3.5 * u)
        cr.curve_to(8.8 * u, 3.5 * u, 10.8 * u, 4.6 * u, 12 * u, 6.5 * u)
        cr.curve_to(13.2 * u, 4.6 * u, 15.2 * u, 3.5 * u, 17.2 * u, 3.5 * u)
        cr.curve_to(19.8 * u, 3.5 * u, 22 * u, 5.5 * u, 22 * u, 8.2 * u)
        cr.curve_to(22 * u, 11.5 * u, 19 * u, 15 * u, 12 * u, 20.5 * u)
        cr.close_path()
        cr.fill() if fill else cr.stroke()

    def star(fill):
        for i in range(10):
            r = 10 if i % 2 == 0 else 4.3
            a = -math.pi / 2 + i * math.pi / 5
            x, y = 12 + r * math.cos(a), 12.6 + r * math.sin(a)
            (cr.move_to if i == 0 else cr.line_to)(x * u, y * u)
        cr.close_path()
        if fill:
            cr.fill()
        else:
            cr.set_line_width(1.8 * u)
            cr.stroke()

    n = name
    if n == "play":
        line(7, 4.5, 19.5, 12, 7, 19.5, close=True, fill=True)
    elif n == "pause":
        rect(6, 4.5, 4, 15); rect(14, 4.5, 4, 15)
    elif n == "next":
