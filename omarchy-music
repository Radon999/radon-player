    def update_now_playing(self):
        a = self.app
        if getattr(a, "mini", None):
            a.mini.update()
        t = a.current_track()
        if not t:
            return
        self.np_title.set_label(t["title"])
        set_link_text(self.np_artist, t["artist"])
        speed = a.speeds.get(t)[0]
        self.np_album.set_label((f" · {t['album']}" if t.get("album") else "") + (f" · {speed:g}×" if speed != 1.0 else ""))
        self.np_art.clear()
        self.art.apply(self.np_art, t)
        self.update_tint(t)
        self.update_now_page(t)
        self.update_nav_sub()
        self.play_btn.icon.set_name("play" if a.paused else "pause")
