    def update_now_page(self, t):
        if not t or not hasattr(self, "np2_title"):
            return
        a = self.app
        self.np2_title.set_label(t["title"])
        set_link_text(self.np2_artist, t["artist"])
        self.np2_album.set_label(f"  —  {t['album']}" if t.get("album") else "")
        self.np2_album.set_visible(bool(t.get("album")))
        src = source_of(t)
        frm = ("Playing a radio" if getattr(a, "radio", False) else "") or \
              (f"From the album {t['album']}" if t.get("album") else "") or \
              (f"Playing from {a.queue_name_s}" if a.queue_name_s else "") or \
              ("My music" if src == "file" or self.lib.has(t["id"]) else SOURCES.get(src, ""))
        self.np_from.set_label(frm)
        self.np_from.set_visible(bool(frm))
        child = self.np_badges.get_first_child()
        while child:
            nxt = child.get_next_sibling()
            self.np_badges.remove(child)
            child = nxt
        saved = self.lib.items.get(t["id"]) if self.lib.has(t["id"]) else None
        marks = []
        if saved:
            marks.append(("FLAC " + (saved.get("quality") or "")).strip() if saved.get("format") == "flac" else "✓ offline")
        elif src != "file":
            q = a.dl.stream_quality(t["id"])
            lossy = a.dl.stream_lossy(t["id"])
            marks.append(q if q and lossy else f"FLAC {q}" if q else "Streaming")
        else:
            # Your own file: its format, bit depth and kHz (or kbps), read from the file.
            facts = None if is_phone_song(t) else self.file_facts_now(t.get("file") or "")
            ext = Path(t.get("file") or "").suffix.lstrip(".").upper()
            if facts and facts.get("quality"):
                marks.append(f"{facts['format']} {facts['quality']}")
            elif ext:
                marks.append(ext)
        speed = a.speeds.get(t)[0]
        if speed != 1.0:
            marks.append(f"{speed:g}×")
        try:
            g = a.gains.get(t)
            if g:
                marks.append(f"{g:+.1f} dB")
        except Exception:  # noqa: BLE001 -- the mark is a nicety
            pass
        for i, m in enumerate(marks):
            lab = Gtk.Label(label=m)
            lab.add_css_class("badge")
            if i:
                lab.add_css_class("quiet")
            self.np_badges.append(lab)
        self.load_big_art(t)

