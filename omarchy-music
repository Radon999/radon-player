    def update_like(self):
        t = self.app.current_track()
        src = self.app.sources.get(source_of(t)) if t else None
        can = bool(t) and bool(src and src.signed_in)
        liked = can and t["id"] in self.app.liked
        self.like_btn.set_visible(can)
        self.tool_like.set_visible(can)
        self.set_tool(self.tool_like, "heart" if liked else "heart_line", liked)
