def deezer_album_tracks(artist, album):
    """(blocking) An album's songs on Deezer, in order: [{"n", "title", "short", "secs"}], or None if it isn't there
    (its name must match, editions included: "Persona (Extended)" isn't "Persona")."""
    q = f'artist:"{artist}" album:"{album}"'
    data = http_json("https://api.deezer.com/search/album?" + urllib.parse.urlencode({"q": q, "limit": 5})).get("data") or []
    want = norm(album)
    best = next((a for a in data if norm(a.get("title")) == want), None)
    if best is None:
        return None
    tracks = http_json(f"https://api.deezer.com/album/{best['id']}/tracks?limit=200").get("data") or []
    return [{"n": tr.get("track_position") or i, "title": tr.get("title") or "", "short": tr.get("title_short") or "",
             "secs": tr.get("duration") or 0} for i, tr in enumerate(tracks, 1)] or None


def deezer_tracklist(artist, album):
    """(blocking) An album's songs on Deezer as {clean title: track number}, or None if it isn't there."""
    out = {}
    for tr in deezer_album_tracks(artist, album) or []:
        out.setdefault(norm(clean_title(tr["title"])), tr["n"])
        out.setdefault(norm(clean_title(tr["short"])), tr["n"])
    out.pop("", None)
    return out or None


