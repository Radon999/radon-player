def make_backup(dest):
    """(blocking) Everything in BACKUP_FILES that's there, into the zip dest. How many files went in."""
    import zipfile
    n = 0
    with zipfile.ZipFile(dest, "w", zipfile.ZIP_DEFLATED) as z:
        z.writestr("radon-backup.json", json.dumps({"app": "radon-player", "platform": "desktop", "version": VERSION,
                                                    "made": int(time.time())}))
        for name, path in BACKUP_FILES.items():
            if Path(path).is_file():
                z.write(path, name)
                n += 1
    return n


def restore_backup(src):
    """(blocking) Put back a backup make_backup made: each file in it in its place (the one there kept beside it as
    .before-restore). The names restored. ValueError if it isn't one of the PC app's backups."""
    import zipfile
    with zipfile.ZipFile(src) as z:
        try:
            info = json.loads(z.read("radon-backup.json"))
        except KeyError:
            raise ValueError("that isn't a Radon Player backup") from None
        if info.get("platform") != "desktop":
            raise ValueError("that's the phone's backup: restore it in the Android app")
        done = []
        for name, path in BACKUP_FILES.items():
            if name not in z.namelist():
                continue
            data = z.read(name)
            json.loads(data)   # it's JSON (or this stops before writing anything wrong)
            path = Path(path)
            if path.exists():
                shutil.copyfile(path, path.with_name(path.name + ".before-restore"))
            path.parent.mkdir(parents=True, exist_ok=True)
            write_atomic(path, data.decode())
            done.append(name)
    return done


def quality_check(path):
    """(blocking, ffmpeg) What a song's file really is: {"clipped": samples at full scale (0: none to speak of),
    "peak": its peak in dBFS, "fake": "" or why it isn't the hi-res it says (upsampled, or 16-bit dressed as 24)}."""
    facts = file_facts(path)
    stats = "astats=measure_perchannel=none:measure_overall=Peak_level+Peak_count+Bit_depth+RMS_level"
    out = subprocess.run(["ffmpeg", "-nostdin", "-nostats", "-hide_banner", "-i", str(path), "-af", stats, "-f", "null", "-"],
                         capture_output=True, text=True, timeout=600, **NO_WINDOW).stderr

    def num(name):
        m = re.search(rf"{name}[^:]*:\s*(-?[\d.]+|-inf)", out)
        return float(m.group(1)) if m and m.group(1) != "-inf" else None
    peak, count, rms = num("Peak level dB"), num("Peak count"), num("RMS level dB")
    bits = [int(x) for x in re.findall(r"Bit depth:\s*([\d/]+)", out)[-1].split("/")] if "Bit depth" in out else []
    res = {"clipped": 0, "peak": round(peak, 2) if peak is not None else None, "fake": ""}
    if peak is not None and peak >= -0.1 and (count or 0) >= 200:
        res["clipped"] = int(count)
    if facts.get("bits", 0) >= 24 and bits and max(bits) <= 16:
        res["fake"] = "16-bit music in a 24-bit file"
    if facts.get("rate", 0) > 48000 and rms is not None:
        hp = "highpass=f=21000:poles=2,highpass=f=21000:poles=2,astats=measure_perchannel=none:measure_overall=RMS_level"
        o2 = subprocess.run(["ffmpeg", "-nostdin", "-nostats", "-hide_banner", "-i", str(path), "-af", hp, "-f", "null", "-"],
                            capture_output=True, text=True, timeout=600, **NO_WINDOW).stderr
        m = re.search(r"RMS level dB:\s*(-?[\d.]+|-inf)", o2)
        top = float(m.group(1)) if m and m.group(1) != "-inf" else -200.0
        if top - rms < -80:
            res["fake"] = ", ".join(x for x in (res["fake"], f"upsampled: nothing above 21 kHz in a {facts['rate'] / 1000:g} kHz file") if x)
    return res


def fingerprint(path):
    """(blocking, ffmpeg) A song's sound as AcoustID knows it: (its fingerprint, its length in seconds)."""
    secs = file_facts(path).get("duration") or 0
    out = subprocess.run(["ffmpeg", "-v", "error", "-nostdin", "-i", str(path), "-t", "120", "-ac", "2", "-f", "chromaprint",
                          "-fp_format", "base64", "-"], capture_output=True, timeout=180, **NO_WINDOW)
    fp = out.stdout.decode(errors="replace").strip()
    if not fp:
        fpcalc = shutil.which("fpcalc")   # an ffmpeg without chromaprint: the fpcalc tool, if it's there
        if fpcalc:
            o = subprocess.run([fpcalc, "-json", str(path)], capture_output=True, timeout=180, **NO_WINDOW)
            j = json.loads(o.stdout or b"{}")
            fp, secs = j.get("fingerprint") or "", j.get("duration") or secs
    if not fp:
        raise RuntimeError("couldn't hear the song (this ffmpeg can't make fingerprints)")
    return fp, round(secs)


def acoustid_identify(path, key):
    """(blocking) What a song is, by its sound (AcoustID, then MusicBrainz's names): [{"title", "artist", "album",
    "score"}], the likeliest first."""
    fp, secs = fingerprint(path)
    data = urllib.parse.urlencode({"client": key, "duration": secs, "fingerprint": fp, "format": "json",
                                   "meta": "recordings releasegroups compress"}).encode()
    res = json.loads(http("https://api.acoustid.org/v2/lookup", data=data,
                          headers={"Content-Type": "application/x-www-form-urlencoded"}))
    if res.get("status") != "ok":
        raise RuntimeError((res.get("error") or {}).get("message") or "AcoustID didn't answer")
    out, seen = [], set()
    for r in res.get("results") or []:
        for rec in r.get("recordings") or []:
            title = rec.get("title") or ""
            artist = ", ".join(a.get("name") or "" for a in rec.get("artists") or [])
            groups = rec.get("releasegroups") or [{}]
            for g in groups[:3]:
                k = (norm(title), norm(artist), norm(g.get("title") or ""))
                if title and k not in seen:
                    seen.add(k)
                    out.append({"title": title, "artist": artist, "album": g.get("title") or "", "type": g.get("type") or "",
                                "score": round(r.get("score") or 0, 2)})
    return out[:12]


