    def album_plays_dialog(self):
        """Settings › Plays on singles and albums…: songs whose imported plays are split between their single, an EP
        and the album (or its deluxe), each Merge plays onto the album, Leave alone, or Other album."""
        a = self.app
        dlg, body, status = self.work_dialog("Plays on singles and albums", full=True)
        plays = [(p[2], p[1], p[3], 1) for p in a.spotify_history.plays]
