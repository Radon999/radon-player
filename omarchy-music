    # ---- skips: a song you went on from with more than SKIP_LEFT seconds of it left ----
    def note_leaving(self):
        """The song playing is about to change: count it as skipped, unless it ran out on its own
        or you went back to the one before."""
        ls = self.listen
        finishing, back = self._finishing, self._going_back
        self._finishing = self._going_back = False
        if not ls or finishing or back:
            return
        t = ls["track"]
        dur = self.duration or ls["meta"].get("duration") or t.get("duration") or 0
        if ls["played"] >= 1 and dur > SKIP_LEFT * 2 and self.position < dur - SKIP_LEFT:
            self.song_stats.skipped(t)
            if self.win and self.win.music_view == "skips" and not self.win.selecting:
                self.win.refresh_music()

    def set_speed(self, tracks, speed, pitch=False):
