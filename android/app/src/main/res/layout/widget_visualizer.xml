<?xml version="1.0" encoding="utf-8"?>
<!-- Visualizer: the music playing as bars in its cover's colours, moving only while it can be seen and music plays; the
     song under it, with play/pause and next. A tap on the bars opens Now playing (VisualizerWidget). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wv_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <!-- The rounded background, in the playing song's cover colour (HomeWidgets.paint) -->
    <ImageView android:id="@+id/w_bg" android:layout_width="match_parent" android:layout_height="match_parent"
        android:src="@drawable/widget_bg" android:scaleType="fitXY" android:tint="#D92B2B3C" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="12dp">

    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ImageView android:id="@+id/wv_bars" android:layout_width="match_parent" android:layout_height="match_parent"
            android:scaleType="fitXY" android:src="@drawable/w_viz" android:contentDescription="The music, as bars" />
        <TextView android:id="@+id/wv_hint" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:padding="6dp" android:textSize="12sp" android:textColor="#FFFFFFFF" android:alpha="0.85"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="6dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/wv_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="14sp" android:textStyle="bold" android:textColor="#FFFFFFFF" android:maxLines="1" android:ellipsize="end"
                android:text="Nothing playing" />
            <TextView android:id="@+id/wv_artist" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:textSize="12sp" android:textColor="#FFFFFFFF" android:maxLines="1" android:ellipsize="end" android:alpha="0.75"
                android:text="Visualizer" />
        </LinearLayout>
        <ImageButton android:id="@+id/wv_play" android:layout_width="44dp" android:layout_height="match_parent"
            android:background="@android:color/transparent" android:src="@drawable/w_play" android:contentDescription="Play or pause" />
        <ImageButton android:id="@+id/wv_next" android:layout_width="44dp" android:layout_height="match_parent"
            android:background="@android:color/transparent" android:src="@drawable/w_next" android:contentDescription="Next" />
    </LinearLayout>
    </LinearLayout>
</FrameLayout>
